  - m_Id: 50015232000
    m_Localized: "\u672C\u7CBE\u9748\u5C07\u5354\u52A9\u60A8\u7C3D\u7F72\u5C08\u5C6C\u526A\u8F2F\u5E2B\u5408\u7D04\u3002
      \n\n\u82E5\u8981\u7E7C\u7E8C\uFF0C\u8ACB\u6309\u4E00\u4E0B\u300C\u4E0B\u4E00\u6B65\u300D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232001
    m_Localized: "\u8ACB\u95B1\u8B80\u6388\u6B0A\u689D\u6B3E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232002
    m_Localized: "\u81E8\u6642\u526A\u8F2F\u5E2B\u50F1\u50AD\u5408\u7D04\n\n\u52C7\u58EB\uFF08\u4EE5\u4E0B\u7C21\u7A31\u300C\u7532\u65B9\u300D\uFF09\u8207\u526A\u8F2F\u5E2B\uFF08\u4EE5\u4E0B\u7C21\u7A31\u300C\u4E59\u65B9\u300D\uFF09\u9054\u6210\u5982\u4E0B\u5354\u8B70\uFF1A\n\n\u7B2C\u4E00\u689D.
      \u5408\u7D04\u671F\u9650 \n\u52DE\u52D5\u5408\u7D04\u671F\u9650\u81EA\u4E59\u65B9\u56DE\u57F7\u5408\u7D04\u4E4B\u65E5\u8D77\u81F3\u5230\u671F\u65E5\u6B62\u3002\u82E5\u672A\u660E\u78BA\u6A19\u8A3B\u5230\u671F\u65E5\uFF0C\u5247\u5408\u7D04\u81EA\u52D5\u5EF6\u671F\uFF1B\u82E5\u5230\u671F\u65E5\u66F4\u65B0\u70BA\u7279\u5B9A\u65E5\u671F\uFF0C\u7532\u65B9\u9808\u81F3\u5C11\u5728\u5230\u671F\u524D
      7 \u5929\u901A\u77E5\u4E59\u65B9\u3002\n\n\u7B2C\u4E8C\u689D. \u5DE5\u4F5C\u5730\u9EDE\u53CA\u696D\u52D9\u5167\u5BB9
      \n\u4E59\u65B9\u4F5C\u70BA\u7532\u65B9 Wtube \u983B\u9053\u7684\u526A\u8F2F\u5E2B\uFF0C\u8CA0\u8CAC\u7532\u65B9\u4EA4\u4ED8\u5F71\u7247\u7684\u5168\u7A0B\u526A\u8F2F\u5DE5\u4F5C\u3002\u4E59\u65B9\u9808\u5728\u7532\u65B9\u901A\u77E5\u7684\u671F\u9650\u5167\u50B3\u9001\u5F71\u7247\u6A94\u6848\u3002\u4E59\u65B9\u5DE5\u4F5C\u5730\u9EDE\u70BA\u5BB6\u4E2D\uFF0C\u7121\u9700\u6BCF\u65E5\u5411\u7532\u65B9\u901A\u5831\u5DE5\u4F5C\u60C5\u6CC1\u3002\u4F46\u7576\u7532\u65B9\u8981\u6C42\u6838\u5BE6\u5DE5\u4F5C\u5BE6\u7E3E\u6642\uFF0C\u4E59\u65B9\u9808\u900F\u904E
      Manasoft Worlds Movie Weaver \u7684\u57F7\u884C\u8A18\u9304\u3001\u6240\u7522\u751F\u5F71\u7247\u6A94\u6848\u7684\u526A\u8F2F\u65E5\u671F\u7B49\u8B49\u660E\u8CC7\u6599\u9032\u884C\u78BA\u8A8D\u3002\n\n\u7B2C\u4E09\u689D.
      \u5DE5\u4F5C\u6642\u9593\u53CA\u4F11\u606F\u6642\u9593 \n\u539F\u5247\u4E0A\u5BE6\u884C\u6BCF\u9031
      52 \u5C0F\u6642\u5DE5\u4F5C\u5236\uFF0C\u6BCF\u65E5\u5DE5\u4F5C\u6642\u9593\u6700\u9577
      8 \u5C0F\u6642\uFF0C\u5305\u542B\u7BC0\u5047\u65E5\u52A0\u73ED\u5728\u5167\u7684\u5EF6\u9577\u5DE5\u4F5C\u6642\u9593\u7E3D\u8A08\u4E0D\u5F97\u8D85\u904E
      12 \u5C0F\u6642\u3002\u5DE5\u4F5C\u6642\u9593\u53CA\u4F11\u606F\u6642\u9593\u5982\u4E0B\uFF1A\u5DE5\u4F5C\u65E5\u2026\u2026
      \n\n\u82E5\u8981\u78BA\u8A8D\u5408\u7D04\u7684\u8A73\u7D30\u5167\u5BB9\uFF0C\u8ACB\u6309\u4E00\u4E0B<u>\u6B64\u8655</u>\u5B58\u53D6
      Manasoft \u5B98\u65B9\u7DB2\u7AD9\u3002"
    m_Metadata:
      m_Items: []
