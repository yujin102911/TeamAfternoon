  - m_Id: 50019426304
    m_Localized: "\u8EDF\u9AD4\u7D42\u7AEF\u4F7F\u7528\u8005\u6388\u6B0A\u5408\u7D04"
    m_Metadata:
      m_Items: []
  - m_Id: 50019426305
    m_Localized: "Manasoft\uFF08\u6216\u6839\u64DA\u60A8\u5C45\u4F4F\u5730\u7684\u4E0D\u540C\uFF0C\u70BA\u5176\u95DC\u4FC2\u4F01\u696D\u4E4B\u4E00\uFF09\u6388\u6B0A\u60A8\u4F7F\u7528\u672C\u88DC\u5145\u5143\u4EF6\u3002\n\n\u672C\u88DC\u5145\u5143\u4EF6\u5728\u60A8\u64C1\u6709\u76F8\u61C9\u7684\u300A\u5C08\u5C6C\u526A\u8F2F\u5E2B\u50F1\u50AD\u5408\u7D04\u300B\u3001\u300A\u5C08\u5C6C\u6A02\u5718\u50F1\u50AD\u5408\u7D04\u300B\u6216\u300A\u5C08\u5C6C\u6D77\u76DC\u50F1\u50AD\u5408\u7D04\u300B\uFF08\u4EE5\u4E0B\u7C21\u7A31\u300C\u5408\u7D04\u300D\uFF09\u4E4B\u6388\u6B0A\u6642\u65B9\u53EF\u4F7F\u7528\u3002\u82E5\u60A8\u6C92\u6709\u76F8\u95DC\u5408\u7D04\u7684\u6388\u6B0A\u6216\u8A31\u6B0A\u5DF2\u904E\u671F\uFF0C\u5247\u4E0D\u5F97\u4F7F\u7528\u672C\u88DC\u5145\u5143\u4EF6\u3002Manasoft
      \u5C07\u6309\u7167\u5B98\u65B9\u7DB2\u7AD9\u6240\u8FF0\uFF0C\u70BA\u672C\u88DC\u5145\u5143\u4EF6\u63D0\u4F9B\u652F\u63F4\u670D\u52D9\u3002\n\n\u672C\u88DC\u5145\u5143\u4EF6\u900F\u904E
      Manasoft Worlds Movie Weaver \u61C9\u7528\u7A0B\u5F0F\uFF08\u4EE5\u4E0B\u7C21\u7A31\u300C\u7A0B\u5F0F\u300D\uFF0C\u9700\u4F7F\u7528\u8005\u53E6\u884C\u5B89\u88DD\u4E26\u7372\u5F97\u6388\u6B0A\uFF09\u652F\u63F4\u7372\u5F97\u6388\u6B0A\u7684\u4F7F\u7528\u8005\u9032\u884C\u65B0\u624B\u6559\u5B78\u3002\n\n\u4E00\u65E6\u5B89\u88DD\u3001\u8907\u88FD\u3001\u4E0B\u8F09\u3001\u5B58\u53D6\u6216\u4EE5\u5176\u4ED6\u65B9\u5F0F\u4F7F\u7528\u672C\u88DC\u5145\u5143\u4EF6\uFF0C\u5373\u8868\u793A\u60A8\u540C\u610F\u63A5\u53D7\u672C\u5408\u7D04\u689D\u6B3E\u7684\u7D04\u675F\u3002"
