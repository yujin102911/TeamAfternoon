    m_Metadata:
      m_Items: []
  - m_Id: 50019426305
    m_Localized: "Manasoft\uFF08\u6216\u6839\u636E\u60A8\u5C45\u4F4F\u5730\u7684\u4E0D\u540C\uFF0C\u4E3A\u5176\u5173\u8054\u516C\u53F8\u4E4B\u4E00\uFF09\u6388\u6743\u60A8\u4F7F\u7528\u672C\u8865\u5145\u7EC4\u4EF6\u3002\n\n\u5982\u679C\u60A8\u62E5\u6709\u76F8\u5E94\u7684\u300A\u4E13\u5C5E\u526A\u8F91\u5E08\u96C7\u4F63\u5408\u540C\u300B\u3001\u300A\u4E13\u5C5E\u4E50\u56E2\u96C7\u4F63\u5408\u540C\u300B\u6216\u300A\u4E13\u5C5E\u6D77\u76D7\u96C7\u4F63\u5408\u540C\u300B\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u5408\u540C\u201D\uFF09\u7684\u8BB8\u53EF\uFF0C\u5219\u53EF\u4EE5\u4F7F\u7528\u672C\u8865\u5145\u7EC4\u4EF6\u3002\n\n\u5982\u679C\u60A8\u6CA1\u6709\u76F8\u5173\u5408\u540C\u7684\u8BB8\u53EF\u6216\u8BB8\u53EF\u5DF2\u8FC7\u671F\uFF0C\u5219\u4E0D\u5F97\u4F7F\u7528\u672C\u8865\u5145\u7EC4\u4EF6\u3002Manasoft
      \u5C06\u6309\u7167\u5B98\u65B9\u7F51\u7AD9\u6240\u8FF0\uFF0C\u4E3A\u672C\u8865\u5145\u7EC4\u4EF6\u63D0\u4F9B\u652F\u6301\u670D\u52A1\u3002\n\n\u672C\u8865\u5145\u7EC4\u4EF6\u901A\u8FC7
      Manasoft Worlds Movie Weaver \u5E94\u7528\u7A0B\u5E8F\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u7A0B\u5E8F\u201D\uFF0C\u9700\u7528\u6237\u53E6\u884C\u5B89\u88C5\u5E76\u83B7\u5F97\u8BB8\u53EF\uFF09\u652F\u6301\u83B7\u5F97\u8BB8\u53EF\u7684\u7528\u6237\u8FDB\u884C\u65B0\u624B\u6559\u7A0B\u3002\u4E00\u65E6\u5B89\u88C5\u3001\u590D\u5236\u3001\u4E0B\u8F7D\u3001\u8BBF\u95EE\u6216\u4EE5\u5176\u4ED6\u65B9\u5F0F\u4F7F\u7528\u672C\u8865\u5145\u7EC4\u4EF6\uFF0C\u5373\u8868\u793A\u60A8\u540C\u610F\u63A5\u53D7\u672C\u534F\u8BAE\u6761\u6B3E\u7684\u7EA6\u675F\u3002"
    m_Metadata:
