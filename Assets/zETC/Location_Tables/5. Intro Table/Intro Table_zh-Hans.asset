  - m_Id: 50015232000
    m_Localized: "\u672C\u5411\u5BFC\u5C06\u534F\u52A9\u60A8\u7B7E\u7F72\u4E13\u5C5E\u526A\u8F91\u5E08\u5408\u540C\u3002\n\n\u82E5\u8981\u7EE7\u7EED\uFF0C\u8BF7\u5355\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232001
    m_Localized: "\u8BF7\u9605\u8BFB\u8BB8\u53EF\u534F\u8BAE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232002
    m_Localized: "\u4E13\u5C5E\u526A\u8F91\u5E08\u96C7\u4F63\u5408\u540C\n\n\u52C7\u58EB\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u7532\u65B9\u201D\uFF09\u4E0E\u526A\u8F91\u5E08\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u4E59\u65B9\u201D\uFF09\u8FBE\u6210\u5982\u4E0B\u534F\u8BAE\uFF1A\n\n\u7B2C\u4E00\u6761.
      \u5408\u540C\u671F\u9650\n\u52B3\u52A8\u5408\u540C\u671F\u9650\u81EA\u4E59\u65B9\u56DE\u6267\u5408\u540C\u4E4B\u65E5\u8D77\u81F3\u5230\u671F\u65E5\u6B62\u3002\u82E5\u672A\u660E\u786E\u6807\u6CE8\u5230\u671F\u65E5\uFF0C\u5219\u5408\u540C\u81EA\u52A8\u5EF6\u671F\uFF1B\u82E5\u5230\u671F\u65E5\u66F4\u65B0\u4E3A\u7279\u5B9A\u65E5\u671F\uFF0C\u7532\u65B9\u987B\u81F3\u5C11\u5728\u5230\u671F\u524D
      7 \u5929\u901A\u77E5\u4E59\u65B9\u3002\n\n\u7B2C\u4E8C\u6761. \u5DE5\u4F5C\u5730\u70B9\u53CA\u4E1A\u52A1\u5185\u5BB9\n\u4E59\u65B9\u4F5C\u4E3A\u7532\u65B9
      Wtube \u9891\u9053\u7684\u526A\u8F91\u5E08\uFF0C\u8D1F\u8D23\u7532\u65B9\u4EA4\u4ED8\u89C6\u9891\u7684\u5168\u7A0B\u526A\u8F91\u5DE5\u4F5C\u3002\u4E59\u65B9\u987B\u5728\u7532\u65B9\u901A\u77E5\u7684\u671F\u9650\u5185\u4F20\u9001\u89C6\u9891\u6587\u4EF6\u3002\u4E59\u65B9\u5DE5\u4F5C\u5730\u70B9\u4E3A\u5BB6\u4E2D\uFF0C\u65E0\u9700\u6BCF\u65E5\u5411\u7532\u65B9\u901A\u62A5\u5DE5\u4F5C\u60C5\u51B5\u3002\u4F46\u5F53\u7532\u65B9\u8981\u6C42\u6838\u5B9E\u5DE5\u4F5C\u5B9E\u7EE9\u65F6\uFF0C\u4E59\u65B9\u987B\u901A\u8FC7
      Manasoft Worlds Movie Weaver \u7684\u8FD0\u884C\u8BB0\u5F55\u3001\u6240\u751F\u6210\u89C6\u9891\u6587\u4EF6\u7684\u526A\u8F91\u65E5\u671F\u7B49\u8BC1\u660E\u6750\u6599\u8FDB\u884C\u786E\u8BA4\u3002\n\n\u7B2C\u4E09\u6761.
      \u5DE5\u4F5C\u65F6\u95F4\u53CA\u4F11\u606F\u65F6\u95F4\n\u539F\u5219\u4E0A\u5B9E\u884C\u6BCF\u5468
      52 \u5C0F\u65F6\u5DE5\u4F5C\u5236\uFF0C\u6BCF\u65E5\u5DE5\u4F5C\u65F6\u95F4\u6700\u957F
      8 \u5C0F\u65F6\uFF0C\u5305\u542B\u8282\u5047\u65E5\u52A0\u73ED\u5728\u5185\u7684\u5EF6\u957F\u5DE5\u4F5C\u65F6\u95F4\u603B\u8BA1\u4E0D\u5F97\u8D85\u8FC7
      12 \u5C0F\u65F6\u3002\u5DE5\u4F5C\u65F6\u95F4\u53CA\u4F11\u606F\u65F6\u95F4\u5982\u4E0B\uFF1A\u5DE5\u4F5C\u65E5\u2026\u2026\n\n\u82E5\u8981\u786E\u8BA4\u5408\u540C\u7684\u8BE6\u7EC6\u5185\u5BB9\uFF0C\u8BF7\u70B9\u51FB\u6B64\u5904\u8BBF\u95EE
      Manasoft \u5B98\u65B9\u7F51\u7AD9\u3002"
    m_Metadata:
      m_Items: []
