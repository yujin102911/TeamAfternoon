    m_Localized: "\u4E13\u5C5E\u526A\u8F91\u5E08\u96C7\u4F63\u5408\u540C\n\n\u52C7\u58EB\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u7532\u65B9\u201D\uFF09\u4E0E\u526A\u8F91\u5E08\uFF08\u4EE5\u4E0B\u7B80\u79F0\u201C\u4E59\u65B9\u201D\uFF09\u8FBE\u6210\u5982\u4E0B\u534F\u8BAE\uFF1A\n\n\u7B2C\u4E00\u6761.
      \u5408\u540C\u671F\u9650\n\u52B3\u52A8\u5408\u540C\u671F\u9650\u81EA\u4E59\u65B9\u56DE\u6267\u5408\u540C\u4E4B\u65E5\u8D77\u81F3\u5230\u671F\u65E5\u6B62\u3002\u7EC8\u6B62\u65E5\u4E3A\u7532\u65B9\u505C\u6B62\u8FD0\u8425\u4E1A\u52A1\u4E4B\u65E5\uFF0C\u6216\u4E59\u65B9\u65E0\u6CD5\u7EE7\u7EED\u63D0\u4F9B\u52B3\u52A1\u4E4B\u65E5\u3002\n\n\u7B2C\u4E8C\u6761.
      \u5DE5\u4F5C\u5730\u70B9\u53CA\u4E1A\u52A1\u5185\u5BB9\n\u4E59\u65B9\u4F5C\u4E3A\u7532\u65B9
      Wtube \u9891\u9053\u7684\u526A\u8F91\u5E08\uFF0C\u8D1F\u8D23\u7532\u65B9\u4EA4\u4ED8\u89C6\u9891\u7684\u5168\u7A0B\u526A\u8F91\u5DE5\u4F5C\u3002\u4E59\u65B9\u987B\u5728\u7532\u65B9\u901A\u77E5\u7684\u671F\u9650\u5185\u4F20\u9001\u89C6\u9891\u6587\u4EF6\u3002\u4E59\u65B9\u5DE5\u4F5C\u5730\u70B9\u4E3A\u5BB6\u4E2D\uFF0C\u65E0\u9700\u6BCF\u65E5\u5411\u7532\u65B9\u901A\u62A5\u5DE5\u4F5C\u60C5\u51B5\u3002\u4F46\u5F53\u7532\u65B9\u8981\u6C42\u6838\u5B9E\u5DE5\u4F5C\u5B9E\u7EE9\u65F6\uFF0C\u4E59\u65B9\u987B\u901A\u8FC7
      Manasoft Worlds Movie Weaver \u7684\u8FD0\u884C\u8BB0\u5F55\u3001\u6240\u751F\u6210\u89C6\u9891\u6587\u4EF6\u7684\u526A\u8F91\u65E5\u671F\u7B49\u8BC1\u660E\u6750\u6599\u8FDB\u884C\u786E\u8BA4\u3002\n\n\u7B2C\u4E09\u6761.
      \u5DE5\u4F5C\u65F6\u95F4\u53CA\u4F11\u606F\u65F6\u95F4\n\u539F\u5219\u4E0A\u5B9E\u884C\u6BCF\u5468
