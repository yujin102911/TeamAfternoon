  - m_Id: 50019426304
    m_Localized: "\u041B\u0438\u0446\u0435\u043D\u0437\u0438\u043E\u043D\u043D\u043E\u0435
      \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435 \u0441 \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 50019426305
    m_Localized: "Manasoft (\u0438\u043B\u0438 \u043E\u0434\u043D\u0430 \u0438\u0437
      \u0430\u0444\u0444\u0438\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0439 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0432\u0430\u0448\u0435\u0433\u043E \u0440\u0435\u0433\u0438\u043E\u043D\u0430)
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u043C \u043F\u0440\u0430\u0432\u043E \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430.\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0434\u0430\u043D\u043D\u044B\u0439 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u043C\u043E\u0436\u043D\u043E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438
      \u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043D\u0430 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430, \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
      \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u0430 \u0438\u043B\u0438 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
      \u043F\u0438\u0440\u0430\u0442\u0430 (\u0434\u0430\u043B\u0435\u0435 \u2014
      \xAB\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\xBB). \u0415\u0441\u043B\u0438
      \u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442 \u0438\u043B\u0438
      \u043E\u043D \u0438\u0441\u0442\u0451\u043A, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u043B\u044C\u0437\u044F. Manasoft \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0443\u0441\u043B\u0443\u0433\u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
      \u0434\u043B\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430, \u043A\u0430\u043A
      \u0443\u043A\u0430\u0437\u0430\u043D\u043E \u043D\u0430 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C
      \u0441\u0430\u0439\u0442\u0435.\n\n\u0414\u0430\u043D\u043D\u044B\u0439 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0443\u0447\u0435\u0431\u043D\u043E\u0433\u043E
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      Manasoft Worlds Movie Weaver \u0434\u043B\u044F Worlds (\u0434\u0430\u043B\u0435\u0435
      \u2014 \xAB\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\xBB), \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0438 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C.\n\n\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F,
      \u043A\u043E\u043F\u0438\u0440\u0443\u044F, \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044F,
      \u043F\u043E\u043B\u0443\u0447\u0430\u044F \u0434\u043E\u0441\u0442\u0443\u043F
      \u0438\u043B\u0438 \u0438\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442, \u0432\u044B \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044C
      \u0441 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 50019426306
    m_Localized: "\u0414\u0430, \u044F \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430."
