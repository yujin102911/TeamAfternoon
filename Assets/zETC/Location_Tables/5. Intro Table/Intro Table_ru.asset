  - m_Id: 49981677568
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442.seal"
    m_Metadata:
      m_Items: []
  - m_Id: 50011037696
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043D\u0430 \u043D\u0430\u0439\u043C
      \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 50011037697
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043D\u0430 \u043D\u0430\u0439\u043C
      \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232000
    m_Localized: "\u042D\u0442\u0430 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430
      \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0441 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430 \u0441 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u044B\u043C
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u043E\u043C.\n\n\u0427\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C, \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u0414\u0430\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232001
    m_Localized: "\u041F\u0440\u043E\u0447\u0442\u0438\u0442\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232002
    m_Localized: "\xAB\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043D\u0430
      \u043D\u0430\u0439\u043C \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u0433\u043E
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430\n\u0413\u0435\u0440\u043E\u0439
      (\u0434\u0430\u043B\u0435\u0435 \u2014 \xAB\u0421\u0442\u043E\u0440\u043E\u043D\u0430
      \u0410\xBB) \u0438 \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440 (\u0434\u0430\u043B\u0435\u0435
      \u2014 \xAB\u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0411\xBB) \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u044E\u0442
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.\n\n\u0421\u0442\u0430\u0442\u044C\u044F
      1. \u0421\u0440\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430\n\u0421\u0440\u043E\u043A
      \u0442\u0440\u0443\u0434\u043E\u0432\u043E\u0433\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 \u0434\u0430\u0442\u044B,
      \u043A\u043E\u0433\u0434\u0430 \u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0411
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442, \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u0434\u043E \u0434\u0430\u0442\u044B \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F.
      \u0415\u0441\u043B\u0438 \u0434\u0430\u0442\u0430 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
      \u043D\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u0430, \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442\u0441\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.
      \u0415\u0441\u043B\u0438 \u0434\u0430\u0442\u0430 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E,
      \u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0411 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0430
      \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u0437\u0430 7 \u0434\u043D\u0435\u0439
      \u0434\u043E \u044D\u0442\u043E\u0439 \u0434\u0430\u0442\u044B.\n\n\u0421\u0442\u0430\u0442\u044C\u044F
      2. \u041C\u0435\u0441\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u044B \u0438
      \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0435\u0439\n\u0421\u0442\u043E\u0440\u043E\u043D\u0430
      \u0411 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0444\u0443\u043D\u043A\u0446\u0438\u0438
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430 \u043D\u0430 \u043A\u0430\u043D\u0430\u043B\u0435
      \u0421\u0442\u043E\u0440\u043E\u043D\u044B \u0410 \u043D\u0430 Wtube \u0438
      \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442 \u043F\u043E\u043B\u043D\u044B\u0439
      \u0446\u0438\u043A\u043B \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0432\u0438\u0434\u0435\u043E, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u0421\u0442\u043E\u0440\u043E\u043D\u043E\u0439 \u0410. \u0421\u0442\u043E\u0440\u043E\u043D\u0430
      \u0411 \u043E\u0431\u044F\u0437\u0430\u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C
      \u0432\u0438\u0434\u0435\u043E\u0444\u0430\u0439\u043B\u044B \u0432 \u0441\u0440\u043E\u043A\u0438,
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u0421\u0442\u043E\u0440\u043E\u043D\u043E\u0439 \u0410. \u041C\u0435\u0441\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u044B \u0421\u0442\u043E\u0440\u043E\u043D\u044B
      \u0411 \u2014 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0439 \u043E\u0444\u0438\u0441,
      \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0435 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435
      \u043E \u0444\u0430\u043A\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F. \u041E\u0434\u043D\u0430\u043A\u043E,
      \u0435\u0441\u043B\u0438 \u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0410
      \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435
      \u0440\u0430\u0431\u043E\u0442\u044B, \u0421\u0442\u043E\u0440\u043E\u043D\u0430
      \u0411 \u0434\u043E\u043B\u0436\u043D\u0430 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
      \u0442\u0430\u043A\u0438\u0435 \u043A\u0430\u043A \u0437\u0430\u043F\u0438\u0441\u0438
      \u043E \u0437\u0430\u043F\u0443\u0441\u043A\u0435 Manasoft Worlds Movie Weaver,
      \u0434\u0430\u0442\u044B \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0445 \u0432\u0438\u0434\u0435\u043E\u0444\u0430\u0439\u043B\u043E\u0432
      \u0438 \u0434\u0440.\n\n\u0421\u0442\u0430\u0442\u044C\u044F 3. \u0420\u0430\u0431\u043E\u0447\u0435\u0435
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u044B\n\u0420\u0430\u0431\u043E\u0447\u0435\u0435
      \u0432\u0440\u0435\u043C\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 8 \u0447\u0430\u0441\u043E\u0432
      \u0432 \u0434\u0435\u043D\u044C, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u0441\u0432\u0435\u0440\u0445\u0443\u0440\u043E\u0447\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u0432 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0438 \u2014 \u0434\u043E
      12 \u0447\u0430\u0441\u043E\u0432, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0430\u044F
      \u043D\u043E\u0440\u043C\u0430 \u0432 52 \u0447\u0430\u0441\u0430. \u0420\u0430\u0431\u043E\u0447\u0435\u0435
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u044B
      \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C:
      \u0440\u0430\u0431\u043E\u0447\u0438\u0435 \u0434\u043D\u0438\u2026 \u0414\u043B\u044F
      \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u043B\u0435\u043D\u0438\u044F \u0441
      \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u043C\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430 \u043F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435
      \u043F\u043E \u044D\u0442\u043E\u0439 \u0441\u0441\u044B\u043B\u043A\u0435
      \u043D\u0430 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0441\u0430\u0439\u0442 Manasoft."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232003
    m_Localized: "\u0414\u0430, \u044F \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u044E\u0441\u044C
      \u0441 \u044D\u0442\u0438\u043C \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232004
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232005
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u0437\u0430\u043A\u043B\u044E\u0447\u0451\u043D.\nManasoft \u0436\u0435\u043B\u0430\u0435\u0442
      \u0432\u0430\u043C \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E
      \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u043D\u0438\u044F.\n\n\u0412\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u0438\u0434\u0435\u043E\u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
      NA1L, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C\u044B\u0439
      Manasoft \u043F\u0440\u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0438
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232006
    m_Localized: "\u0414\u0430, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0432\u0438\u0434\u0435\u043E\u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
      NA1L. (\u0423\u0447\u0435\u0431\u043D\u043E\u0435 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232007
    m_Localized: "\u041D\u0435\u0442, \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232008
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232009
    m_Localized: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232010
    m_Localized: "\u0415\u0441\u043B\u0438 \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0432\u0438\u0434\u0435\u043E\u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
      NA1L \u043E\u0442 Manasoft, \u0432\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0443\u0447\u0435\u0431\u043D\u043E\u0435
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E.\n\n\u0412\u044B
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0443\u0447\u0435\u0431\u043D\u043E\u0435 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
      \u0431\u0435\u0437 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 NA1L?"
    m_Metadata:
