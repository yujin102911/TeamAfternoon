    m_Localized: "\u3053\u306E\u30A6\u30A3\u30B6\u30FC\u30C9\u306F\u3001\u5C02\u5C5E\u7DE8\u96C6\u8005\u5951\u7D04\u306E\u624B\u7D9A\u304D\u3092\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u30D7\u30ED\u30B0\u30E9\u30E0\u3067\u3059\u3002\n\n\u7D9A\u884C\u3059\u308B\u306B\u306F\u300C\u6B21\u3078\u300D\u3092\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
