  - m_Id: 49981677568
    m_Localized: "\uACC4\uC57D\uC11C.ssil"
    m_Metadata:
      m_Items: []
  - m_Id: 50011037696
    m_Localized: "\uC804\uC18D \uD3B8\uC9D1\uC790 \uACE0\uC6A9\uACC4\uC57D\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 50011037697
    m_Localized: "\uC804\uC18D \uD3B8\uC9D1\uC790 \uACE0\uC6A9\uACC4\uC57D\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232000
    m_Localized: "\uC774 \uB9C8\uBC95\uC0AC\uB294 \uC804\uC18D \uD3B8\uC9D1\uC790
      \uACC4\uC57D\uC5D0 \uB3C4\uC6C0\uC744 \uC8FC\uB294 \uD504\uB85C\uADF8\uB7A8\uC785\uB2C8\uB2E4.\n\n\uACC4\uC18D\uD558\uB824\uBA74
      \uB2E4\uC74C\uC744 \uB204\uB974\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 50015232001
    m_Localized: "\uACC4\uC57D \uC57D\uAD00\uC744 \uC77D\uC73C\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232002
    m_Localized: "\uC804\uC18D \uD3B8\uC9D1\uC0AC \uACE0\uC6A9\uACC4\uC57D\uC11C\r\n\uC6A9\uC0AC(\uC774\uD558
      \u201C\uAC11\u201D\uC774\uB77C \uD568)\uC640 \uD3B8\uC9D1\uC0AC(\uC774\uD558
      \u201C\uC744\u201D\uC774\uB77C \uD568)\uB294 \uB2E4\uC74C\uACFC \uAC19\uC774
      \uACC4\uC57D\uC744 \uCCB4\uACB0\uD55C\uB2E4.\r\n\uC81C 1\uC870. \uACC4\uC57D\uAE30\uAC04\r\n\uADFC\uB85C\uACC4\uC57D\uAE30\uAC04\uC740
      \uC744\uC774 \uACC4\uC57D\uC11C\uB97C \uD68C\uC2E0\uD55C \uB0A0\uC9DC\uBD80\uD130
      \uB9CC\uB8CC\uC77C\uAE4C\uC9C0\uB85C \uD55C\uB2E4. \uB9CC\uB8CC\uC77C\uC740
      \uBA85\uC2DC\uB418\uC9C0 \uC54A\uC740 \uACBD\uC6B0 \uC790\uB3D9 \uC5F0\uC7A5\uB418\uBA70,
      \uB9CC\uB8CC\uC77C\uC774 \uD2B9\uC815 \uB0A0\uC9DC\uB85C \uAC31\uC2E0\uB410\uC744
      \uACBD\uC6B0 \uCD5C\uC18C \uB9CC\uB8CC\uC758 7\uC77C \uC804 \uC744\uC5D0\uAC8C
      \uD1B5\uBCF4\uB418\uC5B4\uC57C \uD55C\uB2E4.\r\n\uC81C 2\uC870. \uADFC\uBB34
      \uC7A5\uC18C \uBC0F \uC5C5\uBB34\uB0B4\uC6A9\r\n\uC744\uC740 \uAC11\uC758 Wtube
      \uCC44\uB110\uC758 \uD3B8\uC9D1\uC0AC\uB85C\uC11C \uAC11\uC774 \uC744\uC5D0\uAC8C
      \uC804\uB2EC\uD558\uB294 \uC601\uC0C1\uC758 \uD3B8\uC9D1 \uC804\uBC18\uC744
      \uC218\uD589\uD55C\uB2E4. \uC744\uC740 \uAC11\uC774 \uD1B5\uC9C0\uD55C \uAE30\uAC04
      \uB0B4\uC5D0 \uC601\uC0C1 \uD30C\uC77C\uC744 \uC804\uC1A1\uD574\uC57C \uD55C\uB2E4.
      \uC744\uC758 \uADFC\uBB34 \uC7A5\uC18C\uB294 \uC790\uD0DD\uC73C\uB85C \uD558\uBA70
      \uAC11\uC5D0\uAC8C \uADFC\uBB34 \uC0AC\uC2E4\uC744 \uC77C\uB9C8\uB2E4 \uBCC4\uB3C4\uB85C
      \uD1B5\uC9C0\uD560 \uD544\uC694\uAC00 \uC5C6\uB2E4. \uB2E8, \uAC11\uC774 \uADFC\uBB34
      \uC0AC\uC2E4\uC744 \uC694\uAD6C\uD560 \uB54C\uC5D0\uB294 Manasoft Worlds Movie
      Weaver\uC758 \uC2E4\uD589 \uAE30\uB85D, \uC0DD\uC131\uD55C \uC601\uC0C1 \uD30C\uC77C\uC758
      \uD3B8\uC9D1 \uB0A0\uC9DC \uB4F1\uC73C\uB85C \uC99D\uBE59 \uAC00\uB2A5\uD574\uC57C
      \uD55C\uB2E4.\r\n\uC81C 3\uC870. \uADFC\uB85C\uC2DC\uAC04 \uBC0F \uD734\uAC8C\uC2DC\uAC04\r\n\uADFC\uB85C\uC2DC\uAC04\uC740
      \uD558\uB8E8 \uCD5C\uB300 8\uC2DC\uAC04\uC5D0 \uD734\uC77C\uADFC\uBB34\uB97C
      \uD3EC\uD568\uD55C \uC5F0\uC7A5\uADFC\uB85C\uB97C \uCD1D 12\uC2DC\uAC04\uAE4C\uC9C0
      \uD5C8\uC6A9\uD558\uC5EC \uC8FC 52\uC2DC\uAC04\uC81C\uB97C \uC6D0\uCE59\uC73C\uB85C
      \uD558\uBA70, \uADFC\uBB34\uC2DC\uAC04 \uBC0F \uD734\uAC8C\uC2DC\uAC04\uC740
      \uB2E4\uC74C\uACFC \uAC19\uB2E4. \uADFC\uBB34\uC77C... \uACC4\uC57D\uC11C\uC758
      \uC774\uD558 \uC138\uBD80 \uB0B4\uC6A9\uC744 \uD655\uC778\uD558\uC2DC\uB824\uBA74
      \uC774\uACF3\uC744 \uB20C\uB7EC Manasoft \uACF5\uC2DD \uD648\uD398\uC774\uC9C0\uB85C
      \uC774\uB3D9\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232003
    m_Localized: "\uC608, \uC774 \uACC4\uC57D\uC5D0 \uB3D9\uC758\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232004
    m_Localized: "\uB2E4\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232005
    m_Localized: "\uACC4\uC57D\uC774 \uC815\uC0C1\uC801\uC73C\uB85C \uCCB4\uACB0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \nManasoft\uB294 \uADC0\uD558\uC758 \uBB34\uAD81\uD55C \uBC1C\uC804\uC744 \uAE30\uC6D0\uD569\uB2C8\uB2E4.\n\n\r\n\uADC0\uD558\uB294
      Manasoft\uAC00 \uACC4\uC57D \uC2DC \uC81C\uACF5\uD558\uB294 \uC601\uC0C1 \uD3B8\uC9D1
      \uB3C4\uC6B0\uBBF8 NA1L\uC744 \n\uCD94\uAC00\uB85C \uC124\uCE58\uD558\uC2E4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 50015232006
    m_Localized: "\uC608, \uC601\uC0C1 \uD3B8\uC9D1 \uB3C4\uC6B0\uBBF8 NA1L\uC744
      \uC124\uCE58\uD569\uB2C8\uB2E4. (\uD29C\uD1A0\uB9AC\uC5BC)"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232007
    m_Localized: "\uC544\uB2C8\uC624, \uC124\uCE58\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50015232008
    m_Localized: "\uB2E4\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232009
    m_Localized: "\uC0AC\uC6A9\uC790 \uACBD\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232010
    m_Localized: "Manasoft\uC5D0\uC11C \uC81C\uACF5\uD558\uB294 \uC601\uC0C1 \uD3B8\uC9D1
      \uB3C4\uC6B0\uBBF8 NA1L\uC744 \uC124\uCE58\uD558\uC9C0 \uC54A\uC744 \uACBD\uC6B0,
      \uD29C\uD1A0\uB9AC\uC5BC\uC744 \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \n\nNA1L\uC744 \uC124\uCE58\uD558\uC9C0 \uC54A\uACE0 \uD29C\uD1A0\uB9AC\uC5BC\uC744
      \uAC74\uB108\uB6F0\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232011
    m_Localized: "\uAC74\uB108\uB6F0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232012
    m_Localized: "\uC124\uCE58\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 50015232013
    m_Localized: "NA1L v.2.2.9 \uC124\uCE58 \uB9C8\uBC95\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 50019426304
    m_Localized: "\uC18C\uD504\uD2B8\uC6E8\uC5B4 \uCD5C\uC885 \uB77C\uC774\uC13C\uC2A4
      \uACC4\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 50019426305
    m_Localized: "Manasoft(\uB610\uB294 \uAC70\uC8FC \uC9C0\uC5ED\uC5D0 \uB530\uB77C
      \uACC4\uC5F4\uC0AC \uC911 \uD558\uB098)\uC740 \uADC0\uD558\uC5D0\uAC8C \uBCF8
      \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uC758 \uC0AC\uC6A9\uAD8C\uC744 \uD5C8\uC5EC\uD569\uB2C8\uB2E4.
      \n\n\uBCF8 \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB294 \uD574\uB2F9\uB418\uB294
      \uC804\uC18D \uD3B8\uC9D1\uC0AC \uACE0\uC6A9\uACC4\uC57D\uC11C, \uC804\uC18D
      \uC545\uB2E8 \uACE0\uC6A9\uACC4\uC57D\uC11C, \uC804\uC18D \uD574\uC801 \uACE0\uC6A9\uACC4\uC57D\uC11C(\uC774\uD558
      \u201C\uACC4\uC57D\uC11C\u201D)\uC5D0 \uB300\uD55C \uC0AC\uC6A9\uAD8C\uC774
      \uC788\uB294 \uACBD\uC6B0 \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB97C \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uACC4\uC57D\uC11C\uC5D0 \uB300\uD55C
      \uC0AC\uC6A9\uAD8C\uC774 \uC5C6\uAC70\uB098 \uB9CC\uB8CC\uB41C \uACBD\uC6B0\uC5D0\uB294
      \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB3C4 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      Manasoft\uB294 \uACF5\uC2DD \uD648\uD398\uC774\uC9C0\uC5D0 \uBA85\uC2DC\uD55C
      \uBC14\uC640 \uAC19\uC774 \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uC5D0 \uB300\uD55C
      \uC9C0\uC6D0 \uC11C\uBE44\uC2A4\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4. \n\n\uBCF8
      \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB294 \uC0AC\uC6A9\uC790\uAC00 \uBCC4\uB3C4\uB85C
      \uC124\uCE58 \uBC0F \uB77C\uC774\uC13C\uC2A4\uB97C \uD5C8\uC5EC\uBC1B\uC544\uC57C
      \uD558\uB294 Worlds\uC6A9 Manasoft Worlds Movie Weaver \uC751\uC6A9 \uD504\uB85C\uADF8\uB7A8(\uC774\uD558
      \u201C\uD504\uB85C\uADF8\uB7A8\u201D)\uC744 \uD1B5\uD574 \uD5C8\uAC00 \uBC1B\uC740
      \uC0AC\uC6A9\uC790\uC758 \uD29C\uD1A0\uB9AC\uC5BC \uC9C4\uD589\uC744 \uC9C0\uC6D0\uD569\uB2C8\uB2E4.
      \n\n\uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB97C \uC124\uCE58, \uBCF5\uC0AC,
      \uB2E4\uC6B4\uB85C\uB4DC, \uC561\uC138\uC2A4, \uB610\uB294 \uAE30\uD0C0 \uBC29\uC2DD\uC73C\uB85C
      \uC0AC\uC6A9\uD568\uC73C\uB85C\uC368 \uADC0\uD558\uB294 \uBCF8 \uACC4\uC57D\uC758
      \uC870\uAC74\uC5D0 \uB3D9\uC758\uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 50019426306
    m_Localized: "\uC608, \uC774 \uACC4\uC57D\uC5D0 \uB3D9\uC758\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50019426307
    m_Localized: "\uB2E4\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 50019426308
    m_Localized: "NA1L\uC774 \uC815\uC0C1\uC801\uC73C\uB85C \uC124\uCE58\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \n\n\uC124\uCE58\uB97C \uC644\uB8CC\uD558\uB824\uBA74 \uB9C8\uCE68\uC744 \uD074\uB9AD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 50019426309
    m_Localized: "\uB9C8\uCE68"
    m_Metadata:
