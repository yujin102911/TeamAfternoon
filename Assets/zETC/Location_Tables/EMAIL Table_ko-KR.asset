  - m_Id: 51839754242
    m_Localized: "[Worlds Movie Weaver] \uC6A9\uC0AC \uD0C4\uC0DD \uAE30\uB150 \uCEA0\uD398\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531456
    m_Localized: "\uC774 \uBA54\uC77C\uC740 \uD504\uB85C\uBAA8\uC158 \uAD00\uB828
      \uC548\uB0B4 \uBA54\uC77C \uC218\uC2E0\uC5D0 \uB3D9\uC758\uD55C \uD68C\uC6D0
      \uC804\uC6A9\uC73C\uB85C \uBC1C\uC2E0\uB418\uB294 \uB0B4\uC6A9\uC785\uB2C8\uB2E4.\n\n\uD504\uB85C\uBAA8\uC158
      \uB300\uC0C1: Manasoft Worlds Movie Weaver\uC758 \uBB34\uB8CC \uAC1C\uC778
      \uD68C\uC6D0\n\uD504\uB85C\uBAA8\uC158 \uC77C\uC790: \uC624\uB298\uBD80\uD130
      5\uC77C\n\uD504\uB85C\uBAA8\uC158 \uB0B4\uC6A9:\n\uC720\uB8CC \uAE30\uB2A5
      \u2018\uD2B9\uC218\uD6A8\uACFC\u2019\uB97C \uD504\uB85C\uBAA8\uC158 \uAE30\uAC04
      \uB3D9\uC548 \uBB34\uB8CC\uB85C \uC0AC\uC6A9! \uCEA0\uD398\uC778 \uC77C\uC790\uB9C8\uB2E4
      \uD558\uB098\uC529 \uC804\uD658!\n\n\uD504\uB85C\uBAA8\uC158 \uB300\uC0C1 \uAE30\uB2A5\uC740
      \uB2E4\uC74C\uACFC \uAC19\uC2B5\uB2C8\uB2E4.\n\uC18D\uB3C4\uAC10 \uC788\uB294
      \uC774\uB3D9\uC5D0 \uC81C\uACA9! <font=\"galBold\">\u2018\uC2E0\uC18D\u2019</font>\n<font=\"galBold\">\u2018\uB370\uBBF8\uC9C0
      \uC99D\uAC00\u2019</font> \uBE60\uB974\uB2E4, \uAC15\uD558\uB2E4, \uBA4B\uC9C0\uB2E4.\n\uC138\uC0C1\uC744
      \uC804\uC728\uC2DC\uD0A8 \uAC15\uB825\uD55C \uD55C \uBC29 <font=\"galBold\">\u2018\uD06C\uB9AC\uD2F0\uCEEC\u2019</font>\n\uC7AC\uAD6C\uB3C5
      \uD3ED\uC8FC! \uC5C5\uACC4 1\uC704! \uC694\uC998 \uC774 \uD6A8\uACFC! <font=\"galBold\">\u2018\uAE30\uC808\u2019</font>\n\nManasoft
      Worlds Movie Weaver\uC758 \uAC00\uACA9\uC744 30% \uD560\uC778 (\uBD80\uAC00\uC138
      \uD3EC\uD568. \uC5F0\uAC04, \uB9E4\uC6D4 \uCCAD\uAD6C)\n\uC774 \uD504\uB85C\uBAA8\uC158\uC5D0
      \uB300\uD55C \uCD94\uAC00 \uC815\uBCF4\uB294 <u>\uC5EC\uAE30</u>\uC5D0\uC11C
      \uCC3E\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<u>\uD560\uC778\uB41C \uAC00\uACA9\uC73C\uB85C
      \uAD6C\uB9E4\uD558\uAE30</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531457
    m_Localized: "\uC6A9\uC0AC\uC785\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531458
    m_Localized: "\uC6A9\uC0AC\uC785\uB2C8\uB2E4\n\uC55E\uC73C\uB85C \uCC44\uB110
      \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\n\uADF8\uB7FC \uC624\uB298\uAE4C\uC9C0
      \uB358\uC804 1\uCE35 \uD074\uB9AC\uC5B4 \uC601\uC0C1 \uC791\uC5C5\uD574\uC11C
      \uBCF4\uB0B4\uC8FC\uC2DC\uBA74 \uB429\uB2C8\uB2E4\n\uC6D0\uB798 \uCCAB \uC601\uC0C1
      \uC870\uD68C\uC218\uAC00 \uC81C\uC77C \uC911\uC694\uD558\uB2C8\uAE4C \uCD5C\uB300\uD55C
      \uC2E4\uAC10\uB098\uAC8C\n\uC544\uBB34\uB3C4 \uC758\uC2EC \uBABB \uD558\uAC8C
      \uC9C4\uC9DC\uCC98\uB7FC \uC798 \uB9CC\uB4E4\uC5B4\uC8FC\uC138\uC694\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531459
    m_Localized: "[Worlds Movie Weaver] \uC811\uC18D \uC9C0\uC5F0\uC5D0 \uB300\uD55C
      \uC548\uB0B4  "
    m_Metadata:
      m_Items: []
  - m_Id: 51856531460
    m_Localized: "\uD604\uC7AC \uD504\uB85C\uBAA8\uC158 \uD398\uC774\uC9C0\uC758
      \uD2B8\uB798\uD53D\uC774 \uCD08\uACFC\uB418\uC5B4 \uC811\uC18D\uC774 \uC5B4\uB835\uC2B5\uB2C8\uB2E4.\n\uC810\uAC80
      \uC77C\uC790: \uAE08\uC77C 07:00~24:00\n\n\uC774\uC5D0 \uB530\uB77C \uD504\uB85C\uBAA8\uC158
      \uC77C\uC815\uC744 1\uC77C \uC5F0\uC7A5\uD569\uB2C8\uB2E4. (\uCD1D 6\uC77C)\n\uCD94\uAC00\uB85C
      \uC81C\uACF5\uB41C \uB0A0\uC9DC \uB3D9\uC548 \uC5EC\uB7EC \uD2B9\uC218\uD6A8\uACFC\uB97C
      \uC990\uACA8\uBCF4\uC138\uC694!\n\n\uAC10\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51856531461
    m_Localized: "\uC601\uC0C1 \uD004\uB9AC\uD2F0 \uB05D"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531462
    m_Localized: "\uC601\uC0C1 \uD004\uB9AC\uD2F0 \uB05D\uB0B4\uC8FC\uB124\uC694
      \uC870\uD68C\uC218\uAC00 \uBC8C\uC368 1\uCC9C\uB9CC\uC785\uB2C8\uB2E4\n\uC624\uB298\uB3C4
      \uD558\uC168\uB358 \uAC83\uCC98\uB7FC \uB358\uC804 2\uCE35 \uD074\uB9AC\uC5B4
      \uC601\uC0C1 \uC791\uC5C5\uD574\uC8FC\uC2DC\uBA74 \uB429\uB2C8\uB2E4\n\uC5B4\uC81C\uBCF4\uB2E4
      \uBB34\uC12D\uAC8C \uB9CC\uB4E4\uC5B4\uC8FC\uC138\uC694. \n\n\uC790\uB8CC \uBCF4\uC168\uC73C\uB2C8
      \uC544\uC2DC\uACA0\uC9C0\uB9CC \uC81C\uAC00 5\uC0B4 \uB54C\uBD80\uD130 \uD6C8\uB828
      \uBC1B\uC558\uAE30\uB3C4 \uD558\uACE0 \uCE7C\uC744 \uBABB \uC4F0\uB294 \uAC74
      \uC544\uB2CC\uB370\n\uB9C8\uC871\uB4E4\uC740 5\uAC1C\uC6D4\uBD80\uD130 \uD6C8\uB828\uBC1B\uB294\uB2E4\uB2C8\uAE4C
      \uC601\uC0C1 \uC7AC\uBBF8\uB97C \uC704\uD574\uC11C\uB77C\uB3C4 \uD3B8\uC9D1\uC0AC\uB2D8\uAED8
      \uB9E1\uAE30\uB294 \uAC8C \uB098\uC740 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4\n\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531463
    m_Localized: "\uC5B4\uC81C \uC601\uC0C1\uB3C4 \uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531464
    m_Localized: "\uC5B4\uC81C \uC601\uC0C1\uB3C4 \uAC1C\uBC0C\uAC8C \uBD24\uC2B5\uB2C8\uB2E4\n\uD558\uC168\uB358
      \uAC83\uCC98\uB7FC \uC624\uB298\uB3C4 \uB358\uC804 3\uCE35 \uC791\uC5C5\uD574\uC8FC\uC2DC\uBA74
      \uB429\uB2C8\uB2E4\n\n\uB358\uC804\uC5D0\uC11C \uC601\uC0C1\uC774 \uC54C\uC74C\uC54C\uC74C
      \uB3CC\uACE0 \uC788\uB294 \uAC83 \uAC19\uAE30\uB3C4 \uD55C\uB370\n\uB9C8\uC871\uC740
      \uC798\uB09C \uCC99\uC774 \uC2EC\uD558\uB2C8\uAE4C \uBCF4\uB2E4 \uB9D0\uACA0\uC8E0\n\uD3B8\uC9D1\uAC00\uB2D8\uAED8\uB9CC
      \uC54C\uB824\uB4DC\uB9AC\uB294 \uAC70\uC9C0\uB9CC \uCD5C\uB300\uD55C \uC5B4\uADF8\uB85C\uB97C
      \uB04C\uC5B4\uC11C \uB0A9\uCE58 \uACC4\uD68D\uC744 \uC78A\uC5B4\uBC84\uB9AC\uAC8C
      \uD558\uB294 \uAC8C \uC81C \uC791\uC804\uC785\uB2C8\uB2E4\n\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531465
    m_Localized: "\uC774\uBC88\uC5D0\uB3C4 \uC548 \uBCF4\uB0B4\uC9C0\uBA74 \uB9C8\uB098\uC18C\uD504\uD2B8\uC5D0
      \uBD88\uC9C0\uB97C\uAEBC\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531466
    m_Localized: "\uACE0\uBE14\uB9B0 \uC54C\uC544\uCC28\uB9B0 \uC7A5\uBA74 \uB2E4\uB4E4
      \uBA4B\uC9C0\uB2E4\uACE0 \uB09C\uB9B0\uB370 \uC81C\uAC00 \uBD10\uB3C4 \uC880
      \uBA4B\uC788\u314B\u314B\n\uB9C8\uC655\uB3C4 \uCC44\uB110 \uAD6C\uB3C5\uD588\uC2B5\uB2C8\uB2E4\n\n\uB9C8\uC655\uC740
      \uB9C8\uC655\uC131 \uC9C0\uB9AC\uC5D0 \uBE60\uC2F9\uD560 \uD14C\uB2C8\uAE4C
      \uC774\uBC88 \uC601\uC0C1\uC740 \uC804\uBCF4\uB2E4 \uC2E4\uAC10\uB098\uC57C
      \uD560 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4\n\uC774\uBC88\uC5D0\uB3C4 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\n\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
