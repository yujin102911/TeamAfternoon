    m_Localized: "\u505A\u5F97\u597D\u3002\u73FE\u5728\u8ACB\u5728<b>\u6307\u5B9A\u4F4D\u7F6E\u653E\u7F6E\u8FD1\u6230\u84C4\u529B\u653B\u64CA</b>\u3002"
