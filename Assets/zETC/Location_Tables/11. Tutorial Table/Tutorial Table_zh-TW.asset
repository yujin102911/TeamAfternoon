  m_TableData:
  - m_Id: 10054545956864
    m_Localized: "\u60A8\u597D\uFF0C\u898B\u5230\u60A8\u5F88\u9AD8\u8208\u3002 \n\u6211\u662F\u7531
      Manasoft \u63D0\u4F9B\u7684 OS \u517C\u5F71\u7247\u526A\u8F2F\u5C0F\u52A9\u624B\uFF0C
      <b>NA1L</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151168
    m_Localized: "\u662F\u4E0D\u662F\u89BA\u5F97\u5F71\u7247\u5916\u5305\u526A\u8F2F\u6709\u9EDE\u7121\u5F9E\u4E0B\u624B\uFF1F
      \n\u653E\u5FC3\uFF01\u6211\u6703\u624B\u628A\u624B\u5E36\u60A8\u7684\u3002\u81F3\u65BC\u8DF3\u904E\u6559\u5B78\u2026\u2026
      \u60F3\u90FD\u5225\u60F3\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151169
    m_Localized: "\u9996\u5148\uFF0C\u5EFA\u8B70\u60A8\u6BCF\u5929\u8A2A\u554F <b>MSN</b>\uFF0C\u9806\u4FBF\u70BA
      Manasoft \u8CA2\u737B\u4E00\u9EDE\u9EDE\u6D41\u91CF\u3002\n\n*\u672C\u901A\u77E5\u5305\u542B
      Manasoft \u7684\u5EE3\u544A\u5167\u5BB9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151170
    m_Localized: "<b>Mana Scroll Network</b> \u6703\u4EE5<b>\u65B0\u805E\u5F62\u5F0F</b>\u70BA\u60A8\u63A8\u9001\u6BCF\u65E5\u8CC7\u8A0A\u3002
      \n\u60F3\u77E5\u9053\u6628\u665A\u767C\u751F\u4E86\u4EC0\u9EBC\u5927\u74DC\uFF1F\u4E0A\u9019\u5152\u770B\u6E96\u6C92\u932F\uFF01\n\n*\u672C\u901A\u77E5\u5305\u542B
      Manasoft \u7684\u5EE3\u544A\u5167\u5BB9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151171
    m_Localized: "\u8ACB\u9EDE\u64CA X \u6309\u9215\u5C07\u5176\u95DC\u9589\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151172
    m_Localized: "\u6839\u64DA\u5408\u540C\u898F\u5B9A\uFF0C\u60A8\u7684\u5916\u5305\u5DE5\u4F5C\u5C07\u901A\u904E
      OwlLook \u9032\u884C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151173
    m_Localized: "\u525B\u597D\u6709\u4E00\u5C01\u4FE1\u5230\u4E86\u5462\uFF01\u8ACB\u9EDE\u64CA
      <b>OwlLook</b> \u57F7\u884C\u7A0B\u5F0F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151174
    m_Localized: "\u9EDE\u64CA\u6536\u4EF6\u7BB1\u88E1\u7684\u6A19\u984C\u5373\u53EF\u78BA\u8A8D\u5167\u5BB9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151175
    m_Localized: "\u70BA\u4E86\u7D00\u5FF5\u52C7\u58EB\u8A95\u751F\uFF0CManasoft
      \u76EE\u524D\u6B63\u9650\u6642\u514D\u8CBB\u63D0\u4F9B Worlds Movie Weaver
      \u7684\u6BCF\u65E5\u7279\u6280\u6548\u679C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151176
    m_Localized: "\u6839\u64DA\u5408\u540C\uFF0C\u6BCF\u5929\u90FD\u6703\u6709\u4E00\u4EFD\u526A\u8F2F\u59D4\u8A17\u9001\u9054\uFF0C\u8ACB\u52D9\u5FC5\u6BCF\u5929\u78BA\u8A8D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151177
    m_Localized: "\u5DE5\u4F5C\u6240\u9700\u7684\u6240\u6709\u6587\u4EF6\u90FD\u5728\u9644\u4EF6\u4E2D\u3002
      \n\u6E96\u5099\u597D\u4E86\u7684\u8A71\uFF0C\u8ACB\u9EDE\u64CA\u9644\u4EF6\uFF0C\u958B\u59CB\u88FD\u4F5C\u59D4\u8A17\u5F71\u7247\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151178
    m_Localized: "Manasoft <b>Worlds Movie Weaver</b> \u662F\u70BA\u7528\u6236\u91CF\u8EAB\u5B9A\u5236\u7684\u5F71\u7247\u5275\u4F5C\u7A7A\u9593\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151179
    m_Localized: "\u5728\u9019\u88E1\uFF0C\u60A8\u53EF\u4EE5\u96A8\u5FC3\u6240\u6B32\u5730\u5275\u4F5C\u51FA\u60F3\u50CF\u4E2D\u7684\u6BCF\u4E00\u500B\u5F71\u7247\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151180
    m_Localized: "\u63A5\u4E0B\u4F86\uFF0C\u5C07\u70BA\u60A8\u4ECB\u7D39 <b>Worlds
      Movie Weaver</b> \u7684\u4F7F\u7528\u6307\u5357\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151181
    m_Localized: "\u7A0B\u5F0F\u5DF2\u5C31\u7DD2\uFF0C\u73FE\u5728\u53EF\u4EE5\u958B\u59CB\u526A\u8F2F\u4E86\u3002\n\u6E96\u5099\u597D\u5F8C\uFF0C\u8ACB\u9EDE\u64CA<b>\u300C\u958B\u59CB\u526A\u8F2F\u300D</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151182
    m_Localized: "\u5225\u614C\uFF0C\u6709 <b>NA1L</b> \u966A\u8457\u60A8\u5462\uFF01\u6211\u5011\u4E00\u500B\u4E00\u500B\u4F86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151183
    m_Localized: "\u4E0A\u65B9\u770B\u5230\u7684\u9019\u500B\u756B\u9762\u5C31\u662F
      <b>\u6642\u9593\u8EF8\u9810\u89BD\u5668</b>\u3002 \n\u60A8\u53EF\u4EE5\u5728\u9019\u88E1\u9810\u89BD\u6B63\u5728\u88FD\u4F5C\u7684\u5F71\u7247\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151184
    m_Localized: "\u9019\u500B\u662F <b>\u6642\u9593\u8EF8</b>\uFF0C\u662F\u8A2D\u8A08\u5F71\u7247\u7684\u9762\u677F\u3002
      \n\u5F71\u7247\u7684\u4E00\u5207\u90FD\u5C07\u5728\u9019\u88E1\u6C7A\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151185
    m_Localized: "\u4EE5\u4E2D\u592E\u70BA\u6E96\uFF0C\u4E0A\u65B9\u653E\u7F6E <b>\u6575\u4EBA\u7247\u6BB5</b>\uFF0C\u4E0B\u65B9\u653E\u7F6E
      <b>\u52C7\u58EB\u7247\u6BB5</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151186
    m_Localized: "\u9019\u88E1\u662F <b>\u5EAB</b>\u3002 \n\u60A8\u64C1\u6709\u7684\u6240\u6709\u7247\u6BB5\u548C\u6548\u679C\u90FD\u5B58\u5132\u5728\u9019\u88E1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151187
    m_Localized: "\u6700\u5F8C\u2026\u2026\u9019\u5C31\u662F <b>\u5F71\u7247\u7247\u6BB5</b>\uFF01
      \n\u5B83\u5011\u662F\u88FD\u4F5C\u5F71\u7247\u7684\u6838\u5FC3\u6750\u6599\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151188
    m_Localized: "\u60A8\u53EF\u4EE5\u5C07\u7247\u6BB5\u653E\u7F6E\u5728\u6642\u9593\u8EF8\u4E0A\uFF0C\u96A8\u5FC3\u6240\u6B32\u5730\u5275\u4F5C\u5F71\u7247\u3002
      \n\u90A3\u9EBC\u6211\u5011\u8A66\u8A66\u770B\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151189
    m_Localized: "\u9019\u88E1\u986F\u793A\u7684\u662F <b>\u6575\u4EBA\u653B\u64CA</b>\u3002
      \n\u5C07\u6ED1\u9F20\u61F8\u505C\u5728\u6575\u4EBA\u653B\u64CA\u7247\u6BB5\u4E0A\uFF0C\u5C31\u53EF\u4EE5\u5728\u9810\u89BD\u5668\u4E2D\u78BA\u8A8D\u53D7\u64CA\u4F4D\u7F6E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151190
    m_Localized: "\u7167\u9019\u6A23\u4E0B\u53BB\u80AF\u5B9A\u6703\u88AB\u64CA\u4E2D\u7684\u2026\u2026
      \u4F5C\u70BA\u52C7\u58EB\uFF0C\u7E3D\u5F97\u83EF\u9E97\u5730\u9583\u907F\u958B\u624D\u5920\u5E25\u5427\uFF1F
      \n\u6211\u5011\u4F86\u88FD\u4F5C\u4E00\u6BB5\u52C7\u58EB\u8EB2\u907F\u653B\u64CA\u7684\u756B\u9762\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151191
    m_Localized: "\u52FE\u9078\u5EAB\u4E0A\u65B9\u7684 <b>\u904E\u6FFE\u5668</b>\uFF0C\u53EF\u4EE5\u5FEB\u901F\u627E\u5230\u60F3\u8981\u7684\u7247\u6BB5\u3002
      \n\u8ACB <b>\u52FE\u9078\u300C\u79FB\u52D5\u300D</b> \u5C0B\u627E\u7247\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151192
    m_Localized: "\u8ACB\u5C07\u4E0A\u65B9\u7684 <b>\u79FB\u52D5\u65B9\u584A\u62D6\u62FD\u4E26\u653E\u7F6E\u5728\u6307\u5B9A\u4F4D\u7F6E</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151193
    m_Localized: "\u6210\u529F\u653E\u7F6E\u7247\u6BB5\u5F8C\uFF0C\u8ACB\u9EDE\u64CA
      <b>\u91CD\u7F6E\u9078\u64C7\u6309\u9215</b> \u53D6\u6D88\u904E\u6FFE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151194
    m_Localized: "\u505A\u5F97\u597D\uFF01\u9EDE\u64CA\u79FB\u52D5\u65B9\u584A\u53EF\u4EE5\u66F4\u6539\u79FB\u52D5\u65B9\u5411\u3002
      \n\u8A66\u8A66\u8B93\u52C7\u58EB\u5411\u4E0A\u79FB\u52D5\u3002 \n\u8ACB <b>\u9EDE\u64CA\u4E26\u66F4\u6539\u79FB\u52D5\u65B9\u5411</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151195
    m_Localized: "\u505A\u5F97\u68D2\uFF01 \n\u73FE\u5728\u8ACB<b>\u6309\u4F4F\u6307\u6A19\u4E26\u62D6\u52D5\u81F3\u6307\u5B9A\u4F4D\u7F6E</b>\uFF0C\u5728\u9810\u89BD\u5668\u4E2D\u78BA\u8A8D\u52C7\u58EB\u7684\u884C\u52D5\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151196
    m_Localized: "\u52C7\u58EB\u6210\u529F\u907F\u958B\u4E86\u653B\u64CA\uFF01\u901A\u904E\u653E\u7F6E\u7247\u6BB5\uFF0C\u5C31\u80FD\u50CF\u9019\u6A23\u6F14\u51FA\u7684\u52C7\u58EB\u884C\u52D5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151197
    m_Localized: "\u4E0D\u904E\uFF0C\u70BA\u4E86\u62CD\u51FA\u52C7\u58EB\u5E25\u6C23\u7684\u52DD\u5229\u5834\u9762\uFF0C\u5149\u9760\u8EB2\u907F\u662F\u4E0D\u5920\u7684\u3002\u5F97\u767C\u52D5\u653B\u64CA\u624D\u884C\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151198
    m_Localized: "\u770B\u4E86\u770B\u9644\u4EF6\u5F8C\u767C\u73FE\uFF0C\u52C7\u58EB\u53EF\u4EE5\u4F7F\u7528\u7684\u6B66\u5668\u6709\u5169\u7A2E\uFF1A"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151199
    m_Localized: "\u4E00\u7A2E\u662F<b>\u7121\u8AD6\u8EAB\u5728\u4F55\u8655</b>\u90FD\u80FD\u547D\u4E2D\u6575\u4EBA\u7684<b>\u9060\u7A0B\u653B\u64CA</b>\u2026\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151200
    m_Localized: "\u53E6\u4E00\u7A2E\u662F\u53EA\u80FD\u5728<b>\u96E2\u6575\u4EBA\u8F03\u8FD1\u7684\u9663\u5217</b>\u4E2D\u4F7F\u7528\u7684<b>\u8FD1\u6230\u653B\u64CA</b>\u3002
      \n\u8FD1\u6230\u653B\u64CA\u96D6\u7136\u6709\u7A7A\u9593\u9650\u5236\uFF0C\u4F46\u5A01\u529B\u8981\u5F37\u5927\u5F97\u591A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151201
    m_Localized: "\u6211\u5011\u5148\u8A66\u8457\u653E\u7F6E\u9060\u7A0B\u653B\u64CA\u7247\u6BB5\u5427\u3002
      \n\u8ACB<b>\u9EDE\u64CA\u9060\u7A0B\u653B\u64CA\u6838\u53D6\u65B9\u584A</b>\u4F86\u67E5\u627E\u60F3\u8981\u7684\u7247\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151202
    m_Localized: "\u9060\u7A0B\u653B\u64CA\u7121\u8AD6\u52C7\u58EB\u5728\u54EA\u90FD\u80FD\u767C\u52D5\u3002
      \n\u8ACB\u5C07<b>\u7247\u6BB5\u653E\u7F6E\u5728\u6307\u5B9A\u4F4D\u7F6E</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151203
    m_Localized: "\u54CE\u5440\uFF01\u7CFB\u7D71\u5224\u5B9A\uFF0C\u8A72\u64CD\u4F5C\u504F\u96E2\u4E86\u6700\u4F73\u89E3\u3002
      \n\u4F46\u5225\u64D4\u5FC3\uFF01\u5728\u6B63\u5F0F\u57F7\u884C\u524D\uFF0C\u60A8\u53EF\u4EE5\u81EA\u7531\u4FEE\u6539\u7247\u6BB5\u4F48\u5C40\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151204
    m_Localized: "\u53EF\u4EE5\u901A\u904E<b>\u62D6\u62FD\u4F86\u4FEE\u6539\u4F4D\u7F6E</b>\uFF0C\u6216\u8005\u901A\u904E<b>\u53F3\u64CA\u4F86\u53D6\u6D88\u653E\u7F6E</b>\u3002
      \n\u5229\u7528\u9019\u4E9B\u529F\u80FD\u4F86<b>\u4FEE\u6539\u9060\u7A0B\u7247\u6BB5\u7684\u4F48\u5C40</b>\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151205
    m_Localized: "\u63A5\u4E0B\u4F86\u662F\u8FD1\u6230\u653B\u64CA\u3002\u8FD1\u6230\u53EA\u80FD\u5728\u6700\u524D\u65B9\u767C\u52D5\uFF0C\u6240\u4EE5\u9700\u8981\u5411\u524D\u79FB\u52D5\u4E00\u683C\u3002
      \n\u91CD\u7F6E\u904E\u6FFE\u5668\uFF0C<b>\u52FE\u9078\u8FD1\u6230\u653B\u64CA</b>\u4F86\u627E\u627E\u7247\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151206
    m_Localized: "\u525B\u597D\u6709\u4E00\u500B\u79FB\u52D5\u8207\u653B\u64CA\u5408\u5728\u4E00\u8D77\u7684\u7247\u6BB5\u5462\uFF01
      \n<b>\u653E\u7F6E\u5728\u6307\u5B9A\u4F4D\u7F6E</b>\uFF0C\u7136\u5F8C\u66F4\u6539\u65B9\u5411\u8B93\u52C7\u58EB\u79FB\u52D5\u5230\u53EF\u653B\u64CA\u7684\u4F4D\u7F6E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151207
    m_Localized: "\u505A\u5F97\u597D\u3002\u4F46\u7167\u9019\u6A23\u4E0B\u53BB\uFF0C\u4E0B\u4E00\u6CE2\u653B\u64CA\u5C31\u6703\u53D7\u50B7\u3002\u4F5C\u70BA\u52C7\u58EB\uFF0C\u9019\u53EF\u5C31\u592A\u4E1F\u81C9\u4E86\u2026\u2026
      \n\u9019\u7A2E\u6642\u5019\u5C31\u9700\u8981<b>\u300C\u9632\u79A6\u300D</b>\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151208
    m_Localized: "\u91CD\u7F6E\u904E\u6FFE\u5668\uFF0C<b>\u9EDE\u64CA\u9632\u79A6\u6838\u53D6\u65B9\u584A</b>\u627E\u627E\u770B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151209
    m_Localized: "\u9019\u500B\u7247\u6BB5\u53EF\u4EE5\u64FA\u51FA\u9632\u79A6\u59FF\u614B\uFF0C<b>\u4F7F\u7DCA\u96A8\u5176\u5F8C\u7684\u653B\u64CA\u50B7\u5BB3\u7121\u6548\u5316</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151210
    m_Localized: "\u8A66\u8457\u5C07\u627E\u51FA\u7684<b>\u9632\u79A6\u7247\u6BB5\u653E\u7F6E\u5728\u6307\u5B9A\u4F4D\u7F6E</b>\u3002"
