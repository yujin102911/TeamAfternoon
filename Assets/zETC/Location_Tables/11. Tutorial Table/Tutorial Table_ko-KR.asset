  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: 97b4510909976a64082e7c15b4b1356d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10054545956864
    m_Localized: "\uBC18\uAC11\uC2B5\uB2C8\uB2E4, \uC0AC\uC6A9\uC790\uB2D8.\n\uC800\uB294
      Manasoft\uC5D0\uC11C \uC81C\uACF5\uD558\uB294 OS \uBC0F \uC601\uC0C1 \uD3B8\uC9D1
      \uB3C4\uC6B0\uBBF8 <b>NA1L</b>\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151168
    m_Localized: "\uC601\uC0C1 \uD3B8\uC9D1 \uC678\uC8FC \uACFC\uC815\uC774 \uC5B4\uB824\uC6B0\uC2DC\uB2E4\uACE0\uC694?
      \n\uAC71\uC815 \uB9C8\uC138\uC694! \uC81C\uAC00 \uCC28\uADFC\uCC28\uADFC \uC54C\uB824 
      \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4. \uC2A4\uD0B5\uC740 \uAFC8\uB3C4 \uAFB8\uC9C0
      \uB9C8\uC138\uC694!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151169
    m_Localized: "\uADF8\uB2E4\uC74C\uC73C\uB85C\uB294 Manasoft\uAC00 \uC790\uB791\uD558\uB294
      MSN\uC758 \uD2B8\uB798\uD53D \uC99D\uAC00\uB97C \uC704\uD574 \uB9E4\uC77C <b>MSN</b>\uC744
      \uCCB4\uD06C\uD558\uB294 \uAC83\uC744 \uAD8C\uC7A5 \uB4DC\uB9BD\uB2C8\uB2E4.\n\n*\uBCF8
      \uC54C\uB9BC\uC5D0\uB294 Manasoft\uC758 \uAD11\uACE0\uAC00 \uD3EC\uD568\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151170
    m_Localized: "<b>Mana Scroll Network</b>\uC5D0\uC11C\uB294 \uB9E4\uC77C\uC758
      \uC18C\uC2DD\uC744 <b>\uB274\uC2A4\uB85C \uC81C\uACF5</b>\uD569\uB2C8\uB2E4.\n\uAC04\uBC24\uC5D0
      \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB294\uC9C0 \uC54C\uAE30 \uB531
      \uC88B\uC8E0!\n\n*\uBCF8 \uC54C\uB9BC\uC5D0\uB294 Manasoft\uC758 \uAD11\uACE0\uAC00
      \uD3EC\uD568\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.  \n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151171
    m_Localized: "\uC774\uC81C x\uBC84\uD2BC\uC744 \uB20C\uB7EC \uB2EB\uC544\uBD05\uC2DC\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151172
    m_Localized: "\uACC4\uC57D\uC11C\uC5D0 \uBA85\uC2DC\uB41C \uB0B4\uC6A9\uC5D0
      \uB530\uB974\uBA74 \uC0AC\uC6A9\uC790\uB2D8\uC758 \uC678\uC8FC\uB294 OwlLook\uC744
      \uC0AC\uC6A9\uD558\uC5EC \uC9C4\uD589\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151173
    m_Localized: "\uB9C8\uCE68 \uD3B8\uC9C0\uAC00 \uB3C4\uCC29\uD574 \uC788\uB124\uC694!\n<b>OwlLook</b>\uC744
      \uB20C\uB7EC \uD504\uB85C\uADF8\uB7A8\uC744 \uC2E4\uD589\uD558\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151174
    m_Localized: "\uC774\uACF3\uC774 \uBC1B\uC740 \uD3B8\uC9C0\uD568\uC785\uB2C8\uB2E4.
      \uBA54\uC77C \uC81C\uBAA9\uC744 \uD074\uB9AD\uD558\uBA74 \uC0C1\uC138 \uB0B4\uC6A9\uC744
      \uC77D\uC744 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151175
    m_Localized: "Manasoft\uC5D0\uC11C\uB294 \uD604\uC7AC \uC6A9\uC0AC \uD0C4\uC0DD
      \uAE30\uB150\uC73C\uB85C Worlds Movie Weaver\uC758 \uD2B9\uC218 \uD6A8\uACFC\uB97C
      \uB370\uC77C\uB9AC \uBB34\uB8CC \uC81C\uACF5 \uC911\uC5D0 \uC788\uC2B5\uB2C8\uB2E4.
      \n\uC790\uC138\uD55C \uC0AC\uD56D\uC740 \uBA54\uC77C\uC744 \uD655\uC778\uD574
      \uBCF4\uC138\uC694!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151176
    m_Localized: "\uACC4\uC57D\uC11C \uB0B4\uC6A9\uC5D0 \uB530\uB974\uBA74 \uD558\uB8E8\uC5D0
      \uD55C \uAC74\uC758 \uD3B8\uC9D1 \uC694\uCCAD\uC774 \uB3C4\uCC29\uD560 \uC608\uC815\uC785\uB2C8\uB2E4.\r\n\uC78A\uC9C0
      \uB9D0\uACE0 \uB9E4\uC77C \uD655\uC778\uD574 \uC8FC\uC138\uC694.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151177
    m_Localized: "\uC791\uC5C5\uC5D0 \uD544\uC694\uD55C \uBAA8\uB4E0 \uD30C\uC77C\uC740
      \uCCA8\uBD80  \uD30C\uC77C \uC548\uC5D0 \uB4E4\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.\n\uC900\uBE44\uB418\uC168\uB2E4\uBA74
      \uCCA8\uBD80 \uD30C\uC77C\uC744 \uB20C\uB7EC \uC758\uB8B0 \uC601\uC0C1\uC744
      \uC81C\uC791\uD574 \uBCF4\uC8E0. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151178
    m_Localized: "Manasoft <b>Worlds Movie Weaver</b>\uB294 \uC601\uC0C1\uC744 \uCC3D\uC870\uD574\uB0BC
      \uC218 \uC788\uB294 \uC0AC\uC6A9\uC790 \uB9DE\uCDA4\uD615 \uACF5\uAC04\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151179
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uC0AC\uC6A9\uC790\uB294 \uC6D0\uD558\uB294
      \uC601\uC0C1\uC744 \uC790\uC720\uB86D\uAC8C \uB9CC\uB4E4\uC5B4 \uB0BC \uC218
      \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151180
    m_Localized: "\uC9C0\uAE08\uBD80\uD130\uB294 <b>Worlds Movie Weaver</b>\uC5D0
      \uB300\uD55C \uC0AC\uC6A9 \uC548\uB0B4\uB97C \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151181
    m_Localized: "\uD504\uB85C\uADF8\uB7A8\uC774 \uC900\uBE44\uB418\uC5C8\uC73C\uB2C8
      \uC774\uC81C \uD3B8\uC9D1\uC744 \uC2DC\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \n\uC900\uBE44\uB418\uC168\uB2E4\uBA74 <b>\u2018\uD3B8\uC9D1 \uC2DC\uC791\uD558\uAE30\u2019</b>\uB97C
      \uB204\uB974\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151182
    m_Localized: "\uB2F9\uD669\uD558\uC9C0 \uB9C8\uC138\uC694. \uC800 <b>NA1L</b>\uC774
      \uD568\uAED8\uD560 \uD14C\uB2C8\uAE4C\uC694!\n\uD558\uB098\uC529 \uCC28\uADFC\uCC28\uADFC
      \uC0B4\uD3B4\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151183
    m_Localized: "\uC704\uCABD\uC5D0 \uBCF4\uC774\uB294 \uC774 \uD654\uBA74\uC774
      <b>\uD0C0\uC784\uB77C\uC778 \uBDF0\uC5B4</b>\uC785\uB2C8\uB2E4. \n\uC81C\uC791\uD560
      \uC601\uC0C1\uC758 \uBBF8\uB9AC\uBCF4\uAE30\uB97C \uC774\uACF3\uC5D0\uC11C
      \uD655\uC778\uD560 \uC218 \uC788\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151184
    m_Localized: "\uC774\uAC8C <b>\uD0C0\uC784\uB77C\uC778</b>\uC785\uB2C8\uB2E4.
      \n\uC601\uC0C1\uC744 \uC124\uACC4\uD558\uB294 \uD328\uB110\uC774\uC8E0.\n\uC774\uACF3\uC5D0\uC11C
      \uC601\uC0C1\uC758 \uBAA8\uB4E0 \uAC83\uC774 \uACB0\uC815\uB429\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151185
    m_Localized: "\uC911\uC559\uC744 \uAE30\uC900\uC73C\uB85C \uC704\uCABD\uC740
      <b>\uC801\uC758 \uD074\uB9BD</b>\uC774 \uB4E4\uC5B4\uAC00\uACE0, \uC544\uB798\uCABD\uC740
      <b>\uC6A9\uC0AC\uC758 \uD074\uB9BD</b>\uC774 \uB4E4\uC5B4\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151186
    m_Localized: "\uC774\uACF3\uC740 <b>\uB77C\uC774\uBE0C\uB7EC\uB9AC</b>\uC785\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC774
      \uAC00\uC9C4 \uBAA8\uB4E0 \uD074\uB9BD\uACFC \uD6A8\uACFC\uB294 \uC774\uACF3\uC5D0
      \uC800\uC7A5\uB429\uB2C8\uB2E4. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151187
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C\u2026\uC774\uAC83\uC774 <b>\uC601\uC0C1
      \uD074\uB9BD</b>\uC785\uB2C8\uB2E4!\n\uC601\uC0C1 \uC81C\uC791\uC758 \uC8FC
      \uC7AC\uB8CC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151188
    m_Localized: "\uD074\uB9BD\uC744 \uD0C0\uC784\uB77C\uC778\uC5D0 \uBC30\uCE58\uD574\uC11C
      \uC0AC\uC6A9\uC790\uAC00 \uC6D0\uD558\uB294 \uB300\uB85C \uC601\uC0C1\uC744
      \uC81C\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBC14\uB85C \uD574 \uBCFC\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151189
    m_Localized: "\uC774\uACF3\uC5D0 \uD45C\uC2DC\uB418\uB294 \uAC83\uC774 <b>\uC801\uC758
      \uACF5\uACA9</b>\uC785\uB2C8\uB2E4.\n\uC801\uC758 \uACF5\uACA9 \uD074\uB9BD
      \uC704\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uACF5\uACA9\uBC1B\uB294
      \uC704\uCE58\uB97C \uBDF0\uC5B4\uC5D0\uC11C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151190
    m_Localized: "\uC9C0\uAE08\uC774\uB77C\uBA74 \uACF5\uACA9\uC5D0 \uB2F9\uD558\uACA0\uC9C0\uB9CC\u2026
      \uC6A9\uC0AC\uB77C\uBA74 \uC774 \uC815\uB3C4\uB294 \uBA4B\uC9C0\uAC8C \uD68C\uD53C\uD558\uB294
      \uAC83\uC774 \uC88B\uACA0\uC8E0?\n\uC6A9\uC0AC\uAC00 \uACF5\uACA9\uC744 \uD53C\uD558\uB294
      \uC7A5\uBA74\uC744 \uB9CC\uB4E4\uC5B4 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151191
    m_Localized: "\uB77C\uC774\uBE0C\uB7EC\uB9AC \uC0C1\uB2E8\uC5D0 \uC788\uB294
      <b>\uD544\uD130</b>\uC5D0 \uCCB4\uD06C\uD558\uC5EC \uC6D0\uD558\uB294 \uD074\uB9BD\uC744
      \uCC3E\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n<b>\uC774\uB3D9\uC5D0 \uCCB4\uD06C</b>\uD558\uC5EC
      \uC6D0\uD558\uB294 \uD074\uB9BD\uC744 \uCC3E\uC544\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151192
    m_Localized: "\uC704\uCABD\uC5D0 \uC788\uB294 <b>\uC774\uB3D9 \uBE14\uB85D\uC744
      \uB4DC\uB798\uADF8 \uC564 \uB4DC\uB86D\uD558\uC5EC \uC9C0\uC815\uB41C \uC704\uCE58\uC5D0
      \uBC30\uCE58</b>\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151193
    m_Localized: "\uD074\uB9BD\uC744 \uBB34\uC0AC\uD788 \uBC30\uCE58\uD588\uB2E4\uBA74,
      <b>\uC120\uD0DD \uCD08\uAE30\uD654 \uBC84\uD2BC</b>\uC744 \uB20C\uB7EC \uD544\uD130\uB97C
      \uD574\uC81C\uD569\uC2DC\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151194
    m_Localized: "\uC798 \uD588\uC5B4\uC694!\n\uC774\uB3D9 \uBE14\uB85D\uC740 \uD074\uB9AD\uD574\uC11C
      \uC774\uB3D9 \uBC29\uD5A5\uC744 \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC6A9\uC0AC\uAC00
      \uC704\uB85C \uC6C0\uC9C1\uC774\uB3C4\uB85D \uD574 \uBCFC\uAE4C\uC694?\n<b>\uD074\uB9AD\uD574\uC11C
      \uC774\uB3D9 \uBC29\uD5A5\uC744 \uBC14\uAFD4 \uBCF4\uC138\uC694!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151195
    m_Localized: "\uC798\uD588\uC5B4\uC694!\n\uC774\uC81C <b>\uCEE4\uC11C\uB97C \uC7A1\uACE0
      \uD45C\uC2DC \uC9C0\uC810\uAE4C\uC9C0 \uB4DC\uB798\uADF8</b>\uD558\uC5EC \uC6A9\uC0AC\uAC00
      \uC5B4\uB5BB\uAC8C \uD589\uB3D9\uD558\uB294\uC9C0 \uBDF0\uC5B4\uC5D0\uC11C
      \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151196
    m_Localized: "\uC6A9\uC0AC\uAC00 \uBB34\uC0AC\uD788 \uACF5\uACA9\uC744 \uD53C\uD588\uC2B5\uB2C8\uB2E4!\r\n\uD074\uB9BD\uC744
      \uC774\uC6A9\uD558\uBA74 \uC774\uCC98\uB7FC \uC6A9\uC0AC\uC758 \uD589\uB3D9\uC744
      \uC5F0\uCD9C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151197
    m_Localized: "\uD558\uC9C0\uB9CC \uC6A9\uC0AC\uC758 \uBA4B\uC9C4 \uC2B9\uB9AC
      \uC7A5\uBA74\uC744 \uC704\uD574\uC11C\uB294 \uD53C\uD558\uAE30\uB9CC \uD574\uC11C\uB294
      \uC548 \uB429\uB2C8\uB2E4. \uACF5\uACA9\uC744 \uD574\uC57C\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151198
    m_Localized: "\uCCA8\uBD80 \uD30C\uC77C\uC744 \uD655\uC778\uD574 \uBCF4\uB2C8,
      \uC6A9\uC0AC\uAC00 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uBB34\uAE30\uB294
      \uB450 \uAC00\uC9C0 \uC885\uB958\uAC00 \uC788\uB124\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151199
    m_Localized: "<b>\uC5B4\uB514\uC5D0 \uC788\uB4E0</b> \uC548\uC815\uC801\uC73C\uB85C
      \uC801\uC744 \uB9DE\uD790 \uC218 \uC788\uB294 <b>\uC6D0\uAC70\uB9AC \uACF5\uACA9</b>\uACFC\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151200
    m_Localized: "\u2026<b>\uC801\uACFC \uAC00\uAE4C\uC6B4 \uC5F4</b>\uC5D0\uC11C\uB9CC
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 <b>\uADFC\uAC70\uB9AC \uACF5\uACA9</b>\uC785\uB2C8\uB2E4.\n\uADFC\uAC70\uB9AC
      \uACF5\uACA9\uC740 \uACF5\uAC04\uC758 \uC81C\uC57D\uC774 \uC788\uB294 \uB300\uC2E0,
      \uD6E8\uC52C \uAC15\uD558\uAC8C \uACF5\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151201
    m_Localized: "\uBA3C\uC800 \uC6D0\uAC70\uB9AC \uACF5\uACA9 \uD074\uB9BD\uC744
      \uBC30\uCE58\uD574 \uBD05\uC2DC\uB2E4. \n<b>\uC6D0\uAC70\uB9AC \uACF5\uACA9
      \uCCB4\uD06C\uBC15\uC2A4\uB97C \uD074\uB9AD</b>\uD574 \uC6D0\uD558\uB294 \uD074\uB9BD\uC744
      \uCC3E\uC544\uBCF4\uC138\uC694. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151202
    m_Localized: "\uC6D0\uAC70\uB9AC \uACF5\uACA9\uC740 \uC6A9\uC0AC\uAC00 \uC5B4\uB514
      \uC788\uB4E0 \uACF5\uACA9\uC744 \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \n<b>\uC9C0\uC815\uB41C \uC704\uCE58\uC5D0 \uD074\uB9BD\uC744 \uBC30\uCE58</b>\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151203
    m_Localized: "\uC774\uB7F0!\r\n\uD310\uB2E8 \uACB0\uACFC \uCD5C\uC801\uC758 \uC218\uC5D0\uC11C
      \uBC97\uC5B4\uB0AC\uB2E4\uB294 \uAC83\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.\r\n\uADF8\uB798\uB3C4
      \uAC71\uC815 \uB9C8\uC138\uC694! \uC2E4\uD589\uD558\uAE30 \uC804\uAE4C\uC9C0
      \uD074\uB9BD \uBC30\uCE58\uB294 \uC790\uC720\uB86D\uAC8C \uC218\uC815\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \r"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151204
    m_Localized: "\uD074\uB9BD\uC740 <b>\uB4DC\uB798\uADF8 \uC564 \uB4DC\uB86D\uC73C\uB85C
      \uC704\uCE58\uB97C \uC218\uC815</b>\uD560 \uC218 \uC788\uACE0,\n<b>\uC6B0\uD074\uB9AD\uC744
      \uC774\uC6A9\uD574 \uBC30\uCE58\uB97C \uCDE8\uC18C</b>\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774
      \uAE30\uB2A5\uB4E4\uC744 \uC0AC\uC6A9\uD558\uC5EC <b>\uC6D0\uAC70\uB9AC \uD074\uB9BD
      \uBC30\uCE58\uB97C \uC218\uC815</b>\uD574 \uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151205
    m_Localized: "\uB2E4\uC74C\uC73C\uB85C\uB294 \uADFC\uAC70\uB9AC \uACF5\uACA9\uC785\uB2C8\uB2E4.\n\uADFC\uAC70\uB9AC\uB294
      \uB9E8 \uC55E\uC5D0\uC11C\uB9CC \uACF5\uACA9\uD560 \uC218 \uC788\uC73C\uB2C8
      \uC55E\uC73C\uB85C \uD55C \uCE78 \uB098\uAC00\uC57C \uD569\uB2C8\uB2E4.\n<b>\uD544\uD130
      \uC120\uD0DD\uC744 \uCD08\uAE30\uD654</b>\uD558\uACE0, <b>\uADFC\uAC70\uB9AC
      \uACF5\uACA9\uC5D0 \uCCB4\uD06C</b>\uD558\uC5EC \uD074\uB9BD\uC744 \uCC3E\uC544
      \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151206
    m_Localized: "\uB9C8\uCE68 \uC774\uB3D9\uACFC \uACF5\uACA9\uC774 \uAC19\uC774
      \uBB36\uC5EC \uC788\uB294 \uD074\uB9BD\uC774 \uC788\uB124\uC694! \n<b>\uD45C\uC2DC\uB41C
      \uC704\uCE58\uC5D0 \uBC30\uCE58</b>\uD558\uACE0 \uC6A9\uC0AC\uAC00 \uACF5\uACA9
      \uAC00\uB2A5\uD55C \uC704\uCE58\uB85C \uC774\uB3D9\uD558\uB3C4\uB85D \uBC29\uD5A5\uC744
      \uBC14\uAFD4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151207
    m_Localized: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4.\n\uD558\uC9C0\uB9CC \uC774\uB300\uB85C\uB77C\uBA74
      \uB2E4\uC74C \uACF5\uACA9\uC5D0\uC11C \uD53C\uD574\uB97C \uC785\uAC8C \uB429\uB2C8\uB2E4.\n\uADF8\uAC74
      \uB108\uBB34 \uBA4B\uC5C6\uB294 \uC77C\uC774\uC8E0\u2026.\n\uC774\uB7F4\uB54C
      \uD544\uC694\uD55C \uAC83\uC774 <b>\u2018\uBC29\uC5B4\u2019</b>\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151208
    m_Localized: "\uD544\uD130 \uC120\uD0DD\uC744 \uCD08\uAE30\uD654\uD558\uACE0,
      <b>\uBC29\uC5B4 \uCCB4\uD06C\uBC15\uC2A4\uB97C \uB20C\uB7EC</b> \uD074\uB9BD\uC744
      \uCC3E\uC544 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151209
    m_Localized: "\uC774 \uD074\uB9BD\uC740 \uBC29\uC5B4 \uC790\uC138\uB97C \uCDE8\uD574,
      <b>\uBC14\uB85C \uC9C1\uD6C4\uC5D0 \uC624\uB294 \uACF5\uACA9\uC758 \uB300\uBBF8\uC9C0\uB97C
      \uBB34\uD6A8\uD654</b>\uC2DC\uD0B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151210
    m_Localized: "\uCC3E\uC544\uB0B8 <b>\uBC29\uC5B4 \uD074\uB9BD\uC744 \uC9C0\uC815\uB41C
      \uC704\uCE58\uC5D0 \uBC30\uCE58</b>\uD574 \uBD05\uC2DC\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151211
    m_Localized: "\uBC29\uC5B4\uC640 \uD568\uAED8 \uC788\uB294 <b>\uC774\uB3D9\uC744
      \uD074\uB9AD</b>\uD574, \uC6A9\uC0AC\uAC00 \uC544\uB798\uB85C \uD55C \uCE78
      \uB0B4\uB824\uC624\uB3C4\uB85D \uD574 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151212
    m_Localized: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4.\n\uC774\uB807\uAC8C \uBAA8\uB4E0
      \uD074\uB9BD\uC744 \uBC30\uCE58\uD558\uACE0 \uB098\uBA74 <b>\uC7AC\uC0DD \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uD574\uB2F9 \uC7A5\uBA74\uC744 \uC2E4\uD589</b>\uD558\uC138\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151213
    m_Localized: "\uC544\uC8FC \uBA4B\uC9C4 \uC601\uC0C1\uC785\uB2C8\uB2E4!\r\n\uC774\uCC98\uB7FC
      \uC2E4\uD589 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uC6A9\uC0AC\uAC00 \uD074\uB9BD\uC744
      \uBC30\uCE58\uD55C \uB300\uB85C \uC6C0\uC9C1\uC774\uB294 \uAC78 \uBCFC \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \r"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151214
    m_Localized: "\uD574\uB2F9 \uACFC\uC815\uC744 \uBC18\uBCF5\uD558\uC5EC <b>Worlds
      Movie Weaver</b>\uB97C \uD1B5\uD574 \uC6A9\uC0AC\uAC00 \uC2B9\uB9AC\uD558\uB294
      \uC601\uC0C1\uC744 \uC27D\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151215
    m_Localized: "\uD558\uC9C0\uB9CC \uC81C\uC791\uD560 \uC218 \uC788\uB294 \uC601\uC0C1\uC758
      \uAE38\uC774\uAC00 \uC81C\uD55C\uB418\uC5B4 \uC788\uB2E4\uB294 \uC810 \uC720\uC758\uD558\uC138\uC694!\n<b>\uD574\uB2F9
      \uAE38\uC774\uB97C \uCD08\uACFC</b>\uD558\uBA74 <b>\uD504\uB85C\uADF8\uB7A8\uC774
      \uAC15\uC81C \uC885\uB8CC</b>\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151216
    m_Localized: "\uC774\uC81C \uB2E4\uC74C \uC7A5\uBA74\uC744 \uB9CC\uB4E4\uC5B4
      \uBD05\uC2DC\uB2E4.\n\uC774\uBC88 \uC7A5\uBA74\uC740 \uB354\uC6B1 \uAC15\uB825\uD55C
      \uC7A5\uBA74\uC744 \uC5F0\uCD9C\uD574 \uBCFC \uAC81\uB2C8\uB2E4. \n\uD544\uD130
      \uC120\uD0DD\uC744 \uCD08\uAE30\uD654\uD558\uACE0, <b>\uC6D0\uAC70\uB9AC \uACF5\uACA9
      \uCCB4\uD06C\uBC15\uC2A4\uB97C \uD074\uB9AD</b>\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151217
    m_Localized: "\uC774\uB3D9\uACFC \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC774 \uD558\uB098\uB85C
      \uBB36\uC778 <b>\uD074\uB9BD\uC744 \uC9C0\uC815\uB41C \uACF3\uC73C\uB85C \uB04C\uC5B4</b>\uC624\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151218
    m_Localized: "\uC5EC\uAE30 \uC788\uB294 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC740
      <b>\uCC28\uC9C0 \uACF5\uACA9</b>\uC73C\uB85C, \n\uC624\uB798 \uD798\uC744 \uBAA8\uC740
      \uB9CC\uD07C <b>\uB354 \uAC15\uB825\uD55C \uACF5\uACA9</b>\uC744 \uBCF4\uC7A5\uD569\uB2C8\uB2E4.\n\uD558\uC9C0\uB9CC
      <b>\uC911\uAC04\uC5D0 \uB300\uBBF8\uC9C0\uC744 \uBC1B\uC73C\uBA74 \uCC28\uC9D5\uC774
      \uB04A\uAE30\uB2C8 \uC8FC\uC758</b>\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151219
    m_Localized: "\uD558\uC9C0\uB9CC \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC774 \uB05D\uB098\uB294
      \uC21C\uAC04\uC5D0 \uB9DE\uCDB0 \uC801\uC758 \uACF5\uACA9\uC774 \uC608\uACE0\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151220
    m_Localized: "\uADF8\uB807\uB2E4\uBA74 \uC548\uC804\uD55C \uACF3\uC73C\uB85C
      \uC774\uB3D9\uD560 \uD544\uC694\uAC00 \uC788\uACA0\uC8E0\u2026. \uBAA8\uCC98\uB7FC\uC774\uB2C8
      \uD2B9\uC218\uD6A8\uACFC\uB97C \uC0AC\uC6A9\uD574 \uBCFC\uAE4C\uC694? \n<b>\uD2B9\uC218\uD6A8\uACFC
      \uD0ED\uC744 \uD074\uB9AD</b>\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151221
    m_Localized: "<b>\uD2B9\uC218\uD6A8\uACFC</b>\uB294 \uD074\uB9BD\uC744 \uB354
      \uB2E4\uCC44\uB86D\uAC8C \uB9CC\uB4E4\uC5B4 \uC8FC\uB294 <b>\uD2B9\uBCC4\uD55C
      \uB2A5\uB825</b>\uB4E4\uC785\uB2C8\uB2E4. \n\uBCF8\uB798\uB294 \uC720\uB8CC\uAE30\uB2A5\uC774\uC9C0\uB9CC,
      \uD604\uC7AC \uC77C\uBD80 \uD6A8\uACFC\uB97C \uBB34\uB8CC\uB85C \uC0AC\uC6A9\uD574
      \uBCFC \uC218 \uC788\uB294 \uC774\uBCA4\uD2B8 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151222
    m_Localized: "\uD604\uC7AC \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uD6A8\uACFC\uB294
      \uC2E0\uC18D \uBFD0\uC785\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC774 \uAE30\uB2A5\uC744
      \uC0AC\uC6A9\uD574\uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \n<b>\uC2E0\uC18D \uD6A8\uACFC\uB97C
      \uB4DC\uB798\uADF8 \uC564 \uB4DC\uB86D\uD558\uC5EC \uC774\uB3D9 \uD074\uB9BD
      \uC704\uC5D0 \uC5B9\uC5B4</b>\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151223
    m_Localized: "<b>\uC774\uB3D9 \uD074\uB9BD\uC744 \uD074\uB9AD</b>\uD574, \uC6A9\uC0AC\uAC00
      \uB9E8 \uB4A4\uB85C \uAC08 \uC218 \uC788\uB3C4\uB85D \uD654\uC0B4\uD45C\uB97C
      \uC67C\uCABD\uC73C\uB85C \uD5A5\uD558\uAC8C \uD574 \uC8FC\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151224
    m_Localized: "\uC2E0\uC18D\uC740 \uC774\uB3D9 \uAC70\uB9AC\uB97C 2\uBC30\uB85C
      \uB298\uB824\uC90D\uB2C8\uB2E4. \uC774\uB85C\uC368 \uC801\uC758 \uACF5\uACA9\uC744
      \uBB34\uC0AC\uD788 \uD53C\uD558\uACE0, \uC6D0\uAC70\uB9AC \uCC28\uC9D5 \uACF5\uACA9\uC744
      \uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151225
    m_Localized: "\uD558\uC9C0\uB9CC \uC774\uACF3\uC758 \uBA54\uBAA8\uB9AC\uAC00
      \uC870\uAE08 \uCC28\uC624\uB978\uAC8C \uBCF4\uC774\uC2DC\uB098\uC694? \n<b>\uAC01
      \uD2B9\uC218 \uD6A8\uACFC\uB294 \uBA54\uBAA8\uB9AC\uB97C \uC18C\uBE44</b>\uD569\uB2C8\uB2E4.\n\uBA54\uBAA8\uB9AC\uAC00
      \uBD80\uC871\uD574\uC9C0\uBA74 \uB354 \uC774\uC0C1 \uD6A8\uACFC\uB97C \uC0AC\uC6A9\uD560
      \uC218 \uC5C6\uC5B4\uC694!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151226
    m_Localized: "\uD558\uC9C0\uB9CC \uB108\uBB34 \uC2AC\uD37C\uD558\uC9C0 \uB9C8\uC138\uC694.
      Movie Weaver\uB294 \uADF8\uB7F0 \uC0AC\uC6A9\uC790\uB97C \uC704\uD574 \uC790\uCCB4
      \uCD5C\uC801\uD654 \uAE30\uB2A5\uC744 \uC81C\uACF5\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151227
    m_Localized: "<b>\uD574\uB2F9 \uC870\uAC74\uB4E4\uC744 \uC900\uC218</b>\uD55C\uB2E4\uBA74,
      \uC81C\uD55C\uB41C \uBA54\uBAA8\uB9AC\uC5D0\uC11C\uB3C4 \uB354 \uB9CE\uC740
      \uD6A8\uACFC\uB97C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151228
    m_Localized: "Worlds Movie Weaver\uC758 \uBAA8\uB4E0 \uAE30\uB2A5\uC744 \uD559\uC2B5\uD558\uC168\uC73C\uB2C8
      \uC774\uC81C \uC6A9\uC0AC\uAC00 \uC801\uC744 \uC8FD\uC774\uB294 \uC601\uC0C1\uC744
      \uB9C8\uBB34\uB9AC\uD574 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151229
    m_Localized: "\uBA3C\uC800, \uC801\uC744 \uD655\uC2E4\uD558\uAC8C \uCC98\uCE58\uD558\uAE30
      \uC704\uD574 \uAC15\uB825\uD55C \uACF5\uACA9\uC744 \uC9C4\uD589\uD574 \uBD05\uC2DC\uB2E4.
      \n\uD544\uD130 \uC120\uD0DD\uC744 \uCD08\uAE30\uD654\uD558\uACE0, <b>\uADFC\uAC70\uB9AC
      \uACF5\uACA9 \uD544\uD130</b>\uB97C \uC120\uD0DD\uD574 \uC8FC\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151230
    m_Localized: "\uC798 \uD558\uC168\uC2B5\uB2C8\uB2E4.\n\uC774\uC820 <b>\uC9C0\uC815\uB41C
      \uC704\uCE58\uC5D0 \uADFC\uAC70\uB9AC \uCC28\uC9D5 \uACF5\uACA9\uC744 \uB193\uC544</b>\uC8FC\uC138\uC694.
      \n"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151231
    m_Localized: "<b>\uADFC\uAC70\uB9AC \uCC28\uC9D5</b>\uC740 \uADFC\uAC70\uB9AC
      \uACF5\uACA9\uACFC \uCC28\uC9D5\uC758 \uD2B9\uC9D5\uC744 \uBAA8\uB450 \uAC00\uC9C0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n<b>\uC801\uACFC \uAC00\uAE4C\uC6B4 \uC704\uCE58\uC5D0\uC11C\uB9CC
      \uACF5\uACA9</b>\uD560 \uC218 \uC788\uACE0, <b>\uC911\uAC04\uC5D0 \uACF5\uACA9\uC744
      \uBC1B\uC73C\uBA74 \uB04A\uAE41</b>\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151232
    m_Localized: "\uC774\uB7F0 \uADFC\uAC70\uB9AC \uCC28\uC9D5\uC744 \uC0AC\uC6A9\uD558\uB824\uBA74,
      \uADFC\uAC70\uB9AC \uACF5\uACA9\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294
      \uC704\uCE58\uB85C \uAC00\uC57C\uACA0\uC8E0. \n\uD574\uB2F9 \uC704\uCE58\uC5D0
      <b>\uC2E0\uC18D \uD2B9\uC218\uD6A8\uACFC\uB97C \uC785\uD78C \uC774\uB3D9\uC744
      \uBC30\uCE58</b>\uD558\uC5EC, \uC6A9\uC0AC\uAC00 \uC804\uC5F4\uB85C \uB098\uAC00\uAC8C
      \uD574 \uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151233
    m_Localized: "\uC798 \uD558\uC168\uC2B5\uB2C8\uB2E4. \r\n\uC6A9\uC0AC\uAC00 \uBB34\uC0AC\uD788
      \uADFC\uAC70\uB9AC \uCC28\uC9D5 \uACF5\uACA9\uAE4C\uC9C0 \uC2E4\uD589\uD560
      \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \r"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151234
    m_Localized: "\uC774\uB85C\uC11C \uD074\uB9BD \uBC30\uCE58\uB85C \uCD1D 11\uC758
      \uB300\uBBF8\uC9C0\uB97C \uB123\uC744 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD604\uC7AC
      \uC801\uC758 \uB0A8\uC740 \uCCB4\uB825\uC774 7\uC774\uB2C8, \uAC70\uB72C\uD558\uAC8C
      \uC774\uAE30\uACE0\uB3C4 \uB0A8\uACA0\uB124\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151235
    m_Localized: "\uC774\uC81C <b>\uD50C\uB808\uC774 \uBC84\uD2BC\uC744 \uB20C\uB7EC,
      \uC7A5\uBA74\uC744 \uC2E4\uD589</b>\uD574\uBD05\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151236
    m_Localized: "\uC815\uB9D0 \uBA4B\uC9C4 \uC601\uC0C1\uC778\uAC78\uC694!\r\n\uC6A9\uC0AC\uAC00
      \uB9C8\uCE58 \uC9C4\uC9DC \uB358\uC804\uC744 \uD074\uB9AC\uC5B4\uD558\uB294
      \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \r"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151237
    m_Localized: "\uC544\uC8FC \uC798\uD558\uC168\uC2B5\uB2C8\uB2E4.\n\uC774\uC81C
      \uC81C\uC791\uC774 \uC644\uB8CC\uB41C \uC601\uC0C1\uC5D0 \uC774\uB984\uC744
      \uBD99\uC5EC\uC904 \uCC28\uB840\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151238
    m_Localized: "\uC81C \uC548\uB0B4\uB294 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4.
      \n\uB3C4\uC6C0\uC774 \uB418\uC168\uB098\uC694? \n\n\uC774\uC81C <b>\uC5C5\uB85C\uB4DC
      \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD30C\uC77C\uC744 \uB0B4\uBCF4\uB0B4</b>\uC138\uC694.\n\uD574\uB2F9
      \uB3C4\uC6B0\uBBF8\uB294 \uC790\uB3D9\uC73C\uB85C \uC885\uB8CC\uB429\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 8157630835187712
    m_Localized: "\uC6B0\uC120, \uC694\uC998 \uB300\uC138\uC778 SNS Flutter\uB97C
      \uD655\uC778\uD574 \uBCF4\uC2DC\uB294 \uAC74 \uC5B4\uB5A8\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 8157793226055680
    m_Localized: "\uC774\uACF3\uC5D0\uC11C \uC138\uC0C1\uC774 \uC5B4\uB5BB\uAC8C
      \uB3CC\uC544\uAC00\uB294\uC9C0, \uC0AC\uB78C\uB4E4\uC774 \uC6A9\uC0AC\uC5D0
      \uB300\uD574 \uBB50\uB77C\uACE0 \uB5A0\uB4DC\uB294\uC9C0 \uC2E4\uC2DC\uAC04\uC73C\uB85C
      \uD655\uC778\uD560 \uC218 \uC788\uB2F5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8157874771714048
    m_Localized: "\uD2B8\uB80C\uB4DC \uD30C\uC545\uC740 \uD3B8\uC9D1\uC790\uC758
      \uAE30\uBCF8 \uC18C\uC591\uC774\uC8E0. \uC774\uC81C X \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uB2EB\uC544\uBD05\uC2DC\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 8157970762555392
    m_Localized: "\uC624, \uC6A9\uC0AC\uAC00 \uC9C1\uC811 \uBCF4\uB0B4\uC628 \uC2A4\uCE74\uC6C3
      \uBA54\uC77C\uC774\uAD70\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 8157985153212416
    m_Localized: "\uCC38\uACE0\uB85C \uC774\uBBF8 \uC77D\uC740 \uBA54\uC77C\uACFC
      \uC77D\uC9C0 \uC54A\uC740 \uBA54\uC77C\uC740 \uC544\uC774\uCF58 \uBAA8\uC591\uACFC
      \uBCFC\uB4DC\uCCB4\uB85C \uC27D\uAC8C \uAD6C\uBD84\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8157987355222016
    m_Localized: "\uC791\uC5C5\uC744 \uC2DC\uC791\uD558\uAE30 \uC804\uC5D0 \uD655\uC778\uD574\uC57C
      \uD560 \uC911\uC694\uD55C \uC18C\uC2DD\uC774 \uD558\uB098 \uB354 \uC788\uB294\uB370...
      \uC6A9\uC0AC\uC758 \uC2A4\uCE74\uC6C3 \uBA54\uC77C \uC704\uC5D0 \uC788\uB294
      \uBA54\uC77C\uC744 \uD55C\uBC88 \uB20C\uB7EC\uBCFC\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 8158194767749120
    m_Localized: "\uC601\uC0C1 \uC81C\uBAA9 \uCE78\uC744 \uD074\uB9AD\uD558\uC5EC
      \uC774 \uC601\uC0C1\uC5D0 \uC5B4\uC6B8\uB9AC\uB294 \uADFC\uC0AC\uD55C \uC81C\uBAA9\uC744
      \uC785\uB825\uD574 \uBCF4\uC138\uC694.\n\uC81C\uBAA9 \uC124\uC815\uC774 \uB05D\uB098\uBA74,
      \uC601\uC0C1\uC740 \uC2DC\uC2A4\uD15C\uC5D0 \uC790\uB3D9\uC73C\uB85C \uC800\uC7A5\uB418\uBA70
      \uC774\uACF3\uC5D0\uC11C \uBC14\uB85C \uB0B4\uBCF4\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 10670859155136512
    m_Localized: "\uB2E4\uC74C(V)"
    m_Metadata:
      m_Items: []
  - m_Id: 10670863802425344
    m_Localized: "\uC774\uC804(C)"
    m_Metadata:
      m_Items: []
