    m_Localized: "\u505A\u5F97\u597D\u3002\u73B0\u5728\u8BF7\u5728<b>\u6307\u5B9A\u4F4D\u7F6E\u653E\u7F6E\u8FD1\u6218\u84C4\u529B\u653B\u51FB</b>\u3002"
