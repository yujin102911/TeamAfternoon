  m_TableData:
  - m_Id: 10054545956864
    m_Localized: "\u60A8\u597D\uFF0C\u89C1\u5230\u60A8\u5F88\u9AD8\u5174\u3002\n\u6211\u662F\u7531
      Manasoft \u63D0\u4F9B\u7684 OS \u517C\u89C6\u9891\u526A\u8F91\u5C0F\u52A9\u624B\uFF0C<b>NA1L</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151168
    m_Localized: "\u662F\u4E0D\u662F\u89C9\u5F97\u89C6\u9891\u5916\u5305\u526A\u8F91\u6709\u70B9\u65E0\u4ECE\u4E0B\u624B\uFF1F\n\u653E\u5FC3\uFF01\u6211\u4F1A\u624B\u628A\u624B\u5E26\u60A8\u7684\u3002\n\u81F3\u4E8E\u8DF3\u8FC7\u6559\u7A0B\u2026
      \u60F3\u90FD\u522B\u60F3\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151169
    m_Localized: "\u9996\u5148\uFF0C\u5EFA\u8BAE\u60A8\u6BCF\u5929\u8BBF\u95EE <b>MSN</b>\uFF0C\n\u987A\u4FBF\u4E3A
      Manasoft \u8D21\u732E\u4E00\u70B9\u70B9\u6D41\u91CF\u3002\n\n*\u672C\u901A\u77E5\u5305\u542B
      Manasoft \u7684\u5E7F\u544A\u5185\u5BB9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151170
    m_Localized: "<b>Mana Scroll Network</b> \u4F1A\u4EE5<b>\u65B0\u95FB\u5F62\u5F0F</b>\u4E3A\u60A8\u63A8\u9001\u6BCF\u65E5\u8D44\u8BAF\u3002\n\u60F3\u77E5\u9053\u6628\u665A\u53D1\u751F\u4E86\u4EC0\u4E48\u5927\u74DC\uFF1F\n\u4E0A\u8FD9\u513F\u770B\u51C6\u6CA1\u9519\uFF01\n\n*\u672C\u901A\u77E5\u5305\u542B
      Manasoft \u7684\u5E7F\u544A\u5185\u5BB9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151171
    m_Localized: "\u8BF7\u70B9\u51FB X \u6309\u94AE\u5C06\u5176\u5173\u95ED\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151172
    m_Localized: "\u6839\u636E\u5408\u540C\u89C4\u5B9A\uFF0C\n\u60A8\u7684\u5916\u5305\u5DE5\u4F5C\u5C06\u901A\u8FC7
      OwlLook \u8FDB\u884C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151173
    m_Localized: "\u521A\u597D\u6709\u4E00\u5C01\u4FE1\u5230\u4E86\u5462\uFF01\n\u8BF7\u70B9\u51FB
      <b>OwlLook</b> \u8FD0\u884C\u7A0B\u5E8F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151174
    m_Localized: "\u70B9\u51FB\u6536\u4EF6\u7BB1\u91CC\u7684\u6807\u9898\u5373\u53EF\u786E\u8BA4\u5185\u5BB9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151175
    m_Localized: "\u4E3A\u4E86\u7EAA\u5FF5\u52C7\u58EB\u8BDE\u751F\uFF0CManasoft
      \u76EE\u524D\u6B63\u9650\u65F6\u514D\u8D39\u63D0\u4F9B Worlds Movie Weaver
      \u7684\u6BCF\u65E5\u7279\u6280\u6548\u679C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151176
    m_Localized: "\u6839\u636E\u5408\u540C\uFF0C\u6BCF\u5929\u90FD\u4F1A\u6709\u4E00\u4EFD\u7F16\u8F91\u59D4\u6258\u9001\u8FBE\uFF0C\n\u8BF7\u52A1\u5FC5\u6BCF\u5929\u786E\u8BA4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151177
    m_Localized: "\u5DE5\u4F5C\u6240\u9700\u7684\u6240\u6709\u6587\u4EF6\u90FD\u5728\u9644\u4EF6\u4E2D\u3002\n\u51C6\u5907\u597D\u4E86\u7684\u8BDD\uFF0C\u8BF7\u70B9\u51FB\u9644\u4EF6\uFF0C\n\u5F00\u59CB\u5236\u4F5C\u59D4\u6258\u89C6\u9891\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151178
    m_Localized: "Manasoft <b>Worlds Movie Weaver</b> \u662F\u4E3A\u7528\u6237\u91CF\u8EAB\u5B9A\u5236\u7684\u89C6\u9891\u521B\u4F5C\u7A7A\u95F4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151179
    m_Localized: "\u5728\u8FD9\u91CC\uFF0C\u60A8\u53EF\u4EE5\u968F\u5FC3\u6240\u6B32\u5730\u521B\u4F5C\u51FA\u60F3\u8C61\u4E2D\u7684\u6BCF\u4E00\u4E2A\u89C6\u9891\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151180
    m_Localized: "\u63A5\u4E0B\u6765\uFF0C\u5C06\u4E3A\u60A8\u4ECB\u7ECD<b>Worlds
      Movie Weaver</b>\u7684\u4F7F\u7528\u6307\u5357\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151181
    m_Localized: "\u7A0B\u5E8F\u5DF2\u5C31\u7EEA\uFF0C\u73B0\u5728\u53EF\u4EE5\u5F00\u59CB\u526A\u8F91\u4E86\u3002\n\u51C6\u5907\u597D\u540E\uFF0C\u8BF7\u70B9\u51FB<b>\u201C\u5F00\u59CB\u526A\u8F91\u201D</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151182
    m_Localized: "\u522B\u614C\uFF0C\u6709<b>NA1L</b>\u966A\u7740\u60A8\u5462\uFF01\n\u6211\u4EEC\u4E00\u4E2A\u4E00\u4E2A\u6765\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151183
    m_Localized: "\u4E0A\u65B9\u770B\u5230\u7684\u8FD9\u4E2A\u753B\u9762\u5C31\u662F
      <b>\u65F6\u95F4\u8F74\u9884\u89C8\u5668</b>\u3002\n\u60A8\u53EF\u4EE5\u5728\u8FD9\u91CC\u9884\u89C8\u6B63\u5728\u5236\u4F5C\u7684\u89C6\u9891\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151184
    m_Localized: "\u8FD9\u4E2A\u662F<b>\u65F6\u95F4\u8F74</b>\uFF0C\u662F\u8BBE\u8BA1\u89C6\u9891\u7684\u9762\u677F\u3002\n\u89C6\u9891\u7684\u4E00\u5207\u90FD\u5C06\u5728\u8FD9\u91CC\u51B3\u5B9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151185
    m_Localized: "\u4EE5\u4E2D\u592E\u4E3A\u51C6\uFF0C\u4E0A\u65B9\u653E\u7F6E<b>\u654C\u4EBA\u7247\u6BB5</b>\uFF0C\n\u4E0B\u65B9\u653E\u7F6E
      <b>\u52C7\u58EB\u7247\u6BB5</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151186
    m_Localized: "\u8FD9\u91CC\u662F<b>\u5E93</b>\u3002\n\u60A8\u62E5\u6709\u7684\u6240\u6709\u7247\u6BB5\u548C\u6548\u679C\u90FD\u5B58\u50A8\u5728\u8FD9\u91CC\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151187
    m_Localized: "\u6700\u540E\u2026\u8FD9\u5C31\u662F<b>\u89C6\u9891\u7247\u6BB5</b>\uFF01\n\u5B83\u4EEC\u662F\u5236\u4F5C\u89C6\u9891\u7684\u6838\u5FC3\u6750\u6599\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151188
    m_Localized: "\u60A8\u53EF\u4EE5\u5C06\u7247\u6BB5\u653E\u7F6E\u5728\u65F6\u95F4\u8F74\u4E0A\uFF0C\n\u968F\u5FC3\u6240\u6B32\u5730\u521B\u4F5C\u89C6\u9891\u3002\n\u90A3\u4E48\u6211\u4EEC\u8BD5\u8BD5\u770B\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151189
    m_Localized: "\u8FD9\u91CC\u663E\u793A\u7684\u662F <b>\u654C\u4EBA\u653B\u51FB</b>\u3002\n\u5C06\u9F20\u6807\u60AC\u505C\u5728\u654C\u4EBA\u653B\u51FB\u7247\u6BB5\u4E0A\uFF0C\n\u5C31\u53EF\u4EE5\u5728\u9884\u89C8\u5668\u4E2D\u786E\u8BA4\u53D7\u51FB\u4F4D\u7F6E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151190
    m_Localized: "\u7167\u8FD9\u6837\u4E0B\u53BB\u80AF\u5B9A\u4F1A\u88AB\u51FB\u4E2D\u7684\u2026
      \u4F5C\u4E3A\u52C7\u58EB\uFF0C\n\u603B\u5F97\u534E\u4E3D\u5730\u95EA\u907F\u5F00\u624D\u591F\u5E05\u5427\uFF1F\n\u6211\u4EEC\u6765\u5236\u4F5C\u4E00\u6BB5\u52C7\u58EB\u8EB2\u907F\u653B\u51FB\u7684\u753B\u9762\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151191
    m_Localized: "\u52FE\u9009\u5E93\u4E0A\u65B9\u7684<b>\u8FC7\u6EE4\u5668</b>\uFF0C\n\u53EF\u4EE5\u5FEB\u901F\u627E\u5230\u60F3\u8981\u7684\u7247\u6BB5\u3002\n\u8BF7<b>\u52FE\u9009\u201C\u79FB\u52A8\u201D</b>
      \u5BFB\u627E\u7247\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151192
    m_Localized: "\u8BF7\u5C06\u4E0A\u65B9\u7684<b>\u79FB\u52A8\u65B9\u5757\u62D6\u62FD\u5E76\u653E\u7F6E\u5728\u6307\u5B9A\u4F4D\u7F6E</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151193
    m_Localized: "\u6210\u529F\u653E\u7F6E\u7247\u6BB5\u540E\uFF0C\u8BF7\u70B9\u51FB<b>\u91CD\u7F6E\u9009\u62E9\u6309\u94AE</b>
      \u53D6\u6D88\u8FC7\u6EE4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151194
    m_Localized: "\u505A\u5F97\u597D\uFF01\u70B9\u51FB\u79FB\u52A8\u65B9\u5757\u53EF\u4EE5\u66F4\u6539\u79FB\u52A8\u65B9\u5411\u3002\n\u8BD5\u8BD5\u8BA9\u52C7\u58EB\u5411\u4E0A\u79FB\u52A8\u3002\n\u8BF7<b>\u70B9\u51FB\u5E76\u66F4\u6539\u79FB\u52A8\u65B9\u5411</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151195
    m_Localized: "\u505A\u5F97\u68D2\uFF01\n\u73B0\u5728\u8BF7<b>\u6309\u4F4F\u6307\u9488\u5E76\u62D6\u52A8\u81F3\u6307\u5B9A\u4F4D\u7F6E</b>\uFF0C\n\u5728\u9884\u89C8\u5668\u4E2D\u786E\u8BA4\u52C7\u58EB\u7684\u884C\u52A8\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151196
    m_Localized: "\u52C7\u58EB\u6210\u529F\u907F\u5F00\u4E86\u653B\u51FB\uFF01\n\u901A\u8FC7\u653E\u7F6E\u7247\u6BB5\uFF0C\u5C31\u80FD\u50CF\u8FD9\u6837\u6F14\u51FA\u7684\u52C7\u58EB\u884C\u52A8\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151197
    m_Localized: "\u4E0D\u8FC7\uFF0C\u4E3A\u4E86\u62CD\u51FA\u52C7\u58EB\u5E05\u6C14\u7684\u80DC\u5229\u573A\u9762\uFF0C\n\u5149\u9760\u8EB2\u907F\u662F\u4E0D\u591F\u7684\u3002\u5F97\u53D1\u52A8\u653B\u51FB\u624D\u884C\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151198
    m_Localized: "\u770B\u4E86\u770B\u9644\u4EF6\u540E\u53D1\u73B0\uFF0C\u52C7\u58EB\u53EF\u4EE5\u4F7F\u7528\u7684\u6B66\u5668\u6709\u4E24\u79CD\uFF1A"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151199
    m_Localized: "\u4E00\u79CD\u662F<b>\u65E0\u8BBA\u8EAB\u5728\u4F55\u5904</b>\u90FD\u80FD\u547D\u4E2D\u654C\u4EBA\u7684<b>\u8FDC\u7A0B\u653B\u51FB</b>\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151200
    m_Localized: "\u53E6\u4E00\u79CD\u662F\u53EA\u80FD\u5728<b>\u79BB\u654C\u4EBA\u8F83\u8FD1\u7684\u9635\u5217</b>\u4E2D\u4F7F\u7528\u7684<b>\u8FD1\u6218\u653B\u51FB</b>\u3002\n\u8FD1\u6218\u653B\u51FB\u867D\u7136\u6709\u7A7A\u95F4\u9650\u5236\uFF0C\u4F46\u5A01\u529B\u8981\u5F3A\u5927\u5F97\u591A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151201
    m_Localized: "\u6211\u4EEC\u5148\u8BD5\u7740\u653E\u7F6E\u8FDC\u7A0B\u653B\u51FB\u7247\u6BB5\u5427\u3002\n\u8BF7<b>\u70B9\u51FB\u8FDC\u7A0B\u653B\u51FB\u590D\u9009\u6846</b>\u6765\u67E5\u627E\u60F3\u8981\u7684\u7247\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151202
    m_Localized: "\u8FDC\u7A0B\u653B\u51FB\u65E0\u8BBA\u52C7\u58EB\u5728\u54EA\u90FD\u80FD\u53D1\u52A8\u3002\n\u8BF7\u5C06<b>\u7247\u6BB5\u653E\u7F6E\u5728\u6307\u5B9A\u4F4D\u7F6E</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151203
    m_Localized: "\u54CE\u5440\uFF01\u7CFB\u7EDF\u5224\u5B9A\uFF0C\u8BE5\u64CD\u4F5C\u504F\u79BB\u4E86\u6700\u4F18\u89E3\u3002\n\u4F46\u522B\u62C5\u5FC3\uFF01\u5728\u6B63\u5F0F\u8FD0\u884C\u524D\uFF0C\u60A8\u53EF\u4EE5\u81EA\u7531\u4FEE\u6539\u7247\u6BB5\u5E03\u5C40\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151204
    m_Localized: "\u53EF\u4EE5\u901A\u8FC7<b>\u62D6\u62FD\u6765\u4FEE\u6539\u4F4D\u7F6E</b>\uFF0C\n\u6216\u8005\u901A\u8FC7<b>\u53F3\u51FB\u6765\u53D6\u6D88\u653E\u7F6E</b>\u3002\n\u5229\u7528\u8FD9\u4E9B\u529F\u80FD\u6765<b>\u4FEE\u6539\u8FDC\u7A0B\u7247\u6BB5\u7684\u5E03\u5C40</b>\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151205
    m_Localized: "\u63A5\u4E0B\u6765\u662F\u8FD1\u6218\u653B\u51FB\u3002\n\u8FD1\u6218\u53EA\u80FD\u5728\u6700\u524D\u65B9\u53D1\u52A8\uFF0C\u6240\u4EE5\u9700\u8981\u5411\u524D\u79FB\u52A8\u4E00\u683C\u3002\n\u91CD\u7F6E\u8FC7\u6EE4\u5668\uFF0C<b>\u52FE\u9009\u8FD1\u6218\u653B\u51FB</b>\u6765\u627E\u627E\u7247\u6BB5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151206
    m_Localized: "\u521A\u597D\u6709\u4E00\u4E2A\u79FB\u52A8\u4E0E\u653B\u51FB\u5408\u5728\u4E00\u8D77\u7684\u7247\u6BB5\u5462\uFF01\n<b>\u653E\u7F6E\u5728\u6307\u5B9A\u4F4D\u7F6E</b>\uFF0C\u7136\u540E\u66F4\u6539\u65B9\u5411\u8BA9\u52C7\u58EB\u79FB\u52A8\u5230\u53EF\u653B\u51FB\u7684\u4F4D\u7F6E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151207
    m_Localized: "\u505A\u5F97\u597D\u3002\u4F46\u7167\u8FD9\u6837\u4E0B\u53BB\uFF0C\u4E0B\u4E00\u6CE2\u653B\u51FB\u5C31\u4F1A\u53D7\u4F24\u3002\n\u4F5C\u4E3A\u52C7\u58EB\uFF0C\u8FD9\u53EF\u5C31\u592A\u4E22\u8138\u4E86\u2026\n\u8FD9\u79CD\u65F6\u5019\u5C31\u9700\u8981<b>\u201C\u9632\u5FA1\u201D</b>\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151208
    m_Localized: "\u91CD\u7F6E\u8FC7\u6EE4\u5668\uFF0C<b>\u70B9\u51FB\u9632\u5FA1\u590D\u9009\u6846</b>\u627E\u627E\u770B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151209
    m_Localized: "\u8FD9\u4E2A\u7247\u6BB5\u53EF\u4EE5\u6446\u51FA\u9632\u5FA1\u59FF\u6001\uFF0C\n<b>\u4F7F\u7D27\u968F\u5176\u540E\u7684\u653B\u51FB\u4F24\u5BB3\u65E0\u6548\u5316</b>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151210
