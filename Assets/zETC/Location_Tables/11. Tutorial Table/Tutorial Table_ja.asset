    m_Localized: "\u30D7\u30ED\u30B0\u30E9\u30E0\u306E\u6E96\u5099\u304C\u6574\u3044\u307E\u3057\u305F\u3002\u7DE8\u96C6\u3092\u958B\u59CB\u3067\u304D\u307E\u3059\u3002\n\u6E96\u5099\u304C\u3067\u304D\u305F\u3089<b>\u300C\u7DE8\u96C6\u3092\u958B\u59CB\u3059\u308B\u300D</b>\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
