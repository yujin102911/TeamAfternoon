  m_TableData:
  - m_Id: 10054545956864
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C.\n\u042F
      \u2014 <b>NA1L</b>, \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u043F\u043E
      \u041E\u0421 \u0438 \u0432\u0438\u0434\u0435\u043E\u043C\u043E\u043D\u0442\u0430\u0436\u0443
      \u043E\u0442 Manasoft."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151168
    m_Localized: "\u0412\u0430\u043C \u0441\u043B\u043E\u0436\u043D\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0441 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u043C \u0430\u0443\u0442\u0441\u043E\u0440\u0441\u0438\u043D\u0433\u0430
      \u0432\u0438\u0434\u0435\u043E\u043C\u043E\u043D\u0442\u0430\u0436\u0430?\n\u041D\u0435
      \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C! \u042F \u0448\u0430\u0433
      \u0437\u0430 \u0448\u0430\u0433\u043E\u043C \u0432\u0441\u0451 \u043E\u0431\u044A\u044F\u0441\u043D\u044E.
      \u0418 \u0434\u0430\u0436\u0435 \u043D\u0435 \u043C\u0435\u0447\u0442\u0430\u0439\u0442\u0435
      \u043E \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151169
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E
      \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C
      <b>MSN</b> \u0434\u043B\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F
      \u0442\u0440\u0430\u0444\u0438\u043A\u0430 MSN, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u0433\u043E\u0440\u0434\u0438\u0442\u0441\u044F Manasoft.\n\n*\u042D\u0442\u043E
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 Manasoft."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151170
    m_Localized: "<b>Mana Scroll Network</b> \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      <b>\u043D\u043E\u0432\u043E\u0441\u0442\u0438</b>.\n\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439
      \u0441\u043F\u043E\u0441\u043E\u0431 \u0443\u0437\u043D\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0437\u0430
      \u043D\u043E\u0447\u044C!\n\n*\u042D\u0442\u043E \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0440\u0435\u043A\u043B\u0430\u043C\u0443
      Manasoft."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151171
    m_Localized: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 X, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151172
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C,
      \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u043C \u0432 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0435,
      \u0432\u0430\u0448 \u0430\u0443\u0442\u0441\u043E\u0440\u0441\u0438\u043D\u0433
      \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C\u0441\u044F
      \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      OwlLook."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151173
    m_Localized: "\u0412\u0430\u0443, \u043F\u0438\u0441\u044C\u043C\u043E \u043A\u0430\u043A
      \u0440\u0430\u0437 \u043F\u0440\u0438\u0448\u043B\u043E!\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 <b>OwlLook</b>, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151174
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435, \u043D\u0430\u0436\u0430\u0432
      \u043D\u0430 \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A \u0432
      \u043F\u0430\u043F\u043A\u0435 \xAB\u0412\u0445\u043E\u0434\u044F\u0449\u0438\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151175
    m_Localized: "\u0412 Manasoft \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u0447\u0435\u0441\u0442\u044C
      \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0433\u0435\u0440\u043E\u044F
      \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0441\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u044B \u0434\u043B\u044F
      Worlds Movie Weaver.\n\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0432 \u043F\u0438\u0441\u044C\u043C\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151176
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C
      \u043E\u0434\u0438\u043D \u0437\u0430\u043F\u0440\u043E\u0441 \u043D\u0430
      \u043C\u043E\u043D\u0442\u0430\u0436.\n\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151177
    m_Localized: "\u0412\u0441\u0435 \u0444\u0430\u0439\u043B\u044B, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435
      \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B, \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432\u043E \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0438.\n\u0415\u0441\u043B\u0438
      \u0432\u044B \u0433\u043E\u0442\u043E\u0432\u044B, \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0438 \u043D\u0430\u0447\u043D\u0438\u0442\u0435
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0437\u0430\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435
      \u0432\u0438\u0434\u0435\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151178
    m_Localized: "Manasoft <b>Worlds Movie Weaver</b> \u2014 \u044D\u0442\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E, \u0433\u0434\u0435
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0438 \u043C\u043E\u0433\u0443\u0442
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u0438\u0434\u0435\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151179
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043B\u044E\u0431\u044B\u0435
      \u0432\u0438\u0434\u0435\u043E, \u043A\u0430\u043A\u0438\u0435 \u0437\u0430\u0445\u043E\u0442\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151180
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043C\u044B \u043D\u0430\u0447\u043D\u0435\u043C
      \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E \u043F\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044E
      <b>Worlds Movie Weaver</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151181
    m_Localized: "\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u0433\u043E\u0442\u043E\u0432\u0430,
      \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C
      \u043C\u043E\u043D\u0442\u0430\u0436.\n\u0415\u0441\u043B\u0438 \u0432\u044B
      \u0433\u043E\u0442\u043E\u0432\u044B, \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      <b>\xAB\u041D\u0430\u0447\u0430\u0442\u044C \u043C\u043E\u043D\u0442\u0430\u0436\xBB</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151182
    m_Localized: "\u041D\u0435 \u043F\u0430\u043D\u0438\u043A\u0443\u0439\u0442\u0435.
      \u042F, <b>NA1L</b>, \u0431\u0443\u0434\u0443 \u0441 \u0432\u0430\u043C\u0438!\n\u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C \u0432\u0441\u0451 \u0448\u0430\u0433
      \u0437\u0430 \u0448\u0430\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151183
    m_Localized: "\u042D\u0442\u043E\u0442 \u044D\u043A\u0440\u0430\u043D \u0441\u0432\u0435\u0440\u0445\u0443
      \u2014 \xAB\u041E\u043A\u043D\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430\xBB
      (Viewer).\n\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0435\u043C\u043E\u0435
      \u0432\u0438\u0434\u0435\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151184
    m_Localized: "\u042D\u0442\u043E <b>\u0442\u0430\u0439\u043C\u043B\u0430\u0439\u043D</b>.\n\u041F\u0430\u043D\u0435\u043B\u044C
      \u0434\u043B\u044F \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0432\u0438\u0434\u0435\u043E.\n\u0417\u0434\u0435\u0441\u044C \u0440\u0435\u0448\u0430\u0435\u0442\u0441\u044F
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
      \u0432\u0438\u0434\u0435\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151185
    m_Localized: "\u0412\u0435\u0440\u0445\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u044C
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0446\u0435\u043D\u0442\u0440\u0430
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 <b>\u043A\u043B\u0438\u043F\u044B
      \u0432\u0440\u0430\u0433\u0430</b>, \u0430 \u043D\u0438\u0436\u043D\u044F\u044F
      \u0447\u0430\u0441\u0442\u044C \u2014 <b>\u043A\u043B\u0438\u043F\u044B \u0433\u0435\u0440\u043E\u044F</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151186
    m_Localized: "\u042D\u0442\u043E <b>\u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430</b>.\n\u0417\u0434\u0435\u0441\u044C
      \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0432\u0441\u0435 \u0432\u0430\u0448\u0438
      \u043A\u043B\u0438\u043F\u044B \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151187
    m_Localized: "\"\u0418 \u043D\u0430\u043A\u043E\u043D\u0435\u0446\u2026 \u044D\u0442\u043E
      <b>\u0432\u0438\u0434\u0435\u043E\u043A\u043B\u0438\u043F</b>!\n\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F
      \u0432\u0438\u0434\u0435\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151188
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0442\u044C
      \u043A\u043B\u0438\u043F\u044B \u043D\u0430 \u0442\u0430\u0439\u043C\u043B\u0430\u0439\u043D\u0435
      \u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u0438\u0434\u0435\u043E
      \u0442\u0430\u043A, \u043A\u0430\u043A \u0445\u043E\u0442\u0438\u0442\u0435.\n\u0425\u043E\u0442\u0438\u0442\u0435
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u044F\u043C\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151189
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F
      <b>\u0430\u0442\u0430\u043A\u0430 \u0432\u0440\u0430\u0433\u0430</b>.\n\u0415\u0441\u043B\u0438
      \u043D\u0430\u0432\u0435\u0441\u0442\u0438 \u043C\u044B\u0448\u044C \u043D\u0430
      \u043A\u043B\u0438\u043F \u0430\u0442\u0430\u043A\u0438 \u0432\u0440\u0430\u0433\u0430,
      \u0432 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0449\u0438\u043A\u0435
      \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C,
      \u043A\u0443\u0434\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D
      \u0443\u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151190
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u044B \u0431\u044B
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0443\u0434\u0430\u0440,
      \u043D\u043E\u2026 \u0435\u0441\u043B\u0438 \u0432\u044B \u0433\u0435\u0440\u043E\u0439,
      \u043B\u0443\u0447\u0448\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u043E
      \u0443\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F, \u043F\u0440\u0430\u0432\u0434\u0430?\n\u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0441\u043E\u0437\u0434\u0430\u0434\u0438\u043C \u0441\u0446\u0435\u043D\u0443,
      \u0433\u0434\u0435 \u0433\u0435\u0440\u043E\u0439 \u0438\u0437\u0431\u0435\u0433\u0430\u0435\u0442
      \u0430\u0442\u0430\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151191
    m_Localized: "\u0412 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
      \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438 \u043C\u043E\u0436\u043D\u043E
      \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C <b>\u0444\u0438\u043B\u044C\u0442\u0440</b>,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438 \u043D\u0443\u0436\u043D\u044B\u0439
      \u043A\u043B\u0438\u043F.\n\u041E\u0442\u043C\u0435\u0442\u044C\u0442\u0435
      <b>\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435</b> \u0438 \u043D\u0430\u0439\u0434\u0438\u0442\u0435
      \u043D\u0443\u0436\u043D\u044B\u0439 \u043A\u043B\u0438\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151192
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 <b>\u0431\u043B\u043E\u043A
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0441\u0432\u0435\u0440\u0445\u0443
      \u0438 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0435\u0433\u043E
      \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151193
    m_Localized: "\u0415\u0441\u043B\u0438 \u043A\u043B\u0438\u043F \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u0440\u0430\u0437\u043C\u0435\u0449\u0451\u043D, \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      <b>\u043A\u043D\u043E\u043F\u043A\u0443 \u0441\u0431\u0440\u043E\u0441\u0430
      \u0432\u044B\u0431\u043E\u0440\u0430</b>, \u0447\u0442\u043E\u0431\u044B \u0441\u043D\u044F\u0442\u044C
      \u0444\u0438\u043B\u044C\u0442\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151194
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E!\n\u0411\u043B\u043E\u043A
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
      \u043A\u043B\u0438\u043A\u043D\u0443\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.\n\u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043C \u0433\u0435\u0440\u043E\u044F
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432\u0432\u0435\u0440\u0445.\n<b>\u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151195
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E!\n\u0422\u0435\u043F\u0435\u0440\u044C
      <b>\u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u0435 \u043F\u043E\u043B\u0437\u0443\u043D\u043E\u043A
      \u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0435\u0433\u043E
      \u0434\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0438</b>,
      \u0447\u0442\u043E\u0431\u044B \u0432 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0449\u0438\u043A\u0435
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C, \u043A\u0430\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u0433\u0435\u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151196
    m_Localized: "\u0413\u0435\u0440\u043E\u0439 \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u0443\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043E\u0442 \u0430\u0442\u0430\u043A\u0438!\n\u0421
      \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043B\u0438\u043F\u043E\u0432
      \u043C\u043E\u0436\u043D\u043E \u0442\u0430\u043A \u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0433\u0435\u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151197
    m_Localized: "\u041D\u043E \u0434\u043B\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u043E\u0439
      \u043F\u043E\u0431\u0435\u0434\u044B \u0433\u0435\u0440\u043E\u044F \u043E\u0434\u043D\u043E\u0433\u043E
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
      \u041D\u0443\u0436\u043D\u043E \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151198
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0432 \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0435,
      \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E \u0443 \u0433\u0435\u0440\u043E\u044F
      \u0435\u0441\u0442\u044C \u0434\u0432\u0430 \u0442\u0438\u043F\u0430 \u043E\u0440\u0443\u0436\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043D \u043C\u043E\u0436\u0435\u0442
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151199
    m_Localized: "<b>\u0413\u0434\u0435 \u0431\u044B \u043E\u043D \u043D\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F</b>,
      \u0433\u0435\u0440\u043E\u0439 \u043C\u043E\u0436\u0435\u0442 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E
      \u043F\u043E\u0440\u0430\u0436\u0430\u0442\u044C \u0432\u0440\u0430\u0433\u0430
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E <b>\u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u043E\u0439
      \u0430\u0442\u0430\u043A\u0438</b> \u0438\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151200
    m_Localized: "\u2026\u0438 <b>\u0431\u043B\u0438\u0436\u043D\u044F\u044F \u0430\u0442\u0430\u043A\u0430</b>,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432 <b>\u0440\u044F\u0434\u043E\u043C
      \u0441 \u0432\u0440\u0430\u0433\u043E\u043C</b>.\n\u0411\u043B\u0438\u0436\u043D\u044F\u044F
      \u0430\u0442\u0430\u043A\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0430
      \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E\u043C,
      \u043D\u043E \u0437\u0430\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C \u0433\u043E\u0440\u0430\u0437\u0434\u043E
      \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u0443\u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151201
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043C
      \u043A\u043B\u0438\u043F \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u043E\u0439
      \u0430\u0442\u0430\u043A\u0438.\n<b>\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u0444\u043B\u0430\u0436\u043E\u043A \xAB\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u0430\u044F
      \u0430\u0442\u0430\u043A\u0430\xBB</b>, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438
      \u043D\u0443\u0436\u043D\u044B\u0439 \u043A\u043B\u0438\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151202
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u0430\u044F
      \u0430\u0442\u0430\u043A\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0433\u0435\u0440\u043E\u044E \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
      \u0432 \u043B\u044E\u0431\u043E\u043C \u043C\u0435\u0441\u0442\u0435.\n<b>\u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u0435
      \u043A\u043B\u0438\u043F \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151203
    m_Localized: "\u041E\u0439! \u0421\u0443\u0434\u044F \u043F\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0435,
      \u0432\u044B \u043E\u0442\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u043E\u0442 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0445\u043E\u0434\u0430. \u041D\u043E \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C!
      \u0414\u043E \u0437\u0430\u043F\u0443\u0441\u043A\u0430 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043A\u043B\u0438\u043F\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151204
    m_Localized: "\u041A\u043B\u0438\u043F\u044B \u043C\u043E\u0436\u043D\u043E <b>\u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u044F</b>,
      \u0430 <b>\u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043A\u043B\u0438\u043F
      \u043C\u043E\u0436\u043D\u043E \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043F\u0440\u0430\u0432\u043E\u0433\u043E \u043A\u043B\u0438\u043A\u0430</b>.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u044D\u0442\u0438
      \u0444\u0443\u043D\u043A\u0446\u0438\u0438, \u0447\u0442\u043E\u0431\u044B
      <b>\u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0445 \u043A\u043B\u0438\u043F\u043E\u0432</b>!"
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151205
    m_Localized: "\u0414\u0430\u043B\u0435\u0435 \u2014 \u0431\u043B\u0438\u0436\u043D\u044F\u044F
      \u0430\u0442\u0430\u043A\u0430.\n\u0411\u043B\u0438\u0436\u043D\u044E\u044E
      \u0430\u0442\u0430\u043A\u0443 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043F\u0435\u0440\u0432\u043E\u043C
      \u0440\u044F\u0434\u0443, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0443\u0436\u043D\u043E
      \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430 \u043E\u0434\u043D\u0443
      \u043A\u043B\u0435\u0442\u043A\u0443 \u0432\u043F\u0435\u0440\u0435\u0434.\n<b>\u0421\u0431\u0440\u043E\u0441\u044C\u0442\u0435
      \u0432\u044B\u0431\u043E\u0440 \u0444\u0438\u043B\u044C\u0442\u0440\u0430</b>
      \u0438 <b>\u043E\u0442\u043C\u0435\u0442\u044C\u0442\u0435 \xAB\u0411\u043B\u0438\u0436\u043D\u044F\u044F
      \u0430\u0442\u0430\u043A\u0430\xBB</b>, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438
      \u043D\u0443\u0436\u043D\u044B\u0439 \u043A\u043B\u0438\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151206
    m_Localized: "\u0412\u0430\u0443, \u0435\u0441\u0442\u044C \u043A\u043B\u0438\u043F,
      \u0433\u0434\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0438
      \u0430\u0442\u0430\u043A\u0430 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u044B!\n<b>\u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u0435
      \u0435\u0433\u043E \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435</b> \u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0433\u0435\u0440\u043E\u0439 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F
      \u0432 \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0434\u043B\u044F \u0430\u0442\u0430\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151207
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E!\n\u041D\u043E \u0432
