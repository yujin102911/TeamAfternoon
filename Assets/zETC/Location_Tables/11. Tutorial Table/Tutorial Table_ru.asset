      \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u043E\u0439 \u0430\u0442\u0430\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151220
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E\u2026
      \u0420\u0430\u0437 \u0443\u0436 \u043C\u044B \u043D\u0430 \u044D\u0442\u043E
      \u0440\u0435\u0448\u0438\u043B\u0438\u0441\u044C, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u0441\u044F
      \u0441\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u0430\u043C\u0438!\n<b>\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u0432\u043A\u043B\u0430\u0434\u043A\u0443 \xAB\u0421\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u044B\xBB</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151221
    m_Localized: "<b>\u0421\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u044B</b>
      \u2014 \u044D\u0442\u043E <b>\u043E\u0441\u043E\u0431\u044B\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438</b>,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0435\u043B\u0430\u044E\u0442
      \u043A\u043B\u0438\u043F\u044B \u0431\u043E\u043B\u0435\u0435 \u043A\u0440\u0430\u0441\u043E\u0447\u043D\u044B\u043C\u0438.\n\u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
      \u044D\u0442\u043E \u043F\u043B\u0430\u0442\u043D\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F,
      \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0441\u043E\u0431\u044B\u0442\u0438\u0435, \u0433\u0434\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151222
    m_Localized: "\u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E
      \u044D\u0444\u0444\u0435\u043A\u0442 \xAB\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C\xBB.
      \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C.\n<b>\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u044D\u0444\u0444\u0435\u043A\u0442 \xAB\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C\xBB
      \u0438 \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0435\u0433\u043E
      \u043D\u0430 \u043A\u043B\u0438\u043F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 10054550151223
    m_Localized: "<b>\u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043D\u0430
