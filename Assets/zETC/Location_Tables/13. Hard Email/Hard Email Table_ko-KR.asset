  m_TableData:
  - m_Id: 851488006151
    m_Localized: "\uC774 \uBA54\uC77C\uC740 \uD504\uB85C\uBAA8\uC158 \uAD00\uB828
      \uC548\uB0B4 \uBA54\uC77C \uC218\uC2E0\uC5D0 \uB3D9\uC758\uD55C \uD68C\uC6D0
      \uC804\uC6A9\uC73C\uB85C \uBC1C\uC2E0\uB418\uB294 \uB0B4\uC6A9\uC785\uB2C8\uB2E4.\n\n\uD504\uB85C\uBAA8\uC158
      \uB300\uC0C1: Manasoft Worlds Movie Weaver\uC758 \uBB34\uB8CC \uAC1C\uC778
      \uD68C\uC6D0\n\uD504\uB85C\uBAA8\uC158 \uC77C\uC790: \uC624\uB298\uBD80\uD130
      1\uB2EC\n\uD504\uB85C\uBAA8\uC158 \uB0B4\uC6A9:\n\uC720\uB8CC \uAE30\uB2A5
      \u2018\uD2B9\uC218\uD6A8\uACFC\u2019\uB97C \uD504\uB85C\uBAA8\uC158 \uAE30\uAC04
      \uB3D9\uC548 \uBB34\uB8CC\uB85C \uC0AC\uC6A9!\n\n\uD504\uB85C\uBAA8\uC158 \uB300\uC0C1
      \uAE30\uB2A5\uC740 \uB2E4\uC74C\uACFC \uAC19\uC2B5\uB2C8\uB2E4.\n\uC18D\uB3C4\uAC10
      \uC788\uB294 \uC774\uB3D9\uC5D0 \uC81C\uACA9! <b>\u2018\uC2E0\uC18D\u2019</b>\n<b>\u2018\uB300\uBBF8\uC9C0
      \uC99D\uAC00\u2019</b> \uBE60\uB974\uB2E4, \uAC15\uD558\uB2E4, \uBA4B\uC9C0\uB2E4.\n\uC138\uC0C1\uC744
      \uC804\uC728\uC2DC\uD0A8 \uAC15\uB825\uD55C \uD55C \uBC29 <b>\u2018\uD06C\uB9AC\uD2F0\uCEEC\u2019</b>\n\uC7AC\uAD6C\uB3C5
      \uD3ED\uC8FC! \uC5C5\uACC4 1\uC704! \uC694\uC998 \uC774 \uD6A8\uACFC! <b>\u2018\uAE30\uC808\u2019</b>\n(NEW!)
      \uBB3B\uACA0\uB2E4, \uB0B4\uAC00 \uB9C8\uC655\uC744 \uBB34\uCC0C\uB978 \uC6A9\uC0AC\uC778\uAC00\u2026
      <b>\u2018\uAD11\uD3ED\uD654\u2019</b>\n(NEW!) \uB2E4\uC2DC \uC77C\uC5B4\uB098
      \uC2F8\uC6B8 \uD798\uC744! <b>\u2018\uD68C\uBCF5\u2019</b>\n\nManasoft Worlds
      Movie Weaver\uC758 \uAC00\uACA9\uC744 50% \uD560\uC778 (\uBD80\uAC00\uC138
      \uD3EC\uD568. \uC5F0\uAC04, \uB9E4\uC6D4 \uCCAD\uAD6C)\n\uC774 \uD504\uB85C\uBAA8\uC158\uC5D0
      \uB300\uD55C \uCD94\uAC00 \uC815\uBCF4\uB294 <u>\uC5EC\uAE30</u>\uC5D0\uC11C
      \uCC3E\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<u>\uD560\uC778\uB41C \uAC00\uACA9\uC73C\uB85C
      \uAD6C\uB9E4\uD558\uAE30</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006150
    m_Localized: "[Manasoft Worlds Movie Weaver] 50% \uD2B9\uAC00! \uB9C8\uC655 \uD1A0\uBC8C
      \uAE30\uB150 \uCEA0\uD398\uC778 \uC548\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006149
    m_Localized: "\uB3C5\uD558\uB2E4 \uB3C5\uD574 \uC774\uB798\uB3C4 \uACB0\uD63C\uC744
      \uC548 \uC2DC\uCF1C\uC918?\r\n\uD654\uC774\uD2B8 \uB4DC\uB798\uACE4 \uB9DD\uD1A0
      \uAC04\uC9C0\uB09C\uB2E4\uACE0 \uD640\uB791 \uBE8F\uC5B4\uAC04 \uAC70 \uBCF4\uC168\uC5B4\uC694?
      \uC120\uBB3C\uC740 \uAC1C\uBFD4\r\n\uACF5\uC8FC\uB2D8\uC774 \uD280\uAE40\uC74C\uC2DD
      \uC88B\uC544\uD55C\uB314\uB294\uB370 \uC804 \uAE30\uB984 \uD280\uB294 \uAC70
      \uC2EB\uC5B4\uD55C\uB2E8 \uB9D0\uC774\uC5D0\uC694 \uC694\uB9AC\uD560 \uB54C
      \uC785\uC73C\uB824\uACE0 \uD588\uB294\uB370 \uC5B4\uB5A1\uD558\uB0D0\uACE0\uC694
      \uC544 \uB9DD\uD588\uC2B5\uB2C8\uB2E4 \uC9C4\uC9DC\r\n\uC774\uBC88\uC5D0\uB3C4
      \uC798 \uBD80\uD0C1\uB4DC\uB9AC\uACE0 \uC88B\uC740 \uBC29\uC5B4 \uC804\uBB38
      \uB9C8\uBC95\uC0AC \uC54C\uACE0 \uC788\uC73C\uBA74 \uC18C\uAC1C \uC880 \uC2DC\uCF1C\uC8FC\uC138\uC694\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006148
    m_Localized: "\uB3C5\uD558\uB2E4 \uB3C5\uD574 \r"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006147
    m_Localized: "\uD654\uC774\uD2B8 \uB4DC\uB798\uACE4 \uD138 \uB9CC\uC838\uBCF4\uC168\uC5B4\uC694?\r\n\uC804
      \uB9CC\uC838\uBD04 \uBCF4\uC1A1\uBCF4\uC1A1\uD568\u314B\u314B\r\n\uC7A0 \uB9DB\uC788\uAC8C
      \uC628\uB2E4\uACE0 \uD588\uB2E4\uAC00 \uB9DD\uD1A0\uB3C4 \uD55C \uBC8C \uC5BB\uC5B4\uC654\uC5B4\uC694\r\n\uBD88
      \uACF5\uACA9\uC5D0 \uBA74\uC5ED \uB41C\uB2E4\uB294\uB370 \uC77C\uCC0D \uC92C\uC73C\uBA74
      \uB358\uC804\uC5D0\uC11C \uC5F0\uCD9C \uB354 \uBA4B\uC788\uAC8C \uD588\uC744
      \uB4EF\uC694 \uC9C0\uAE08\uC740 \uC4F8\uBAA8\uB3C4 \uC5C6\uACE0\r\n\uADF8\uB798\uB3C4
      \uC785\uACE0 \uC788\uC73C\uBA74 \uAC04\uC9C0\uB0A9\uB2C8\uB2E4\r\n\uC774\uBC88\uC5D4
      \uCC44\uB110\uC5D0 \uC0AC\uD758 \uB4A4\uC5D0 \uC601\uC0C1 \uC62C\uB77C\uAC04\uB2E4\uACE0
      \uD574\uB1A8\uC73C\uB2C8\uAE4C \uAE30\uD55C \uC9C0\uCF1C\uC8FC\uC2DC\uBA74
      \uB3FC\uC694 4\uC77C \uC548\uC5D0 \uAF2D\uC694\n\n\uCCA8\uBD80 \uD30C\uC77C\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006146
    m_Localized: "\uBCF4\uC1A1\uBCF4\uC1A1"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006145
    m_Localized: "\uC798 \uC9C0\uB0B4\uC168\uB098\uC694? \uC800 \uC6A9\uC0AC\uC785\uB2C8\uB2E4\r\n\r\n\uB358\uC804\uB3C4
      \uB2EB\uD614\uACE0 \uC9C0\uC0C1\uC5D0 \uAC00\uB054 \uB0B4\uB824\uC624\uB294
      \uBAAC\uC2A4\uD130 \uC815\uB3C4\uC57C \uC27D\uAC8C \uC7A1\uC744 \uC218 \uC788\uB294\uB370
      (\uC9C4\uC9DC\uC784)\r\n\uD3B8\uC9D1\uC774 \uC7AC\uBC0C\uC73C\uB2C8\uAE4C \uB2E4\uB4E4
      \uBB34\uD3B8\uC9D1\uBCF8\uC740 \uC548 \uBCFC \uAC83 \uAC19\uACE0 \uC800\uB3C4
      \uAD6C\uB3C5\uC790 \uC720\uC9C0\uD558\uACE0 \uC2F6\uACE0 \uD574\uC11C \uC804\uC18D
      \uACC4\uC57D\uC11C \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4\r\n\uC804\uCC98\uB7FC\uB9CC
      \uD574\uC8FC\uC2DC\uBA74 \uB3FC\uC694\r\n\r\n\uADF8\uB798\uC11C \uB9D0\uC778\uB370
      \uC800 \uACF5\uC8FC\uB2D8\uC774\uB791 \uACB0\uD63C\uD558\uACE0 \uC2F6\uAC70\uB4E0\uC694\r\n\uADFC\uB370
      \uAD6D\uC655\uC774 \uB9C8\uC655 \uCD94\uAC00\uB85C \uC548 \uBB34\uCC0C\uB974\uBA74
      \uACB0\uD63C \uC548 \uC2DC\uCF1C\uC900\uB300\uC694\r\n\uC774\uC0C8\uB07C\uAC00
      \uB354 \uB9C8\uC655\uAC19\uC544\uC694\r\n\uC544\uBB34\uD2BC \uB9C8\uC655\uC774\uB791
      \uC5F0\uB77D\uD574\uC11C \uB2E4\uB978 \uB9C8\uC655 \uC12D\uC678\uD574 \uB480\uAC70\uB4E0\uC694?
      \uB2E4\uB4E4 \uAC1C\uC2E0\uB0A8 \uC9C4\uC9DC\uB85C\r\n\uADFC\uCC98 \uC0AC\uB294
      \uBAAC\uC2A4\uD130\uB4E4\uD55C\uD14C \uB2E4 \uC5F0\uB77D \uB3CC\uB9AC\uB824\uB358
      \uAC70 \uACA8\uC6B0 \uB9C9\uC558\uC5B4\uC694;;\r\n\uC77C\uB2E8 \uBE14\uB8E8
      \uB4DC\uB798\uACE4\uB9CC \uB098\uC624\uB77C\uACE0 \uD588\uB294\uB370 \uB2E4\uC74C
      \uC8FC\uC5D0\uB294 \uB2E4\uB978 \uCE5C\uAD6C\uB4E4\uB3C4 \uBD80\uB974\uB824\uACE0\uC694\r\n\uC774\uBBF8
      \uB2E8\uD1A1\uBC29\uB3C4 \uD320\uC73C\uB2C8\uAE4C \uD3B8\uC9D1\uB9CC \uC798
      \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\n\n\uCCA8\uBD80 \uD30C\uC77C\n[ENTER_LINK]"
