  - m_Id: 851488006144
    m_Localized: "<size=18>\u042D\u0442\u043E \u044F, \u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006145
    m_Localized: "\u041A\u0430\u043A \u0432\u0430\u0448\u0438 \u0434\u0435\u043B\u0430?
      \u042D\u0442\u043E \u044F, \u0413\u0435\u0440\u043E\u0439.\n\n\u041F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435
      \u0437\u0430\u043A\u0440\u044B\u0442\u043E, \u0430 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0441\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C,
      \u043C\u043E\u0436\u043D\u043E \u043B\u0435\u0433\u043A\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
      (\u0447\u0435\u0441\u0442\u043D\u043E).\n\u041C\u043E\u043D\u0442\u0430\u0436
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
      \u0442\u0430\u043A \u0447\u0442\u043E, \u0434\u0443\u043C\u0430\u044E, \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0435\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
      \u0432\u0438\u0434\u0435\u043E. \u042F \u0442\u043E\u0436\u0435 \u0445\u043E\u0447\u0443
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u0434\u043F\u0438\u0441\u0447\u0438\u043A\u043E\u0432,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043D\u0430 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432.\n\u0414\u0435\u043B\u0430\u0439\u0442\u0435
      \u0432\u0441\u0451 \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0440\u0430\u043D\u044C\u0448\u0435.\n\n\u041A\u0441\u0442\u0430\u0442\u0438,
      \u044F \u0445\u043E\u0447\u0443 \u0436\u0435\u043D\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0435.\n\u041D\u043E
      \u043A\u043E\u0440\u043E\u043B\u044C \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442
      \u043C\u0435\u043D\u044F, \u0435\u0441\u043B\u0438 \u044F \u043D\u0435 \u043E\u0434\u043E\u043B\u0435\u044E
      \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u044B\u043A\u0443.\n\u042D\u0442\u043E\u0442 \u0447\u0435\u043B
      \u0441\u0430\u043C \u043F\u043E\u0445\u0443\u0436\u0435 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0438.\n\u0412
      \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435, \u044F
      \u0441\u0432\u044F\u0437\u0430\u043B\u0441\u044F \u0441 \u0442\u0451\u043C\u043D\u044B\u043C
      \u0432\u043B\u0430\u0434\u044B\u043A\u043E\u0439 \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u0434\u0440\u0443\u0433\u0438\u0445 \u0442\u0451\u043C\u043D\u044B\u0445 \u0432\u043B\u0430\u0434\u044B\u043A
      \u0434\u043B\u044F \u0443\u0447\u0430\u0441\u0442\u0438\u044F.\u0412\u0441\u0435
      \u043E\u043D\u0438 \u0432 \u0434\u0438\u043A\u043E\u043C \u0432\u043E\u0441\u0442\u043E\u0440\u0433\u0435.\n\u042F
      \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u043B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0438\u0445, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u044C
      \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432.\n\u041F\u043E\u043A\u0430
      \u0447\u0442\u043E \u043F\u0443\u0441\u0442\u044C \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0421\u0438\u043D\u0438\u0439 \u0434\u0440\u0430\u043A\u043E\u043D,
      \u0430 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043D\u0435\u0434\u0435\u043B\u0435 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043C
      \u0434\u0440\u0443\u0433\u0438\u0445.\n\u0413\u0440\u0443\u043F\u043F\u043E\u0432\u043E\u0439
      \u0447\u0430\u0442 \u0443\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u043D,
      \u0442\u0430\u043A \u0447\u0442\u043E \u043F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043C\u043E\u043D\u0442\u0430\u0436.\n\n\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u0435:\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006146
    m_Localized: "<size=18>\u041F\u0443\u0448\u0438\u0441\u0442\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006147
    m_Localized: "\u0412\u044B \u0442\u0440\u043E\u0433\u0430\u043B\u0438 \u0448\u0435\u0440\u0441\u0442\u044C
      \u0411\u0435\u043B\u043E\u0433\u043E \u0434\u0440\u0430\u043A\u043E\u043D\u0430?\n\u042F
      \u0442\u0440\u043E\u0433\u0430\u043B \u2014 \u043E\u043D\u0430 \u0442\u0430\u043A\u0430\u044F
      \u043F\u0443\u0448\u0438\u0441\u0442\u0430\u044F, \u0445\u0430\u0445\u0430.\n\u0413\u043E\u0432\u043E\u0440\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0441\u043E\u043D \u043F\u0440\u0438\u0434\u0451\u0442
      \u0441\u043B\u0430\u0434\u043A\u043E, \u0430 \u044F \u0435\u0449\u0451 \u0438
      \u043F\u043B\u0430\u0449 \u043F\u043E\u043B\u0443\u0447\u0438\u043B.\n\u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0447\u0442\u043E \u043E\u043D \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
      \u043E\u0442 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0445 \u0430\u0442\u0430\u043A
      \u2014 \u0435\u0441\u043B\u0438 \u0431\u044B \u0434\u0430\u043B\u0438 \u0435\u0433\u043E
      \u0440\u0430\u043D\u044C\u0448\u0435, \u0441\u044A\u0451\u043C\u043A\u0430
      \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430
      \u0431\u044B \u043A\u0440\u0443\u0447\u0435. \u0421\u0435\u0439\u0447\u0430\u0441
      \u0443\u0436\u0435 \u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F,
      \u043D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u0442\u0438\u043B\u044C\u043D\u043E
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0430\u0434\u0435\u0442.\n\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437
      \u0432\u0438\u0434\u0435\u043E \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043A\u0430\u043D\u0430\u043B\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438 \u0434\u043D\u044F, \u0442\u0430\u043A \u0447\u0442\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0439\u0442\u0435
      \u0441\u0440\u043E\u043A\u0438 \u2014 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 4 \u0434\u043D\u0435\u0439.\n\n\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u0435:\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006148
    m_Localized: "<size=18>\u041D\u0443 \u0438 \u0432\u0440\u0435\u0434\u043D\u044B\u0439
      \u0436\u0435 \u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006149
    m_Localized: "\u041D\u0443 \u0438 \u0432\u0440\u0435\u0434\u043D\u044B\u0439
      \u0436\u0435 \u043E\u043D \u2014 \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043D\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u044E\u0442 \u0436\u0435\u043D\u0438\u0442\u044C\u0441\u044F?\n\u0412\u0438\u0434\u0435\u043B\u0438,
      \u043A\u0430\u043A \u043E\u043D\u0438 \u043E\u0442\u043E\u0431\u0440\u0430\u043B\u0438
      \u0443 \u043C\u0435\u043D\u044F \u043F\u043B\u0430\u0449 \u0411\u0435\u043B\u043E\u0433\u043E
      \u0434\u0440\u0430\u043A\u043E\u043D\u0430? \u0413\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043E \u043F\u043E\u0434\u0430\u0440\u043A\u0430\u0445 \u0432\u043E\u043E\u0431\u0449\u0435
      \u0441\u043C\u0435\u0448\u043D\u043E.\n\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430
      \u043B\u044E\u0431\u0438\u0442 \u0436\u0430\u0440\u0435\u043D\u0443\u044E \u0435\u0434\u0443,
      \u0430 \u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u043D\u043E\u0448\u0443
      \u0431\u0440\u044B\u0437\u0433\u0438 \u043C\u0430\u0441\u043B\u0430. \u0425\u043E\u0442\u0435\u043B
      \u043D\u0430\u0434\u0435\u0442\u044C \u043F\u043B\u0430\u0449 \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0442\u043E\u0432\u043A\u0438,
      \u0430 \u0442\u0435\u043F\u0435\u0440\u044C \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C\u2026
      \u0410\u0445, \u0432\u0441\u0451 \u043F\u0440\u043E\u043F\u0430\u043B\u043E,
      \u0447\u0435\u0441\u0442\u043D\u043E.\n\u0418 \u0432 \u044D\u0442\u043E\u0442
      \u0440\u0430\u0437 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E
      \u043D\u0430 \u0432\u0430\u0441. \u0415\u0441\u043B\u0438 \u0437\u043D\u0430\u0435\u0442\u0435
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0433\u043E
      \u043C\u0430\u0433\u0430, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0435\u0433\u043E
      \u043C\u043D\u0435.\n\n\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u0435:\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006150
    m_Localized: "<size=18>[WMW] \u0423\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435
      \u043E \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u0438 \u0432 \u0447\u0435\u0441\u0442\u044C
      \u0438\u0441\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u044F \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u044B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 851488006151
    m_Localized: "\u042D\u0442\u043E \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E
      \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0447\u043B\u0435\u043D\u0430\u043C, \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0432\u0448\u0438\u043C\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
      \u043F\u0438\u0441\u0435\u043C \u043E \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u044F\u0445.\n\n\u0426\u0435\u043B\u0435\u0432\u0430\u044F
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044F \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:
      \u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435 \u043B\u0438\u0447\u043D\u044B\u0435
      \u0447\u043B\u0435\u043D\u044B Manasoft Worlds Movie Weaver\n\u0421\u0440\u043E\u043A
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:
      \u0441 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E
      \u0434\u043D\u044F \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 1 \u043C\u0435\u0441\u044F\u0446\u0430\n\u0421\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
      \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:\n\u041F\u043B\u0430\u0442\u043D\u0430\u044F
      \u0444\u0443\u043D\u043A\u0446\u0438\u044F \xAB\u0421\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u044B\xBB
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u043C\u043E-\u043F\u0435\u0440\u0438\u043E\u0434\u0430!\n\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438,
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u0432 \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:\n\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0439! \xAB\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C\xBB\n\xAB\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435
      \u0443\u0440\u043E\u043D\u0430\xBB \u2014 \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0441\u0438\u043B\u044C\u043D\u043E, \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u043E.\n\u041C\u043E\u0449\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440, \u043F\u043E\u0442\u0440\u044F\u0441\u0448\u0438\u0439
      \u043C\u0438\u0440: \xAB\u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439\xBB\n\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0435
      \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0438 \u0437\u0430\u0448\u043A\u0430\u043B\u0438\u0432\u0430\u044E\u0442!
      \u041B\u0438\u0434\u0435\u0440 \u043E\u0442\u0440\u0430\u0441\u043B\u0438!
      \u0421\u0435\u0439\u0447\u0430\u0441 \u044D\u0442\u043E\u0442 \u044D\u0444\u0444\u0435\u043A\u0442:
      \xAB\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435\xBB\n(NEW!) \u0421\u043A\u0430\u0436\u0443
      \u043F\u0440\u044F\u043C\u043E: \u044F \u0442\u043E\u0442 \u0433\u0435\u0440\u043E\u0439,
      \u0447\u0442\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u044B\u043A\u0443\u2026 \xAB\u042F\u0440\u043E\u0441\u0442\u044C\xBB\n(NEW!)
      \u0412\u0441\u0442\u0430\u043D\u044C \u0441\u043D\u043E\u0432\u0430, \u0447\u0442\u043E\u0431\u044B
      \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F! \xAB\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435\xBB\n\n\u0421\u043A\u0438\u0434\u043A\u0430
      50% \u043D\u0430 Manasoft Worlds Movie Weaver (\u0441 \u041D\u0414\u0421, \u0435\u0436\u0435\u0433\u043E\u0434\u043D\u0430\u044F
      \u0438\u043B\u0438 \u0435\u0436\u0435\u043C\u0435\u0441\u044F\u0447\u043D\u0430\u044F
      \u043E\u043F\u043B\u0430\u0442\u0430)\n\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 <u>\u0437\u0434\u0435\u0441\u044C</u>.\n\n<u>\u041A\u0443\u043F\u0438\u0442\u044C
      \u043F\u043E \u0441\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439 \u0446\u0435\u043D\u0435</u>"
