  m_SharedData: {fileID: 11400000, guid: 2db70b72201b43c4ca84b5199e6cc4e0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 27013668864
    m_Localized: " \uB9C8\uC655, 7\uC77C \uB4A4 \uACF5\uC8FC \uB0A9\uCE58 \uC608\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028992
    m_Localized: "\uAE08\uC77C \uB9C8\uC655\uC774 SNS\uB97C \uD1B5\uD574 \u201C\uACF5\uC8FC\uB97C
      7\uC77C \uB4A4 \uB0A9\uCE58\uD560 \uAC83\u201D\uC774\uB77C\uACE0 \uC120\uC5B8\uD588\uB2E4.
      \uD568\uAED8 \uC5C5\uB85C\uB4DC \uB41C \uC0AC\uC9C4\uC5D0\uB294 \u2018\uADF8\uB0E5
      \uC6B0\uB9AC \uB2E4 \uAC19\uC774 \uC2EC\uC2EC\uD558\uC790, \uC544\uBB34\uB3C4
      \uC7AC\uBC0C\uC9C0 \uB9D0\uC790\u2019 \uB77C\uB294 \uBB38\uAD6C\uAC00 \uC801\uD600
      \uD654\uC81C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27043028993
    m_Localized: " \uAD6D\uC655, \uC6A9\uC0AC \uC120\uBC1C\uD574 \uB9C8\uC655\uC131
      \uD30C\uACAC \uACB0\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028994
    m_Localized: "\uAD6D\uC655\uC740 \uAE08\uC77C \uC548\uC73C\uB85C \uB9C8\uC655\uC744
      \uBB34\uCC0C\uB97C \uC6A9\uC0AC\uB97C \uC9C1\uC811 \uC120\uBC1C\uD55C \uD6C4
      \uB9C8\uC655\uC131\uC5D0 \uD30C\uACAC\uD558\uACA0\uB2E4\uACE0 \uBC1C\uD45C\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27043028995
    m_Localized: " \uBC31\uC791\uAC00 \uC790\uC81C\uAC00 \uC6A9\uC0AC\uB85C \uCD5C\uC885
      \uC120\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028996
    m_Localized: "\uAD6D\uC655\uC740 \u201C\uBC31\uC791\uC774 \uC2ED\uC5EC\uB144
      \uC804 \uC790\uC2DD\uC758 \uAC80\uC220\uC774 \uB6F0\uC5B4\uB098\uB2E4\uACE0
      \uC790\uB791\uD55C \uBC14 \uC788\uB2E4\u201D\uBA74\uC11C \uC774\uC720\uB97C
      \uBC1D\uD614\uB2E4. \uC774\uD6C4 \uC6A9\uC0AC\uC758 \uD589\uBCF4\uB294 <\uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30>\uB77C\uB294 \uC81C\uBAA9\uC73C\uB85C \uC775\uC77C\uBD80\uD130
      \uC6A9\uC0AC \uAC1C\uC778 \uCC44\uB110\uC5D0 \uACF5\uAC1C\uB420 \uC608\uC815\uC774\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 27043028997
    m_Localized: " [\uC27D\uAC8C \uBCF4\uB294 \uC2DC\uC0AC\uC0C1\uC2DD] \uB9C8\uC655\uC131\uC758
      \uAD6C\uC870\uB294 \uC5B4\uB5BB\uAC8C \uC774\uB8E8\uC5B4\uC838 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028998
    m_Localized: "300\uB144 \uAC04 \uB9C8\uC655\uC131\uC5D0 \uB4E4\uC5B4\uAC04 \uC774\uB294
      \uC5C6\uC9C0\uB9CC, \uAD6C\uC870\uB294 \uACE0\uBB38\uC11C\uB85C \uC804\uD574\uC9C4\uB2E4.
      \uB9C8\uC655\uC131\uC740 5\uCE35 \uB358\uC804\uACFC \uC5F0\uACB0\uB418\uC5B4
      \uC788\uC73C\uBA70, \uAC01 \uCE35\uB9C8\uB2E4 \uBAAC\uC2A4\uD130\uAC00 \uC11C\uC2DD\uD55C\uB2E4.
      1\uCE35\uC740 \uC774\uBE14\uC544\uC774, 2\uCE35\uC740 \uC0B4\uC778\uBC84\uC12F,
      3\uCE35\uC740 \uACE0\uBE14\uB9B0, 4\uCE35\uC740 \uACE8\uB818\uC73C\uB85C\u2026\u2026. "
    m_Metadata:
      m_Items: []
  - m_Id: 27043028999
    m_Localized: " \uC6A9\uC0AC\uC758 \uB208\uBD80\uC2E0 \uCCAB \uD65C\uC57D! <\uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30> 1\uD654 \uC774\uBE14\uC544\uC774 \uD3B8 \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029000
    m_Localized: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uD558\uB8E8 \uB9CC\uC5D0 \uB358\uC804
      1\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uAD6D\uC655\uC740 \uAE30\uC068\uC758
      \uB208\uBB3C\uC744 \uD758\uB9AC\uBA70 \u201C\uC628 \uBC31\uC131\uC774 \uD65C\uC57D\uC744
      \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uB2E4. \uACF5\uC8FC\uC640 \uC655\uAD6D\uC744
      \uC9C0\uCF1C\uB2EC\uB77C\u201D \uB77C\uB294 \uB9D0\uC744 \uB0A8\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27043029001
    m_Localized: " [MSN \uC5EC\uB860\uC870\uC0AC] \u2018\uACF5\uC8FC\uAC00 \uC0B6\uC5D0
      \uC758\uC9C0\uAC00 \uB41C\uB2E4\u2019\uB294 \uBC31\uC131 80%\uC5D0 \uB2EC\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029002
    m_Localized: "\uBC31\uC131 \uB300\uC0C1\uC73C\uB85C \uC2DC\uD589\uB41C \uC5EC\uB860\uC870\uC0AC\uC5D0\uC11C
      \u2018\uACF5\uC8FC\uAC00 \uC0B6\uC5D0 \uC758\uC9C0\uAC00 \uB41C\uB2E4\u2019\uB294
      \uC758\uACAC\uC774 80%, \u2018\uACF5\uC8FC\uAC00 \uB098\uB77C\uC758 \uBBF8\uB798\u2019\uB294
      \uC758\uACAC\uC774 70%\uC5D0 \uC721\uBC15\uD588\uB2E4. \uC8FC\uAC04 \uC778\uAE30\uC791
      \uC21C\uC704\uC5D0\uB294 \u300A\uACF5\uC8FC\uB2D8\uC774 \uC5C6\uC5B4\uC120
      \uC548 \uB418\uB294 50\uAC00\uC9C0 \uC774\uC720\u300B\uAC00 \uC624\uB974\uAE30\uB3C4
      \uD558\uBA74\uC11C\u2026\u2026. "
    m_Metadata:
      m_Items: []
  - m_Id: 27043029003
    m_Localized: " [\uC9C4\uC2E4 \uD639\uC740 \uAC70\uC9D3] \uB9C8\uC871\uC740 \uBAA8\uB450
      \uAC70\uC9D3\uB9D0\uC7C1\uC774\uB2E4?"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029004
    m_Localized: "\uB9C8\uC871\uC758 \uB9D0 \uC911 \uD314 \uD560\uC740 \uAC70\uC9D3\uB9D0\uC774\uB77C\uB294
      \uC18D\uB2F4\uC774 \uC788\uB2E4. \uACFC\uC5F0 \uC0AC\uC2E4\uC77C\uAE4C? \uC81C\uC791\uB144
      \uD1B5\uACC4\uB85C \uBD24\uC744 \uB54C, \uB9C8\uC871\uC758 \uBC1C\uC5B8\uC740
      \uC2E4\uC81C\uBCF4\uB2E4 \uC0C1\uB2F9\uD788 \uACFC\uC7A5\uB418\uC5B4 \uC788\uC5C8\uB2E4\uACE0
      \uD55C\uB2E4. \uD558\uC9C0\uB9CC \uC774\uB294 \uB9C8\uC871\uC758 \uD2B9\uC131\uACFC
      \uAD00\uB828\uB41C \uAC83\uC73C\uB85C\u2026\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 27043029005
    m_Localized: " \uC6A9\uC0AC\uAC00 \uAC70\uBA38\uC954 \uC2B9\uB9AC\uC758 \uB9DB!
      <\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30> 2\uD654 \uC0B4\uC778\uBC84\uC12F \uD3B8
      \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029006
    m_Localized: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uC0AC\uD758 \uB9CC\uC5D0 \uB358\uC804
      2\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uC6A9\uC0AC\uB294 \uCC98\uCE58\uD55C
      \uC0B4\uC778\uBC84\uC12F\uC744 \uBA39\uC73C\uBA74\uC11C \u2018\uBC84\uC12F\uC774
      \uBC1C\uD6A8\uB41C \uAC83\u2019, \u2018\uC6C0\uC9C1\uC784\uC774 \uB9CE\uC740
      \uBC1C \uBD80\uBD84\uC774 \uD2B9\uD788 \uB9DB\uC788\uB2E4\u2019\uB294 \uD3C9\uC744
      \uB0A8\uACBC\uB2E4. \uC774\uB85C \uC778\uD574 \uC77C\uBC18 \uBC84\uC12F\uC758
      \uC2DC\uC7A5 \uAC00\uACA9\uC774 \uB450 \uBC30\uB85C \uB6F0\uBA74\uC11C\u2026\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 27043029007
    m_Localized: " \uB179\uC544\uB0B4\uB9B0 \uC0B4\uC778\uBC84\uC12F, \uC815\uB9D0
      \uBC1C\uD6A8\uC2DD\uD488\uC778\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417600
    m_Localized: "\uC77C\uBC18\uC801\uC73C\uB85C \uD478\uB978\uC0C9\uC73C\uB85C \uBB34\uB978
      \uC2DD\uD488\uC740 \uBA39\uC9C0 \uC54A\uB294 \uAC8C \uC0C1\uC2DD\uC774\uB2E4.
      \uADF8\uB7EC\uB098 \uC6A9\uC0AC\uB294 \uC9C0\uB09C <\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30>\uC5D0\uC11C
      \uC0B4\uC778\uBC84\uC12F\uC744 \uC12D\uCDE8\uD558\uACE0\uB3C4 \uC774\uC0C1\uC774
      \uC5C6\uC5C8\uB2E4. \uC5F0\uAD6C\uC9C4\uC740 \uC0B4\uC778\uBC84\uC12F\uC758
      \uAD6C\uC870\uB97C \uBD84\uC11D\uD574 \uC77C\uBC18\uC778\uC774 \uC12D\uCDE8\uD574\uB3C4
      \uC778\uCCB4\uC5D0 \uBB34\uD574\uD55C\uC9C0 \uC54C\uC544\uBCF4\uACE0\uC790
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417601
    m_Localized: " \uB358\uC804 \uC548\uC5D0\uC11C \uC778\uD130\uB137 \uD655\uC778
      \uAC00\uB2A5\uD55C \uC774\uC720, \uBC14\uB85C \u2018\uC774\uAC70\u2019\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417602
    m_Localized: "\uC6A9\uC0AC\uAC00 \uB358\uC804 \uC548\uC5D0\uC11C\uB3C4 \uC2E4\uC2DC\uAC04
      \uC5C5\uB85C\uB4DC \uAC00\uB2A5\uD55C \uC774\uC720\u2197\u2197 \uB358\uC804
      2\uCE35\uAE4C\uC9C0 \uC2E4\uC2DC\uAC04 \uC911.\uACC4\u2197\u2197 \uB358\uC804
      3\uCE35\uBD80\uD130 \uC778\uD130\uB137 \uB04A\uAE40 \u2018\uC774\uAC78\u2019\uB85C
      \uD574\uACB0\uD558\uC138\uC694\u2197\u2197 \uC6A9\uC0AC\uB300\uB9C8\uC655 \uBC30\uD305\uAE08
      \uCC98\uC74C 20%\u2197\u2197 \uC2A4\uD53C\uB4DC\uD55C {\uCD9C \uAE08} \uC18D\uB3C4\u2197\u2197"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417603
    m_Localized: "\uBA48\uCD94\uC9C0 \uC54A\uB294 \uC6A9\uC0AC! <\uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30> 3\uD654 \uACE0\uBE14\uB9B0 \uD3B8 \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417604
    m_Localized: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uC774\uD2C0 \uB9CC\uC5D0 \uB358\uC804
      3\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uC0AC\uAC01\uC5D0\uC11C \uB36E\uCCD0\uC624\uB358
      \uACE0\uBE14\uB9B0\uC758 \uB450\uAC1C\uACE8\uC744 \uC9C1\uACA9\uD574 \uBD80\uC218\uB294
      \uC7A5\uBA74\uC774 \uD2B9\uD788 \uBC31\uD2F0\uC98C\uB4E4 \uC0AC\uC774\uC5D0
      \uD070 \uC778\uAE30\uB97C \uB04C\uC5B4, \uC6A9\uC0AC \uC9C0\uC9C0\uC790 \uBAA8\uC784
      \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\u2019\uC774 \uC870\uC9C1\uB418\uB294
      \uB4F1\uC758 \uC6C0\uC9C1\uC784\uC774 \uC77C\uC5B4\uB098\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417605
    m_Localized: "\uC6A9\uC0AC \uCC44\uB110, \uAD6C\uB3C5\uC790 100\uB9CC\uBA85 \uB2EC\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417606
    m_Localized: "\uC6A9\uC0AC\uAC00 \uBB34\uC0AC\uD788 \uADC0\uD658\uD560 \uACBD\uC6B0
      \uD6C8\uC7A5 \uC218\uC5EC\uC2DD\uC5D0\uC11C \uC624\uB9AC\uD560\uCF58 \uBC84\uD2BC
      \uB610\uD55C \uC218\uC5EC\uB420 \uC608\uC815\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417607
    m_Localized: "\uC5B4\uB824\uC6B4 MZ \uC138\uB300 \uC5B8\uC5B4\u2026 \uC18C\uD1B5\uD558\uAE30
      \uC704\uD55C \uD544\uC218 \uC6A9\uC5B4 \u20185\uAC00\uC9C0\u2019 "
    m_Metadata:
      m_Items: []
  - m_Id: 27051417608
    m_Localized: "MZ(Magic-Z) \uC138\uB300\uB294 \uAE30\uC874 \uC138\uB300\uC640
      \uB2E4\uB974\uAC8C \uB9C8\uBC95 \uC601\uCC3D\uC744 \uBB35\uC74C\uC73C\uB85C
      \uD558\uAC70\uB098 \uC904\uC784\uB9D0, \uC720\uD589\uC5B4\uB85C \uC0AC\uC6A9\uD558\uB294
      \uACBD\uD5A5\uC744 \uBCF4\uC778\uB2E4. \uCCAB\uBC88\uC9F8 \uD544\uC218 \uC6A9\uC5B4:
      \uB3C5\uC2EC\uC220. MZ \uC138\uB300\uC758 \uB9C8\uC74C\uC744 \uC9C1\uC811 \uD655\uC778\uD568\uC73C\uB85C\uC368
      \uBD88\uD544\uC694\uD55C \uC624\uD574\uB97C \uC904\uC77C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417609
    m_Localized: "\uB9C8\uC655, \uC6A9\uC0AC\uC5D0\uAC8C \uC74C\uC131 \uD3B8\uC9C0
      \uB0A8\uACA8"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417610
    m_Localized: "MSN\uC5D0\uC11C \uC6B8\uC74C\uC18C\uB9AC\uB97C \uD574\uC11D\uD55C
      \uACB0\uACFC \u201C\uD604\uC7AC \uC18D\uB3C4\uB77C\uBA74 \uC624\uB298 \uC6A9\uC0AC\uAC00
      \uB9C8\uC655\uC131\uC5D0 \uB3C4\uCC29\uD558\uACA0\uC73C\uB098, \uB9CC\uC804\uC758
      \uC0C1\uD0DC\uB85C \uC2F8\uC6CC\uC8FC\uAE38 \uBC14\uB77C\uAE30 \uB54C\uBB38\uC5D0
      5\uCE35\uC758 \uACC4\uB2E8\uC744 \uBB34\uB108\uB728\uB838\uB2E4. \uC6A9\uC0AC\uB294
      \uD558\uB8E8 \uD734\uC2DD\uD558\uACE0 \uBC14\uB85C \uC62C\uB77C\uC624\uB77C\u201D\uB294
      \uBA54\uC2DC\uC9C0\uB97C \uC6A9\uC0AC\uC5D0\uAC8C \uC804\uD55C \uAC83\uC73C\uB85C
      \uCD94\uC815\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417611
    m_Localized: "\uB3CC\uBCF4\uB2E4 \uAC15\uD55C \uC758\uC9C0\uC758 \uC6A9\uC0AC!
      <\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30> 4\uD654 \uACE8\uB818 \uD3B8 \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417612
    m_Localized: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uB098\uD758 \uB9CC\uC5D0 \uB358\uC804
      4\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uC774\uBC88\uC5D0 \uC6A9\uC0AC\uAC00
      \uBB3C\uB9AC\uCE5C \uACE8\uB818\uC740 \uC774\uC804\uC758 \uBAAC\uC2A4\uD130\uC640
      \uB2EC\uB9AC \uB3CC\uC5D0 \uD2B9\uC218\uD55C \uB9C8\uBC95\uC744 \uAC78\uC5B4
      \uB9CC\uB4DC\uB294 \uC778\uACF5 \uC0DD\uBA85\uCCB4\uB2E4. \uC655\uAD6D\uC5D0\uC11C\uB294
      \uC790\uACA9\uC774 \uC788\uB294 \uB9C8\uBC95\uC0AC\uB4E4\uB9CC \uC81C\uC791\uD560
      \uC218 \uC788\uC73C\uBBC0\uB85C \uD568\uBD80\uB85C \uB530\uB77C\uD558\uB294
      \uAC83\uC740 \uAE08\uBB3C."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417613
    m_Localized: "\u201C\uC6A9\uC0AC, \uC9C4\uC9DC \uC6A9\uC0AC \uB9DE\uB098\u201D
      \uB9C8\uC655\uC131 \uB3C4\uC804\uAE30 \u2018\uD569\uC131\u2019 \uC758\uD639
      \uBD88\uAC70\uC838"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417614
    m_Localized: "\uD0C8\uC804\uD55C \uB9C8\uC871 A\uC528\uAC00 <\uC6A9\uC0AC, \uC800\uAC70
      \uB2E4 \uCF54\uC2A4\uD504\uB819\uB2C8\uB2E4>\uB77C\uB294 \uC601\uC0C1\uC744
      \uC62C\uB824 \uD654\uC81C\uB2E4. \uC601\uC0C1\uC5D0\uB294 \u201C\uCE7C\uC744
      \uD718\uB450\uB974\uB294 \uC7A5\uBA74\uC5D0\uC11C \uC190\uAC00\uB77D\uC774
      6\uAC1C\u201D \uB4F1\uC758 \uB0B4\uC6A9\uC774 \uB2F4\uACBC\uB2E4. \u2018\uC6A9\uC0AC\uC758
      \uACF5\uC8FC\uB4E4\u2019\uC740 \uD5C8\uC704\uC0AC\uC2E4 \uC720\uD3EC \uD610\uC758\uB85C
      \uAC15\uACBD \uB300\uC751\uD560 \uAC83\uC774\uB77C\uACE0 \uBC1D\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417615
    m_Localized: " \uC6A9\uC0AC, \uACFC\uC5F0 \uC9C4\uC9DC \uC601\uC6C5 \uB418\uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417616
    m_Localized: "\uB9C8\uC655\uC774 \uBCF4\uB0B8 \uC74C\uC131 \uD3B8\uC9C0\uC758
      \uB0B4\uC6A9\uC774 \uAC70\uC9D3\uB9D0\uC784\uC774 \uBC1D\uD600\uC84C\uB2E4.
      \uBC31\uC131 \uB300\uBD80\uBD84\uC774 \uC601\uC0C1\uC744 \uC2DC\uCCAD\uD558\uACE0
      \uB098\uC11C\uC57C \uC774\uB97C \uC54C\uAC8C \uB3FC \uD070 \uCDA9\uACA9\uC744
      \uC8FC\uACE0 \uC788\uB2E4. \uC6A9\uC0AC\uC758 \uC0DD\uC0AC\uAC00 \uBD88\uD22C\uBA85\uD574\uC9C0\uBA74\uC11C
      <\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30>\uC758 \uC5C5\uB85C\uB4DC \uC77C\uC815\uC5D0
      \uB9CE\uC740 \uAD00\uC2EC\uC774 \uBAA8\uC544\uC9C0\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417617
    m_Localized: " \uACF5\uC8FC, \uC6A9\uC0AC\uB791 \uACB0\uD63C\uD558\uB098\u2026
      \u201C\uC0AC\uB78C\uC744 \uBD10\uC57C \uD560 \uC77C\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417618
    m_Localized: "\uACF5\uC8FC\uB97C \uAD6C\uD55C \uC6A9\uC0AC\uB294 \uC655\uBE44\uB098
      \uAD6D\uC11C \uC790\uB9AC\uC5D0 \uC624\uB974\uB294 \uAC83\uC774 \uC804\uD1B5\uC774\uB2E4.
      \uADF8\uB7EC\uB098 \uD604\uB300\uC758 \uC6A9\uC0AC\uC5D0\uAC8C\uB3C4 \uC774\uB7EC\uD55C
      \uAD00\uC2B5\uC744 \uC801\uC6A9\uC2DC\uCF1C\uC57C \uD558\uB294\uAC00\uC5D0\uB294
      \uB17C\uC7C1\uC774 \uC624\uAC00\uACE0 \uC788\uB2E4. \uD55C\uD3B8 \uC6A9\uC0AC\uB294
      \uC9C0\uB09C 3\uC77C, \uD569\uC131 \uC758\uD639\uC774 \uBD88\uAC70\uC9C4 \uC774\uD6C4\uB85C
      \uC9C0\uAE08\uAE4C\uC9C0 \uD574\uBA85\uC744 \uB0B4\uB193\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417619
    m_Localized: " \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\u2019, \uC774\uB984
      \uBC14\uB00C\uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417620
    m_Localized: "\uC6A9\uC0AC \uC9C0\uC9C0\uC790 \uBAA8\uC784 \u2018\uC6A9\uC0AC\uC758
      \uACF5\uC8FC\uB4E4\u2019\uC774 \uAC1C\uBA85\uB420 \uC704\uAE30\uB2E4. \uBC95\uC6D0\uC740
      \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\u2019 \uBA85\uCE6D\uC774 \uC0AC\uD68C\uC5D0
      \uD63C\uB780\uC744 \uC904 \uC6B0\uB824\uAC00 \uC788\uC5B4 \uCC98\uBC8C\uB420
      \uC18C\uC9C0\uAC00 \uC788\uB2E4\uACE0 \uBC1D\uD614\uB2E4. \uD604\uC7AC\uAE4C\uC9C0
      \uBCC0\uACBD\uD560 \uBA85\uCE6D\uC73C\uB85C \uB17C\uC758\uB41C \uAC83\uC740
      \u2018\uC6A9\uC0AC\uC758 \uBB34\uC218\uB9AC\uB4E4\u2019\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
