      m_Items: []
  - m_Id: 6933811281927
    m_Localized: "\"\u300C\u9B54\u529B\u30BC\u30ED\u3001\u501F\u91D1100\u5104\u3002\u983C\u308C\u308B\u306E\u306F\u9A19\u3055\u308C\u3066\u8CB7\u3063\u305F\u30B5\u30A4\u30B3\u30ED\u3060\u3051\uFF01\u300D\n\u300ENo
      Mana, Just Dice\u300F\u306F\u3001\u501F\u91D1\u307E\u307F\u308C\u306E\u843D\u3061\u3053\u307C\u308C\u9B54\u5973\u306B\u3088\u308B\u3001\u30AE\u30EA\u30AE\u30EA\u306E\u751F\u5B58\u5287\u3092\u63CF\u3044\u305F\u30BF\u30FC\u30F3\u5236\u6226\u8853\u30ED\u30FC\u30B0\u30E9\u30A4\u30AF\u3067\u3059\u3002\u9B54\u6CD5\u306F\u304A\u308D\u304B\u3001\u81C6\u75C5\u3059\u304E\u3066\u4E00\u6B69\u8E0F\u307F\u51FA\u3059\u306E\u3055\u3048\u30B5\u30A4\u30B3\u30ED\u304C\u5FC5\u8981\u306A\u5F7C\u5973\u3092\u5C0E\u3044\u3066\u3042\u3052\u3066\u304F\u3060\u3055\u3044\uFF01\u9650\u3089\u308C\u305F\u30B5\u30A4\u30B3\u30ED\u3092\u300C\u79FB\u52D5\u300D\u3068\u300C\u653B\u6483\u300D\u306B\u6226\u7565\u7684\u306B\u914D\u5206\u3057\u3066\u4E0D\u904B\u3092\u8986\u3057\u3001\u9858\u3044\u3092\u53F6\u3048\u308B\u4F1D\u8AAC\u306E\u30B9\u30AF\u30ED\u30FC\u30EB\u3092\u52DD\u3061\u53D6\u308A\u307E\u3057\u3087\u3046\uFF01\""
