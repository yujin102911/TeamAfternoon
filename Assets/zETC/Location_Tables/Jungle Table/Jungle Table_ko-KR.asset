  m_TableData:
  - m_Id: 71669891072
    m_Localized: Be Queen Bee
    m_Metadata:
      m_Items: []
  - m_Id: 190754570240
    m_Localized: "\uC5EC\uC655\uBC8C\uC774 \uB418\uC5B4 \uD398\uB85C\uBAAC \uD45C\uC2DD\uC73C\uB85C
      \uAFC0\uBC8C \uBB34\uB9AC\uB97C \uC9C0\uD718\uD558\uB294 \uC561\uC158 \uC804\uB7B5
      \uAC8C\uC784\uC785\uB2C8\uB2E4. \uC801\uC774 \uC810\uB839\uD55C \uAF43\uBC2D\uC744
      \uBE7C\uC557\uACE0, \uAD76\uC8FC\uB9BC\uC5D0\uC11C \uBC97\uC5B4\uB098\uC138\uC694.
      \uC2E4\uC2DC\uAC04\uC73C\uB85C \uC801\uC744 \uD3EC\uC704\uD558\uACE0, \uAFC0\uC744
      \uAC15\uD0C8\uD558\uBA70, \uAD70\uB2E8\uC744 \uC9C4\uD654\uC2DC\uD0A4\uC138\uC694.
      \uB2F9\uC2E0\uC758 \uD398\uB85C\uBAAC\uC774 \uACE7 \uBC95\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 361315942400
    m_Localized: 'Cartapli : Fold Quest'
    m_Metadata:
      m_Items: []
  - m_Id: 1102608842752
    m_Localized: "Cartapli: fold Quest\uB294 \uC804\uB7B5 \uB85C\uADF8\uB77C\uC774\uD06C\uC640
      \uB3C5\uCC3D\uC801\uC778 \uC885\uC774\uC811\uAE30 \uD37C\uC990\uC774 \uACB0\uD569\uD55C
      \uD134 \uAE30\uBC18 \uC804\uD22C \uAC8C\uC784\uC785\uB2C8\uB2E4. \uB2F9\uC2E0\uC758
      \uC190\uC73C\uB85C \uC885\uC774\uB97C \uC811\uC5B4 \uC704\uCE58\uB97C \uBC14\uAFB8\uBA70
      \uBAA8\uB4E0 \uC801\uC744 \uCC98\uCE58\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281920
    m_Localized: D1AL-ogue
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281921
    m_Localized: "\uD0DC\uC591\uC774 \uB728\uC9C0 \uC54A\uB294 \uC0AC\uC774\uBC84\uD391\uD06C
      \uB3C4\uC2DC\uC5D0\uC11C \uC548\uB4DC\uB85C\uC774\uB4DC \uC218\uB9AC\uACF5\uC774
      \uB418\uC5B4\uBCF4\uC138\uC694. \uB3C5\uCC3D\uC801\uC778 \uC6D0\uD615 \uD37C\uC990
      'D1AL'\uC744 \uD68C\uC804\uC2DC\uD0A4\uACE0 \uBAA8\uB4C8\uC744 \uD569\uC131\uD574,
      \uACE0\uC7A5 \uB09C \uADF8\uB140\uB4E4\uC758 \uBAB8\uACFC \uB9C8\uC74C\uC744
      \uCE58\uC720\uD574\uC57C \uD569\uB2C8\uB2E4. \uB2F9\uC2E0\uC758 \uC815\uAD50\uD55C
      \uC218\uB9AC\uB294 \uACE7 \uADF8\uB4E4\uACFC\uC758 \uB300\uD654\uAC00 \uB429\uB2C8\uB2E4.
      \uC9C0\uAE08, \uB2E4\uC774\uC5BC\uC744 \uB3CC\uB824 \uC774\uC57C\uAE30\uB97C
      \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281922
    m_Localized: EXE.CUTOR
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281923
    m_Localized: "EXE.CUTOR\uB294 \uB370\uC774\uD130 \uBE14\uB85D\uC744 \uBC30\uCE58\uD574
      \uB77C\uC778\uC744 \uC644\uC131\uD558\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4.
      \uB2E4\uC591\uD55C \uC7A5\uBE44\uB97C \uD68D\uB4DD\uD558\uACE0 \uB370\uC774\uD130
      \uBE14\uB85D\uC744 \uAC15\uD654\uD574, \uB354 \uAC15\uB825\uD55C \uB77C\uC778\uC744
      \uB9CC\uB4E4\uC5B4 \uC0AC\uC774\uBC84 \uACF5\uAC04\uC744 \uC7A0\uC2DD\uD55C
      \uBC14\uC774\uB7EC\uC2A4 \uC219\uC8FC\uB97C \uD1F4\uCE58\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281924
    m_Localized: In My Bubble
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281925
    m_Localized: "\"In My Bubble\uC740 \uADC0\uC5EC\uC6B4 \uAD70\uBC24\uBAA8\uC790\uB97C
      \uC4F4 \uC544\uC774\uAC00 \uAFC8\uC18D \uC138\uC0C1\uC758 \uC591\uB4E4\uC744
      \uAD6C\uD558\uAE30 \uC704\uD574 \uB5A0\uB098\uB294 3D \uC561\uC158 \uC5B4\uB4DC\uBCA4\uCC98
      \uD50C\uB7AB\uD3FC \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\uC5B4\uB460\uC5D0 \uC7A0\uAE34
      \uC138\uC0C1\uC744 \uD0D0\uD5D8\uD558\uBA70 \uD0C0\uB77D\uD55C \uC591\uB4E4\uC744
      \uAD6C\uCD9C\uD558\uACE0, \uC2E0\uBE44\uB85C\uC6B4 \uBC84\uBE14\uC758 \uD798\uC73C\uB85C
      \uC0AC\uB77C\uC9C4 \uC544\uCE68\uC744 \uB418\uCC3E\uC544 \uC8FC\uC138\uC694!\""
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281926
    m_Localized: No Mana, Just Dice
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281927
    m_Localized: "\"\uB9C8\uB825 0, \uBE5A 100\uC5B5. \uBBFF\uC744 \uAC74 \uC0AC\uAE30\uB2F9\uD55C
      \uC8FC\uC0AC\uC704\uBFD0!\"\n<No Mana, Just Dice>\uB294 \uBE5A\uB354\uBBF8\uC5D0
      \uC549\uC740 \uB099\uC81C \uB9C8\uB140\uC758 \uC0DD\uC874\uC744 \uADF8\uB9B0
      \uD134\uC81C \uC804\uC220 \uB85C\uADF8\uB77C\uC774\uD06C\uC785\uB2C8\uB2E4.
      \uB9C8\uBC95\uC740\uCEE4\uB155, \uAC81\uC774 \uB9CE\uC544 \uD55C \uBC1C\uC790\uAD6D
      \uB5BC\uB294 \uAC83\uC870\uCC28 \uC8FC\uC0AC\uC704\uAC00 \uD544\uC694\uD55C
      \uADF8\uB140\uB97C \uB3C4\uC640\uC8FC\uC138\uC694. \uC8FC\uC0AC\uC704\uB97C
      \uC774\uB3D9\uACFC \uACF5\uACA9\uC5D0 \uC804\uB7B5\uC801\uC73C\uB85C \uBC30\uBD84\uD574
      \uD0C0\uACE0\uB09C \uBD88\uC6B4\uC744 \uB4A4\uC9D1\uACE0, \uC18C\uC6D0\uC744
      \uB4E4\uC5B4\uC8FC\uB294 \uC804\uC124\uC758 \uC2A4\uD06C\uB864\uC744 \uCC3E\uC544\uC8FC\uC138\uC694!\""
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281928
    m_Localized: Spacetime Shooter
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281929
    m_Localized: "\"\uB2F9\uC2E0\uC740 \uC2DC\uAC04\uACFC \uACF5\uAC04\uC744 \uC870\uC885\uD558\uB294
      \uC2A4\uB098\uC774\uD37C\uC785\uB2C8\uB2E4.\n\uD55C\uBC1C\uC758 \uCD1D\uC54C\uB85C
      \uBAA8\uB4E0 \uC801\uC744 \uCC98\uCE58\uD558\uC138\uC694.\""
    m_Metadata:
      m_Items: []
