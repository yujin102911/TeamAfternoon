  - m_Id: 190754570240
    m_Localized: "\u8FD9\u662F\u4E00\u6B3E\u52A8\u4F5C\u7B56\u7565\u6E38\u620F\uFF0C\u73A9\u5BB6\u5C06\u5316\u8EAB\u4E3A\u8702\u540E\uFF0C\u5229\u7528\u8D39\u6D1B\u8499\u6807\u8BB0\u6307\u6325\u8702\u7FA4\u3002\u593A\u56DE\u88AB\u654C\u4EBA\u5360\u9886\u7684\u82B1\u7530\uFF0C\u6446\u8131\u9965\u997F\u3002\u5B9E\u65F6\u5305\u56F4\u654C\u4EBA\uFF0C\u63A0\u593A\u8702\u871C\uFF0C\u5E76\u8FDB\u5316\u4F60\u7684\u8702\u7FA4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 361315942400
    m_Localized: 'Cartapli : Fold Quest'
    m_Metadata:
      m_Items: []
  - m_Id: 1102608842752
    m_Localized: "\u300ACartapli: fold Quest\u300B\u662F\u4E00\u6B3E\u7ED3\u5408\u4E86\u7B56\u7565\u8089\u9E3D\u4E0E\u72EC\u7279\u6298\u7EB8\u89E3\u8C1C\u7684\u56DE\u5408\u5236\u6218\u6597\u6E38\u620F\u3002\u4EB2\u624B\u6298\u53E0\u7EB8\u5F20\u6539\u53D8\u4F4D\u7F6E\uFF0C\u6D88\u706D\u6240\u6709\u654C\u4EBA\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281920
    m_Localized: D1AL-ogue
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281921
    m_Localized: "\u5728\u6C38\u65E0\u65E5\u51FA\u7684\u8D5B\u535A\u670B\u514B\u57CE\u5E02\u4E2D\uFF0C\u6210\u4E3A\u4E00\u540D\u4EFF\u751F\u4EBA\u7EF4\u4FEE\u5DE5\u5427\u3002\u65CB\u8F6C\u72EC\u521B\u7684\u73AF\u5F62\u8C1C\u9898\u201CD1AL\u201D\u5E76\u5408\u6210\u6A21\u5757\uFF0C\u6CBB\u6108\u5979\u4EEC\u7834\u788E\u7684\u8EAB\u5FC3\u3002\u4F60\u7CBE\u6E5B\u7684\u7EF4\u4FEE\u6280\u672F\u4FBF\u662F\u4E0E\u5979\u4EEC\u4EA4\u6D41\u7684\u8BED\u8A00\u3002\u73B0\u5728\uFF0C\u8F6C\u52A8\u62E8\u76D8\uFF0C\u5F00\u542F\u6545\u4E8B\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281922
    m_Localized: EXE.CUTOR
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281923
    m_Localized: "EXE.CUTOR \u662F\u4E00\u6B3E\u901A\u8FC7\u653E\u7F6E\u6570\u636E\u65B9\u5757\u6765\u5B8C\u6210\u7EBF\u8DEF\u7684\u6E38\u620F\u3002\u83B7\u53D6\u591A\u79CD\u88C5\u5907\u5E76\u5F3A\u5316\u6570\u636E\u65B9\u5757\uFF0C\u6253\u9020\u66F4\u5F3A\u5927\u7684\u7EBF\u8DEF\uFF0C\u51FB\u8D25\u4FB5\u8680\u8D5B\u535A\u7A7A\u95F4\u7684\u75C5\u6BD2\u5BBF\u4E3B\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281924
    m_Localized: In My Bubble
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281925
    m_Localized: "\u300AIn My Bubble\u300B\u662F\u4E00\u6B3E 3D \u52A8\u4F5C\u5192\u9669\u5E73\u53F0\u6E38\u620F\u3002\u5728\u6E38\u620F\u4E2D\uFF0C\u4F60\u5C06\u626E\u6F14\u4E00\u540D\u6234\u7740\u53EF\u7231\u98DE\u884C\u5E3D\uFF08\u62A4\u8033\u5E3D\uFF09\u7684\u5B69\u5B50\uFF0C\u4E3A\u4E86\u62EF\u6551\u68A6\u5883\u4E16\u754C\u91CC\u7684\u7EF5\u7F8A\u800C\u8E0F\u4E0A\u65C5\u7A0B\u3002\u8BF7\u63A2\u7D22\u88AB\u9ED1\u6697\u7B3C\u7F69\u7684\u4E16\u754C\uFF0C\u6551\u52A9\u88AB\u8150\u8680\u7684\u7EF5\u7F8A\uFF0C\u5229\u7528\u795E\u5947\u7684\u6CE1\u6CAB\u529B\u91CF\u627E\u56DE\u6D88\u5931\u7684\u6E05\u6668\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281926
    m_Localized: No Mana, Just Dice
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281927
    m_Localized: "\"\u6CD5\u529B\u5F52\u96F6\uFF0C\u8D1F\u503A\u767E\u4EBF\u3002\u80FD\u6307\u671B\u7684\u53EA\u6709\u90A3\u9897\u88AB\u9A97\u5F97\u6765\u7684\u9AB0\u5B50\uFF01\"\n\u300ANo
      Mana, Just Dice\u300B\u662F\u4E00\u6B3E\u56DE\u5408\u5236\u6218\u672F\u8089\u9E3D\u6E38\u620F\uFF0C\u8BB2\u8FF0\u4E86\u4E00\u4F4D\u8EAB\u8D1F\u5DE8\u503A\u7684\u540A\u8F66\u5C3E\u9B54\u5973\u7684\u751F\u5B58\u8BB0\u3002\u522B\u8BF4\u65BD\u5C55\u9B54\u6CD5\u4E86\uFF0C\u5979\u80C6\u5C0F\u5982\u9F20\uFF0C\u8FDE\u8D70\u4E00\u6B65\u8DEF\u90FD\u9700\u8981\u9760\u9AB0\u5B50\u51B3\u5B9A\u3002\u8BF7\u52A9\u5979\u4E00\u81C2\u4E4B\u529B\uFF0C\u7B56\u7565\u6027\u5730\u5C06\u9AB0\u5B50\u5206\u914D\u7ED9\u79FB\u52A8\u548C\u653B\u51FB\uFF0C\u626D\u8F6C\u5929\u751F\u5384\u8FD0\uFF0C\u627E\u5230\u90A3\u4E2A\u80FD\u5B9E\u73B0\u613F\u671B\u7684\u4F20\u8BF4\u5377\u8F74\uFF01\""
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281928
    m_Localized: Spacetime Shooter
    m_Metadata:
      m_Items: []
  - m_Id: 6933811281929
    m_Localized: "\"\u4F60\u662F\u4E00\u540D\u64CD\u7EB5\u65F6\u95F4\u4E0E\u7A7A\u95F4\u7684\u72D9\u51FB\u624B\u3002\n\u7528\u4E00\u53D1\u5B50\u5F39\u6D88\u706D\u6240\u6709\u654C\u4EBA\u3002\""
