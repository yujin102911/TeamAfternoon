  - m_Id: 51856531456
    m_Localized: "\u672C\u90AE\u4EF6\u4EC5\u53D1\u9001\u7ED9\u540C\u610F\u63A5\u6536\u4FC3\u9500\u76F8\u5173\u4FE1\u606F\u901A\u77E5\u7684\u4F1A\u5458\u3002\n\n\u4FC3\u9500\u5BF9\u8C61\uFF1A
      Manasoft Worlds Movie Weaver \u514D\u8D39\u4E2A\u4EBA\u4F1A\u5458 \n\u4FC3\u9500\u65E5\u671F\uFF1A
      \u5373\u65E5\u8D77\u5171 5 \u5929\n\u4FC3\u9500\u5185\u5BB9\uFF1A \u4FC3\u9500\u671F\u95F4\u53EF\u514D\u8D39\u4F7F\u7528\u4ED8\u8D39\u529F\u80FD\u201C\u7279\u6548\u201D\uFF01\u6D3B\u52A8\u671F\u95F4\u6BCF\u65E5\u8F6C\u6362\u4E00\u4E2A\uFF01\n\n\u672C\u6B21\u4FC3\u9500\u5BF9\u8C61\u529F\u80FD\u5982\u4E0B\uFF1A\n\u901F\u5EA6\u611F\u5341\u8DB3\uFF0C\u79FB\u52A8\u9996\u9009\uFF01<b>\u201C\u8FC5\u901F\u201D</b>
      \n<b>\u201C\u4F24\u5BB3\u63D0\u5347\u201D</b> \u66F4\u5FEB\u3001\u66F4\u5F3A\u3001\u66F4\u5E05\u3002\n\u9707\u64BC\u4E16\u754C\u7684\u5F3A\u529B\u4E00\u51FB
      <b>\u201C\u66B4\u51FB\u201D</b> \n\u7EED\u8BA2\u7206\u6EE1\uFF01\u4E1A\u754C\u7B2C\u4E00\uFF01\u8FD1\u671F\u6700\u706B\u7279\u6548\uFF01
      <b>\u201C\u7729\u6655\u201D</b>\n\nManasoft Worlds Movie Weaver \u4EF7\u683C\u4F18\u60E0
      30%\uFF08\u542B\u7A0E\u3002\u6309\u5E74\u6216\u6309\u6708\u8BA1\u8D39\uFF09\n\u5173\u4E8E\u672C\u6B21\u4FC3\u9500\u7684\u66F4\u591A\u4FE1\u606F\uFF0C\u8BF7\u70B9\u51FB<u>\u6B64\u5904</u>\u67E5\u770B\u3002\n\n<u>\u4EE5\u4F18\u60E0\u4EF7\u8D2D\u4E70</u>"
    m_Metadata:
      m_Items: []
