  - m_Id: 51839754242
    m_Localized: "[Worlds Movie Weaver] \u6176\u795D\u52C7\u58EB\u8A95\u751F\u7D00\u5FF5\u6D3B\u52D5"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531456
    m_Localized: "\u672C\u90F5\u4EF6\u50C5\u767C\u9001\u7D66\u540C\u610F\u63A5\u6536\u4FC3\u92B7\u76F8\u95DC\u8CC7\u8A0A\u901A\u77E5\u7684\u6703\u54E1\u3002\n\n\u4FC3\u92B7\u5C0D\u8C61\uFF1A
      Manasoft Worlds Movie Weaver \u514D\u8CBB\u500B\u4EBA\u6703\u54E1 \n\u4FC3\u92B7\u65E5\u671F\uFF1A
      \u5373\u65E5\u8D77\u5171 5 \u5929 \n\u4FC3\u92B7\u5167\u5BB9\uFF1A \u4FC3\u92B7\u671F\u9593\u53EF\u514D\u8CBB\u4F7F\u7528\u4ED8\u8CBB\u529F\u80FD\u300C\u7279\u6548\u300D\uFF01\u6D3B\u52D5\u671F\u9593\u6BCF\u65E5\u8F49\u63DB\u4E00\u500B\uFF01\n\n\u672C\u6B21\u4FC3\u92B7\u5C0D\u8C61\u529F\u80FD\u5982\u4E0B\uFF1A
      \n\u901F\u5EA6\u611F\u5341\u8DB3\uFF0C\u79FB\u52D5\u9996\u9078\uFF01<b>\u300C\u8FC5\u901F\u300D</b>
      \n<b>\u300C\u50B7\u5BB3\u63D0\u5347\u300D</b> \u66F4\u5FEB\u3001\u66F4\u5F37\u3001\u66F4\u5E25\u3002
      \n\u9707\u64BC\u4E16\u754C\u7684\u5F37\u529B\u4E00\u64CA <b>\u300C\u66B4\u64CA\u300D</b>
      \n\u7E8C\u8A02\u7206\u6EFF\uFF01\u696D\u754C\u7B2C\u4E00\uFF01\u8FD1\u671F\u6700\u706B\u7279\u6548\uFF01
      <b>\u300C\u7729\u6688\u300D</b>\n\nManasoft Worlds Movie Weaver \u50F9\u683C\u512A\u60E0
      30%\uFF08\u542B\u7A05\u3002\u6309\u5E74\u6216\u6309\u6708\u8A08\u8CBB\uFF09
      \n\u95DC\u65BC\u672C\u6B21\u4FC3\u92B7\u7684\u66F4\u591A\u8CC7\u8A0A\uFF0C\u8ACB\u9EDE\u64CA<u>\u6A19\u984C</u>\u67E5\u770B\u3002\n\n<u>\u4EE5\u512A\u60E0\u50F9\u8CFC\u8CB7</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531457
    m_Localized: "\u6211\u662F\u52C7\u58EB"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531458
    m_Localized: "\u6211\u662F\u52C7\u58EB\u3002 \n\u6211\u7684\u983B\u9053\u5C31\u62DC\u8A17\u60A8\u4E86\u3002
      \n\n\u90A3\u9EBC\uFF0C\u8ACB\u5728\u4ECA\u5929\u5167\u5B8C\u6210\u5730\u4E0B\u57CE
      1 \u5C64\u7684\u901A\u95DC\u5F71\u7247\u526A\u8F2F\u4E26\u767C\u9001\u7D66\u6211\u3002
      \n\u9996\u689D\u5F71\u7247\u7684\u64AD\u653E\u91CF\u53EF\u662F\u6700\u95DC\u9375\u7684\uFF0C\u6240\u4EE5\u8ACB\u52D9\u5FC5\u628A\u5B83\u505A\u5F97\u903C\u771F\u4E00\u4E9B\u3002
      \n\u70BA\u4E86\u4E0D\u9732\u51FA\u7834\u7DBB\uFF0C\u8ACB\u52D9\u5FC5\u505A\u5F97\u8DDF\u771F\u7684\u4E00\u6A23\u5B8C\u7F8E\u3002\n\n\u9644\u4EF6
      \n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531459
    m_Localized: "[Worlds Movie Weaver] \u8A2A\u554F\u5EF6\u9072\u76F8\u95DC\u901A\u77E5"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531460
    m_Localized: "\u7531\u65BC\u76EE\u524D\u4FC3\u92B7\u9801\u9762\u7684\u6D41\u91CF\u8D85\u8F09\uFF0C\u66AB\u6642\u96E3\u4EE5\u8A2A\u554F\u3002
      \n\u7DAD\u8B77\u6642\u9593\uFF1A\u4ECA\u65E5 07:00 ~ 24:00 \n\u56E0\u6B64\uFF0C\u4FC3\u92B7\u6D3B\u52D5\u65E5\u7A0B\u5C07\u5EF6\u9577
      1 \u5929\u3002\uFF08\u5171 6 \u5929\uFF09 \n\u8ACB\u5728\u984D\u5916\u63D0\u4F9B\u7684\u65E5\u671F\u5167\u76E1\u60C5\u9AD4\u9A57\u5404\u7A2E\u7279\u6548\uFF01\n\n\u8B1D\u8B1D\u3002"
    m_Metadata:
