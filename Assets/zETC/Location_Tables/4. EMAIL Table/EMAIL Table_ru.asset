      \u043C\u043E\u0433\u0443\u0442 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C.\n\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
