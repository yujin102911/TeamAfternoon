  - m_Id: 51839754242
    m_Localized: "<size=18>[WMW] \u041A\u0430\u043C\u043F\u0430\u043D\u0438\u044F
      \u0432 \u0447\u0435\u0441\u0442\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F
      \u0433\u0435\u0440\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531456
    m_Localized: "\u042D\u0442\u043E \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E
      \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0447\u043B\u0435\u043D\u0430\u043C, \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0432\u0448\u0438\u043C\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
      \u043F\u0438\u0441\u0435\u043C \u043E \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u044F\u0445.\n\n\u0426\u0435\u043B\u0435\u0432\u0430\u044F
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044F \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:
      \u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435 \u043B\u0438\u0447\u043D\u044B\u0435
      \u0447\u043B\u0435\u043D\u044B Manasoft Worlds Movie Weaver\n\u0421\u0440\u043E\u043A
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:
      \u0441 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E
      \u0434\u043D\u044F \u043D\u0430 5 \u0434\u043D\u0435\u0439\n\u0421\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
      \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:\n\u041F\u043B\u0430\u0442\u043D\u0430\u044F
      \u0444\u0443\u043D\u043A\u0446\u0438\u044F \xAB\u0421\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u044B\xBB
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u043C\u043E-\u043F\u0435\u0440\u0438\u043E\u0434\u0430!
      \u041E\u0434\u0438\u043D \u044D\u0444\u0444\u0435\u043A\u0442 \u043C\u043E\u0436\u043D\u043E
      \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u0438.\n\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438,
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u0432 \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438:\n\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0439! \xAB\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C\xBB\n\xAB\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435
      \u0443\u0440\u043E\u043D\u0430\xBB \u2014 \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0441\u0438\u043B\u044C\u043D\u043E, \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u043E.\n\u041C\u043E\u0449\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440, \u043F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0438\u0439
      \u043C\u0438\u0440 \xAB\u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439\xBB\n\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0435
      \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0438 \u0437\u0430\u0448\u043A\u0430\u043B\u0438\u0432\u0430\u044E\u0442!
      \u041B\u0438\u0434\u0435\u0440 \u043E\u0442\u0440\u0430\u0441\u043B\u0438!
      \u0421\u0435\u0439\u0447\u0430\u0441 \u044D\u0442\u043E\u0442 \u044D\u0444\u0444\u0435\u043A\u0442!
      \xAB\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435\xBB\n\n\u0421\u043A\u0438\u0434\u043A\u0430
      30% \u043D\u0430 Manasoft Worlds Movie Weaver (\u0441 \u041D\u0414\u0421, \u0435\u0436\u0435\u0433\u043E\u0434\u043D\u0430\u044F
      \u0438\u043B\u0438 \u0435\u0436\u0435\u043C\u0435\u0441\u044F\u0447\u043D\u0430\u044F
      \u043E\u043F\u043B\u0430\u0442\u0430)\n\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 <u>\u0437\u0434\u0435\u0441\u044C</u>.\n\n<u>\u041A\u0443\u043F\u0438\u0442\u044C
      \u043F\u043E \u0441\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439 \u0446\u0435\u043D\u0435</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531457
    m_Localized: "<size=18>\u042F \u2014 \u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531458
    m_Localized: "\u042F \u2014 \u0413\u0435\u0440\u043E\u0439.\n\u041F\u0440\u043E\u0448\u0443
      \u0432\u0430\u0441 \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u0435\u0441\u0442\u0438
      \u043A\u0430\u043D\u0430\u043B \u0432 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C.\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0438 \u043F\u0440\u0438\u0441\u043B\u0430\u0442\u044C \u0432\u0438\u0434\u0435\u043E
      \u0441 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u044D\u0442\u0430\u0436\u0430 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F.\n\u0422\u0430\u043A
      \u043A\u0430\u043A \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u043E\u043B\u0438\u043A
      \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u043E\u0432,
      \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0435\u0433\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
      \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u043C, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u043F\u043E\u0434\u043E\u0437\u0440\u0438\u043B,
      \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430.\n\n\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u0435:\n[ENTER_LINK]"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531459
    m_Localized: "<size=18>[WMW] \u0423\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435
      \u043E \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531460
    m_Localized: "\u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0442\u0440\u0430\u0444\u0438\u043A \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435
      \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438 \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D,
      \u0438 \u0434\u043E\u0441\u0442\u0443\u043F \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u0451\u043D.\n\u041F\u0435\u0440\u0438\u043E\u0434
      \u0442\u0435\u0445\u0440\u0430\u0431\u043E\u0442: \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0441 07:00 \u0434\u043E 24:00\n\n\u0412 \u0441\u0432\u044F\u0437\u0438 \u0441
      \u044D\u0442\u0438\u043C \u0441\u0440\u043E\u043A \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u043F\u0440\u043E\u043C\u043E-\u0430\u043A\u0446\u0438\u0438 \u043F\u0440\u043E\u0434\u043B\u0451\u043D
      \u043D\u0430 1 \u0434\u0435\u043D\u044C (\u0432\u0441\u0435\u0433\u043E 6 \u0434\u043D\u0435\u0439).\n\u0412
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C\u0438
      \u0441\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u0430\u043C\u0438!\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
