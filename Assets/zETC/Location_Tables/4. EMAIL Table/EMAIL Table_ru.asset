    m_Localized: "\u0412\u043E\u043F\u0440\u043E\u0441 \u043E \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0438
      \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430"
