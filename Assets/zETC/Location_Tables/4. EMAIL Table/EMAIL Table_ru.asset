  - m_Id: 8103873917214720
    m_Localized: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435.\n\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0432\u0440\u0435\u043C\u044F \u0432\u044B \u044F\u0432\u043B\u044F\u0435\u0442\u0435\u0441\u044C
      \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445
      \u0432\u043E\u0441\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u043E\u0432, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0440\u0435\u0448\u0438\u043B \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0432\u0430\u043C\u0438.\n\n\u041C\u0435\u043D\u044F \u0432\u044B\u0431\u0440\u0430\u043B\u0438
      \u0433\u0435\u0440\u043E\u0435\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043F\u0430\u0441\u0442\u0438 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443,
      \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u043E \u043B\u0438\u0447\u043D\u044B\u043C
      \u043F\u0440\u0438\u0447\u0438\u043D\u0430\u043C \u0441\u0435\u0439\u0447\u0430\u0441
      \u043C\u043D\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043B\u043E\u0436\u043D\u043E
      \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435.\n\n\u0412
      \u0441\u0432\u044F\u0437\u0438 \u0441 \u044D\u0442\u0438\u043C \u044F \u0438\u0449\u0443
      \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0441\u043C\u043E\u0436\u0435\u0442 \u0432\u043C\u0435\u0441\u0442\u043E \u043C\u0435\u043D\u044F
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u0438\u0434\u0435\u043E
      \u0441 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F.\n\u0412\u043E\u0437\u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435
      \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
      \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u0442\u044C \u0441 \u0432\u0430\u0448\u0438\u043C\u0438
      \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F\u043C\u0438.\n\n\u0415\u0441\u043B\u0438
      \u0432\u0430\u043C \u044D\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,\n\u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0442\u0435\u0441\u044C \u0441
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u043C \u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C\u0438
      \u043D\u0438\u0436\u0435 \u0438, \u0435\u0441\u043B\u0438 \u0432\u0441\u0451
      \u0443\u0441\u0442\u0440\u043E\u0438\u0442, \u0437\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442.\n\n\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u0435\n\n-
      <color=blue><u>\u0413\u0435\u0440\u043E\u0439\uFF0B\u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B\uFF0B\u0414\u043E\u0433\u043E\u0432\u043E\u0440.zip</u></color>"
