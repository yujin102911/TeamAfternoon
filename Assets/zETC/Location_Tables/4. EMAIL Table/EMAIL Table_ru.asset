  - m_Id: 51856531461
    m_Localized: "<size=18>\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u0438\u0434\u0435\u043E
      \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531462
    m_Localized: "\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u0438\u0434\u0435\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0435\u0435
      \u2014 \u0443\u0436\u0435 10 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u043E\u0432!\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0432\u0438\u0434\u0435\u043E \u0441 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u044D\u0442\u0430\u0436\u0430 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F,
      \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0438 \u0432\u0447\u0435\u0440\u0430.\n\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435
      \u0435\u0433\u043E \u0435\u0449\u0451 \u0431\u043E\u043B\u0435\u0435 \u043F\u0443\u0433\u0430\u044E\u0449\u0438\u043C.\n\n\u041A\u0430\u043A
      \u0432\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0432\u0438\u0434\u0435\u043B\u0438
      \u043F\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C,
      \u044F \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u0441\u044F
      \u0441 \u043F\u044F\u0442\u0438 \u043B\u0435\u0442 \u0438 \u043C\u043E\u0433\u0443
      \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u0441 \u043C\u0435\u0447\u043E\u043C.\n\u041D\u043E
      \u0434\u0435\u043C\u043E\u043D\u044B \u0442\u0440\u0435\u043D\u0438\u0440\u0443\u044E\u0442\u0441\u044F
      \u0441 \u043F\u044F\u0442\u0438 \u043C\u0435\u0441\u044F\u0446\u0435\u0432,
      \u0442\u0430\u043A \u0447\u0442\u043E \u0440\u0430\u0434\u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430
      \u0432\u0438\u0434\u0435\u043E \u043B\u0443\u0447\u0448\u0435 \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0432\u0430\u043C, \u043C\u043E\u043D\u0442\u0430\u0436\u0451\u0440.\n\n\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u0435:\n[ENTER_LINK]"
