  - m_Id: 51856531472
    m_Localized: "\u0412\u044B \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0440\u0430\u0431\u043E\u0442\u0443?\n\u0422\u0451\u043C\u043D\u044B\u0439
      \u0432\u043B\u0430\u0434\u044B\u043A\u0430 \u043F\u0440\u0438\u0448\u0451\u043B.\n\u041E\u043D
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0434\u0430\u0436\u0435
      300 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434 \u0442\u0430\u043A\u043E\u0433\u043E
      \u043C\u043E\u043D\u0442\u0430\u0436\u0430 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438
      \u0438 \u0447\u0442\u043E \u0441\u0430\u043C \u0442\u043E\u0436\u0435 \u0445\u043E\u0447\u0435\u0442
      \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u043E \u043F\u043E\u044F\u0432\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0432\u0438\u0434\u0435\u043E.\n\u041E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442
      \u0434\u044B\u0445\u0430\u043D\u0438\u044F \u0434\u043B\u044F \u0435\u0433\u043E
      \u043A\u043E\u0432\u0430\u0440\u043D\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0437\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044C\u0451\u0442 \u0441\u0437\u0430\u0434\u0438.\n\u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C, \u0447\u0442\u043E
      \u043E\u043D \u043D\u0435 \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0430\u0435\u0442
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 100 \u043B\u0435\u0442, \u0438
      \u043D\u0430\u0447\u0430\u043B\u0438 \u0441\u044A\u0451\u043C\u043A\u0443.\n\n\u041D\u043E
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u043A\u0440\u0443\u0447\u0435,
      \u0435\u0441\u043B\u0438 \u0431\u044B \u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0441\u044F
      \u043F\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435 \u0438 \u0441\u0440\u0430\u0436\u0430\u043B\u0441\u044F.\n\u041C\u044B
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
      \u0437\u0430\u0432\u0442\u0440\u0430 \u0432 \u044D\u0442\u043E \u0436\u0435
      \u0432\u0440\u0435\u043C\u044F, \u0442\u0430\u043A \u0447\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
      \u043C\u043E\u043D\u0442\u0430\u0436 \u0434\u043E \u044D\u0442\u043E\u0433\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442\u0430.\n\n\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u0435:\n[ENTER_LINK]"
