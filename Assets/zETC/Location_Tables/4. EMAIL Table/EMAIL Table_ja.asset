  - m_Id: 51839754242
    m_Localized: "[Worlds Movie Weaver] \u52C7\u8005\u8A95\u751F\u8A18\u5FF5\u30AD\u30E3\u30F3\u30DA\u30FC\u30F3"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531456
    m_Localized: "\u3053\u306E\u30E1\u30FC\u30EB\u306F\u3001\u30D7\u30ED\u30E2\u30FC\u30B7\u30E7\u30F3\u95A2\u9023\u306E\u6848\u5185\u30E1\u30FC\u30EB\u306E\u53D7\u4FE1\u306B\u540C\u610F\u3055\u308C\u305F\u4F1A\u54E1\u9650\u5B9A\u3067\u914D\u4FE1\u3055\u308C\u3066\u3044\u307E\u3059\u3002\n\n\n\n\u30D7\u30ED\u30E2\u30FC\u30B7\u30E7\u30F3\u5BFE\u8C61\uFF1AManasoft
      Worlds Movie Weaver\u306E\u7121\u6599\u500B\u4EBA\u4F1A\u54E1\n\u30D7\u30ED\u30E2\u30FC\u30B7\u30E7\u30F3\u671F\u9593\uFF1A\u672C\u65E5\u304B\u30895\u65E5\u9593\n\u30D7\u30ED\u30E2\u30FC\u30B7\u30E7\u30F3\u5185\u5BB9\uFF1A\n\u6709\u6599\u6A5F\u80FD\u300C\u7279\u6B8A\u52B9\u679C\u300D\u3092\u671F\u9593\u4E2D\u3001\u7121\u6599\u3067\u958B\u653E\uFF01\u30AD\u30E3\u30F3\u30DA\u30FC\u30F3\u671F\u9593\u4E2D\u3001\u6BCE\u65E5\u4E00\u3064\u305A\u3064\u8FFD\u52A0\uFF01\n\n\u30D7\u30ED\u30E2\u30FC\u30B7\u30E7\u30F3\u5BFE\u8C61\u6A5F\u80FD\u306F\u4EE5\u4E0B\u306E\u901A\u308A\u3067\u3059\u3002\n\u30B9\u30D4\u30FC\u30C9\u611F\u3042\u3075\u308C\u308B\u79FB\u52D5\u306B\u6700\u9069\uFF01
      <b>\u300C\u8FC5\u901F\u300D</b>\n<b>\u300C\u30C0\u30E1\u30FC\u30B8\u30A2\u30C3\u30D7\u300D</b>
      \u65E9\u3044\u3001\u5F37\u3044\u3001\u30AB\u30C3\u30B3\u3044\u3044\u3002\n\u4E16\u754C\u3092\u9707\u64BC\u3055\u305B\u305F\u5F37\u529B\u306A\u4E00\u6483
      <b>\u300C\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u300D</b>\n\u518D\u8CFC\u8AAD\u7D9A\u51FA\uFF01\u696D\u754C1\u4F4D\uFF01\u4ECA\u8A71\u984C\u306E\u52B9\u679C\uFF01
      <b>\u300C\u30B9\u30BF\u30F3\u300D</b>\n\nManasoft Worlds Movie Weaver\u306E\u4FA1\u683C\u309230%\u5272\u5F15\uFF08\u7A0E\u8FBC\u3002\u5E74\u6255\u3044\u3001\u6708\u6255\u3044\u5BFE\u5FDC\uFF09\n\u3053\u306E\u30D7\u30ED\u30E2\u30FC\u30B7\u30E7\u30F3\u306B\u95A2\u3059\u308B\u8A73\u7D30\u306F<u>\u3053\u3061\u3089</u>\u304B\u3089\u3054\u78BA\u8A8D\u3044\u305F\u3060\u3051\u307E\u3059\u3002\n\n<u>\u5272\u5F15\u4FA1\u683C\u3067\u8CFC\u5165\u3059\u308B</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531457
    m_Localized: "\u52C7\u8005\u3067\u3059"
    m_Metadata:
      m_Items: []
  - m_Id: 51856531458
    m_Localized: "\u3053\u3093\u306B\u3061\u306F\u3001\u52C7\u8005\u3067\u3059\u3002\n\u3053\u308C\u304B\u3089\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3044\u305F\u3057\u307E\u3059\u3002\n\u3068\u308A\u3042\u3048\u305A\u4ECA\u65E5\u4E2D\u306B\u30C0\u30F3\u30B8\u30E7\u30F31\u968E\u306E\u30AF\u30EA\u30A2\u52D5\u753B\u3092\u7DE8\u96C6\u3057\u3066\u9001\u3063\u3066\u304F\u3060\u3055\u3044\u3002\n\u6700\u521D\u306E\u52D5\u753B\u306E\u518D\u751F\u6570\u304C\u4E00\u756A\u5927\u4E8B\u306A\u306E\u3067\u3001\u3067\u304D\u308B\u3060\u3051\u30EA\u30A2\u30EB\u306B\u3001
      \u8AB0\u3082\u7591\u308F\u306A\u3044\u304F\u3089\u3044\u672C\u7269\u3063\u307D\u304F\u4F5C\u3063\u3066\u304F\u3060\u3055\u3044\u3002\n\n\u6DFB\u4ED8\u30D5\u30A1\u30A4\u30EB\n
