      \u0441 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0435\u0439
      \u0441\u0443\u0434\u0430 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0444\u0430\u043D-\u043A\u043B\u0443\u0431\u0430 \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B
      \u0413\u0435\u0440\u043E\u044F\xBB \u043C\u043E\u0436\u0435\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C\u0441\u044F
