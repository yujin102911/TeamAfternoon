  m_TableData:
  - m_Id: 2049427365888
    m_Localized: "\u0412\u0441\u0435\u043C \u043F\u0440\u0438\u0432\u0435\u0442,
      \u044F \u0413\u0435\u0440\u043E\u0439, \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0439\u0441\u044F
      \u043D\u0430 \u0432\u0435\u043B\u0438\u043A\u0443\u044E \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E
      \u043F\u043E \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044E \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B.\\n\u0421
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E \u0434\u043D\u044F
      \u0437\u0430\u0445\u043E\u0436\u0443 \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435,
      \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u043E\u0432\u043E\u0435 \u0432\u0438\u0434\u0435\u043E
      \u043D\u0430 \u041D\u044C\u044E\u0422\u044C\u044E\u0431\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0439\u0442\u0438 \u0443\u0436\u0435 \u0437\u0430\u0432\u0442\u0440\u0430.\\n\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0438 \u0436\u0434\u0438\u0442\u0435
      <\u0425\u0440\u043E\u043D\u0438\u043A\u0438 \u0448\u0442\u0443\u0440\u043C\u0430
      \u0437\u0430\u043C\u043A\u0430 \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044F
      \u0434\u0435\u043C\u043E\u043D\u043E\u0432>.\\n\u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435
      \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F \u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2049561583616
    m_Localized: "\u0410, \u0442\u0430\u043A \u044D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C
      \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439 \u0413\u0435\u0440\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049561583617
    m_Localized: "\u041F\u043E\u044F\u0432\u0438\u043B\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049561583618
    m_Localized: "\u041F\u043E\u0433\u043D\u0430\u043B\u0438!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777920
    m_Localized: "\u0413\u0435\u0440\u043E\u0439\u2026 \u0432\u044B \u2014 \u043D\u0430\u0448\u0430
      \u043D\u0430\u0434\u0435\u0436\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777921
    m_Localized: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u043D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777922
    m_Localized: "\u041C\u044B \u0434\u0430\u0436\u0435 \u043D\u0435 \u043D\u0430\u0434\u0435\u0435\u043C\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0431\u0435\u0434\u0443 \u043D\u0430\u0434 \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u0435\u043C
      \u0434\u0435\u043C\u043E\u043D\u043E\u0432, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u0434\u0430\u0439\u0442\u0435 \u043F\u043E\u0445\u0438\u0442\u0438\u0442\u044C
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777923
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443
      \u043F\u043E\u0445\u0438\u0442\u044F\u0442 \u2014 \u0413\u0435\u0440\u043E\u044E
      \u043A\u043E\u043D\u0435\u0446 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441
      \u043D\u0435\u0439, \u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777924
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430
      \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777925
    m_Localized: "\u0418 \u0432\u0441\u0451 \u044D\u0442\u043E \u0435\u0449\u0451
      \u0438 \u043D\u0430 \u041D\u044C\u044E\u0422\u044C\u044E\u0431\u0435 \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777926
    m_Localized: "\u041D\u0443 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F-\u0442\u043E
      \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F,
      \u0432\u043E\u0442 \u0438 \u0440\u0435\u0448\u0438\u043B\u0438 \u0432\u0435\u0441\u0442\u0438
      \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777927
    m_Localized: "\u0414\u0430 \u044D\u0442\u043E \u0436\u0435 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0439
      \u0445\u0430\u0439\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777928
    m_Localized: "\u0410 \u044F \u0432\u0435\u0440\u044E \u0413\u0435\u0440\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777929
    m_Localized: "Hello World. \u0412\u0441\u0435 \u0436\u0434\u0430\u043B\u0438?
      \u042D\u0442\u043E \u0413\u0435\u0440\u043E\u0439.\\n\u0412\u043E\u0442 \u0442\u043E
      \u0441\u0430\u043C\u043E\u0435 \u0432\u0438\u0434\u0435\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0432\u044B \u0436\u0434\u0430\u043B\u0438: <[ENTER_TITLE]>.\\n\u0421 \u0413\u043B\u0430\u0437\u043E\u043C
      \u0417\u043B\u0430 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0431\u0435\u0437 \u043F\u0440\u043E\u0431\u043B\u0435\u043C.\\n\u0414\u0430\u0436\u0435
      \u0436\u0430\u043B\u044C, \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043B\u0435\u0433\u043A\u043E,
      \u0432\u0438\u0434\u0435\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0432\u044B\u0448\u043B\u043E.\\n\u041D\u043E \u0434\u0430\u043B\u044C\u0448\u0435
      \u0431\u0443\u0434\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0440\u0443\u0447\u0435
      \u2014 \u0436\u0434\u0438\u0442\u0435 \u043D\u043E\u0432\u044B\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435
      \u0440\u043E\u043B\u0438\u043A\u0438 \u0438\u0437 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u0438\u0439~"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777930
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0435\u0431\u0435\u2026
      \u0442\u0430\u043A \u0432\u044B \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439
      \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A \u0433\u0440\u0430\u0444\u0441\u043A\u043E\u0433\u043E
      \u0440\u043E\u0434\u0430, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0432\u0441\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777931
    m_Localized: "\u0414\u0430 \u043E\u043D \u0434\u0430\u0436\u0435 \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u0435\u0435,
      \u0447\u0435\u043C \u0432 \u0441\u043B\u0443\u0445\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777932
    m_Localized: "\u0414\u0430-\u0434\u0430, \u0442\u0435\u043F\u0435\u0440\u044C
      \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0435\u0433\u043E \u0432\u0438\u0434\u0435\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777933
    m_Localized: "\u041D\u0443 \u043D\u0435 \u0437\u043D\u0430\u044E, \u043D\u0435
      \u0432 \u043C\u043E\u0451\u043C \u0432\u043A\u0443\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777934
    m_Localized: ";;\u041D\u0443 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043A\u0440\u0430\u0441\u0430\u0432\u0447\u0438\u043A
      \u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777935
    m_Localized: "\u0412\u0430\u0443\u2026 \u044F \u0442\u0430\u043A \u0436\u0434\u0430\u043B(\u0430)
      [ENTER_TITLE] (("
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777936
    m_Localized: "222 \u044F \u0442\u043E\u0436\u0435 (("
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777937
    m_Localized: 333((((
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777938
    m_Localized: "\u0414\u0430 \u043B\u0430\u0434\u043D\u043E, \u0447\u0442\u043E
      \u0437\u0430 \u0431\u0435\u0437\u0443\u043C\u043D\u044B\u0435 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u044B?!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777939
    m_Localized: "\u041A\u0430\u043A \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435
      \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777940
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u043E(((
      \u0421\u0440\u043E\u0447\u043D\u043E \u0435\u0449\u0451 \u0432\u0438\u0434\u0435\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777941
    m_Localized: "\u041F\u043E\u0434\u043F\u0438\u0441\u0447\u0438\u043A\u0438 \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445 \u043F\u0440\u0438\u0431\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777942
    m_Localized: "\u041E\u043D \u0441\u0435\u0439\u0447\u0430\u0441 \u043C\u0438\u0440\u043E\u0432\u043E\u0439
      \u0440\u0435\u043A\u043E\u0440\u0434 \u0441\u0442\u0430\u0432\u0438\u0442 \u0436\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777943
    m_Localized: "\u0414\u043E \u043D\u0430\u0448\u0438\u0445 \u043F\u0430\u0440\u043D\u0435\u0439
      \u0438\u0437 VTS \u0435\u043C\u0443 \u0435\u0449\u0451 \u0434\u0430\u043B\u0435\u043A\u043E\u0430\u0445\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777944
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u044B\u0441\u0442\u0440\u043E
      \u0440\u0430\u0441\u0442\u0451\u0442, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u0441\u043A\u0430\u0436\u0443\u0442, \u0447\u0442\u043E \u044D\u0442\u043E
      \u043D\u0430\u043A\u0440\u0443\u0442\u043A\u0430, \u043F\u043E\u0432\u0435\u0440\u044E\u0430\u0445\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777945
    m_Localized: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0439 \u0434\u0432\u043E\u0440
      \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442?
      \u0420\u0435\u0441\u043F\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777946
    m_Localized: "\u041F\u0435\u0440\u0432\u043E\u0435 \u0432\u0438\u0434\u0435\u043E
      \u0443\u0436\u0435 \u043D\u0430\u0431\u0440\u0430\u043B\u043E \u0434\u0435\u0441\u044F\u0442\u044C
      \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u043E\u0432.\\n\u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B \u0432\u0435\u0434\u044C \u0431\u0443\u0434\u0435\u0442\u0435
      \u0435\u0449\u0451 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777947
    m_Localized: "\u041A\u0442\u043E \u0435\u0449\u0451 \u0434\u043E \u0441\u0438\u0445
      \u043F\u043E\u0440 \u043D\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777948
    m_Localized: "\u042F \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B\u0441\u044F\u2665\uFE0F"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777949
    m_Localized: "\u041B\u0443\u0447\u0448\u0435\u0435 // \u0432\u0438\u0434\u0435\u043E
      // \u0432 \u043C\u0438\u0440\u0435 // \u0441\u0440\u043E\u0447\u043D\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435  [ENTER_TITLE] //"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777950
    m_Localized: "\u0411\u0435\u0433\u043E\u043C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777951
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0438\u0442\u0430\u044E, \u043D\u043E \u043F\u043E\u0441\u043B\u0435
      \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777952
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043D\u0430\u0440\u043E\u0434,
      \u0441 \u0432\u0430\u043C\u0438 \u0413\u0435\u0440\u043E\u0439.\\n\u0412\u0438\u0434\u0435\u043E
      \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u043D\u044F \u2014 <[ENTER_TITLE]>.\\n\u0423\u0431\u0438\u043B
      \u0433\u0440\u0438\u0431-\u0443\u0431\u0438\u0439\u0446\u0443, \u043F\u043E\u0442\u043E\u043C
      \u043F\u043E\u0436\u0430\u0440\u0438\u043B \u0438 \u0441\u044A\u0435\u043B
      \u2014 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0432\u043A\u0443\u0441\u043D\u043E\u314E\\n\u0418
      \u043A\u0443\u0440\u0438\u0446\u0430, \u0438 \u0433\u0440\u0438\u0431\u044B,
      \u043F\u043E\u0445\u043E\u0436\u0435, \u0432\u043A\u0443\u0441\u043D\u0435\u0435
      \u0432\u0441\u0435\u0433\u043E \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F
      \u043D\u043E\u0436\u043A\u0438?\\n\u041B\u044E\u0431\u0438\u0442\u0435\u043B\u044F\u043C
      \u0433\u0440\u0438\u0431\u043E\u0432 \u0441\u043E\u0432\u0435\u0442\u0443\u044E
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C~\\n\u0412
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437 \u0432\u0435\u0440\u043D\u0443\u0441\u044C
      \u0441 \u0435\u0449\u0451 \u0431\u043E\u043B\u0435\u0435 \u043A\u0440\u0443\u0442\u044B\u043C
      \u0432\u0438\u0434\u0435\u043E, \u0442\u0430\u043A \u0447\u0442\u043E \u0441\u0442\u0430\u0432\u044C\u0442\u0435
      \u043B\u0430\u0439\u043A\u0438, \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0439\u0442\u0435\u0441\u044C
      \u0438 \u0432\u043A\u043B\u044E\u0447\u0430\u0439\u0442\u0435 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
