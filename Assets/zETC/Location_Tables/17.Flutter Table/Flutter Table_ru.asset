  - m_Id: 2049569972250
    m_Localized: "\u041B\u044E\u0431\u0438\u043C\u043E\u043C\u0443 \u0413\u0435\u0440\u043E\u044E.
      \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u0413\u0435\u0440\u043E\u0439.
      \u042F \u0448\u043A\u043E\u043B\u044C\u043D\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439,
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0432 \u0432\u0430\u0448\u0435
      \u043F\u0435\u0440\u0432\u043E\u0435 \u0432\u0438\u0434\u0435\u043E, \u0441\u043D\u043E\u0432\u0430
      \u043E\u0431\u0440\u0451\u043B \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0436\u0438\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0432\u0430\u043C \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044C \u043A
      \u044D\u0442\u043E\u043C\u0443 \u043C\u0438\u0440\u0443 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442, \u0438 \u0441\u0435\u0439\u0447\u0430\u0441
      \u044F \u0436\u0438\u0432\u0443, \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u044F\u0441\u044C
      \u043A\u0430\u0436\u0434\u044B\u043C \u0434\u043D\u0451\u043C, \u0441\u043B\u0435\u0434\u044F
      \u0437\u0430 \u0432\u0430\u043C\u0438\u2026<u>\u0435\u0449\u0451</u>"
