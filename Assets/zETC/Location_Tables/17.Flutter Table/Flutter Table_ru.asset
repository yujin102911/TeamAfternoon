      \u0441\u043E\u0441\u043B\u043E\u0432\u043D\u044B\u0445 \u0442\u0438\u0442\u0443\u043B\u043E\u0432
      \u0438 \u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0441\u043F\u043E\u0440\u044B, \u043C\u044B \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u043C
      \u0441 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E
      \u0434\u043D\u044F \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0444\u0430\u043D-\u043A\u043B\u0443\u0431\u0430 \u043D\u0430 \xAB\u0421\u043B\u0443\u0436\u0430\u043D\u043A\u0438
      \u0413\u0435\u0440\u043E\u044F\xBB.\\n\u041E\u0431 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F\u0445,
      \u043A\u0430\u0441\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
      \u043F\u0440\u043E\u0435\u043A\u0442\u0430 The Holy Warrior Global Official
      Fanclub \u2018Limited Edition Package\u2019, \u0431\u0443\u0434\u0435\u0442
