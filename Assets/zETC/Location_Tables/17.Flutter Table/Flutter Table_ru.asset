    m_Metadata:
      m_Items: []
  - m_Id: 2049574166551
    m_Localized: "\u041B\u0443\u0447\u0448\u0438\u0439 \u0432\u044B\u0431\u043E\u0440
      \u043A\u043E\u0440\u043E\u043B\u044F-\u043C\u043E\u0434\u043D\u0438\u043A\u0430
      \u0441\u0435\u0437\u043E\u043D\u0430 S/W \u2014 \u0437\u0430\u043F\u0443\u0441\u043A
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \xAB\u041F\u043B\u0430\u0449\u0430
      \u0411\u0435\u043B\u043E\u0433\u043E \u0414\u0440\u0430\u043A\u043E\u043D\u0430\xBB.\\n\u041D\u0435\u0436\u043D\u044B\u0439
      \u0436\u0435\u043C\u0447\u0443\u0436\u043D\u044B\u0439 \u043E\u0442\u0442\u0435\u043D\u043E\u043A
      \u043C\u0435\u0445\u0430 \u0431\u0435\u043B\u043E\u0433\u043E \u0434\u0440\u0430\u043A\u043E\u043D\u0430
      \u0438 \u043E\u0431\u044A\u0451\u043C\u043D\u0430\u044F \u043B\u0438\u043D\u0438\u044F
      \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u043C\u0435\u0445\u0430.
      \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u043E\u0439
      \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E\u0439 \u043C\u0430\u0433\u0438\u0438
      Mosinsa \u043F\u043B\u0430\u0449 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u043B\u0451\u0433\u043A\u043E\u0441\u0442\u044C \u0438 \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044E,
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u044D\u043B\u0435\u0433\u0430\u043D\u0442\u043D\u044B\u0439
      \u0441\u0438\u043B\u0443\u044D\u0442 \u043A\u0430\u043A \u043D\u0430 \u0437\u0435\u043C\u043B\u0435,
      \u0442\u0430\u043A \u0438 \u0432 \u043F\u043E\u043B\u0451\u0442\u0435.\\n\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u0441\u0430\u0439\u0442\u0435
      \u0434\u0440\u043E\u043F\u0430.\\n#Mosinsa"
    m_Metadata:
      m_Items: []
