      \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777970
    m_Localized: "\u0421\u043D\u043E\u0432\u0430 \u043F\u0440\u043E\u0433\u043E\u043B\u043E\u0434\u0430\u043B\u0441\u044F\u2026
      \u043F\u043E\u0439\u0434\u0443 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043C\u0443\u043A\u0431\u0430\u043D\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777971
    m_Localized: "\u0412\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0430,
      \u0441 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u043E\u043C \u043D\u0435
      \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777972
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u0430 \u043A\u0443\u043B\u0438\u043D\u0430\u0440\u0438\u0438
      \u2014 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u043E\u0436\u0430\u0440\u043A\u0430.
      \u0412\u0438\u0434\u0435\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u043E \u044D\u0442\u043E
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043E\u0447\u0435\u043D\u044C
      \u043F\u043E\u043B\u0435\u0437\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777973
    m_Localized: "\U0001F451 [NOTICE] \u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0444\u0430\u043D\u0434\u043E\u043C\u0430
      \u0438 \u043D\u0430\u0431\u043E\u0440 \u0432 1-\u0439 \u0441\u043E\u0441\u0442\u0430\u0432
      \u0444\u0430\u043D-\u043A\u043B\u0443\u0431\u0430\n\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u043C\u0443 \u0443\u0447\u0430\u0441\u0442\u0438\u044E
      \u043D\u0430\u0448\u0438\u0445 \u0441\u043E\u0440\u0430\u0442\u043D\u0438\u043A\u043E\u0432,
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0444\uB984\u0434\u043E\u043C\u0430 \u0431\u044B\u043B\u043E \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043E
      \u043A\u0430\u043A \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B
      \u0413\u0435\u0440\u043E\u044F\xBB (Hero's Princess)!\n\n\u041C\u044B \u043E\u0431\u044A\u044F\u0432\u043B\u044F\u0435\u043C
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u043D\u0430\u0431\u043E\u0440
      \u0432 \xAB1-\u0439 \u0441\u043E\u0441\u0442\u0430\u0432 \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\xBB,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u0443\u0434\u0443\u0442 \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u0442\u044C
      \u0421\u0432\u044F\u0442\u043E\u0433\u043E \u0412\u043E\u0438\u043D\u0430 \u0432
      \u0435\u0433\u043E \u0432\u0435\u043B\u0438\u043A\u043E\u043C \u043F\u043E\u0445\u043E\u0434\u0435
      \u043F\u0440\u043E\u0442\u0438\u0432 \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044F
      \u0414\u0435\u043C\u043E\u043D\u043E\u0432! \u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0439\u0442\u0435\u0441\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u044B\u0435 \u0431\u043E\u043D\u0443\u0441\u044B
      \u0434\u043B\u044F \u0440\u0430\u043D\u043D\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432
      \u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0442\u0440\u0438\u0443\u043C\u0444
      \u043D\u0430\u0448\u0435\u0433\u043E \u0413\u0435\u0440\u043E\u044F! \u2694\uFE0F\u2728\n\n\U0001F381
      \u0421\u043E\u0441\u0442\u0430\u0432 Limited Edition Package:\\n\u25CF \u0411\u0440\u0435\u043B\u043E\u043A-\u043A\u043E\u043F\u0438\u044F
      [\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E \u0421\u0432\u044F\u0442\u043E\u0433\u043E
      \u041C\u0435\u0447\u0430] \u0441 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
