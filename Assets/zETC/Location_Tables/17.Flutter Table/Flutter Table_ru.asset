  - m_Id: 2049565777968
    m_Localized: "\u042F \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0435
      \u0433\u043E\u0442\u043E\u0432 \u0435\u0441\u0442\u044C \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432
      \u0438\u0437 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u0438\u0439\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777969
    m_Localized: "\u0412\u043E\u0442 \u0443\u0436 \u043A\u043E\u043C\u0443 \u043D\u0435
      \u043B\u0435\u043D\u044C \u0431\u044B\u043B\u043E \u0441\u044E\u0434\u0430
