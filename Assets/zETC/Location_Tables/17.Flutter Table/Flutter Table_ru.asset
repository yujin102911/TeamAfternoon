      m_Items: []
  - m_Id: 2049569972312
    m_Localized: "\U0001F62D\U0001F62DHe is alive\U0001F62D\U0001F62D"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972313
    m_Localized: "\u0412\u043E\u0442 \u043E\u043D, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0413\u0435\u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972314
    m_Localized: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E, \u043E\u0434\u043D\u0438\u043C
      \u0432\u0438\u0434\u0435\u043E \u0437\u0430\u043A\u0440\u044B\u043B \u0432\u0441\u0435
      \u0441\u043B\u0443\u0445\u0438 \u043E \u0444\u0435\u0439\u043A\u0435, \u0443\u0431\u0438\u043B
      \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044F \u0434\u0435\u043C\u043E\u043D\u043E\u0432
      \u0438 \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043B \u0433\u0435\u0440\u043E\u0435\u043C
      \u2014 \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u043D\u0435 \u0431\u043E\u0433,
      \u0442\u043E \u043A\u0442\u043E \u0442\u043E\u0433\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972315
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E, \u043C\u044B \u0432\u0435\u0434\u044C
      \u0432\u0435\u0440\u0438\u043B\u0438 \u0432 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972316
    m_Localized: "3:22 \u0413\u0435\u0440\u043E\u0439 \u0442\u0430\u043C \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435\u0440\u0435\u0430\u043B\u044C\u043D\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972317
    m_Localized: "\u042F \u043F\u0440\u0430\u0432\u0434\u0430 \u0436\u0438\u0432\u0443
      \u0440\u0430\u0434\u0438 [ENTER_TITLE]."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972318
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0432\u0438\u0434\u0435\u043E
      \u043D\u0435 \u0432\u044B\u0448\u043B\u043E, \u044F \u0431\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u043C\u0435\u0440, \u0430 \u0413\u0435\u0440\u043E\u0439
      \u0441\u043F\u0430\u0441 \u0441\u0442\u0440\u0430\u043D\u0443, \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443
      \u0438 \u043C\u0435\u043D\u044F \u0437\u0430\u043E\u0434\u043D\u043E. \u041E\u043D
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0433\u0435\u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972319
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442-\u043F\u0440\u0438\u0432\u0435\u0442,
      \u043D\u0430\u0440\u043E\u0434 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430~
      \u0441 \u0432\u0430\u043C\u0438 \u0413\u0435\u0440\u043E\u0439.\\n\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
      \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0435\u0440\u0438\u044F\u0430\u0445\u0430\u0445
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0435 \u0432\u0438\u0434\u0435\u043E
      \u2014 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E
      <[ENTER_TITLE]>.\\n\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437
      \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u0435\u0441\u0442\u0438
      \u043F\u0440\u044F\u043C\u0443\u044E \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u044E
      \u0441 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0438 \u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u044F,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0440\u0435\u043C\u044F \u043F\u0443\u0431\u043B\u0438\u043A\u0430\u0446\u0438\u0438
      \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C, \u043D\u0435
      \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F\u0430\u0445\u0430\u0445\\n\u0415\u0441\u043B\u0438
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u041D\u044C\u044E\u0422\u044C\u044E\u0431\u0435,
      \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
      \u0441\u0435\u0440\u0438\u0438 \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0438 \u043F\u0440\u044F\u043C\u043E\u0439
      \u044D\u0444\u0438\u0440 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0438
      \u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u044F\u314E\\n\u0422\u043E\u0433\u0434\u0430
      \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u043D\u0430 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0438,
      \u043C\u043E\u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043C\u0438\u043B\u044B\u0435
      \u043F\u043E\u0434\u0434\u0430\u043D\u043D\u044B\u0435\U0001F339"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972320
    m_Localized: "\u0412\u0430\u0443, \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u044F
      \u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u044F?! \u0413\u0435\u0440\u043E\u0439
      \u0441\u043F\u0430\u0441 \u0441\u0442\u0440\u0430\u043D\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972321
    m_Localized: "\u041D\u0443 \u0442\u0430\u043A \u043E\u043D \u0443\u0436\u0435
      \u0441\u043F\u0430\u0441 \u0435\u0451~"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972322
    m_Localized: "\u041E\u043D \u0436\u0435 \u0433\u0435\u0440\u043E\u0439, \u043F\u043E\u0431\u0435\u0434\u0438\u0432\u0448\u0438\u0439
      \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044F \u0434\u0435\u043C\u043E\u043D\u043E\u0432
      \u0438 \u0441\u043F\u0430\u0441\u0448\u0438\u0439 \u0441\u0442\u0440\u0430\u043D\u0443,
      \u0442\u0430\u043A \u0447\u0442\u043E \u044D\u0442\u043E \u0437\u0430\u0441\u043B\u0443\u0436\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972323
    m_Localized: "\u0413\u0435\u0440\u043E\u0439 \u0434\u0430\u0436\u0435 \u043D\u0430
      \u0441\u0442\u0440\u0438\u043C\u0435 \u0431\u0435\u0437\u0443\u043C\u043D\u043E
      \u043A\u0440\u0430\u0441\u0438\u0432\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972324
    m_Localized: "\u0416\u0430\u0440\u0438\u043B \u0440\u0438\u0441, \u0441\u043C\u043E\u0442\u0440\u044F
      \u044D\u0442\u043E \u0432\u0438\u0434\u0435\u043E, \u0438 \u0440\u0438\u0441
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0441\u0430\u043C \u0441\u043E\u0431\u043E\u0439
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972325
    m_Localized: "\u0413\u0435\u0440\u043E\u0439. \u0418 \u0441\u0435\u0433\u043E\u0434\u043D\u044F.
      \u0412\u044B \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u044B.
      Good. <[ENTER_TITLE]> \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972326
    m_Localized: "\u042F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043A\u043D\u043E\u043F\u043A\u0443
      \u041E\u043C\u043D\u0438\u043A\u0440\u043E\u043D.\\n\u0412\u0441\u0451 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u043C\u043E\u0435\u043C\u0443 \u0442\u0430\u043B\u0430\u043D\u0442\u0443 \u0438
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0435 \u0432\u0430\u0441,
      \u0436\u0438\u0442\u0435\u043B\u0438 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430\u0430\u0445\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972327
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972328
    m_Localized: Congrats! You deserve it!
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972329
    m_Localized: "\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0435\u0451 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u0430\u0440\u043D\u0438 \u0438\u0437 VTS\u2026 \u043C\u043E\u0439
      \u043C\u0438\u0440 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u0443\u0445\u043D\u0443\u043B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972330
    m_Localized: "\u041D\u043E \u044D\u0442\u043E\u0442 \u043F\u0430\u0440\u0435\u043D\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0436 \u0441\u0430\u043C\u043E\u0432\u043B\u044E\u0431\u043B\u0451\u043D.
      \u0414\u0430, \u0441\u0442\u0440\u0430\u043D\u0443 \u0441\u043F\u0430\u0441
      \u2014 \u044D\u0442\u043E \u043A\u0440\u0443\u0442\u043E, \u043D\u043E \u0438\u0437-\u0437\u0430
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F \u0441\u043A\u0440\u043E\u043C\u043D\u043E\u0441\u0442\u0438
      \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972331
    m_Localized: "\u0413\u0435\u0440\u043E\u044E \u043C\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972332
    m_Localized: "\u041C\u043D\u0435 \u043E\u043D \u0442\u043E\u0436\u0435 \u0438\u043D\u043E\u0433\u0434\u0430
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0437\u0430\u043D\u043E\u0441\u0447\u0438\u0432\u044B\u043C\u2026
      \u043D\u043E \u0442\u0430\u043B\u0430\u043D\u0442 \u0443 \u043D\u0435\u0433\u043E
      \u043D\u0435 \u043E\u0442\u043D\u044F\u0442\u044C("
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972333
    m_Localized: "\u0415\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0432\u0438\u0434\u0443\u0435\u0448\u044C,
      \u0434\u0430???"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972334
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0439
      \u0434\u0432\u043E\u0440 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u0437\u0430\u044F\u0432\u0438\u043B: \xAB\u0411\u0440\u0430\u043A \u0413\u0435\u0440\u043E\u044F
      \u0438 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B \u2014 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0430\u044F
      \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044F\u2026 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B.\xBB\\n\u0422\u0430\u043A\u0436\u0435
      \u043A\u043E\u0440\u043E\u043B\u044C \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u043D\u043E
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B: \xAB\u0415\u0441\u043B\u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0441\u0442\u0430\u0440\u044B\u043C \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044F\u043C,
      \u0442\u043E \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C \u0442\u0430\u043A\u0438\u043C\u0438 \u0436\u0435\u2026
      \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u044D\u0442\u043E, \u0435\u0441\u043B\u0438 \u0413\u0435\u0440\u043E\u0439
      \u043F\u043E\u0431\u0435\u0434\u0438\u0442 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F
      \u0442\u0440\u0451\u0445 \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u0435\u0439
      \u0434\u0435\u043C\u043E\u043D\u043E\u0432.\xBB \u0418 \u0435\u0449\u0451:
      \xAB\u0412\u044B\u0434\u0430\u0432\u0430\u0442\u044C \u0434\u043E\u0447\u044C
      \u0437\u0430\u043C\u0443\u0436 \u0437\u0430 \u043F\u043E\u0431\u0435\u0434\u0443
      \u0432\u0441\u0435\u0433\u043E \u043D\u0430\u0434 \u043E\u0434\u043D\u0438\u043C
