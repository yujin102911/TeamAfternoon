      m_Items: []
  - m_Id: 2049569972309
    m_Localized: "\u0427\u0442\u043E, \u043E\u043D \u0435\u0449\u0451 \u0438 \u0441
      \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u0435\u043C \u0434\u0435\u043C\u043E\u043D\u043E\u0432
      \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F? \u042D\u0442\u043E
      \u0436\u0435 \u0431\u0438\u0442\u0432\u0430 \u0432\u0435\u043A\u0430, \u0430\u0436
      \u0434\u0443\u0445 \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972310
    m_Localized: "<[ENTER_TITLE]> \u2014 \u044F \u0442\u0430\u043A \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972311
    m_Localized: "\u041D\u0443 \u0438 \u043D\u0430\u043F\u0443\u0433\u0430\u043B
      \u0436\u0435, \u0433\u043B\u0430\u0432\u043D\u043E\u0435, \u0447\u0442\u043E
      \u0436\u0438\u0432 \u0438 \u0437\u0434\u043E\u0440\u043E\u0432."
