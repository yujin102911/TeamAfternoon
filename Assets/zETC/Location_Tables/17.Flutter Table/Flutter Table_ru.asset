  - m_Id: 2049569972262
    m_Localized: "\u0421\u043A\u0430\u043D\u0434\u0430\u043B\u044C\u043D\u043E\u0435
      \u0432\u0438\u0434\u0435\u043E \xAB\u0413\u0435\u0440\u043E\u0439 \u2014 \u044D\u0442\u043E
      \u0432\u0441\u0451 \u043A\u043E\u0441\u043F\u043B\u0435\u0439\xBB.\\n\u041F\u043E
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C \u0430\u043D\u0430\u043B\u0438\u0437\u0430
      \u0441\u043F\u043E\u0440\u043D\u043E\u0439 \u0441\u0446\u0435\u043D\u044B \u0441
      \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C \u0438 \u043A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u0435\u0439
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u0433\u043E
      Neum News, \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435
      \u0434\u0435\u043C\u043E\u043D\u0430 \u0410 \u043E \xAB\u0448\u0435\u0441\u0442\u0438
      \u043F\u0430\u043B\u044C\u0446\u0430\u0445\xBB \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u043E\u0441\u044C.
      \u0422\u043E, \u0447\u0442\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u043E
      \u043A\u0430\u043A \u043B\u0438\u0448\u043D\u0438\u0439 \u043F\u0430\u043B\u0435\u0446,
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
      \u0444\u043E\u043D\u0430, \u0432\u044B\u0437\u0432\u0430\u0432\u0448\u0438\u043C
      \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0438\u043B\u043B\u044E\u0437\u0438\u044E.\\n\u0422\u0435\u043C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0444\u0430\u043D-\u043A\u043B\u0443\u0431 \u0413\u0435\u0440\u043E\u044F
      \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B \u0413\u0435\u0440\u043E\u044F\xBB
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B \u043E \u0436\u0451\u0441\u0442\u043A\u0438\u0445
      \u043C\u0435\u0440\u0430\u0445 \u043F\u0440\u043E\u0442\u0438\u0432 \u0434\u0435\u043C\u043E\u043D\u0430
      \u0410 \u0437\u0430 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435
      \u043B\u043E\u0436\u043D\u043E\u0439 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
      \u0438 \u043A\u043B\u0435\u0432\u0435\u0442\u0443.\\n\\n#NeumNews #\u0421\u043A\u0430\u043D\u0434\u0430\u043B\u0413\u0435\u0440\u043E\u044F
      #\u041F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435\u0412\u041C\u043E\u043D\u0442\u0430\u0436\u0435
