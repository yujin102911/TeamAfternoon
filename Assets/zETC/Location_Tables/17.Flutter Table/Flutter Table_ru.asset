  - m_Id: 2049574166560
    m_Localized: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u044D\u0442\u043E \xAB\u0421\u043B\u0443\u0436\u0430\u043D\u043A\u0438 \u0413\u0435\u0440\u043E\u044F\xBB.\\n\u041F\u043E
      \u0434\u0435\u043B\u0443 \u043E \u0437\u043B\u043E\u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439
      \u043A\u043B\u0435\u0432\u0435\u0442\u0435 \u0438 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0438
      \u043B\u043E\u0436\u043D\u043E\u0439 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
      \u0432 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0438 \u0413\u0435\u0440\u043E\u044F
      \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0410\u0441\u0435\u043D\u0434\u0440\u044B
      (@assendrasyopyop) \u0441\u0443\u0434 \u0432\u044B\u043D\u0435\u0441 \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440
      \u2014 \u0448\u0442\u0440\u0430\u0444 \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435
      3000 \u0434\u0438\u043D\u0430\u0440\u043E\u0432. \u041E\u0434\u043D\u0430\u043A\u043E,
      \u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0432\u0448\u0438\u0441\u044C
      \u0441 \u043E\u0442\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435\u043C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0439, \u043F\u043E\u0441\u043B\u0435
      \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u0446\u0438\u0439 \u0441
      \u0433\u0440\u0430\u0444\u0441\u043A\u0438\u043C \u0434\u043E\u043C\u043E\u043C
      \u043C\u044B \u043F\u0440\u0438\u043D\u044F\u043B\u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u043F\u043E\u0434\u0430\u0442\u044C \u0430\u043F\u0435\u043B\u043B\u044F\u0446\u0438\u044E.\\n\u041C\u044B,
      \u0413\u0435\u0440\u043E\u0439 \u0438 \u0435\u0433\u043E \u0441\u043B\u0443\u0436\u0430\u043D\u043A\u0438,
      \u043E\u0431\u0435\u0449\u0430\u0435\u043C \u0438 \u0434\u0430\u043B\u044C\u0448\u0435
      \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435
      \u0434\u043B\u044F \u0435\u0433\u043E \u0437\u0430\u0449\u0438\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2049574166561
    m_Localized: "3000 \u0434\u0438\u043D\u0430\u0440\u043E\u0432? \u0422\u0443\u0442
      \u0441\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u0435\u0441\u0442\u044C
      \u0441\u0432\u044F\u0437\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2049574166562
    m_Localized: "\u042F \u0438\u0437 \u0441\u0435\u043C\u044C\u0438 \u044E\u0440\u0438\u0441\u0442\u043E\u0432,
      \u0438 \u0434\u0430 \u2014 \u0442\u0443\u0442 \u044F\u0432\u043D\u043E \u0432\u0441\u0451
      \u043F\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2049574166563
    m_Localized: "\u042F \u043F\u0440\u0430\u0432\u0434\u0430 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E:
      \u043A\u0430\u043A \u0431\u044B\u0432\u0448\u0438\u0439 \u0434\u0435\u043C\u043E\u043D
      \u0432\u043E\u043E\u0431\u0449\u0435 \u043C\u043E\u0436\u0435\u0442 \u0438\u043C\u0435\u0442\u044C
      \u0441\u0432\u044F\u0437\u0438 \u0432 \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u043A\u0440\u0443\u0433\u0430\u0445\u2026? \u0420\u0435\u0430\u043B\u044C\u043D\u043E
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2049574166564
    m_Localized: "\u0427\u0435\u043C \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0441\u0443\u0434? \u042D\u0442\u043E \u0436\u0435 \u043F\u044F\u0442\u043D\u043E
      \u043D\u0430 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439
      \u0441\u0435\u043C\u044C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2049574166565
    m_Localized: "\u0414\u0430 \u0432\u043B\u0435\u043F\u0438\u0442\u0435 \u0443\u0436\u0435
      \u0435\u043C\u0443 \u0441\u0442\u0430\u0442\u044C\u044E \u0437\u0430 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u0438\u0437\u043C\u0435\u043D\u0443, \u0447\u0442\u043E \u0442\u0430\u043A
      \u0442\u044F\u043D\u0443\u0442\u044C-\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2049574166566
    m_Localized: "\u042D? \u041D\u043E \u0435\u0441\u043B\u0438 \u0437\u0430 \u0442\u0430\u043A\u043E\u0435
      \u0434\u0430\u0432\u0430\u0442\u044C \u0438\u0437\u043C\u0435\u043D\u0443,
      \u0440\u0430\u0437\u0432\u0435 \u044D\u0442\u043E \u043D\u0435 \u0435\u0449\u0451
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0431\u044C\u0451\u0442 \u043F\u043E
      \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u0443 \u043A\u043E\u0440\u043E\u043D\u044B?"
    m_Metadata:
