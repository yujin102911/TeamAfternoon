  - m_Id: 999834947674112
    m_Localized: "\u041F\u043E\u0434\u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E
      \u0413\u0435\u0440\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839936
    m_Localized: "[Notice] \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u0430\u043D\u0438\u0435 \u0437\u0430
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0444\u0430\u043D\u0434\u043E\u043C\u0430
      \u0413\u0435\u0440\u043E\u044F! \u2665\uFE0F\n1. \u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B
      \u0413\u0435\u0440\u043E\u044F (Hero's Princess)\n\n\u041F\u0440\u0438\u0447\u0438\u043D\u0430:
      \u041D\u0430\u0448\u0430 \u043A\u043B\u044F\u0442\u0432\u0430 \u0443\u0441\u0442\u0438\u043B\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C \u0413\u0435\u0440\u043E\u044F \u0446\u0432\u0435\u0442\u0430\u043C\u0438.
      \u0410\u043D\u0442\u0438-\u043A\u043B\u0438\u0448\u0435: \u043A\u043E\u0433\u0434\u0430
      \u0413\u0435\u0440\u043E\u0439 \u0432 \u0431\u0435\u0434\u0435, \u043C\u044B
      \u0441\u0430\u043C\u0438 \u0441\u043F\u0430\u0441\u0430\u0435\u043C \u0435\u0433\u043E
      (\u0430 \u0442\u0430\u043A\u0436\u0435 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u043C
      \u0435\u0433\u043E \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043D\u0430\u0448\u0438\u0445
      \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u043E\u0432).\n\n\u0421\u043B\u043E\u0433\u0430\u043D:
      \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B, \u0432\u043F\u0435\u0440\u0435\u0434
      \u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u043D\u0430\u0448\u0435\u0433\u043E
      \u0413\u0435\u0440\u043E\u044F!\xBB\n\n2. \u0421\u0442\u0440\u0430\u0436\u0430
      \u0413\u0435\u0440\u043E\u044F (Warrior's Vanguard)\n\n\u041F\u0440\u0438\u0447\u0438\u043D\u0430:
      \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u0442
      \u0430\u0440\u043C\u0438\u044F \u041F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044F
      \u0414\u0435\u043C\u043E\u043D\u043E\u0432, \u043C\u044B \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0438\u043C
      \u0438\u043C \u043F\u0443\u0442\u044C! \u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0432\u043E\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u044C
      \u0438 \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044F \xAB\u043D\u0430\u0434\u0435\u0436\u043D\u043E\u0433\u043E
      \u0449\u0438\u0442\u0430\xBB.\n\n\u0421\u043B\u043E\u0433\u0430\u043D: \xAB\u0413\u0435\u0440\u043E\u0439,
      \u0442\u044B \u0430\u0442\u0430\u043A\u0443\u0439. \u041C\u044B \u0432\u043E\u0437\u044C\u043C\u0435\u043C
      \u043D\u0430 \u0441\u0435\u0431\u044F \u0437\u0430\u0449\u0438\u0442\u0443\xBB.\n\n\u041F\u0440\u043E\u0441\u0438\u043C
      \u0432\u0441\u0435\u0445 \u0441\u043E\u0440\u0430\u0442\u043D\u0438\u043A\u043E\u0432
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u0432\u043E\u0439 \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u043D\u044B\u0439
      \u0432\u044B\u0431\u043E\u0440!\n#\u0421\u0432\u044F\u0442\u043E\u0439\u0412\u043E\u0438\u043D
      #\u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u0424\u0430\u043D\u0434\u043E\u043C\u0430
      #\u0413\u043E\u043B\u043E\u0441\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839937
    m_Localized: "1-\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u2014 \u044D\u0442\u043E
      \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0438\u043D\u0436\U0001F605 \u042F
      \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0438\u0441\u043F\u0430\u0440\u044E\u0441\u044C
      \u043E\u0442 \u0441\u0442\u044B\u0434\u0430, \u0435\u0441\u043B\u0438 \u0413\u0435\u0440\u043E\u0439
      \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u043D\u0430\u0437\u043E\u0432\u0435\u0442
      \u043D\u0430\u0441 \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430\u043C\u0438\xBB.
      \u041D\u043E \u0432 \u044D\u0442\u043E\u043C \u0447\u0442\u043E-\u0442\u043E
      \u0435\u0441\u0442\u044C... \u0412 \u043E\u0431\u0449\u0435\u043C, \u0433\u043E\u043B\u043E\u0441\u0443\u044E
      \u0437\u0430 1."
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839938
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E 2-\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442,
      \u0421\u0442\u0440\u0430\u0436\u0430! \u041D\u0430\u0448 \u0412\u043E\u0438\u043D
      \u0442\u0430\u043A\u043E\u0439 \xAB\u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0439\xBB,
      \u0447\u0442\u043E \u0435\u0433\u043E \u0431\u044B \u043B\u044E\u0431\u043E\u0439
      \u0433\u043E\u0431\u043B\u0438\u043D \u0440\u0430\u0437\u0434\u0430\u0432\u0438\u043B,
      \u0435\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839939
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \xAB\u041A\u043E\u0432\u0440\u0438\u043A
      \u0413\u0435\u0440\u043E\u044F\xBB \u043D\u0435 \u043F\u0440\u043E\u0448\u0435\u043B
      \u0432 \u0444\u0438\u043D\u0430\u043B?? \U0001F630 \u0410\u0434\u043C\u0438\u043D\u044B,
      \u0447\u0442\u043E \u0437\u0430 \u043F\u0440\u0435\u0434\u0432\u0437\u044F\u0442\u043E\u0441\u0442\u044C?
      \u0412\u044B \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u0435\u0442\u0435
      \u043C\u043E\u0438 \u0438\u0434\u0435\u0438 \u0446\u0435\u043B\u0443\u044E
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C!"
    m_Metadata:
      m_Items: []
