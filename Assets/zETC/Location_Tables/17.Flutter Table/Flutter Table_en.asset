    m_Metadata:
      m_Items: []
  - m_Id: 2049569972300
    m_Localized: I'm so worried I could die...
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972301
    m_Localized: The spelling is kind of a disaster, though.
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972302
