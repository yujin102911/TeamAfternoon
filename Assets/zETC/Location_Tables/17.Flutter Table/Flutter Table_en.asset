      m_Items: []
  - m_Id: 2049569972282
    m_Localized: "No way... \U0001F480\U0001F480"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972283
    m_Localized: Didn't the Holy Warrior say he was meeting the Demon King today...?
