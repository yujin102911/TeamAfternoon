  m_TableData:
  - m_Id: 2049427365888
    m_Localized: "\uC548\uB155\uD558\uC138\uC694 \uC774\uBC88 \uACF5\uC8FC\uAD6C\uD558\uAE30
      \uB300\uC791\uC804\uC758 \uC6A9\uC0AC\uC785\uB2C8\uB2E4 \n\uC624\uB298\uBD80\uD130
      \uB358\uC804 \uB4E4\uC5B4\uAC00\uB2C8 \uBE60\uB974\uBA74 \uB0B4\uC77C\uCBE4
      \uB274\uD2AD \uC601\uC0C1 \uC62C\uB77C\uC62C \uAC81\uB2C8\uB2E4 \n<\uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30> \uBC31\uC131\uB4E4\uC758 \uB9CE\uC740 \uAE30\uB300\uC640
      \uC751\uC6D0 \uBD80\uD0C1\uD574\uC694 \n\uAD6C\uB3C5\uACFC \uC54C\uB9BC\uC124\uC815
      \uC78A\uC9C0\uB9C8\uC2DC\uACE0\u314E"
    m_Metadata:
      m_Items: []
  - m_Id: 2049561583616
    m_Localized: "\uC544 \uC774 \uC0AC\uB78C\uC774 \uADF8 \uC6A9\uC0AC?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049561583617
    m_Localized: "\uB5B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2049561583618
    m_Localized: "\uAC00\uC988\uC544"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777920
    m_Localized: "\uC6A9\uC0AC\uB2D8\u2026 \uC800\uD76C\uC758 \uD76C\uB9DD\uC774\uC2ED\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777921
    m_Localized: "\uC655\uC2E4 \uACB0\uC815\uC774\uC9C0\uB9CC \uC194\uC9C1\uD788
      \uC880 \uBD88\uC548\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777922
    m_Localized: "\uB9C8\uC655 \uD1A0\uBC8C\uC740 \uAE30\uB300\uB3C4 \uC548 \uD55C\uB2E4
      \uACF5\uC8FC\uB2D8 \uB0A9\uCE58\uB9CC \uB9C9\uC544\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777923
    m_Localized: "\uACF5\uC8FC\uB2D8 \uB0A9\uCE58\uB418\uBA74 \uC6A9\uC0AC\uB791
      \uAC19\uC774 \uC8FD\uC74C \u3147\u3147"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777924
    m_Localized: "\uC81C\uBC1C \uACF5\uC8FC\uB2D8 \uBB34\uC0AC\uD558\uAE38"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777925
    m_Localized: "\uC640\uC911\uC5D0 \uC774\uAC78 \uB274\uD29C\uBE0C\uB85C \uD558\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777926
    m_Localized: "\uC6CC\uB099 \uAC70\uAD6D\uC801 \uC0C1\uD669\uC774\uB2E4\uBCF4\uB2C8
      \uBC29\uC1A1 \uACB0\uC815\uD55C\uAC70 \uC544\uB2D8?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777927
    m_Localized: "\uB531\uBD10\uB3C4 \uAC4D \uC5B4\uADF8\uB85C\uC778\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777928
    m_Localized: "\uB09C \uC6A9\uC0AC \uBBFF\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777929
    m_Localized: "Hello World. \uB2E4\uB4E4 \uAE30\uB2E4\uB9AC\uACE0 \uACC4\uC168\uB098\uC694?
      \uC6A9\uC0AC\uC785\uB2C8\uB2E4. \n\uC5EC\uB7EC\uBD84\uC774 \uAE30\uB2E4\uB9AC\uC2DC\uB358
      \uBC14\uB85C \uADF8 \uC601\uC0C1 <[ENTER_TITLE]> \uC785\uB2C8\uB2E4 \n\uC774\uBE14\uC544\uC774\uCBE4\uC740
      \uAC04\uB2E8\uD558\uAC8C \uC7A1\uC558\uC8E0 \n\uB108\uBB34 \uC27D\uAC8C \uC7A1\uC544\uC11C
      \uC601\uC0C1 \uAE38\uC774\uAC00 \uC9E7\uC544\uC9C4 \uAC70 \uAC19\uC544\uC11C
      \uC544\uC27D\uB124\uC694 \n\uD558\uC9C0\uB9CC \uC55E\uC73C\uB85C\uB3C4 \uB354
      \uBA4B\uC9C0\uACE0 \uC7AC\uBC0C\uB294 \uB358\uC804 \uC601\uC0C1 \uB4E4\uACE0
      \uC62C\uD14C\uB2C8\uAE4C \uAE30\uB300\uD574\uC8FC\uC2DC\uB77C\uACE0~"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777930
    m_Localized: "\uD5C9 \uC18C\uBB38\uC73C\uB85C\uB9CC \uB4E3\uB358 \uBC31\uC791\uAC00\uC758
      \uC790\uC81C\u2026 \uB2F9\uC2E0\uC774\uC5C8\uAD70\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777931
    m_Localized: "\uC18C\uBB38\uBCF4\uB2E4 \uD6C8\uD6C8\uD55C\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777932
    m_Localized: "\u3147\u3147\u3147\uC55E\uC73C\uB85C \uC601\uC0C1 \uBCFC\uB9DB
      \uB0A0\uB4EF"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777933
    m_Localized: "\uC544 \uADF8\uC815\uB3C4\uC778\uAC00 \uB0B4 \uCDE8\uD5A5\uC740
      \uC544\uB2D8"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777934
    m_Localized: ";;\uC774\uC815\uB3C4\uBA74 \uC798\uC0DD\uAE34 \uAC70\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777935
    m_Localized: "\uC640\u2026 [ENTER_TITLE] \uB108\uBB34 \uAE30\uB2E4\uB838\uC5B4\uC694
      \u315C\u315C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777936
    m_Localized: "222 \uB098\uB3C4\uB098\uB3C4 \u315C\u315C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777937
    m_Localized: "333\u315C\u315C\u315C\u315C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777938
    m_Localized: "\uC640 \uBBF8\uCE5C \uC870\uD68C\uC218 \uBB34\uC5C7"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777939
    m_Localized: "\uC5B4\uCF00\uD588\uB204"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777940
    m_Localized: "\uB108\uBB34 \uC9E7\uC544\uC694\u315C\u315C\u315C \uB354 \uAC00\uC838\uC640
      \uB2F9\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777941
    m_Localized: "\uAD6C\uB3C5\uC790 \uC218 \uC2E4\uC2DC\uAC04\uC73C\uB85C \uB290\uB124\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777942
    m_Localized: "\uC138\uACC4 \uC2E0\uAE30\uB85D \uC138\uC6B0\uB294 \uC911 \u3137\u3137"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777943
    m_Localized: "\uC544\uC9C1 \uC6B0\uB9AC VTS \uC624\uBE60\uB4E4 \uB118\uC73C\uB824\uBA74
      \uBA40\uC5C8\uAC70\uB4E0 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777944
    m_Localized: "\uAC1C\uBE60\uB974\uB124 \uC9C4\uC9DC \uC0AC\uAE30\uB77C \uD574\uB3C4
      \uBBFF\uC744\uB4EF\u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777945
    m_Localized: "\u3139\u3147 \uC655\uC2E4 \uC65C\uC774\uB807\uAC8C \uC77C \uC798\uD568?
      \uC544\uC8FC \uCE6D\uCC2C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777946
    m_Localized: "\uCCAB \uC601\uC0C1 \uC870\uD68C\uC218\uAC00 \uCC9C\uB9CC\uC774\uB77C\uB2C8
      \n\uBC31\uC131\uB4E4 \uC774\uC81C \uAD6C\uB3C5\uB3C4 \uB354 \uC5F4\uC2EC\uD788
      \uB20C\uB7EC\uC57C\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777947
    m_Localized: "\uC544\uC9C1\uB3C4 \uB204\uAC00 \uC548 \uB20C\uB800\uB0D0"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777948
    m_Localized: "\uAD6C\uB3C5\uD588\uC5B4\uC694\u2665\uFE0F"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777949
    m_Localized: "\uC138\uACC4 // \uCD5C \uACE0\uC758 \uC601\uC0C1 // \uC9C0\uAE08
      \uB2F9\uC7A5 [ENTER_TITLE] //"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777950
    m_Localized: "\uB2F9\uC7A5 \uB2EC\uB824\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777951
    m_Localized: "\uB208\uD305\uC871\uC778\uB370 \uC774\uAC70\uBCF4\uACE0 \uAD6C\uB3C5\uD588\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777952
    m_Localized: "\uD558\uC774 \uBC31\uC131 \uC5EC\uB7EC\uBD84 \uC6A9\uC0AC\uC785\uB2C8\uB2E4
      \n\uC774\uD2C0\uCC28 \uC601\uC0C1\uC740 <[ENTER_TITLE]>\uC785\uB2C8\uB2E4 \n\uC0B4\uC778\uBC84\uC12F
      \uC8FD\uC778 \uB2E4\uC74C\uC5D0 \uAD6C\uC6CC\uBA39\uC5C8\uB294\uB370 \uB9DB\uC788\uB354\uB77C\uAD6C\uC6A4\u314E
      \n\uB2ED\uACE0\uAE30\uB3C4 \uADF8\uB807\uACE0 \uBC84\uC12F\uB3C4 \uD655\uC2E4\uD788
      \uBC1C \uBD80\uBD84 \uC880 \uB9DB\uC788\uB294 \uB290\uB08C? \n\uBC84\uC12F
      \uC88B\uC544\uD558\uC2DC\uB294 \uBD84\uB4E4\uC740 \uD55C\uBC88 \uCE04\uB77C\uC774
      \uD574\uBCF4\uC154\uB3C4 \uC88B\uC744\uB4EF~ \n\uB2E4\uC74C\uC5D4 \uB354 \uBA4B\uC9C4
      \uC601\uC0C1\uC73C\uB85C \uB3CC\uC544\uC62C\uD14C\uB2C8 \uBAA8\uB450 \uC88B\uC544\uC694
      \uAD6C\uB3C5 \uC54C\uB9BC\uC124\uC815 \uB20C\uB7EC\uB450\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777953
    m_Localized: "\uC544\uB2C8 \uC800 \uBC84\uC12F\uC744 \uC5B4\uCF00 \uBA39\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777954
    m_Localized: "\uC57C \uC694\uC998\uC5D4 \uB358\uC804 \uBAAC\uC2A4\uD130 \uBA39\uB294
      \uAC8C \uC720\uD589\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777955
    m_Localized: ";; \uC5B4\uB514\uC11C \uC720\uD589\uD558\uB294 \uAC70\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777956
    m_Localized: "\uB108 \uB358\uC804\uBE75, \uD130\uBB34\uB2C8 \uC5C6\uB294 \uC2A4\uD0AC\uB85C
      \uC774\uC138\uACC4 \uBC29\uB791\uBE75 \uBAB0\uB77C??"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777957
    m_Localized: "\uB098 68\uC138\uC778\uB514 [ENTER_TITLE]\uBCF4\uACE0 \uC0B4\uC778\uBC84\uC12F
      \uBA39\uC73C\uB7EC \uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777958
    m_Localized: "\uC785\uB355 \uBD80\uC815\uAE30 \uACAA\uC5C8\uB294\uB370 \uC774\uC81C\uB294
      \uC778\uC815\uD560 \uC218\uBC16\uC5D0 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777959
    m_Localized: "\uC57C\uB108\uB450??"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777960
    m_Localized: "\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4 \uC808\uCC2C \uBAA8\uC9D1\uC911(1/10000)"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777961
    m_Localized: "\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4 \uC808\uCC2C \uBAA8\uC9D1\uC911(2/10000)"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777962
    m_Localized: "\uADFC\uB370 \uC774 \uC6A9\uC0AC\uB294 \uC65C \uBAAC\uC2A4\uD130\uB791
      \uC2F8\uC6B0\uB294 \uAC70 \uAC19\uC9C0\uAC00 \uC54A\uC9C0?? \uD798\uB4E4\uC5B4\uD558\uC9C0\uB3C4
      \uC54A\uACE0 \uB108\uBB34 \uBA40\uCA61\uD574\uBCF4\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777963
    m_Localized: "\uC544\uB2C8 \uADF8\uB2C8\uAE4C\u2026\uB098\uB9CC \uADF8\uB807\uAC8C
      \uC0DD\uAC01\uD558\uB294 \uAC8C \uC544\uB2C8\uC5C8\uAD6C\uB098.."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777964
    m_Localized: "\uAC4D \uBB34\uC220\uC2E4\uB825\uC774 \uC9C0\uB9AC\uB294\uAC70
      \uC544\uB2D8?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777965
    m_Localized: "\uC655\uAD6D \uCD5C\uACE0\uC758 \uC694\uB9AC\uC0AC\uB97C \uBF51\uB294\uB2E4,
      \uB358\uC804 \uC694\uB9AC\uC0AC\uC785\uB2C8\uB2E4. \n\uC774\uBC88 \uC601\uC0C1\uB3C4
      \uC7AC\uBC0C\uAC8C \uBCF4\uC168\uB098\uC694? \n\uC7A5\uC548\uC758 \uD654\uC81C\uAC70\uB9AC\uC600\uB358
      \uADF8 \uC74C\uC2DD! [\uC2EC\uC0AC\uC704\uC6D0\uC758 \uC548\uB300\uB97C \uBC97\uAE34
      \uADF8 \uB9DB: \uD0AC\uB7EC \uBA38\uC26C\uB8F8 \uC2A4\uD14C\uC774\uD06C] \uC600\uC2B5\uB2C8\uB2E4.
      \n\n\uACFC\uC5F0 \uB05D\uAE4C\uC9C0 \uC0DD\uC874\uD560 \uD300\uC740\u2026?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777966
    m_Localized: "\u3137\u3137 \uBB3C \uB4E4\uC5B4\uC62C \uB54C \uB178 \uAC1C \uC5F4\uC2EC\uD788
      \uC800\uC73C\uC2DC\uB124 ;;"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777967
    m_Localized: "\uC5B4\uB978\uB9F9\uC218 \uAEBC \uC694\uB9AC \uC88B\uC558\uB294\uB370..\uB5A8\uC5B4\uC9C4
      \uAC70 \uC880 \uC758\uC678"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777968
    m_Localized: "\uB09C \uC544\uC9C1\uB3C4 \uB358\uC804 \uBAAC\uC2A4\uD130 \uC694\uB9AC\uB294
      \uC880\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777969
    m_Localized: "\uAD73\uC774\uAD73\uC774 \uC5EC\uAE30\uAE4C\uC9C0 \uC640\uC11C
      \uB313\uAE00 \uC4F0\uB294 \uC815\uC131 \uBCF4\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777970
    m_Localized: "\uC544 \uBCF4\uB2C8\uAE4C \uB610 \uBC30\uACE0\uD504\uB124\u2026
      \uBA39\uBC29 \uBD10\uC57C\uACA0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777971
    m_Localized: "\uC5B4\uC9DC\uD53C \uC9ED\uC778\uB370 \uCC10\uC774\uB791 \uBABB\uBE44\uBE44\uC96C"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777972
    m_Localized: "\uC694\uB9AC\uC758 \uAE30\uBCF8\uC740 \uC775\uD798. \uADF8. \uC911\uC694\uC131\uC744.
      \uC54C\uB824\uC8FC\uB294 \uC601\uC0C1\uC544\uC8FC \uC720\uC775\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777973
    m_Localized: "[NOTICE] \uC6A9\uC0AC \uACF5\uC2DD \uD32C\uB364\uBA85 \uD655\uC815
      \uBC0F 1\uAE30 \uBAA8\uC9D1 \uC548\uB0B4 \U0001F451\n\uB204\uB9AC\uAFBC \uBC31\uC131
      \uC5EC\uB7EC\uBD84\uC758 \uC555\uB3C4\uC801\uC778 \uD22C\uD45C \uACB0\uACFC\uB85C,
      \uACF5\uC2DD \uD32C\uB364\uBA85\uC774 \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4(Hero's
      Princess)\u2019\uB85C \uCD5C\uC885 \uACB0\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4!\n\uC6A9\uC0AC\uB2D8\uC758
      \uB9C8\uC655 \uC815\uBC8C \uB300\uC7A5\uC815, \uADF8 \uC704\uB300\uD55C \uCCAB\uAC78\uC74C\uC744
      \uAC00\uC7A5 \uAC00\uAE4C\uC774\uC11C \uD568\uAED8\uD560 \u20181\uAE30 \uACF5\uC8FC\uB2D8\u2019\uB4E4\uC744
      \uBAA8\uC2ED\uB2C8\uB2E4! \uC5BC\uB9AC\uBC84\uB4DC \uAC00\uC785\uC790\uC5D0\uAC8C\uB9CC
      \uC99D\uC815\uB418\uB294 \uB3C5\uC810 \uD61C\uD0DD\uC73C\uB85C \uC6A9\uC0AC\uB2D8\uC758
      \uC601\uAD11\uC5D0 \uD0D1\uC2B9\uD558\uC138\uC694! \u2694\uFE0F\u2728\n\n\U0001F381
      Limited Edition Package \uAD6C\uC131:\n\u25CF \uC6A9\uC0AC \uCE5C\uD544 \uC11C\uBA85
      \uAC01\uC778 [\uC804\uC124\uC758 \uC131\uAC80] \uB808\uD50C\uB9AC\uCE74 \uD0A4\uB9C1\n\u25CF
      \uBBF8\uACF5\uAC1C \uB358\uC804 \uC694\uB9AC \uBA39\uBC29 \uB85C\uADF8\uBD81
      (Recipe ver.)\n\u25CF \uC624\uD504\uB77C\uC778 \uD32C\uBBF8\uD305 '\uC6A9\uC0AC\uC758
      \uC131' \uC6B0\uC120 \uCC38\uC5EC\uAD8C\n\u25CF \uB514\uC9C0\uD138 \uAC00\uC785
      \uC778\uC99D\uC11C (Serial No. 000001~ )\n\n\U0001F517 [\uC2E0\uCCAD \uB9C1\uD06C:
      Warrior-Princess-Official.com/Join]\n\n#\uC6A9\uC0AC #HolyWarrior #Warrior_and_Princess
