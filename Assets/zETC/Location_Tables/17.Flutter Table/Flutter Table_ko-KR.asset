  - m_Id: 2049574166574
    m_Localized: "\uBAA8\uC2E0\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 2049574166575
    m_Localized: "\uC6A9\uC0AC\uC758 \uBB34\uC218\uB9AC\uB4E4"
    m_Metadata:
      m_Items: []
  - m_Id: 999834947674112
    m_Localized: "\uC6A9\uC0AC\uB9C8\uC774\uB108\uAC24\uB7EC\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839936
    m_Localized: "[Notice] \uC6A9\uC0AC \uD32C\uB364\uBA85 \uCD5C\uC885 \uD22C\uD45C
      \uC548\uB0B4 \u2665\uFE0F\n1. \uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\n\uC774\uC720:
      \uC6A9\uC0AC\uAC00 \uAC00\uB294 \uAE38\uC5D0 \uAF43\uAE38\uB9CC \uAE54\uC544\uC8FC\uACA0\uB2E4\uB294
      \uC758\uC9C0. \uC6A9\uC0AC\uAC00 \uC704\uAE30\uC5D0 \uCC98\uD558\uBA74 \uC6B0\uB9AC\uAC00
      \uAD6C\uD558\uB7EC \uAC04\uB2E4\uB294 \uC5ED\uD074\uB9AC\uC170\uC801 \uAC10\uC131
      (a.k.a. \uC785\uAE08\uC73C\uB85C \uC9C0\uD0A4\uB294 \uACF5\uC8FC\uB2D8\uB4E4)\n\uC2AC\uB85C\uAC74:
      \uACF5\uC8FC\uB2D8\uB4E4, \uC6A9\uC0AC\uB2D8 \uC9C0\uD0A4\uB7EC \uAC11\uC2DC\uB2E4.\n\n2.
      \uC6A9\uC0AC \uC218\uBE44\uB300 \n\uC774\uC720: \uB9C8\uC655\uAD70\uC774 \uCCD0\uB4E4\uC5B4\uC640\uB3C4
      \uC6A9\uC0AC \uC55E\uAE38\uC740 \uC6B0\uB9AC\uAC00 \uB9C9\uC544\uC900\uB2E4!
      \uD074\uB798\uC2DD\uD55C \uAD70\uB300\uC2DD \uCDA9\uC131\uC2EC\uACFC \uB4E0\uB4E0\uD55C
      \uBC29\uD328 \uCEE8\uC149.\n\uC2AC\uB85C\uAC74: \uC6A9\uC0AC\uB294 \uACF5\uACA9\uD574,
      \uC218\uBE44\uB294 \uC6B0\uB9AC\uAC00 \uD560\uAC8C.\n\n\uB204\uB9AC\uAFBC \uBC31\uC131\uB2D8\uB4E4\uC758
      \uC2E0\uC911\uD55C \uD55C \uD45C \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\n#\uC6A9\uC0AC
      #\uACF5\uC2DD\uD32C\uB364\uBA85 #\uB9C8\uC774\uB108\uAC24\uB7EC\uB9AC #\uD22C\uD45C\uBD80\uD0C1\n"
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839937
    m_Localized: "1\uBC88\uC740 \uC5D0\uBC14\uC784;; \uC6A9\uC0AC\uAC00 \uACF5\uC8FC\uB2D8\uC774\uB77C\uACE0
      \uBD80\uB974\uBA74 \uB0B4 \uC190\uAC00\uB77D \uB2E4 \uC0AC\uB77C\uC9C8 \uB4EF.
      \uADFC\uB370 \uADF8\uAC8C \uB610 \uB9DB\uB3C4\uB9AC\uAE34 \uD558\uB124... \uC77C\uB2E8
      1\uBC88 \uD22C\uD45C\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839938
    m_Localized: "\uBB34\uC870\uAC74 2\uBC88 \uC218\uBE44\uB300\uC9C0. \uC6B0\uB9AC
      \uC6A9\uC0AC \uC720\uB9AC\uBAB8\uC774\uB77C \uC6B0\uB9AC\uAC00 \uC548 \uC9C0\uCF1C\uC8FC\uBA74
      \uBC8C\uC368 \uACE0\uBE14\uB9B0\uD55C\uD14C \uD138\uB838\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839939
    m_Localized: "\uC544\uB2C8 \uC6A9\uC0AC \uBC1C\uB2E6\uAC1C\uB294 \uC65C \uD6C4\uBCF4\uC5D0\uC11C
      \uBE60\uC9C4 \uAC70\uC784? \uC6B4\uC601\uC9C4 \uD3B8\uD30C\uD310\uC815 \uC624\uC9C0\uB124;;
      \uC544\uAE4C\uBD80\uD130 \uB0B4\uAEBC\uB9CC \uC2A4\uB8E8\uD568?"
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839940
    m_Localized: 1
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839941
    m_Localized: 1111111
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839942
    m_Localized: "\uC6A9\uC0AC\uB2D8 \uC131\uACA9\uC0C1 '\uACF5\uC8FC\uB2D8\uB4E4'\uC774\uB77C\uACE0
      \uBD80\uB974\uB77C\uACE0 \uD558\uBA74 \uC5BC\uAD74 \uD130\uC9C8 \uAC83 \uAC19\uC740\uB370
      \uADF8 \uBC18\uC751 \uBCF4\uACE0 \uC2F6\uC5B4\uC11C 1\uBC88 \uCC0D\uC74C \u314B\u314B\u314B\u314B\u314B
      \uC544 \uB2D8\uB4E4\uC544 \uB2E4\uB4E4 1\uBC88 \uCC0D\uC73C\uB77C\uACE0!!\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839943
    m_Localized: "\uC544\uB2C8 \uB0B4 \uC544\uC774\uB514\uC5B4 \uBB3C\uC57D\uC154\uD2C0\uC740
      \uC65C \uD0C8\uB77D\uD568? \uC6B4\uC601\uC790 \uC77C \uC548 \uD558\uB0D0?\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 999834972839944
    m_Localized: "\uD22C\uD45C \uACB0\uACFC\uB294 \uB0B4\uC77C \uC624\uC804 9\uC2DC
      30\uBD84\uC5D0 \uBC1C\uD45C\uB429\uB2C8\uB2E4! \uB2E4\uB4E4 \uD55C \uD45C\uAC00
      \uC18C\uC911\uD568"
    m_Metadata:
      m_Items: []
