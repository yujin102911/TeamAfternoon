  - m_Id: 2049569972316
    m_Localized: "3:22 \uC6A9\uC0AC \uC9C4\uC9DC \uC798\uC0DD\uACBC\uB2E4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972317
    m_Localized: "\uB098 \uC9C4\uC9DC [ENTER_TITLE] \uB54C\uBB38\uC5D0 \uC0B0\uB2E4 "
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972318
    m_Localized: "\uC774\uBC88\uC5D0 \uC601\uC0C1 \uC548 \uC62C\uB77C\uC624\uBA74
      \uAC4D \uC8FD\uC73C\uB824\uACE0 \uD588\uB294\uB370 \uC6A9\uC0AC\uAC00 \uB098\uB77C\uB3C4
      \uC0B4\uB9AC\uACE0 \uACF5\uC8FC\uB3C4 \uC0B4\uB9AC\uACE0 \uB098\uB3C4 \uC0B4\uB838\uB2E4.
      \uC6A9\uC0AC\uB294 \uC601\uC6C5\uC774 \uB9DE\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972319
    m_Localized: "\uC548\uB155\uC548\uB155 \uBC31\uC131\uC5EC\uB7EC\uBD84~ \uC6A9\uC0AC\uC785\uB2C8\uB2E4
      \n\uB4DC\uB514\uC5B4 \uB9C8\uC9C0\uB9C9\uD3B8\uC774\uB124\uC694\u314B\u314B
      \uC624\uB298 \uC601\uC0C1\uC740 \uC5B4\uC81C\uC5D0 \uC774\uC740 <[ENTER_TITLE]>\uC785\uB2C8\uB2E4
      \n\uC774\uBC88\uC5D0\uB294 \uD6C8\uC7A5 \uC218\uC5EC\uC2DD\uC5D0\uC11C \uB77C\uC774\uBE0C\uC1A1\uCD9C\uD574\uC57C\uD574\uC11C
      \uC5C5\uB85C\uB4DC \uC2DC\uAC04\uC774 \uB2EC\uB77C\uC84C\uC73C\uB2C8\uAE4C
      \uC54C\uB9BC\uC124\uC815 \uD574\uB450\uC2DC\uACE0\u314B\u314B \n\uB274\uD29C\uBE0C\uB85C
      \uBCF4\uC2DC\uBA74 \uB9C8\uC9C0\uB9C9\uD3B8 \uC774\uD6C4\uC5D0 \uBC14\uB85C
      \uD6C8\uC7A5\uC218\uC5EC\uC2DD \uB77C\uC774\uBE0C\uB3C4 \uBCFC \uC218 \uC788\uC5B4\uC6A4\u314E
      \n\uADF8\uB7FC \uD6C8\uC7A5\uC218\uC5EC\uC2DD\uB54C \uBD05\uC2DC\uB2E4 \uB098\uC758
      \uC791\uACE0 \uADC0\uC5EC\uC6B4 \uC544\uAE30 \uBC31\uC131\uB4E4\U0001F339"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972320
    m_Localized: "\uC640 \uD6C8\uC7A5\uC218\uC5EC\uC2DD?!? \uC6A9\uC0AC\uAC00 \uB098\uB77C\uB97C
      \uAD6C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972321
    m_Localized: "\uC751 \uC774\uBBF8 \uAD6C\uD588\uC5B4~"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972322
    m_Localized: "\uB9C8\uC655 \uBB3C\uB9AC\uCE5C \uAD6C\uAD6D\uC601\uC6C5\uC778\uB370
      \uC774\uC815\uB3C4\uB294 \uD574\uC57C\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972323
    m_Localized: "\uC6A9\uC0AC\uB2D8 \uB77C\uC774\uBE0C\uC5D0\uC11C\uB3C4 \uBBF8\uCE5C\uB4EF\uC774
      \uC798\uC0DD\uAE30\uC2EC\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972324
    m_Localized: "\uBCF6\uC74C\uBC25 \uBCF6\uC73C\uBA74\uC11C \uC774 \uC601\uC0C1
      \uBD24\uB354\uB2C8 \uBC25\uC774 \uC800\uC808\uB85C \uBCF6\uC544\uC84C\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972325
    m_Localized: "\uC6A9\uC0AC. \uC624\uB298\uB3C4. \uBA4B\uC9C0\uC2DC\uB124\uC694.
      Good. <[ENTER_TITLE]> \uC798 \uBD24\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972326
    m_Localized: "\uC800 \uC624\uBBF8\uD06C\uB860 \uBC84\uD2BC \uBC1B\uC558\uC5B4\uC694
      \n\uC774\uAC8C \uB2E4 \uC81C \uB6F0\uC5B4\uB09C \uC2E4\uB825\uACFC \uBC31\uC131
      \uC5EC\uB7EC\uBD84 \uB355\uC785\uB2C8\uB2E4\u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972327
    m_Localized: "\uCD95\uD558\uD569\uB2C8\uB2E4!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972328
    m_Localized: Congrats! You deserve it!
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972329
    m_Localized: "\uB9D0\uB3C4 \uC548\uB3FC VTS \uC624\uBE60\uB4E4\uBCF4\uB2E4 \uBE68\uB9AC
      \uBC1B\uB2E4\uB2C8\u2026 \uC624\uB298 \uB0B4 \uC138\uC0C1\uC774 \uBB34\uB108\uC84C\uC5B4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972330
    m_Localized: "\uADFC\uB370 \uC598 \uC790\uBED1 \uCA4C\uB294 \uAC70 \uAC19\uC74C
