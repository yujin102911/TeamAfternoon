      m_Items: []
  - m_Id: 2049569972262
    m_Localized: "\uB17C\uB780\uC758 \uC601\uC0C1 <\uC6A9\uC0AC, \uC800\uAC70 \uB2E4
      \uCF54\uC2A4\uD504\uB819\uB2C8\uB2E4> \n\uB124\uC6C0\uB274\uC2A4\uAC00 \uBB38\uC81C\uC758
      \uC7A5\uBA74\uC744 \uD655\uB300 \uBC0F \uD6C4\uBCF4\uC815\uD574 \uBD84\uC11D\uD55C
      \uACB0\uACFC, \uB9C8\uC871 A\uC528\uAC00 \uC8FC\uC7A5\uD55C \u2018\uC190\uAC00\uB77D
      6\uAC1C\u2019\uB294 \uC0AC\uC2E4\uC774 \uC544\uB2CC \uAC83\uC73C\uB85C \uBCF4\uC785\uB2C8\uB2E4.
      \uC190\uAC00\uB77D\uCC98\uB7FC \uBCF4\uC600\uB358 \uBD80\uBD84\uC740 \uB4A4\uCABD
      \uBC30\uACBD\uC774 \uACB9\uCCD0 \uCC29\uC2DC\uB97C \uC77C\uC73C\uD0A8 \uAC83\uC774\uB77C\uB294
      \uD574\uC11D\uC785\uB2C8\uB2E4.\r\n\uD55C\uD3B8 \uC6A9\uC0AC \uACF5\uC2DD \uD32C\uD074\uB7FD
      \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\u2019\uC740 \uB9C8\uC871 A\uC528\uC5D0
      \uB300\uD574 \uD5C8\uC704\uC0AC\uC2E4 \uC720\uD3EC \uBC0F \uBA85\uC608\uD6FC\uC190
      \uD610\uC758\uB85C \uAC15\uACBD \uB300\uC751\uC744 \uC608\uACE0\uD588\uC2B5\uB2C8\uB2E4.\n\r\n#\uB124\uC6C0\uB274\uC2A4
