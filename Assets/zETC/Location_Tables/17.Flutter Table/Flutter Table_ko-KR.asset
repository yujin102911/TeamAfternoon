      m_Items: []
  - m_Id: 2049569972236
    m_Localized: "\uD5C8\uC704\uC0AC\uC2E4 \uC720\uD3EC\uB85C \uACE0\uC18C \uB2F9\uD558\uACE0
      \uC2F6\uC73C\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 2049569972237
    m_Localized: "\uC548\uB155\uD558\uC138\uC694, \uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\uC785\uB2C8\uB2E4.
      \n\uCD5C\uADFC \uC6A9\uC0AC\uC640 \uAD00\uB828\uD55C \uC545\uC758\uC801 \uBE44\uBC29,
      \uD5C8\uC704\uC0AC\uC2E4 \uC720\uD3EC, \uBA85\uC608\uD6FC\uC190 \uB4F1\uC758
      \uD589\uC704\uAC00 \uC9C0\uC18D\uC801\uC73C\uB85C \uC774\uC5B4\uC9D0\uC5D0
      \uB530\uB77C \uC0AC\uC548\uC744 \uC88C\uC2DC\uD558\uC9C0 \uC54A\uACE0 \uBC31\uC791\uAC00\uC640
      \uD611\uC758\uD558\uC5EC \uBC95\uC801 \uC808\uCC28\uB97C \uC9C4\uD589\uD558\uAE30\uB85C
      \uACB0\uC815\uD588\uC2B5\uB2C8\uB2E4. \r\n\uC545\uC131 \uAC8C\uC2DC\uBB3C \uB4F1
      \uC704\uBC95 \uD610\uC758 \uC0AC\uB840\uB97C \uBC1C\uACAC\uD558\uC2E0 \uACBD\uC6B0
      \uD574\uB2F9 \uACC4\uC815\uC758 DM, \uB610\uB294 \uBA54\uC77C(Hero_s_Princess@MSN.com)\uC744
      \uD1B5\uD574 \uC801\uADF9 \uC81C\uBCF4\uD574\uC8FC\uC2DC\uBA74 \uAC10\uC0AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.\r\n\n\uC55E\uC73C\uB85C\uB3C4
      \uC6A9\uC0AC\uB2D8\uC758 \uC5EC\uC815\uC5D0 \uB9CE\uC740 \uC751\uC6D0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
