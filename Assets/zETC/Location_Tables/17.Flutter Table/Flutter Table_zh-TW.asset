  - m_Id: 2049565777972
    m_Localized: "\u6599\u7406\u7684\u57FA\u790E\u5C31\u662F\u8981\u716E\u719F\u3002\u9019\u500B\u5F71\u7247\u5F88\u597D\u5730\u544A\u8A34\u4E86\u5927\u5BB6\u9019\u4E00\u9EDE\uFF0C\u975E\u5E38\u6709\u610F\u7FA9\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2049565777973
    m_Localized: "\U0001F451 [NOTICE] \u52C7\u58EB\u5B98\u65B9\u7C89\u7D72\u5718\u540D\u7A31\u78BA\u5B9A
      \uBC0F \u7B2C\u4E00\u671F\u62DB\u52DF\u516C\u544A\n\u7D93\u904E\u5404\u4F4D\u7DB2\u53CB\u8207\u570B\u6C11\u7684\u71B1\u60C5\u6295\u7968\uFF0C\u5B98\u65B9\u7C89\u7D72\u5718\u540D\u7A31\u6B63\u5F0F\u78BA\u5B9A\u70BA\u2014\u2014\u300C\u52C7\u58EB\u7684\u516C\u4E3B\u5011
      (Hero's Princess)\u300D\uFF01\n\n\u6211\u5011\u5C07\u6B63\u5F0F\u62DB\u52DF\u300C\u7B2C\u4E00\u671F\u516C\u4E3B\u5011\u300D\uFF0C\u8207\u52C7\u58EB\u5927\u4EBA\u4E00\u540C\u8E0F\u4E0A\u5F81\u8A0E\u9B54\u738B\u7684\u5049\u5927\u9060\u5F81\uFF01\u73FE\u5728\u52A0\u5165\u5373\u53EF\u4EAB\u53D7\u65E9\u9CE5\u5C08\u5C6C\u7279\u5178\uFF0C\u8B93\u6211\u5011\u5171\u540C\u898B\u8B49\u52C7\u58EB\u7684\u69AE\u8000\u6642\u523B\uFF01\u2694\uFE0F\u2728\n\n\U0001F381
