      \u0433\u0435\u0440\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 27051417616
    m_Localized: "\u0412\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
      \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u043E\u0433\u043E
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u044F, \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u0414\u0435\u043C\u043E\u043D\u043E\u043C, \u0431\u044B\u043B\u043E \u043B\u043E\u0436\u043D\u044B\u043C.
      \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0436\u0438\u0442\u0435\u043B\u0435\u0439
      \u0443\u0437\u043D\u0430\u043B\u0438 \u043E\u0431 \u044D\u0442\u043E\u043C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430
      \u0432\u0438\u0434\u0435\u043E, \u0447\u0442\u043E \u0432\u044B\u0437\u0432\u0430\u043B\u043E
      \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u0448\u043E\u043A. \u041F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443
      \u0441\u0443\u0434\u044C\u0431\u0430 \u0433\u0435\u0440\u043E\u044F \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439, \u0433\u0440\u0430\u0444\u0438\u043A
      \u0432\u044B\u0445\u043E\u0434\u0430 \u0441\u0435\u0440\u0438\u0439 \xAB\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435
      \u0437\u0430\u043C\u043A\u0430 \u0414\u0435\u043C\u043E\u043D\u0430\xBB \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
      \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441."
