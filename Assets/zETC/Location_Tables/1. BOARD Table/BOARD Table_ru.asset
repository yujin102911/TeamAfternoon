  - m_Id: 27051417618
    m_Localized: "\u0421\u043F\u0430\u0441\u0448\u0438\u0439 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443
      \u0433\u0435\u0440\u043E\u0439 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0442\u0438\u0442\u0443\u043B
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u044B \u0438\u043B\u0438 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435. \u041E\u0434\u043D\u0430\u043A\u043E
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E\u0442\u0441\u044F \u0441\u043F\u043E\u0440\u044B
      \u043E \u0442\u043E\u043C, \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043B\u0438
      \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u044D\u0442\u0438 \u043E\u0431\u044B\u0447\u0430\u0438
      \u043A \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C \u0433\u0435\u0440\u043E\u044F\u043C.
      \u0422\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C, \u0433\u0435\u0440\u043E\u0439
      \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0442\u0440\u0438
      \u0434\u043D\u044F \u043F\u043E\u0441\u043B\u0435 \u0432\u0441\u043F\u043B\u044B\u0432\u0448\u0438\u0445
      \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0439 \u0432 \u043C\u043E\u043D\u0442\u0430\u0436\u0435
      \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0439."
