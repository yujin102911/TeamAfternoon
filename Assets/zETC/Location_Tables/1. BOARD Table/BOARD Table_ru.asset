  - m_Id: 27051417613
    m_Localized: "<size=20>\xAB\u0413\u0435\u0440\u043E\u0439 \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043B\u0438 \u043E\u043D \u0433\u0435\u0440\u043E\u0439?\xBB \u0412 \u0441\u0435\u0440\u0438\u0430\u043B\u0435
      \xAB\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0437\u0430\u043C\u043A\u0430
      \u0414\u0435\u043C\u043E\u043D\u0430\xBB \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0438
      \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u044F \u0432 \u043C\u043E\u043D\u0442\u0430\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 27051417614
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0439 \u0434\u0435\u043C\u043E\u043D
      \u0410 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B \u0432\u0438\u0434\u0435\u043E
      \u043F\u043E\u0434 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C \xAB\u0413\u0435\u0440\u043E\u0439,
      \u0432\u0441\u0451 \u044D\u0442\u043E \u043A\u043E\u0441\u043F\u043B\u0435\u0439\xBB,
      \u0432\u044B\u0437\u0432\u0430\u0432\u0448\u0435\u0435 \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441.
      \u0412 \u0432\u0438\u0434\u0435\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C
      \u043A\u0430\u0434\u0440\u044B, \u0433\u0434\u0435 \xAB\u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u0433\u0435\u0440\u043E\u044F \u0448\u0435\u0441\u0442\u044C \u043F\u0430\u043B\u044C\u0446\u0435\u0432
      \u043F\u0440\u0438 \u0432\u0437\u043C\u0430\u0445\u0435 \u043C\u0435\u0447\u0430\xBB.
      \u0421\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B
      \u0433\u0435\u0440\u043E\u044F\xBB \u0437\u0430\u044F\u0432\u0438\u043B\u043E,
      \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0436\u0435\u0441\u0442\u043A\u043E
      \u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043D\u0430
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435
      \u043B\u043E\u0436\u043D\u043E\u0439 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438."
