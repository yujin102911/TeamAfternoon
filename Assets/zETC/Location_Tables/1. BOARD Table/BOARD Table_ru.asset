  - m_Id: 27051417620
    m_Localized: "\u0421\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u043E\u0432
      \u0433\u0435\u0440\u043E\u044F \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B
      \u0433\u0435\u0440\u043E\u044F\xBB \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u043F\u043E\u0434 \u0443\u0433\u0440\u043E\u0437\u043E\u0439 \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0438\u044F.
      \u0421\u0443\u0434 \u0437\u0430\u044F\u0432\u0438\u043B, \u0447\u0442\u043E
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B
      \u0433\u0435\u0440\u043E\u044F\xBB \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0437\u0432\u0430\u0442\u044C
      \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0445\u0430\u043E\u0441
      \u0438 \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442 \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u044E.
      \u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0433\u043E
      \u043D\u043E\u0432\u043E\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \xAB\u0421\u043B\u0443\u0433\u0438
      \u0433\u0435\u0440\u043E\u044F\xBB."
