  m_TableData:
  - m_Id: 27013668864
    m_Localized: "<size=20>\u0414\u0435\u043C\u043E\u043D \u043E\u0431\u044A\u044F\u0432\u0438\u043B
      \u043E \u043F\u043E\u0445\u0438\u0449\u0435\u043D\u0438\u0438 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B
      \u0447\u0435\u0440\u0435\u0437 7 \u0434\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028992
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0414\u0435\u043C\u043E\u043D
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0446\u0441\u0435\u0442\u0438 \u043E\u0431\u044A\u044F\u0432\u0438\u043B:
      \xAB\u0427\u0435\u0440\u0435\u0437 7 \u0434\u043D\u0435\u0439 \u044F \u043F\u043E\u0445\u0438\u0449\u0443
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443\xBB.\n\u0412 \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0435\u043C\u043E\u0439
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0431\u044B\u043B\u0430
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C: \xAB\u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043A\u0443\u0447\u0430\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435
      \u0431\u044B\u043B\u043E \u0432\u0435\u0441\u0435\u043B\u043E\xBB, \u0447\u0442\u043E
      \u0432\u044B\u0437\u0432\u0430\u043B\u043E \u0448\u0438\u0440\u043E\u043A\u0438\u0439
      \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 27043028993
    m_Localized: "<size=20>\u041A\u043E\u0440\u043E\u043B\u044C \u0432\u044B\u0431\u0440\u0430\u043B
      \u0433\u0435\u0440\u043E\u044F \u0438 \u0440\u0435\u0448\u0438\u043B \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0435\u0433\u043E \u0432 \u0437\u0430\u043C\u043E\u043A \u0414\u0435\u043C\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028994
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B, \u0447\u0442\u043E \u043B\u0438\u0447\u043D\u043E
      \u0432\u044B\u0431\u0435\u0440\u0435\u0442 \u0433\u0435\u0440\u043E\u044F,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0431\u0435\u0434\u0438\u0442
      \u0414\u0435\u043C\u043E\u043D\u0430, \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442
      \u0435\u0433\u043E \u0432 \u0437\u0430\u043C\u043E\u043A \u0414\u0435\u043C\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 27043028995
    m_Localized: "<size=20>\u041D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A
      \u0433\u0440\u0430\u0444\u0441\u043A\u043E\u0433\u043E \u0434\u043E\u043C\u0430
      \u0432\u044B\u0431\u0440\u0430\u043D \u0433\u0435\u0440\u043E\u0435\u043C \u043D\u0430
      \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u043C \u043E\u0442\u0431\u043E\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028996
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u044C \u043F\u043E\u044F\u0441\u043D\u0438\u043B,
      \u0447\u0442\u043E \xAB\u0433\u0440\u0430\u0444 \u0445\u0432\u0430\u043B\u0438\u043B\u0441\u044F
      \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u0435 \u043D\u0430\u0437\u0430\u0434
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E\u043C \u0441\u0432\u043E\u0435\u0433\u043E
      \u0441\u044B\u043D\u0430 \u0432 \u0444\u0435\u0445\u0442\u043E\u0432\u0430\u043D\u0438\u0438\xBB.\n\u041F\u043E\u0441\u043B\u0435
      \u044D\u0442\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u0433\u0435\u0440\u043E\u044F \u0431\u0443\u0434\u0443\u0442 \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u043C \u043A\u0430\u043D\u0430\u043B\u0435
      \u043F\u043E\u0434 \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u043E\u043C
      \xAB\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0437\u0430\u043C\u043A\u0430
      \u0414\u0435\u043C\u043E\u043D\u0430\xBB \u043D\u0430\u0447\u0438\u043D\u0430\u044F
      \u0441\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 27043028997
    m_Localized: "<size=20>[\u041B\u0451\u0433\u043A\u0438\u0439 \u043E\u0431\u0437\u043E\u0440]
      \u041A\u0430\u043A \u0443\u0441\u0442\u0440\u043E\u0435\u043D \u0437\u0430\u043C\u043E\u043A
      \u0414\u0435\u043C\u043E\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028998
    m_Localized: "\u0417\u0430 300 \u043B\u0435\u0442 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u043B \u0432 \u0437\u0430\u043C\u043E\u043A
      \u0414\u0435\u043C\u043E\u043D\u0430, \u043D\u043E \u0435\u0433\u043E \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430\u0441\u044C \u0432 \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0445
      \u043C\u0430\u043D\u0443\u0441\u043A\u0440\u0438\u043F\u0442\u0430\u0445. \u0417\u0430\u043C\u043E\u043A
      \u0441\u043E\u0435\u0434\u0438\u043D\u0451\u043D \u0441 \u043F\u044F\u0442\u0438\u044D\u0442\u0430\u0436\u043D\u044B\u043C
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435\u043C, \u0438
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u044D\u0442\u0430\u0436\u0435
      \u043E\u0431\u0438\u0442\u0430\u044E\u0442 \u043C\u043E\u043D\u0441\u0442\u0440\u044B:
      \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435
      \u2014 \u0417\u043B\u043E\u0431\u043D\u044B\u0439 \u0413\u043B\u0430\u0437,
      \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C \u2014 \u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0413\u0440\u0438\u0431\u044B, \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435\u043C
      \u2014 \u0413\u043E\u0431\u043B\u0438\u043D\u044B, \u043D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u043C
      \u2014 \u0413\u043E\u043B\u0435\u043C\u044B\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 27043028999
    m_Localized: "<size=20>\u0411\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0439
      \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0434\u0432\u0438\u0433 \u0433\u0435\u0440\u043E\u044F!
      \xAB\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0437\u0430\u043C\u043A\u0430
      \u0414\u0435\u043C\u043E\u043D\u0430\xBB, \u044D\u043F\u0438\u0437\u043E\u0434
      1: \u0417\u043B\u043E\u0431\u043D\u044B\u0439 \u0413\u043B\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029000
    m_Localized: "\u0413\u0435\u0440\u043E\u0439 \u043F\u043E\u043A\u043E\u0440\u0438\u043B
      \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u0442\u0430\u0436 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F
      \u0432\u0441\u0435\u0433\u043E \u0437\u0430 \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C
      \u043F\u043E\u0441\u043B\u0435 \u0432\u0445\u043E\u0434\u0430.\n\u041A\u043E\u0440\u043E\u043B\u044C,
      \u043F\u0440\u043E\u043B\u0438\u0432 \u0441\u043B\u0451\u0437\u044B \u0440\u0430\u0434\u043E\u0441\u0442\u0438,
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0441\u043B\u043E\u0432\u0430:
      \xAB\u0412\u0435\u0441\u044C \u043D\u0430\u0440\u043E\u0434 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442
      \u0437\u0430 \u0442\u0432\u043E\u0438\u043C\u0438 \u043F\u043E\u0434\u0432\u0438\u0433\u0430\u043C\u0438.
      \u0417\u0430\u0449\u0438\u0449\u0430\u0439 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443
      \u0438 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 27043029001
    m_Localized: "<size=20>[\u041E\u043F\u0440\u043E\u0441 MSN] 80% \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F
      \u0437\u0430\u044F\u0432\u0438\u043B\u0438, \u0447\u0442\u043E \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430
      \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u0438\u043C \u0441\u043C\u044B\u0441\u043B
      \u0436\u0438\u0437\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029002
    m_Localized: "\u0412 \u043E\u043F\u0440\u043E\u0441\u0435 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F
      80% \u0440\u0435\u0441\u043F\u043E\u043D\u0434\u0435\u043D\u0442\u043E\u0432
      \u0437\u0430\u044F\u0432\u0438\u043B\u0438, \u0447\u0442\u043E \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430
      \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u0438\u043C \u0441\u043C\u044B\u0441\u043B
      \u0436\u0438\u0437\u043D\u0438, \u0430 70% \u0441\u0447\u0438\u0442\u0430\u044E\u0442
      \u0435\u0451 \u0431\u0443\u0434\u0443\u0449\u0438\u043C \u0441\u0442\u0440\u0430\u043D\u044B.
      \u0412 \u0435\u0436\u0435\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u043E\u043C
      \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0435 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438
      \u0434\u0430\u0436\u0435 \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C
      \u043A\u043D\u0438\u0433\u0430 \xAB50 \u043F\u0440\u0438\u0447\u0438\u043D,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 27043029003
    m_Localized: "<size=20>[\u041F\u0440\u0430\u0432\u0434\u0430 \u0438\u043B\u0438
      \u043B\u043E\u0436\u044C] \u0412\u0441\u0435 \u0434\u0435\u043C\u043E\u043D\u044B
      \u2014 \u043B\u0433\u0443\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029004
    m_Localized: "\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u0430:
      \xAB\u0412\u043E\u0441\u0435\u043C\u044C \u0438\u0437 \u0434\u0435\u0441\u044F\u0442\u0438
      \u0441\u043B\u043E\u0432 \u0434\u0435\u043C\u043E\u043D\u043E\u0432 \u2014
      \u043B\u043E\u0436\u044C\xBB. \u0422\u0430\u043A \u043B\u0438 \u044D\u0442\u043E
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435? \u041F\u043E
      \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0435 \u0437\u0430 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
      \u0433\u043E\u0434, \u0432\u044B\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043D\u0438\u044F
      \u0434\u0435\u043C\u043E\u043D\u043E\u0432 \u0431\u044B\u043B\u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u0435\u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u044B. \u041E\u0434\u043D\u0430\u043A\u043E
      \u044D\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0441\u0430\u043C\u0438\u0445 \u0434\u0435\u043C\u043E\u043D\u043E\u0432\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029005
    m_Localized: "<size=20>\u0412\u043A\u0443\u0441 \u043F\u043E\u0431\u0435\u0434\u044B
      \u0433\u0435\u0440\u043E\u044F! \xAB\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435
      \u0437\u0430\u043C\u043A\u0430 \u0414\u0435\u043C\u043E\u043D\u0430\xBB, \u044D\u043F\u0438\u0437\u043E\u0434
      2: \u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0413\u0440\u0438\u0431\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 27043029006
    m_Localized: "\u0413\u0435\u0440\u043E\u0439 \u043F\u043E\u043A\u043E\u0440\u0438\u043B
      \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F
      \u0432\u0441\u0435\u0433\u043E \u0437\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F
      \u043F\u043E\u0441\u043B\u0435 \u0432\u0445\u043E\u0434\u0430. \u041F\u043E\u0435\u0434\u0430\u044F
      \u043F\u043E\u0432\u0435\u0440\u0436\u0435\u043D\u043D\u044B\u0435 \u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0413\u0440\u0438\u0431\u044B, \u043E\u043D \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u0438: \xAB\u0413\u0440\u0438\u0431\u044B
      \u0445\u043E\u0440\u043E\u0448\u043E \u0444\u0435\u0440\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B\xBB
      \u0438 \xAB\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432\u043A\u0443\u0441\u043D\u044B
      \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0435 \u0447\u0430\u0441\u0442\u0438
      \u043D\u043E\u0436\u0435\u043A\xBB. \u042D\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E
