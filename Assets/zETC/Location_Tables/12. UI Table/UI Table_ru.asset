      m_Items: []
  - m_Id: 143439268405250
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 143439268405251
    m_Localized: "\u041F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u043D\u0435\u043F\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043D\u043D\u043E\u0435
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B.\r\n\r\n\u2022
      \u041E\u0448\u0438\u0431\u043A\u0430 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u0436\u0443\u0440\u043D\u0430\u043B\u0430 \u0431\u043E\u044F\r\n\u2022 \u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E
      \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u043E\u0435 \u0431\u043E\u0435\u0432\u043E\u0435
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435. \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E.\r\n\r\n\u042D\u043A\u0441\u043F\u043E\u0440\u0442
      \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0444\u0430\u0439\u043B\u0430 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
