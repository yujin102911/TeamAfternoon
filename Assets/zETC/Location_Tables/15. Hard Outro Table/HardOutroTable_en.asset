  m_SharedData: {fileID: 11400000, guid: 15c4c33990b43744c811740d55fffcae, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 513100541952
    m_Localized: <size=22>[Breaking] Hero Returns After Defeating Three Demon Kings
      in Just Over a Month
    m_Metadata:
      m_Items: []
  - m_Id: 513100541953
    m_Localized: 'Royal Marriage Settled Between Princess and Warrior: Officials
      Expected to Clash Over Wedding Date'
    m_Metadata:
      m_Items: []
  - m_Id: 513100541954
    m_Localized: Hero Responds Calmly to Reporter's Questions
    m_Metadata:
      m_Items: []
  - m_Id: 513100541955
    m_Localized: MSN News brings you the daily updates.
    m_Metadata:
      m_Items: []
  - m_Id: 513100541956
    m_Localized: The hero has returned after defeating all the remaining three demon
      lords.
    m_Metadata:
      m_Items: []
  - m_Id: 513100541957
    m_Localized: "Concerns arose as the channel's upload speed slowed due to the
      increased strength of the foes, \nbut the hero appeared at the official ceremony
      unscathed, looking as usual."
    m_Metadata:
      m_Items: []
  - m_Id: 513100541958
    m_Localized: "The king expressed his respect for the hero's initiative force
      and loyalty, \nannouncing after careful consideration that the hero and princess
      would be married in a royal union."
    m_Metadata:
      m_Items: []
  - m_Id: 513104736256
    m_Localized: "In a related interview, the princess stated, \u201CWhile we needn't
      adhere to outdated laws, breakfasts eating the fried food the hero made weren't
      bad,\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 848640667648
    m_Localized: "Furthermore, \nthe hero became a hot topic again when he responded
      thus to a reporter's question, \n\u201CWasn't it difficult to defeat all four
      demon lords this time?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 1951042170880
    m_Localized: 'fueling anticipation for the birth of the princess/hero ship into
      canon.

'
    m_Metadata:
      m_Items: []
  - m_Id: 6035343969939456
    m_Localized: "Last week, a video titled '[ENTER_TITLE]' was released on the Holy
      Warrior's personal channel, \nofficially confirming the defeat of the Black
      Dragon and the subjugation of the Four Dark Kings."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
