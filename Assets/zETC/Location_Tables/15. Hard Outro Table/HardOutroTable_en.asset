  m_SharedData: {fileID: 11400000, guid: 15c4c33990b43744c811740d55fffcae, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 513100541952
    m_Localized: <size=22>[BREAKING] Holy Warrior Returns After Defeating Three Dark
      Lords in One Month
    m_Metadata:
      m_Items: []
  - m_Id: 513100541953
    m_Localized: Princess & Holy Warrior Wedding Confirmed; Date in Dispute
    m_Metadata:
      m_Items: []
  - m_Id: 513100541954
    m_Localized: Holy Warrior followed with a relaxed response to the reporter's
      question.
    m_Metadata:
      m_Items: []
  - m_Id: 513100541955
    m_Localized: MSN News brings you the daily updates.
    m_Metadata:
      m_Items: []
  - m_Id: 513100541956
    m_Localized: Holy Warrior has officially returned after slaying the remaining
      three Dark Lords.
    m_Metadata:
      m_Items: []
  - m_Id: 513100541957
    m_Localized: "While some expressed concern over a slight delay in updates\u2014attributing
      it to the increasing strength of the enemies\u2014Holy Warrior appeared at
      the official ceremony completely unscathed, looking as composed as ever."
    m_Metadata:
      m_Items: []
  - m_Id: 513100541958
    m_Localized: "In recognition of the Holy Warrior\u2019s drive and unwavering
      loyalty, the King announced his decision to approve the marriage between the
      Holy Warrior and the Princess."
    m_Metadata:
      m_Items: []
  - m_Id: 513104736256
    m_Localized: "The Princess also shared her thoughts in a recent interview:\n\u201CWhile
      there is no need to adhere to outdated laws, the idea of waking up to the fried
      food the Holy Warrior prepares every morning didn't seem so bad.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 848640667648
    m_Localized: "Furthermore, when a reporter asked the Holy Warrior if defeating
      all four Dark Lords was a difficult feat, the Holy Warrior\u2019s relaxed response
      has become a hot topic:"
    m_Metadata:
      m_Items: []
  - m_Id: 1951042170880
    m_Localized: "Her comments have fueled public excitement for the birth of the
      Kingdom\u2019s newest power couple."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
