      m_Items: []
  - m_Id: 513100541957
    m_Localized: "\u76F8\u624B\u304C\u5F37\u529B\u306B\u306A\u3063\u305F\u5206\u3001\u30C1\u30E3\u30F3\u30CD\u30EB\u306E\u66F4\u65B0\u983B\u5EA6\u304C\u4E0B\u304C\u308A\u3001\u4E00\u90E8\u3067\u306F\u61F8\u5FF5\u306E\u58F0\u3082\u4E0A\u304C\u3063\u3066\u3044\u307E\u3057\u305F\u304C\u3001\n\u52C7\u8005\u306F\u4ECA\u56DE\u3082\u50B7\u4E00\u3064\u306A\u3044\u3044\u3064\u3082\u306E\u59FF\u3067\u516C\u306E\u5834\u306B\u767B\u5834\u3057\u307E\u3057\u305F\u3002"
