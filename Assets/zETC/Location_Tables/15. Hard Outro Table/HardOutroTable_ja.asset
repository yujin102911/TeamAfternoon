      m_Items: []
  - m_Id: 513100541958
    m_Localized: "\u56FD\u738B\u306F\u52C7\u8005\u306E\u63A8\u9032\u529B\u3068\u5FE0\u8AA0\u5FC3\u306B\u656C\u610F\u3092\u8868\u3057\u3001\n\u719F\u8003\u306E\u672B\u3001\u52C7\u8005\u3068\u738B\u5973\u306E\u5A5A\u5100\u3092\u57F7\u308A\u884C\u3046\u3053\u3068\u3092\u6C7A\u5B9A\u3057\u305F\u3068\u767A\u8868\u3057\u307E\u3057\u305F\u3002"
