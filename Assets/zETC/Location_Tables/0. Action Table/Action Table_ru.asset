    m_Localized: "\u0411\u043B\u0438\u0436\u043D\u044F\u044F \u0430\u0442\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13105423974121472
    m_Localized: "<u>\u0422\u043E\u043B\u044C\u043A\u043E \u0441 \u0440\u044F\u0434\u0430,
      \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u043A \u0432\u0440\u0430\u0433\u0443,</u>
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 {0} \u0443\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 13338832629645312
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u044F\u044F \u0430\u0442\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500608
    m_Localized: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 {0} \u0443\u0440\u043E\u043D\u0430
      \u0432\u043D\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u043F\u043E\u0437\u0438\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500609
    m_Localized: "\u0417\u0430\u0449\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500610
    m_Localized: "<u>\u0411\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u0430\u0442\u0430\u043A\u0443 \u0432\u0440\u0430\u0433\u0430</u>."
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500611
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500612
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500613
    m_Localized: "\u0414\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500614
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 13343988578500615
    m_Localized: "\u0417\u0430\u0440\u044F\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 13343988582694912
    m_Localized: "\u041F\u043E\u0434\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u0449\u043D\u0443\u044E \u0430\u0442\u0430\u043A\u0443 \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E
      \u0431\u043E\u044F.\n<u>\u041F\u0440\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438
      \u0443\u0440\u043E\u043D\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430
      \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 13343988582694913
    m_Localized: "\u041D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u043D\u0438\u0435
      \u0442\u0435\u0442\u0438\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 13343988582694914
    m_Localized: "\u041F\u043E\u0434\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u0449\u043D\u0443\u044E \u0434\u0430\u043B\u044C\u043D\u044E\u044E
      \u0430\u0442\u0430\u043A\u0443.\n<u>\u041F\u0440\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438
      \u0443\u0440\u043E\u043D\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430
      \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.</u>"
    m_Metadata:
      m_Items: []
