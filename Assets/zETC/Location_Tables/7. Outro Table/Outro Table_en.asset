  m_TableData:
  - m_Id: 86874775552
    m_Localized: NEWS
    m_Metadata:
      m_Items: []
  - m_Id: 86908329984
    m_Localized: LIVE
    m_Metadata:
      m_Items: []
  - m_Id: 86908329985
    m_Localized: "<size=18>[BREAKING] Holy Warrior Returns After Defeating Dark Lord
      in Just One Week\u2026 Savior of the Realm\r"
    m_Metadata:
      m_Items: []
  - m_Id: 86908329986
    m_Localized: "Royal Celebration Held to Honor Hero\u2019s Victory \u201CLet the
      Feast Begin\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524288
    m_Localized: "Holy Warrior Makes Bold Response to Royal Highness\u2019s Joke"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524289
    m_Localized: "MSN News brings you the daily updates.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524290
    m_Localized: "The Holy Warrior has returned after defeating the Dark Lord.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524291
    m_Localized: "Contrary to expert predictions, \nthe Warrior reappeared in public
      just one week after departure."
    m_Metadata:
      m_Items: []
  - m_Id: 86912524292
    m_Localized: "The dungeon itself was cleared in a mere six days.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524293
    m_Localized: "Combined with the unprecedented move to simulcast \nthe campaign
      on Wtube, public approval ratings \nfor the Royal administration have surged
      dramatically.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524294
    m_Localized: "Earlier today, our Royal Highness honored \nthe Holy Warrior\u2019s
      achievements \nby awarding a Medal of Valor and the Orichalcum Button"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524295
    m_Localized: "The Hero then drew attention by responding to the King\u2019s question,
      \n\u201CSo, did you truly kill the Dark Lord?\u201D \nThe Holy Warrior responded
      thus\n"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524296
    m_Localized: "\u2026\r"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524297
    m_Localized: "(smirks)\r"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524298
    m_Localized: 'It''s now safe to turn off

      your computer.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
