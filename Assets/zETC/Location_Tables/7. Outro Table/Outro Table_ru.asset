  - m_Id: 86908329984
    m_Localized: "\u0412 \u043F\u0440\u044F\u043C\u043E\u043C \u044D\u0444\u0438\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 86908329985
    m_Localized: "[\u0421\u0420\u041E\u0427\u041D\u042B\u0415 \u041D\u041E\u0412\u041E\u0421\u0422\u0418]
      \u0413\u0435\u0440\u043E\u0439 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F,
      \u043F\u043E\u0431\u0435\u0434\u0438\u0432 \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u044B\u043A\u0443 \u0432\u0441\u0435\u0433\u043E \u0437\u0430
      \u043D\u0435\u0434\u0435\u043B\u044E\u2026 \u0413\u0435\u0440\u043E\u0439-\u0441\u043F\u0430\u0441\u0438\u0442\u0435\u043B\u044C
      \u0441\u0442\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 86908329986
    m_Localized: "\u0412\u043E \u0434\u0432\u043E\u0440\u0446\u0435 \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438
      \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0431\u0430\u043D\u043A\u0435\u0442 \u0432 \u0447\u0435\u0441\u0442\u044C
      \u043F\u043E\u0431\u0435\u0434\u044B \u0433\u0435\u0440\u043E\u044F\u2026 \u201C\u041F\u0443\u0441\u0442\u044C
      \u0432\u0435\u0441\u044C \u043D\u0430\u0440\u043E\u0434 \u0435\u0441\u0442
      \u0438 \u043F\u044C\u0451\u0442!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524288
    m_Localized: "\u041D\u0430 \u0448\u0443\u0442\u043A\u0443 \u043A\u043E\u0440\u043E\u043B\u044F
      \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E \u0434\u0435\u0440\u0437\u043A\u043E\u0435
      \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u0433\u0435\u0440\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524289
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0451\u043C \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u044B\u0435
      \u043D\u043E\u0432\u043E\u0441\u0442\u0438 \u2014 \u044D\u0442\u043E MSN \u041D\u043E\u0432\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524290
    m_Localized: "\u0413\u0435\u0440\u043E\u0439 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0431\u0435\u0434\u044B \u043D\u0430\u0434
      \u0442\u0451\u043C\u043D\u044B\u043C \u0432\u043B\u0430\u0434\u044B\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 86912524291
    m_Localized: "\u0412\u043E\u043F\u0440\u0435\u043A\u0438 \u043F\u0440\u043E\u0433\u043D\u043E\u0437\u0430\u043C
      \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u043E\u0432, \u0433\u0435\u0440\u043E\u0439
      \u0432\u043D\u043E\u0432\u044C \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C
      \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0438 \u0432\u0441\u0435\u0433\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0434\u0435\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 86912524292
    m_Localized: "\u041D\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F \u0443\u0448\u043B\u043E
      \u0432\u0441\u0435\u0433\u043E 6 \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 86912524293
    m_Localized: "\u0412 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438 \u0441
      \u0431\u0435\u0441\u043F\u0440\u0435\u0446\u0435\u0434\u0435\u043D\u0442\u043D\u044B\u043C
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u043C \u044D\u0444\u0438\u0440\u043E\u043C
      \u043D\u0430 Wtube, \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
      \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u0432\u0437\u043B\u0435\u0442\u0435\u043B \u0434\u043E \u0440\u0435\u043A\u043E\u0440\u0434\u043D\u044B\u0445
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 86912524294
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043A\u043E\u0440\u043E\u043B\u044C
      \u0432\u0440\u0443\u0447\u0438\u043B \u043C\u0435\u0434\u0430\u043B\u044C \u0437\u0430
      \u0431\u043E\u0435\u0432\u044B\u0435 \u0437\u0430\u0441\u043B\u0443\u0433\u0438
      \u0438 \u201C\u041E\u0440\u0438\u0445\u0430\u043B\u043A\u043E\u0432\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443\u201D, \u043E\u0442\u043C\u0435\u0447\u0430\u044F
      \u0437\u0430\u0441\u043B\u0443\u0433\u0438 \u0433\u0435\u0440\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 86912524295
    m_Localized: "\u0417\u0430\u0442\u0435\u043C \u043E\u0442\u0432\u0435\u0442 \u0433\u0435\u0440\u043E\u044F
      \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441 \u043A\u043E\u0440\u043E\u043B\u044F
      \xAB\u0422\u044B \u0442\u043E\u0447\u043D\u043E \u0443\u0431\u0438\u043B \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u044B\u043A\u0443?\xBB \u0432\u044B\u0437\u0432\u0430\u043B
      \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 86912524296
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 86912524297
    m_Localized: "(\u0441\u043C\u0435\u0445)"
    m_Metadata:
      m_Items: []
  - m_Id: 86912524298
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E
      \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u0443."
    m_Metadata:
