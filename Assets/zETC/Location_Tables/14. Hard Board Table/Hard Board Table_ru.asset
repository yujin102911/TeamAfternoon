  - m_Id: 148535238666
    m_Localized: "\xAB\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
      \u0441\u0435\u043C\u044C\u044F \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0435 \u0432\u0438\u0434\u0435\u043E,
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0449\u0435\u0435 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u0443\u044E
      \u0436\u0438\u0437\u043D\u044C \u043A\u043E\u0440\u043E\u043B\u044F \u0438
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B. \u0418\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u043A\u0430\u043A \u201C\u043E\u0442\u0435\u0446-\u0434\u0443\u0448\u043A\u0430\u201D
      \u0438 \u201C\u043E\u0442\u0435\u0446-\u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B\u201D,
      \u043A\u043E\u0440\u043E\u043B\u044C \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F
      \u0443\u043B\u044B\u0431\u0430\u043B\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u043E\u0439, \u0430
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430, \u0432 \u0441\u0432\u043E\u044E
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u043B\u0430
      \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\u0435 \u043A \u044D\u0442\u043E\u043C\u0443
      \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435, \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u044F
      \u0431\u043B\u0438\u0437\u043A\u0438\u0435 \u0438 \u0442\u0451\u043F\u043B\u044B\u0435
      \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0432\u043D\u0443\u0442\u0440\u0438
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238667
    m_Localized: "<size=20>\xAB\u041F\u0430\u0442\u0440\u0430\u0448, \u044F \u0432\u0441\u0451
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u0441\u044B\u043F\u0430\u044E!
      \u042D\u043F\u0438\u0437\u043E\u0434 2 \xAB\u0417\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u0435
      \u0437\u0430\u043C\u043A\u0430 \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0438\xBB:
      \u0442\u0440\u0435\u0442\u044C\u044F \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u043E
      \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u044B\u043A\u0443, \u0411\u0435\u043B\u043E\u0433\u043E
      \u0434\u0440\u0430\u043A\u043E\u043D\u0430, \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238668
    m_Localized: "\xAB\u0413\u0435\u0440\u043E\u0439 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440, \u043E\u0441\u043D\u043E\u0432\u044B\u0432\u0430\u044F\u0441\u044C
      \u043D\u0430 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u0445 \u043E
      \u0442\u043E\u043C, \u0447\u0442\u043E \u0442\u0451\u043C\u043D\u044B\u0439
      \u0432\u043B\u0430\u0434\u044B\u043A\u0430 \u0411\u0435\u043B\u044B\u0439 \u0434\u0440\u0430\u043A\u043E\u043D
      \u0431\u044B\u043B \u0437\u0430\u043C\u0435\u0447\u0435\u043D \u0432 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0445
      \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u0445. \u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u0438\u0437-\u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0438 \u0432\u044B\u0440\u0432\u0430\u043B\u0441\u044F
      \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0448\u0438\u043F \u0438 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u043B
      \u0433\u0435\u0440\u043E\u044F! \u042D\u043F\u0438\u0437\u043E\u0434 2 \xAB\u0417\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u0435
      \u0437\u0430\u043C\u043A\u0430 \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0438\xBB
      \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u043D\u0430
      \u043A\u0430\u043D\u0430\u043B\u0435 \u0433\u0435\u0440\u043E\u044F.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238669
    m_Localized: "<size=20>\xAB\u041A\u043E\u0440\u043E\u043B\u044C \u0440\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u0434\u043E\u0431\u044B\u0447\u0443, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0443\u044E
      \u0433\u0435\u0440\u043E\u0435\u043C \u2014 \u201C\u041F\u043B\u0430\u0449
      \u0411\u0435\u043B\u043E\u0433\u043E \u0434\u0440\u0430\u043A\u043E\u043D\u0430\u201D\u2026
      \u201C\u041C\u043E\u044F \u0432\u043B\u0430\u0441\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C
      \u0437\u0430\u043C\u0435\u0442\u043D\u0435\u0435\u201D\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238670
    m_Localized: "\xAB\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043A\u043E\u0440\u043E\u043B\u044C
      \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043B \u0432\u0438\u0434\u0435\u043E,
      \u0433\u0434\u0435 \u0440\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043F\u043B\u0430\u0449 \u0411\u0435\u043B\u043E\u0433\u043E \u0434\u0440\u0430\u043A\u043E\u043D\u0430,
      \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0435\u043C.
      \u041D\u0430\u0434\u0435\u0432 \u043F\u043B\u0430\u0449, \u043A\u043E\u0440\u043E\u043B\u044C
      \u043E\u0431\u043E\u0448\u0451\u043B \u0437\u0430\u043C\u043E\u043A, \u0433\u043E\u0440\u0434\u043E
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044F: \u201C\u041A\u0430\u043A
      \u0432\u0430\u043C \u043C\u043E\u044F \u0432\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C?\u201D,
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u044F
      \u0441\u0432\u043E\u044E \u0440\u0430\u0434\u043E\u0441\u0442\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238671
    m_Localized: "<size=20>\xAB\u201C\u0414\u0430\u0436\u0435 \u0434\u0440\u0430\u043A\u043E\u043D\u0430
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0436\u0430\u0440\u0438\u0442\u044C\u201D
      \u2014 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442
      \u043E\u0441\u043E\u0431\u0443\u044E \u043B\u044E\u0431\u043E\u0432\u044C \u043A
      \u0436\u0430\u0440\u0435\u043D\u044B\u043C \u0431\u043B\u044E\u0434\u0430\u043C\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238672
    m_Localized: "\xAB\u041D\u0430 \u043D\u0435\u0434\u0430\u0432\u043D\u0435\u043C
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C \u0443\u0436\u0438\u043D\u0435
      \u0431\u044B\u043B\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u043E,
      \u0447\u0442\u043E \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
      \u043B\u044E\u0431\u0438\u0442 \u0436\u0430\u0440\u0435\u043D\u044B\u0435 \u0431\u043B\u044E\u0434\u0430.
      \u0420\u0430\u043D\u0435\u0435 \u0432 \u0432\u0438\u0434\u0435\u043E \u043D\u0430
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u043C \u043A\u0430\u043D\u0430\u043B\u0435
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0443\u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430:
      \u201C\u0414\u0430\u0436\u0435 \u0434\u0440\u0430\u043A\u043E\u043D\u0430 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0436\u0430\u0440\u0438\u0442\u044C, \u0438 \u044F \u0445\u043E\u0442\u0435\u043B\u0430
      \u0431\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u0441\u0443\u043F\u0440\u0443\u0433\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u0443\u0434\u0435\u0442 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u043C\u043D\u0435 \u0436\u0430\u0440\u0435\u043D\u0443\u044E \u0435\u0434\u0443
      \u043F\u043E \u0443\u0442\u0440\u0430\u043C\u201D\xBB."
