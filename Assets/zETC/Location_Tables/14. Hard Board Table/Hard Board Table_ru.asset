  m_TableData:
  - m_Id: 148505878528
    m_Localized: "<size=20>\xAB\u041A\u043E\u0440\u043E\u043B\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B
      \u0433\u0435\u0440\u043E\u044E: \u201C\u0418\u0434\u0438 \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u044C
      \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F \u0432 \u0441\u0442\u0440\u0430\u043D\u0435
      \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0443\u201D.
      \u0413\u0435\u0440\u043E\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0443\u0442\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238656
    m_Localized: "\xAB\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043A\u043E\u0440\u043E\u043B\u044C
      \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B \u0433\u0435\u0440\u043E\u044E
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0442\u0440\u0451\u0445
      \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F \u0432 \u0441\u0442\u0440\u0430\u043D\u0435
      \u0442\u0451\u043C\u043D\u044B\u0445 \u0432\u043B\u0430\u0434\u044B\u043A \u0434\u043E
      \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0441\u043E\u0441\u0442\u043E\u0438\u0442\u0441\u044F
      \u0441\u0432\u0430\u0434\u044C\u0431\u0430. \u041F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u044B\u0435
      \u0438 \u043D\u0430\u0440\u043E\u0434 \u0432\u044B\u0440\u0430\u0437\u0438\u043B\u0438
      \u0441\u0432\u043E\u0438 \u043E\u043F\u0430\u0441\u0435\u043D\u0438\u044F,
      \u043D\u043E \u043A\u043E\u0440\u043E\u043B\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B
      \u0442\u0432\u0451\u0440\u0434\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E,
      \u0433\u043E\u0432\u043E\u0440\u044F: \u201C\u041D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0442\u0451\u043C\u043D\u044B\u0439 \u0432\u043B\u0430\u0434\u044B\u043A\u0430
      \u043F\u043E\u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0445\u0438\u0442\u0438\u0442\u044C
      \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0443, \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435
      \u043F\u043E\u0441\u043B\u043E\u0432\u0438\u0446\u0443: \u043B\u0443\u0447\u0448\u0430\u044F
      \u0437\u0430\u0449\u0438\u0442\u0430 \u2014 \u044D\u0442\u043E \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435.\u201D.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238657
    m_Localized: "<size=20>\xAB[\u041B\u0451\u0433\u043A\u0438\u0439 \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A
      \u043F\u043E \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C]
      \u0422\u0451\u043C\u043D\u044B\u0445 \u0432\u043B\u0430\u0434\u044B\u043A \u0431\u043E\u043B\u044C\u0448\u0435
      \u043E\u0434\u043D\u043E\u0433\u043E?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238658
    m_Localized: "\xAB\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435
      \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u043E\u0442
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430 \u0432 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0422\u0451\u043C\u043D\u044B\u0435
      \u0432\u043B\u0430\u0434\u044B\u043A\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0447\u0438\u0441\u043B\u0443 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u0438\u0439:
      \u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u0434\u0440\u0430\u043A\u043E\u043D,
      \u0421\u0438\u043D\u0438\u0439 \u0434\u0440\u0430\u043A\u043E\u043D, \u0411\u0435\u043B\u044B\u0439
      \u0434\u0440\u0430\u043A\u043E\u043D \u0438 \u0427\u0451\u0440\u043D\u044B\u0439
      \u0434\u0440\u0430\u043A\u043E\u043D. \u041E\u0434\u043D\u0430\u043A\u043E
      \u043E\u043D\u0438 \u043B\u0438\u0431\u043E \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438
      \u0438\u0437 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F,
      \u043B\u0438\u0431\u043E \u043F\u043E\u043A\u0438\u0434\u0430\u043B\u0438 \u0441\u0432\u043E\u0438
      \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0447\u0435\u043C\u0443 \u0432 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B\u0441\u044F \u043C\u0438\u0440\u2026\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238659
    m_Localized: "<size=20>\xAB\u0413\u0435\u0440\u043E\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043D\u043E\u0432\u044B\u0439 \u043A\u043E\u043D\u0442\u0435\u043D\u0442 \u043D\u0430
      Wtube\u2026 \u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044D\u0442\u043E
      \u043D\u0435 \u0432\u044B\u0437\u043E\u0432, \u0430 \u0437\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238660
    m_Localized: "\xAB\u0413\u0435\u0440\u043E\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043B
      \u043D\u043E\u0432\u044B\u0439 \u043A\u043E\u043D\u0442\u0435\u043D\u0442 \u043D\u0430
      \u0441\u0432\u043E\u0451\u043C \u043B\u0438\u0447\u043D\u043E\u043C \u043A\u0430\u043D\u0430\u043B\u0435
      Wtube. \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u2014 \xAB\u0417\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u0435
      \u0437\u0430\u043C\u043A\u0430 \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0438\xBB,
      \u0438, \u043A\u0430\u043A \u043E\u043D \u0441\u043E\u043E\u0431\u0449\u0438\u043B,
      \u0432 \u043D\u0451\u043C \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E
      \u0432\u0441\u0451 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
      \u043F\u043E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044E
      \u0442\u0440\u0451\u0445 \u0442\u0451\u043C\u043D\u044B\u0445 \u0432\u043B\u0430\u0434\u044B\u043A.
      \xAB\u0417\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u0435 \u0437\u0430\u043C\u043A\u0430
      \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0438\xBB
      \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E
      \u043D\u0430 \u043B\u0438\u0447\u043D\u043E\u043C \u043A\u0430\u043D\u0430\u043B\u0435
      \u0433\u0435\u0440\u043E\u044F \u0441 \u043D\u0430\u0447\u0430\u043B\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238661
    m_Localized: "<size=20>\xAB\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u0441\u0432\u0435\u0440\u043A\u0430\u0435\u0442 \u043C\u043E\u043B\u043D\u0438\u044F
      \u2014 \u0432\u043F\u0435\u0440\u0451\u0434! \u042D\u043F\u0438\u0437\u043E\u0434
      1 \xAB\u0417\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u0435 \u0437\u0430\u043C\u043A\u0430
      \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0438\xBB:
      \u0432\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u043E
      \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0432\u043B\u0430\u0434\u044B\u043A\u0443, \u0421\u0438\u043D\u0435\u0433\u043E
      \u0434\u0440\u0430\u043A\u043E\u043D\u0430, \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238662
    m_Localized: "\xAB\u0413\u0435\u0440\u043E\u0439, \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u044F,
      \u0447\u0442\u043E \u043A\u0430\u043A \u043C\u0438\u043D\u0438\u043C\u0443\u043C
      \u043E\u0434\u0438\u043D \u0442\u0451\u043C\u043D\u044B\u0439 \u0432\u043B\u0430\u0434\u044B\u043A\u0430
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435,
      \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F \u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0435
      \u0441\u0442\u0430\u0440\u043E\u0435 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435.
      \u0416\u0434\u0430\u0432\u0448\u0438\u0439 \u0435\u0433\u043E \u0442\u0451\u043C\u043D\u044B\u0439
      \u0432\u043B\u0430\u0434\u044B\u043A\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0421\u0438\u043D\u0438\u043C \u0434\u0440\u0430\u043A\u043E\u043D\u043E\u043C,
      \u043F\u043E \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044E \u0432\u043B\u0430\u0434\u0435\u044E\u0449\u0438\u043C
      \u043C\u043E\u043B\u043D\u0438\u044F\u043C\u0438. \u042D\u043F\u0438\u0437\u043E\u0434
      1 \xAB\u0417\u0430\u0432\u043E\u0435\u0432\u0430\u043D\u0438\u0435 \u0437\u0430\u043C\u043A\u0430
      \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0438\xBB
      \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u043D\u0430
      \u043A\u0430\u043D\u0430\u043B\u0435 \u0433\u0435\u0440\u043E\u044F.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238663
    m_Localized: "<size=20>\xAB\u2018\u0413\u0435\u0440\u043E\u044F \u043E\u0431\u0432\u0438\u043D\u044F\u044E\u0442
      \u0432 \u043A\u043B\u0435\u0432\u0435\u0442\u0435\u2019 \u2014 \u0434\u0435\u043C\u043E\u043D
      \u0410, \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440\u0451\u043D\u043D\u044B\u0439
      \u043A \u0448\u0442\u0440\u0430\u0444\u0443 \u0432 \u043F\u0435\u0440\u0432\u043E\u0439
      \u0438\u043D\u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u043E\u0441\u043F\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043B\u0443\u0436\u0430\u043D\u043A\u0430\u043C\u0438 \u0433\u0435\u0440\u043E\u044F
      \u0432 \u0430\u043F\u0435\u043B\u043B\u044F\u0446\u0438\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238664
    m_Localized: "\xAB\u0414\u0435\u043C\u043E\u043D \u0410 \u0431\u044B\u043B \u043E\u0448\u0442\u0440\u0430\u0444\u043E\u0432\u0430\u043D
      \u043D\u0430 3000 \u0434\u0438\u043D\u0430\u0440\u043E\u0432 \u0437\u0430 \u043A\u043B\u0435\u0432\u0435\u0442\u0443
      \u043D\u0430 \u0433\u0435\u0440\u043E\u044F. \u041E\u0434\u043D\u0430\u043A\u043E
      \u0441\u043B\u0443\u0433\u0438 \u0433\u0435\u0440\u043E\u044F \u043F\u043E\u0434\u0430\u043B\u0438
      \u0430\u043F\u0435\u043B\u043B\u044F\u0446\u0438\u044E, \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u0432
      \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u044F\u0433\u043A\u0438\u043C. \u0421\u0430\u043C \u0434\u0435\u043C\u043E\u043D
      \u0410 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442: \u201C\u0421\u0430\u043C
      \u0444\u0430\u043A\u0442 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0432\u043B\u0430\u0434\u044B\u043A\u0443
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u043B\u0438 \u0442\u0430\u043A
      \u0431\u044B\u0441\u0442\u0440\u043E, \u2014 \u044D\u0442\u043E \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u201D\u2026\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238665
    m_Localized: "<size=20>\xAB[\u0424\u043E\u0442\u043E\u043F\u043E\u0434\u0431\u043E\u0440\u043A\u0430]
      \u201C\u041A\u043E\u0440\u043E\u043B\u044C-\u0442\u043E, \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0434\u0443\u0448\u0438 \u043D\u0435 \u0447\u0430\u0435\u0442 \u0432 \u0434\u043E\u0447\u043A\u0435\u201D
      \u2014 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043E
      \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0435 \u0432\u0438\u0434\u0435\u043E
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439 \u0441\u0435\u043C\u044C\u0438\xBB"
