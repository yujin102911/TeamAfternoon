  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Hard Board Table_ko-KR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: 2da076b6776cc384daa3ebf2b151408b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 148505878528
    m_Localized: "\uAD6D\uC655, \uC6A9\uC0AC\uC5D0\uAC8C \u201C\uAD6D\uD63C \uC804
      \uB0A8\uC544\uC788\uB294 \uB9C8\uC655\uC744 \uD1A0\uBC8C\uD558\uB77C\u201D
      \uBA85\uB839\uD574\u2026 \uC6A9\uC0AC \uC624\uB298 \uC5EC\uD589\uAE38 \uC62C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238656
    m_Localized: "\uAD6D\uC655\uC774 \uC624\uB298 \uC6A9\uC0AC\uC5D0\uAC8C \uAD6D\uD63C\uC744
      \uC131\uC0AC\uD558\uAE30 \uC804 \uB0A8\uC740 \uB9C8\uC655 \uC14B\uC744 \uBB34\uCC0C\uB974\uB77C\uACE0
      \uBA85\uB839\uD588\uB2E4. \uC2E0\uD558\uC640 \uBC31\uC131\uB4E4\uC740 \uC6B0\uB824\uB97C
      \uD45C\r\n\uD588\uC73C\uB098, \u201C\uB2E4\uB978 \uB9C8\uC655\uC774 \uC5B8\uC81C
      \uACF5\uC8FC\uB97C \uB0A9\uCE58\uD558\uB824 \uB4E4\uC9C0 \uBAA8\uB978\uB2E4,
      \uC120\uBE75\uD544\uC2B9\uC774\uB77C\uB294 \uACA9\uC5B8\uC744 \uC78A\uC9C0
      \uB9D0\uC544\uC57C\u201D \uB77C\uBA70 \uAC15\uACBD\uD55C\r\n\uD0DC\uB3C4\uB97C
      \uC720\uC9C0\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 148535238657
    m_Localized: "[\uC27D\uAC8C \uBCF4\uB294 \uC2DC\uC0AC\uC0C1\uC2DD] \uB9C8\uC655\uC740
      \uD558\uB098\uAC00 \uC544\uB2C8\uB2E4?"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238658
    m_Localized: "\uD0DC\uCD08\uC5D0 \uB358\uC804\uC740 \uC655\uAD6D\uC744 \uAC00\uC6B4\uB370\uC5D0
      \uB450\uACE0 \uB124 \uBC29\uD5A5\uC73C\uB85C \uAC08\uB77C\uC838 \uC788\uC5C8\uB2E4.
      \uB9C8\uC655\uB3C4 \uB358\uC804\uC758 \uC218\uC5D0 \uB9DE\uAC8C \uB808\uB4DC
      \uB4DC\uB798\uACE4\u47BB\uBE14\uB8E8\n\uB4DC\uB798\uACE4\u47BB\uD654\uC774\uD2B8
      \uB4DC\uB798\uACE4\u47BB\uBE14\uB799 \uB4DC\uB798\uACE4 \uCD1D \uB137\uC774\uC5C8\uC73C\uB098,
      \uB358\uC804 \uC548\uC5D0\uC11C \uB098\uC624\uC9C0 \uC54A\uAC70\uB098 \uD130\uB97C
      \uBC84\uB9AC\uACE0 \uB5A0\uB098 \uC655\uAD6D\uC758 \uD3C9\uD654\n\uAC00 \uC720\uC9C0\uB418\uC5C8\uB358\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238659
    m_Localized: "\uC6A9\uC0AC, \uC0C8 Wtube \uCF58\uD150\uCE20 \uBC1C\uD45C\u2026
      \uC774\uBC88\uC5D4 \uB3C4\uC804\uC774 \uC544\uB2CC \uC815\uBCF5\uC774\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238660
    m_Localized: "\uC6A9\uC0AC\uAC00 \uC774\uBC88 Wtube \uAC1C\uC778 \uCC44\uB110\uC744
      \uD1B5\uD574 \uC0C8 \uCF58\uD150\uCE20\uB97C \uBC1C\uD45C\uD588\uB2E4. \uC81C\uBAA9\uC740
      <\uB9C8\uC655\uC131 \uC815\uBCF5\uAE30>\uB85C, \uC138 \uB9C8\uC655\uC744 \uCC98\uCE58\uD558\uB294\r\n\uC5EC\uC815
      \uC804\uCCB4\uB97C \uB2F4\uC744 \uAC83\uC774\uB77C\uACE0 \uBC1D\uD614\uB2E4.
      <\uB9C8\uC655\uC131 \uC815\uBCF5\uAE30>\uB294 \uB2E4\uC74C \uC8FC\uBD80\uD130
      \uC6A9\uC0AC \uAC1C\uC778 \uCC44\uB110\uC5D0 \uACF5\uAC1C\uB420 \uC608\uC815\uC774\uB2E4.
      \r"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238661
    m_Localized: "\uBC88\uAC1C\uAC00 \uB0B4\uB9AC\uCCD0\uB3C4 \uB3CC\uACA9! <\uB9C8\uC655\uC131
      \uC815\uBCF5\uAE30> 1\uD654 \uB450\uBC88\uC9F8 \uB9C8\uC655, \uBE14\uB8E8 \uB4DC\uB798\uACE4
      \uD3B8 \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238662
    m_Localized: "\uC6A9\uC0AC\uB294 \uB9C8\uC655 \uC911 \uCD5C\uC18C \uD558\uB098\uAC00
      \uB358\uC804 \uC548\uC5D0 \uC788\uC744 \uAC83\uC774\uB77C\uB294 \uCD94\uB9AC\uB97C
      \uC120\uBCF4\uC774\uBA70 \uD3D0\uC1C4\uB41C \uAD6C \uB358\uC804\uC73C\uB85C
      \uD5A5\uD588\uB2E4. \uAE30\uB2E4\uB9AC\uACE0\r\n\uC788\uB358 \uB9C8\uC655\uC740
      \uBE14\uB8E8 \uB4DC\uB798\uACE4\uC73C\uB85C, \uBC88\uAC1C\uB97C \uB2E4\uB8EC\uB2E4\uB294
      \uC804\uC2B9\uC774 \uB0B4\uB824\uC628\uB2E4. <\uB9C8\uC655\uC131 \uC815\uBCF5\uAE30>
      1\uD654\uB294 \uD604\uC7AC \uC6A9\uC0AC \uCC44\uB110\uC5D0\uC11C\r\n\uC2DC\uCCAD
      \uAC00\uB2A5."
    m_Metadata:
      m_Items: []
  - m_Id: 148535238663
    m_Localized: "\u2018\uC6A9\uC0AC \uBA85\uC608\uD6FC\uC190 \uD610\uC758\u2019
      \uB9C8\uC871 A\uC528, 1\uC2EC \uBC8C\uAE08\uD615\uC5D0 \uC6A9\uC0AC\uC758 \uBB34\uC218\uB9AC\uB4E4
      \uD56D\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238664
    m_Localized: "\uB9C8\uC871 A\uC528\uAC00 \uC6A9\uC0AC\uC758 \uBA85\uC608\uD6FC\uC190
      \uD610\uC758\uB85C 3\uCC9C \uB514\uB098\uB974\uC758 \uBC8C\uAE08\uC744 \uC120\uACE0\uBC1B\uC558\uB2E4.
      \uADF8\uB7EC\uB098 \uC6A9\uC0AC\uC758 \uBB34\uC218\uB9AC\uB4E4\uC740 \uD615\uC774
      \uC801\uB2E4\r\n\uB294 \uC774\uC720\uB85C \uD56D\uC18C\uB97C \uC81C\uAE30\uD588\uB2E4.
      \uB9C8\uC871 A\uC528\uB294 \u201C\uC774\uB807\uAC8C \uBE60\uB978 \uC2DC\uC77C
      \uB0B4\uC5D0 \uB450 \uBC88\uC9F8 \uB9C8\uC655\uC744 \uCC98\uCE58\uD588\uB2E8
      \uC790\uCCB4\uAC00 \uC0AC\uAE30\uADF9\u201D\uC774\r\n\uB77C\uACE0 \uC8FC\uC7A5\uD558\uBA70\u2026."
    m_Metadata:
      m_Items: []
  - m_Id: 148535238665
    m_Localized: "[\uD654\uBCF4] \u201C\uAD6D\uC655\uB3C4 \uD3C9\uBC94\uD55C \uB538\uBC14\uBCF4\uC600\uAD6C\uB098\u201D
      \uC655\uC2E4 \uBE44\uACF5\uAC1C \uC601\uC0C1 \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238666
    m_Localized: "\uC655\uC2E4\uC774 \uAD6D\uC655\uACFC \uACF5\uC8FC\uC758 \uC77C\uC0C1\uC744
      \uB2F4\uC740 \uBE44\uACF5\uAC1C \uC601\uC0C1\uC744 \uACF5\uAC1C\uD588\uB2E4.
      \uD3C9\uC18C \u2018\uB538\uBC14\uBCF4\u2019, \u2018\uACF5\uC8FC\uBC14\uBCF4\u2019\uB85C
      \uC54C\uB824\uC9C4 \uAD6D\uC655\uC740 \uACF5\uC8FC\r\n\uC640 \uD568\uAED8 \uD558\uB294
      \uB0B4\uB0B4 \uD568\uBC15\uC6C3\uC74C\uC744 \uC9C0\uC5C8\uC73C\uBA70, \uACF5\uC8FC\uB3C4
      \uC774\uB7F0 \uAD6D\uC655\uC758 \uBAA8\uC2B5\uC5D0 \uC775\uC219\uD568\uC744
      \uBCF4\uC5EC \uC655\uC2E4 \uC2DD\uAD6C \uAC04\uC758 \uB3C8\uB3C5\uD568\uC744\r\n\uC790\uB791\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 148535238667
    m_Localized: "\uD30C\uD2B8\uB77C\uC288, \uB098 \uC810\uC810 \uC7A0\uC774 \uC640!
      <\uB9C8\uC655\uC131 \uC815\uBCF5\uAE30> 2\uD654 \uC138\uBC88\uC9F8 \uB9C8\uC655,
      \uD654\uC774\uD2B8 \uB4DC\uB798\uACE4 \uD3B8 \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238668
    m_Localized: "\uC6A9\uC0AC\uB294 \uB9C8\uC655 \uD654\uC774\uD2B8 \uB4DC\uB798\uACE4\uC774
      \uCD94\uC6B4 \uC9C0\uC5ED\uC5D0\uC11C \uB098\uB294 \uBAA8\uC2B5\uC774 \uBC1C\uACAC\uB41C\uB2E4\uB294
      \uBAA9\uACA9\uB2F4\uC744 \uD1A0\uB300\uB85C \uBD81\uCABD\uC73C\uB85C \uD5A5\uD588\uB2E4.
      \uADF8\uB7EC\r\n\uB358 \uB3C4\uC911 \uC19F\uAD6C\uCE5C \uC5BC\uC74C \uAC00\uC2DC\uAC00
      \uC6A9\uC0AC\uB97C \uC2B5\uACA9\uD558\uB294\uB370! <\uB9C8\uC655\uC131 \uC815\uBCF5\uAE30>
      2\uD654\uB294 \uD604\uC7AC \uC6A9\uC0AC \uCC44\uB110\uC5D0\uC11C \uC2DC\uCCAD
      \uAC00\uB2A5."
    m_Metadata:
      m_Items: []
  - m_Id: 148535238669
    m_Localized: "\uAD6D\uC655, \uC6A9\uC0AC\uAC00 \uC9C4\uC0C1\uD55C \uC804\uB9AC\uD488
      \u2018\uD654\uC774\uD2B8 \uB4DC\uB798\uACE4 \uB9DD\uD1A0\u2019 \uC5B8\uBC15\uC2F1\u2026
      \u201C\uB0B4\uAC00 \uC5EC\uCFE8\uC774\uB77C \uD654\uC774\uD2B8\uAC00 \uC798
      \uC5B4\uC6B8\uB824\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238670
    m_Localized: "\uAD6D\uC655\uC774 \uC624\uB298 \uC6A9\uC0AC\uAC00 \uC9C4\uC0C1\uD55C
      \uD654\uC774\uD2B8 \uB4DC\uB798\uACE4 \uB9DD\uD1A0\uB97C \uAC1C\uBD09\uD558\uB294
      \uC601\uC0C1\uC744 \uACF5\uAC1C\uD588\uB2E4. \uAD6D\uC655\uC740 \uB9DD\uD1A0\uB97C
      \uB450\uB974\uACE0 \uC655\uC131\uC744\r\n\uB3CC\uBA74\uC11C \u201C\uC704\uC5C4\uC774
      \uC5B4\uB5A0\uB290\uB0D0\u201D\uACE0 \uC790\uB791\uD558\uBA70 \uAE30\uC05C
      \uB9C8\uC74C\uC744 \uACE0\uC2A4\uB780\uD788 \uB4DC\uB7EC\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 148535238671
    m_Localized: "\u201C\uB4DC\uB798\uACE4\uB3C4 \uD280\uAE30\uBA74 \uBA39\uC744
      \uC218 \uC788\uC5B4\u201D \uACF5\uC8FC, \uD280\uAE40 \uC694\uB9AC\uC5D0 \uB0A8\uB2E4\uB978
      \uC560\uC815 \uB4DC\uB7EC\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 148535238672
    m_Localized: "\uC774\uBC88 \uACF5\uAC1C \uB9CC\uCC2C\uC5D0\uC11C \uACF5\uC8FC\uAC00
      \uD280\uAE40 \uC694\uB9AC\uB97C \uC5EC\uC804\uD788 \uC990\uACA8 \uBA39\uB294\uB2E4\uB294
      \uC0AC\uC2E4\uC774 \uBC1D\uD600\uC84C\uB2E4. \uACF5\uC8FC\uB294 \uACFC\uAC70
      \uC655\uC2E4 \uCC44\uB110 \uC601\uC0C1\r\n\uC5D0\uC11C\uB3C4 \u201C\uB4DC\uB798\uACE4\uB3C4
      \uD280\uAE30\uBA74 \uB9DB\uB0A0 \uAC83, \uC544\uCE68\uC5D0 \uD280\uAE40 \uC694\uB9AC\uB97C
      \uD574\uC8FC\uB294 \uBC30\uC6B0\uC790\uB97C \uB9CC\uB098\uACE0 \uC2F6\uB2E4\u201D\uACE0
      \uB9D0\uD55C \uBC14 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
