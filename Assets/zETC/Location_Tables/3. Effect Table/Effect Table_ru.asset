  m_TableData:
  - m_Id: 32461537280
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C.mfx,"
    m_Metadata:
      m_Items: []
  - m_Id: 32482508800
    m_Localized: "\u042D\u0444\u0444\u0435\u043A\u0442 \u043A\u043B\u0438\u043F\u043E\u0432,
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445 \u0441 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 2 \u0440\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 32486703104
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0443\u0440\u043E\u043D\u0430.mfx"
    m_Metadata:
      m_Items: []
  - m_Id: 32486703105
    m_Localized: "\u0423\u0440\u043E\u043D \u0430\u0442\u0430\u043A\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 +3."
    m_Metadata:
      m_Items: []
  - m_Id: 32486703106
    m_Localized: "\u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0443\u0434\u0430\u0440.mfx"
    m_Metadata:
      m_Items: []
  - m_Id: 32486703107
    m_Localized: "\u0423\u0440\u043E\u043D \u0430\u0442\u0430\u043A\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 2 \u0440\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 32486703108
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435.mfx"
    m_Metadata:
      m_Items: []
  - m_Id: 32486703109
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432\u0440\u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1922903857414144
    m_Localized: "\u0411\u0435\u0440\u0441\u0435\u0440\u043A.mfx"
    m_Metadata:
      m_Items: []
  - m_Id: 1922930436718592
    m_Localized: "\u0421\u043D\u0438\u0436\u0430\u0435\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435
      \u043D\u0430 <color=#D94036>\u2665 -1</color>, \u043D\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0443\u0440\u043E\u043D \u0430\u0442\u0430\u043A\u0438 \u0432 3 \u0440\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1922994861228032
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435.mfx"
    m_Metadata:
      m_Items: []
  - m_Id: 1923136754532352
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      <color=#D94036>\u2665 +1</color>, \u043D\u043E \u043B\u0435\u0447\u0438\u0442
      \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 10% \u043E\u0442 \u043C\u0430\u043A\u0441.
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
    m_Metadata:
      m_Items: []
