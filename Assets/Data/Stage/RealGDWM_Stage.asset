  _stageNumber: 1
  _stageName: "[\uC758\uB8B0] \uC9C0\uAE08 \uC99D\uAC70\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
  _requestLetter: "\uCE5C\uC560\uD558\uB294 \uD3B8\uC9D1\uC0AC\uB2D8\uAED8,\r\n\uC548\uB155\uD558\uC138\uC694\u2026\r\n\uC774\uB807\uAC8C
    \uBA54\uC77C\uC744 \uB4DC\uB9AC\uAC8C \uB420 \uC904\uC740 \uC815\uB9D0 \uBAB0\uB790\uB294\uB370\uC694\u2026\r\n\uC624\uB298
    \uB358\uC804 1\uCE35\uC5D0\uC11C \uC2AC\uB77C\uC784\uACFC \uC804\uD22C\uB97C
    \uBC8C\uC600\uB2E4\uAC00\u2026 \uD604\uC7AC \uC5EC\uB7EC \uC758\uBBF8\uB85C \uACE4\uB780\uD55C
    \uC0C1\uD669\uC5D0 \uB193\uC778 \uC6A9\uC0AC\uC785\uB2C8\uB2E4.\r\n\uC2AC\uB77C\uC784\uACFC\uC758
    \uC804\uD22C \uACB0\uACFC\uB294 \uBB50\u2026 \uB124. \uCC38\uD328\uD588\uC2B5\uB2C8\uB2E4.\n\n\uADF8\uB7F0\uB370
    \uBB38\uC81C\uAC00 \uD558\uB098 \uC0DD\uACBC\uC2B5\uB2C8\uB2E4\u2026 \uC544\uB2C8,
    \uC0AC\uC2E4 \uBB38\uC81C\uB294 \uC774\uCABD\uC774 \uB354 \uD07D\uB2C8\uB2E4.\r\n\uC81C\uAC00
    \uC870\uAE08 \uC804\uC5D0 \uC6A9\uC0AC \uCC44\uC6A9\uC18C\uC5D0 <color=red>\uC2AC\uB77C\uC784\uC740
    \uAE54\uB054\uD558\uAC8C \uCC98\uB9AC\uD588\uB2E4</color>\uACE0 \uB9D0\uD574\uBC84\uB838\uAC70\uB4E0\uC694.
    (\uC65C \uADF8\uB7AC\uB294\uC9C0\uB294 \uC800\uB3C4 \uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4)\r\n(\uB2F9\uC5F0\uD558\uAE34
    \uD55C\uB370) \uADF8 \uB9D0\uC744 \uC815\uB9D0 \uADF8\uB300\uB85C \uBBFF\uC740
    \uAC74\uC9C0 \uCC44\uC6A9\uC18C\uC5D0\uC11C \uACE7 \uC120\uBC1C \uC808\uCC28\uC5D0
    \uB4E4\uC5B4\uAC04\uB2E4\uB294 \uC5F0\uB77D\uC774 \uC640\uBC84\uB838\uACE0\uC694\u2026\r\n\uC9C0\uAE08
    \uC640\uC11C \uC0AC\uC2E4\uB300\uB85C \uB9D0\uD558\uC790\uB2C8\u2026 <color=red>\uBC88\uBCF5\uD558\uAE30\uC5D4
    \uC81C\uAC00 \uB108\uBB34 \uC5C6\uC5B4 \uBCF4\uC77C \uAC83 \uAC19\uC544\uC11C\uC694\u2026</color>\n\n\uADF8\uB798\uC11C\u2026
    \uC5FC\uCE58\uC5C6\uC9C0\uB9CC \uC774\uB807\uAC8C \uB3C4\uC6C0\uC744 \uC694\uCCAD\uB4DC\uB9AC\uAC8C
    \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uB2E4\uD589\uC774\uB77C\uBA74 \uB2E4\uD589\uD788\uB3C4,
    \uB358\uC804\uC5D0\uC11C \uC2F8\uC6B0\uB2E4 \uB0A8\uC740 <color=red>\uC804\uD22C
    \uD589\uB3D9 \uAE30\uB85D \uD074\uB9BD</color>\uB4E4\uC740 \uC870\uAE08 \uAC00\uC9C0\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\uD65C\uC744 \uD55C \uBC88 \uC408\uB358 \uC7A5\uBA74\uC774\uB77C\uB4E0\uC9C0,
    \uAD1C\uD788 \uC5EC\uB7EC \uBC88 \uC6C0\uC9C1\uC774\uB294 \uC7A5\uBA74\uC774\uB77C\uB4E0\uC9C0\u2026
    \uADF8\uB7F0 \uAC83\uB4E4\uC778\uB370\uC694\u2026\u314E\u314E\r\n\uC774\uAC78\u2026
    \uC815\uB9D0 \uC798 \uC870\uD569\uD558\uBA74\u2026 <color=red>\uC774\uAE34 \uC804\uD22C
    \uD558\uB098\uCBE4\uC740 \uB9CC\uB4E4 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C
    \uD574\uC11C\uC694\u2026</color> (\uC544\uB2D0 \uC218\uB3C4 \uC788\uC9C0\uB9CC\uC694)\r\n\uD3B8\uC9D1\uC0AC\uB2D8\uAED8\uC11C\uB294
    \uC561\uC158 \uD074\uB9BD\uB4E4\uC744 \uC774\uC5B4 \uBD99\uC5EC\uC11C <color=red>\uC6D0\uD558\uB294
    \uC804\uD22C \uD750\uB984\uC744 \uC0C8\uB85C \uB9CC\uB4E4\uC5B4\uC8FC\uC2E0\uB2E4</color>\uACE0
    \uB4E4\uC5C8\uC5B4\uC694\u2026\n\n\uC5B4\uB5BB\uAC8C \uC2F8\uC6E0\uB294\uC9C0\uB294\u2026
    \uC774\uC81C \uC911\uC694\uD558\uC9C0 \uC54A\uACE0 \uC601\uC0C1 \uC18D\uC758
    \uC81C\uAC00 \uADF8\uB7F4\uB4EF\uD574 \uBCF4\uC774\uAE30\uB9CC \uD558\uBA74 \uB429\uB2C8\uB2E4\u2026^^\r\n\uBD80\uB514
    \uC81C\uAC00 \uBCF4\uB0B8 \uC561\uC158 \uD074\uB9BD\uB4E4\uB85C \uBA4B\uC9C4
    \uC804\uD22C\uB97C \uB9CC\uB4E4\uC5B4\uC8FC\uC138\uC694\u2026\n\n\uC774 \uC601\uC0C1
    \uD558\uB098\uC5D0 \uC81C \uC6A9\uC0AC \uC778\uC0DD\uC774 \uB2EC\uB824 \uC788\uC2B5\uB2C8\uB2E4\u2026
    \uC9C4\uC9DC\uB85C\uC694.\r\n\uADF8\uB7FC\u2026 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\u2026
    (\uAFB8\uBC85)\n\n\uCCA8\uBD80\uD30C\uC77C\n\n[ENTER_LINK]"
