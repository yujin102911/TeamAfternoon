  _mails:
  - subject: "\uB9C8\uC9C0\uB9C9 \uC601\uC0C1\uC785\uB2C8"
    sender: "\uC6A9\uC0AC <lv01@msn.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uC81C\uAC00 \uC6A9\uC0AC\uAC00 \uB41C \uAC74 \uC804\uBD80 \uD3B8\uC9D1\uAC00\uB2D8
      \uB355\uBD84\uC785\uB2C8\uB2E4\r\n\uB9C8\uC9C0\uB9C9 \uC601\uC0C1\uC740 \uC81C\uC77C
      \uBA4B\uC788\uAC8C \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!\n\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    unlockCondition: 0
  _boardEntries:
  - title: " \uC6A9\uC0AC, \uACFC\uC5F0 \uC9C4\uC9DC \uC601\uC6C5 \uB418\uB098"
    content: "<\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30> 5\uD654\uC5D0 \uB530\uB974\uBA74
      \uB9C8\uC655\uC774 \uC6A9\uC0AC\uC5D0\uAC8C \uBCF4\uB0B8 \uC74C\uC131 \uD3B8\uC9C0\uC758
      \uB0B4\uC6A9\uC774 \uC0C8\uBE68\uAC04 \uAC70\uC9D3\uB9D0\uC784\uC774 \uBC1D\uD600\uC84C\uB2E4.
      \uBC31\uC131 \uB300\uBD80\uBD84\uC774 \uC601\uC0C1\uC744 \uC2DC\uCCAD\uD558\uACE0
      \uB098\uC11C\uC57C \uC774\uB97C \uC54C\uAC8C \uB3FC \uB354\uC6B1 \uCDA9\uACA9\uC744
      \uC8FC\uACE0 \uC788\uB2E4. \uC6A9\uC0AC\uC758 \uC0DD\uC0AC\uAC00 \uBD88\uD22C\uBA85\uD574\uC9C0\uBA74\uC11C
      <\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30> 6\uD654\uC758 \uC5C5\uB85C\uB4DC \uC77C\uC815\uC5D0
      \uB9CE\uC740 \uAD00\uC2EC\uC774 \uBAA8\uC544\uC9C0\uACE0 \uC788\uB2E4."
    illustration: {fileID: 0}
  - title: " \uACF5\uC8FC, \uC6A9\uC0AC\uB791 \uACB0\uD63C\uD558\uB098\u2026 \u201C\uC0AC\uB78C\uC744
      \uBD10\uC57C \uD560 \uC77C\u201D"
    content: "\uACFC\uAC70\uC5D0 \uACF5\uC8FC\uB97C \uAD6C\uD55C \uC6A9\uC0AC\uB294
      \uC655\uBE44\uB098 \uAD6D\uC11C \uC790\uB9AC\uC5D0 \uC624\uB974\uB294 \uAC83\uC774
      \uC804\uD1B5\uC774\uC5C8\uB2E4. \uADF8\uB7EC\uB098 \u201C\uC870\uD68C\uC218
      \uB54C\uBB38\uC5D0 \uD55C \uC790\uADF9\uC801 \uD3B8\uC9D1 \uC544\uB2C8\uB0D0\u201D\uB294
      \u2018\uC6A9\uC0AC \uC74C\uBAA8\uB860\u2019\uC774 \uC81C\uAE30\uB418\uBA74\uC11C
      \uC6A9\uC0AC\uC5D0\uAC8C \uC774\uB7EC\uD55C \uAD00\uC2B5\uC744 \uC801\uC6A9\uC2DC\uCF1C\uC57C
      \uD558\uB294\uAC00\uC5D0 \uB300\uD55C \uB17C\uC7C1\uC774 \uC624\uAC00\uACE0
      \uC788\uB2E4. \uD55C\uD3B8 \uC6A9\uC0AC\uB294 \uC9C0\uB09C 3\uC77C, \uD569\uC131
      \uC758\uD639\uC774 \uBD88\uAC70\uC9C4 \uC774\uD6C4\uB85C \uC9C0\uAE08\uAE4C\uC9C0
      \uD574\uBA85\uC744 \uB0B4\uB193\uC9C0 \uC54A\uC558\uB2E4."
    illustration: {fileID: 0}
  - title: " \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\u2019, \uC774\uB984 \uBC14\uB00C\uB098"
    content: "\uC6A9\uC0AC \uC9C0\uC9C0\uC790 \uBAA8\uC784 \u2018\uC6A9\uC0AC\uC758
      \uACF5\uC8FC\uB4E4\u2019\uC774 \uAC1C\uBA85\uB420 \uC704\uAE30\uB2E4. \uBC95\uC6D0\uC740
      \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\u2019 \uBA85\uCE6D\uC740 \uC2E0\uBD84
      \u2018\uACF5\uC8FC\u2019\uC758 \uC0AC\uC6A9\uCC98\uC5D0 \uB9DE\uC9C0 \uC54A\uACE0
      \uC0AC\uD68C\uC5D0 \uD63C\uB780\uC744 \uC904 \uC6B0\uB824\uAC00 \uC788\uC5B4
      \uCC98\uBC8C\uB420 \uC18C\uC9C0\uAC00 \uC788\uB2E4\uACE0 \uBC1D\uD614\uB2E4.
      \uD604\uC7AC\uAE4C\uC9C0 \uBCC0\uACBD\uD560 \uBA85\uCE6D\uC73C\uB85C \uB17C\uC758\uB41C
      \uAC83\uC740 \u2018\uC6A9\uC0AC\uC758 \uC2DC\uC885\uB4E4\u2019\uACFC \u2018\uC6A9\uC0AC\uC758
      \uBB34\uC218\uB9AC\uB4E4\u2019\uC774\uB2E4."
    illustration: {fileID: 0}
