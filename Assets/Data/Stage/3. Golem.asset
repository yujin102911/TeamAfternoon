  _mails:
  - subject: "RE: RE: RE: [\uAE09\uD568] \uC601\uC0C1 \uD3B8\uC9D1 \uC694\uCCAD\uD569\uB2C8\uB2E4"
    sender: "\uC6A9\uC0AC <lv01@msn.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uACE0\uBE14\uB9B0 \uC54C\uC544\uCC28\uB9B0 \uC7A5\uBA74 \uB2E4\uB4E4
      \uBA4B\uC9C0\uB2E4\uACE0 \uB09C\uB9B0\uB370 \uC81C\uAC00 \uBD10\uB3C4 \uC880
      \uBA4B\uC788\uB124\uC694 \u314E\n\uB9C8\uC655\uB3C4 \uC81C \uCC44\uB110\uC744
      \uAD6C\uB3C5\uD588\uC5B4\uC694\n(\uC0AC\uC9C4)\n\uB9C8\uC655\uC740 \uB9C8\uC655\uC131
      \uC9C0\uB9AC\uC5D0 \uBE60\uC2F9\uD560 \uD14C\uB2C8\uAE4C \uC774\uBC88 \uC601\uC0C1\uC740
      \uC804\uBCF4\uB2E4 \uC9C4\uC9DC\uCC98\uB7FC \uBCF4\uC5EC\uC57C \uD560 \uAC83
      \uAC19\uC2B5\uB2C8\uB2E4.\n\uC774\uBC88\uC5D0\uB3C4 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.\r\n\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    unlockCondition: 0
  _boardEntries:
  - title: " \uBA48\uCD94\uC9C0 \uC54A\uB294 \uC6A9\uC0AC! <\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30>
      3\uD654 \uACE0\uBE14\uB9B0 \uD3B8 \uACF5\uAC1C"
    content: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uC774\uD2C0 \uB9CC\uC5D0 \uB358\uC804
      3\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uC0AC\uAC01\uC5D0\uC11C \uB36E\uC838\uC624\uB358
      \uACE0\uBE14\uB9B0\uC758 \uB450\uAC1C\uACE8\uC744 \uC9C1\uACA9\uD574 \uBD80\uC218\uB294
      \uC7A5\uBA74\uC774 \uD2B9\uD788 \uBC31\uD2F0\uC98C\uB4E4 \uC0AC\uC774\uC5D0
      \uD070 \uC778\uAE30\uB97C \uB04C\uC5B4, \uC6A9\uC0AC \uC9C0\uC9C0\uC790 \uBAA8\uC784
      '\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4'\uC774 \uC870\uC9C1\uB418\uB294 \uB4F1\uC758
      \uC6C0\uC9C1\uC784\uC774 \uC77C\uC5B4\uB098\uACE0 \uC788\uB2E4."
    illustration: {fileID: 0}
  - title: " \uC6A9\uC0AC \uCC44\uB110, \uAD6C\uB3C5\uC790 100\uB9CC\uBA85 \uB2EC\uC131"
    content: "\uC6A9\uC0AC\uAC00 \uBB34\uC0AC\uD788 \uADC0\uD658\uD560 \uACBD\uC6B0
      \uD6C8\uC7A5 \uC218\uC5EC\uC2DD\uC5D0\uC11C \uACE8\uB4DC \uBC84\uD2BC \uB610\uD55C
      \uC218\uC5EC\uB420 \uC608\uC815\uC774\uB2E4."
    illustration: {fileID: 0}
  - title: " \uC5B4\uB824\uC6B4 MZ \uC138\uB300 \uC5B8\uC5B4\u2026 \uC18C\uD1B5\uD558\uAE30
      \uC704\uD55C \uD544\uC218 \uC6A9\uC5B4 '5\uAC00\uC9C0'"
    content: "MZ(Magic-Z) \uC138\uB300\uB294 \uAE30\uC874 \uC138\uB300\uC640 \uB2E4\uB974\uAC8C
      \uB9C8\uBC95 \uC601\uCC3D\uC744 \uBB35\uC74C\uC73C\uB85C \uD558\uAC70\uB098
      \uC904\uC784\uB9D0, \uC720\uD589\uC5B4\uB85C \uC0AC\uC6A9\uD558\uB294 \uACBD\uD5A5\uC744
      \uBCF4\uC778\uB2E4. \uCCAB\uBC88\uC9F8 \uD544\uC218 \uC6A9\uC5B4: \uB3C5\uC2EC\uC220.
      MZ \uC138\uB300\uC758 \uB9C8\uC74C\uC744 \uC9C1\uC811 \uD655\uC778\uD568\uC73C\uB85C\uC368
      \uBD88\uD544\uC694\uD55C \uC624\uD574\uB97C \uC904\uC77C \uC218\u2026\u2026."
    illustration: {fileID: 0}
