  _mails:
  - subject: "RE: [\uAE09\uD568] \uC601\uC0C1 \uD3B8\uC9D1 \uC694\uCCAD\uD569\uB2C8\uB2E4"
    sender: "\uC6A9\uC0AC <lv01@msn.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uC601\uC0C1 \uD004\uB9AC\uD2F0 \uB05D\uB0B4\uC8FC\uB124\uC694!! \uC720\uD29C\uBE0C
      \uC870\uD68C\uC218\uAC00 \uBC8C\uC368 1\uCC9C\uB9CC\uC785\uB2C8\uB2E4\r\n\uC774\uB300\uB85C
      \uB358\uC804 2\uCE35 \uD074\uB9AC\uC5B4 \uC601\uC0C1\uB3C4 \uC791\uC5C5 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.
      \uC5B4\uC81C \uC601\uC0C1\uBCF4\uB2E8 \uBB34\uC12D\uAC8C \uD574\uC8FC\uC138\uC694\n\r\n\uC790\uB8CC
      \uBCF4\uC168\uC73C\uB2C8 \uC544\uC2DC\uACA0\uC9C0\uB9CC \uC81C\uAC00 5\uC0B4
      \uB54C\uBD80\uD130 \uD6C8\uB828 \uBC1B\uC558\uAE30\uB3C4 \uD558\uACE0 \uCE7C\uC744
      \uBABB \uC4F0\uB294 \uAC74 \uC544\uB2CC\uB370\n\uB9C8\uC871\uB4E4\uC740 5\uAC1C\uC6D4\uBD80\uD130
      \uD6C8\uB828\uBC1B\uB294\uB2E4\uB2C8\uAE4C \uC601\uC0C1 \uC7AC\uBBF8\uB97C
      \uC704\uD574\uC11C\uB77C\uB3C4 \uD3B8\uC9D1\uC0AC\uB2D8\uAED8 \uB9E1\uAE30\uB294
      \uAC8C \uB098\uC740 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4\r\n\n\n\uCCA8\uBD80 \uD30C\uC77C\n[ENTER_LINK]"
    unlockCondition: 0
  _boardEntries:
  - title: "\uC6A9\uC0AC\uC758 \uB208\uBD80\uC2E0 \uCCAB \uD65C\uC57D! <\uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30> 1\uD654 \uC774\uBE14\uC544\uC774 \uD3B8 \uACF5\uAC1C"
    content: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uD558\uB8E8 \uB9CC\uC5D0 \uB358\uC804
      1\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uAD6D\uC655\uC740 \uAE30\uC068\uC758
      \uB208\uBB3C\uC744 \uD758\uB9AC\uBA70 \u201C\uC628 \uBC31\uC131\uC774 \uD65C\uC57D\uC744
      \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uB2E4. \uACF5\uC8FC\uC640 \uC655\uAD6D\uC744
      \uC9C0\uCF1C\uB2EC\uB77C\u201D \uB77C\uB294 \uB9D0\uC744 \uB0A8\uACBC\uB2E4."
    illustration: {fileID: 0}
  - title: "[MSN \uC5EC\uB860\uC870\uC0AC] \u2018\uACF5\uC8FC\uAC00 \uC0B6\uC5D0
      \uC758\uC9C0\uAC00 \uB41C\uB2E4\u2019\uB294 \uBC31\uC131 \uC57D 80%\uC5D0 \uB2EC\uD574"
    content: "\uBC31\uC131 \uB300\uC0C1\uC73C\uB85C \uC2DC\uD589\uB41C \uC5EC\uB860\uC870\uC0AC\uC5D0\uC11C
      \u2018\uACF5\uC8FC\uAC00 \uC0B6\uC5D0 \uC758\uC9C0\uAC00 \uB41C\uB2E4\u2019\uB294
      \uC758\uACAC\uC774 80%, \u2018\uACF5\uC8FC\uAC00 \uB098\uB77C\uC758 \uBBF8\uB798\u2019\uB294
      \uC758\uACAC\uC774 70%\uC5D0 \uC721\uBC15\uD588\uB2E4. \uC8FC\uAC04 \uC778\uAE30\uC791
      \uC21C\uC704\uC5D0\uB294 \u300A\uACF5\uC8FC\uB2D8\uC774 \uC5C6\uC5B4\uC120
      \uC548 \uB418\uB294 50\uAC00\uC9C0 \uC774\uC720\u300B\uAC00 \uC624\uB974\uAE30\uB3C4
      \uD558\uBA74\uC11C\u2026\u2026"
    illustration: {fileID: 0}
  - title: "[\uC9C4\uC2E4 \uD639\uC740 \uAC70\uC9D3] \uB9C8\uC871\uC740 \uBAA8\uB450
      \uAC70\uC9D3\uB9D0\uC7C1\uC774\uB2E4?"
    content: "\uB9C8\uC871\uC774 \uBC49\uC740 \uB9D0\uC758 \uD314 \uD560\uC740 \uAC70\uC9D3\uB9D0\uC774\uB77C\uB294
      \uC18D\uB2F4\uC774 \uC788\uB2E4. \uACFC\uC5F0 \uC0AC\uC2E4\uC77C\uAE4C? \uC81C\uC791\uB144
      \uD1B5\uACC4\uB85C \uBD24\uC744 \uB54C, \uB9C8\uC871\uC758 \uBC1C\uC5B8\uC740
      \uC2E4\uC81C\uBCF4\uB2E4 \uC0C1\uB2F9\uD788 \uACFC\uC7A5\uB418\uC5B4 \uC788\uC5C8\uB2E4\uACE0
      \uD55C\uB2E4. \uD558\uC9C0\uB9CC \uC774\uB294 \uB9C8\uC871\uC758 \uD2B9\uC131\uACFC
      \uAD00\uB828\uB41C \uAC83\uC73C\uB85C\u2026"
