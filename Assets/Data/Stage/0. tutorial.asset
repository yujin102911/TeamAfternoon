  _mails:
  - subject: "[\uAE09\uD568] \uC601\uC0C1 \uD3B8\uC9D1 \uC694\uCCAD\uD569\uB2C8\uB2E4"
    sender: "\uC6A9\uC0AC <trustme@inailedit.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uC6A9\uC0AC\uC785\uB2C8\uB2E4 (\u2197\uAC8C\uC2DC\uD310 \uBC14\uB85C\uAC00\uAE30)\r\n\uBB50\uB4E0
      \uD3B8\uC9D1\uD574\uC8FC\uC2E0\uB2E4\uB294 \uD3B8\uC9D1\uC0AC\uC2DC\uC8E0?\r\n\uB358\uC804
      1\uCE35 \uD074\uB9AC\uC5B4 \uC601\uC0C1 \uC791\uC5C5 \uB418\uB098\uC694? \uC624\uB298
      \uC548\uC73C\uB85C \uD574\uC8FC\uC138\uC694.\r\n\uBCF4\uC218\uB294 \uBD80\uB974\uC2DC\uB294
      \uB300\uB85C \uB9DE\uCDB0 \uB4DC\uB9BD\uB2C8\uB2E4\n\r\n\uC81C\uAC00 \uC758\uB8B0\uD588\uB2E8
      \uAC74 \uADF9\uBE44\uC0AC\uD56D\uC785\uB2C8\uB2E4\n\n\uCCA8\uBD80 \uD30C\uC77C\n[ENTER_LINK]"
    unlockCondition: 0
  _boardEntries:
  - title: " \uB9C8\uC655, 7\uC77C \uB4A4 \uACF5\uC8FC \uB0A9\uCE58 \uC608"
    content: "\uAE08\uC77C \uB9C8\uC655\uC774 SNS\uB97C \uD1B5\uD574 \u201C\uACF5\uC8FC\uB97C
      7\uC77C \uB4A4 \uB0A9\uCE58\uD560 \uAC83\u201D\uC774\uB77C\uACE0 \uC120\uC5B8\uD588\uB2E4.
      \uD568\uAED8 \uC5C5\uB85C\uB4DC \uB41C \uC0AC\uC9C4\uC5D0\uB294 \u2018\uADF8\uB0E5
      \uC6B0\uB9AC \uB2E4 \uAC19\uC774 \uC2EC\uC2EC\uD558\uC790, \uC544\uBB34\uB3C4
      \uC7AC\uBC0C\uC9C0 \uB9D0\uC790\u2019 \uB77C\uB294 \uBB38\uAD6C\uAC00 \uC801\uD600
      \uD654\uC81C\uB2E4."
    illustration: {fileID: 0}
  - title: " \uAD6D\uC655, \uC6A9\uC0AC \uC120\uBC1C\uD574 \uB9C8\uC655\uC131 \uD30C\uACAC
      \uACB0\uC815"
    content: "\uAD6D\uC655\uC740 \uAE08\uC77C \uC548\uC73C\uB85C \uB9C8\uC655\uC744
      \uBB34\uCC0C\uB97C \uC6A9\uC0AC\uB97C \uC9C1\uC811 \uC120\uBC1C\uD55C \uD6C4
      \uB9C8\uC655\uC131\uC5D0 \uD30C\uACAC\uD558\uACA0\uB2E4\uACE0 \uBC1C\uD45C\uD588\uB2E4."
    illustration: {fileID: 0}
  - title: " \uBC31\uC791\uAC00 \uC790\uC81C\uAC00 \uC6A9\uC0AC\uB85C \uCD5C\uC885
      \uC120\uBC1C"
    content: "\uBC31\uC791\uAC00\uC758 \uC790\uC81C\uAC00 \uC6A9\uC0AC \uD6C4\uBCF4
      \uC911 \uCD5C\uC885\uC801\uC73C\uB85C \uC120\uBC1C\uB418\uC5C8\uB2E4. \uAD6D\uC655\uC740
      \u201C\uBC31\uC791\uC774 \uC2ED\uC5EC\uB144 \uC804 \uC790\uC2DD\uC758 \uAC80\uC220\uC774
      \uB6F0\uC5B4\uB098\uB2E4\r\n\uACE0 \uD55C \uBC14 \uC788\uB2E4\u201D\uBA74\uC11C
      \uC120\uBC1C \uC774\uC720\uB97C \uBC1D\uD614\uB2E4. \uC774\uD6C4 \uC6A9\uC0AC\uC758
      \uD589\uC801\uC740 \u2018\uB9C8\uC655\uC131 \uB3C4\uC804\uAE30\u2019\uB77C\uB294
      \uC81C\uBAA9\uC73C\uB85C \uC775\uC77C\uBD80\uD130 \uC6A9\uC0AC \r\n\uAC1C\uC778
      \uCC44\uB110\uC5D0 \uACF5\uAC1C\uB420 \uC608\uC815\uC774\uB2E4."
    illustration: {fileID: 0}
  - title: "[\uC27D\uAC8C \uBCF4\uB294 \uC2DC\uC0AC\uC0C1\uC2DD] \uB9C8\uC655\uC131\uC758
      \uAD6C\uC870\uB294 \uC5B4\uB5BB\uAC8C \uC774\uB8E8\uC5B4\uC838 \uC788\uC744\uAE4C?"
    content: "300\uB144 \uAC04 \uB9C8\uC655\uC131\uC5D0 \uB4E4\uC5B4\uAC04 \uC774\uB294
      \uC5C6\uC9C0\uB9CC, \uAD6C\uC870\uAC00 \uC124\uBA85\uB41C \uACE0\uBB38\uC11C\uB294
      \uC804\uD574\uC9C4\uB2E4. \uB9C8\uC655\uC131\uC740 5\uCE35 \uB358\uC804\uACFC
      \uC5F0\uACB0\uB418\uC5B4 \uC788\uC73C\uBA70, \uAC01 \uCE35\uB9C8\uB2E4 \uBAAC\uC2A4\uD130\uAC00
      \uC11C\uC2DD\uD55C\uB2E4. 1\uCE35\uC740 \uC2AC\uB77C\uC784, 2\uCE35\uC740 \uD574\uACE8
      \uBCD1\uC0AC, 3\uCE35\uC740 \uAC70\uBBF8, 4\uCE35\uC740 \uACE8\uB818\uC73C\uB85C\u2026\u2026. "
    illustration: {fileID: 0}
