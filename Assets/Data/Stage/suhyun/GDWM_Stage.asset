  m_Name: GDWM_Stage
  m_EditorClassIdentifier: 
  _stageNumber: 1
  _stageName: "<size=34>\uC624\uC988\uC758 \uB9C8\uBC95\uC0AC</size>\n<size=22>The
    Wonderful Wizard of Oz</size>\n<size=16>by L. Frank Baum</size>"
  _requestLetter: " \uC800\uB294 \uB9D0 \uC798.. \uBABB\uD574\uC694\n \uAE00\uC528\uB3C4
    \uC798.. \uBABB\uC368\uC624..\n\uADFC\uB370\uC800\uB294 \uB9E4\uC77C\uBD10\uC694\n
    <b><color=black>\uC6B8\uACE0\uC787\uB294 \uB3C4\uB85C\uC2DC</b></color>\uB97C\uC624\n\uC774\uC9D1\uC5D0\uC11C\uB294
    \uB3C4\uB85C\uC2DC\uAC00 \uC5C5\uC11C\uC838\uB3C4 \uC544\uBB34\uB3C4 \uC548\uCC3E\uC544\uC694\n
    \uB3C4\uB77C\uC640\uB3C4 \uC544\uBB34\uB3C4 \uBC18\uAC00\uC6CC\uC548\uD574\uC624\n\uB3C4\uB85C\uC2DC\uB294
    \uB3C4\uB9DD\uCCD0\uC368\uC694\n \uADFC\uB370\uB3C4 \uB2E4\uC2DC \uC774\uC9D1\uC73C\uB85C
    \uBCF4\uB124\uC838\uC368\uC694\n\uADF8\uB2E4\uC74C\uBD80\uD134 \uB3C4\uB85C\uC2DC\uB294
    \uC804\uD600 \uC6C3\uC9C8\uC548\uD574\uC624\n \uADF8\uB0E5.. \uAC00\uB9CC\uC774
    \uC787\uC5B4\uC694\n\uC0AC\uC11C\uB2D8\n \uC774\uC138\uC0C1\uC5D0\uC11C <b><color=black>\uB3C4\uB85C\uC2DC\uB294
    \uD589\uBCF5\uD574\uC9C8\uC218 \uC5C5\uC368</b></color>\uC694\n\uBD80\uD0C1\uC774\uC5D0\uC624\n
    \uB3C4\uB85C\uC2DC\uAC00 \uC870\uAE08\uC774\uB77C\uB3C4 \uD589\uBCF5\uD574\uC9C8\uC218
    \uC787\uAC8C\n \uB3C4\uC640\uC8FC\uC0C8\uC694..\n\n<align=\"right\">\uD1A0\uD1A0\uAC00</align>"
  _thankLetter: "\uC548\uB155\uD558\uC138\uC694! \uC800\uB294 \uB3C4\uB85C\uC2DC\uC5D0\uC694.\n\n\uC774\uC81C
    \uC800\uB294 \uC9D1\uC5D0 \uB3CC\uC544\uC640 \uC788\uC5B4\uC694. \uC9C4\uC9DC
    \uC9D1\uC5D0\uC694!\n\uC5E0 \uC544\uC8FC\uBA38\uB2C8\uC640 \uD5E8\uB9AC \uC544\uC800\uC528\uAC00
    \uB9E4\uC77C \uC800\uB97C \uC0AC\uB791\uD574 \uC8FC\uC138\uC694.\n\uC774\uB7F0
    \uAFC8\uAC19\uC740 \uC0B6\uC744 \uC0B4 \uC218 \uC788\uB2E4\uB294 \uAC8C \uC544\uC9C1\uB3C4
    \uC870\uAE08 \uBBFF\uAE30\uC9C0 \uC54A\uC544\uC694.\n\uC815\uB9D0 \uAC10\uC0AC\uD574\uC694!\n\n\uC774\uC81C
    \uC800\uB294 \uB3CC\uC544\uC62C \uC9D1\uC774 \uC788\uC5B4\uC11C \uC88B\uC544\uC694.\n\uC624\uB298\uC740
    \uC88B\uC740 \uAFC8\uC744 \uAFC0 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694!\n\nps.
    \uD1A0\uD1A0\uB294 \uC9C0\uAE08 \uC606\uC5D0\uC11C \uC790\uACE0\uC788\uC5B4\uC694.\n\uC800\uB97C
    \uC704\uD574 \uD3B8\uC9C0\uB97C \uBCF4\uB0C8\uB2E4\uACE0 \uD574\uC11C\n\uB9CE\uC774
    \uB9CE\uC774 \uCE6D\uCC2C\uD574\uC92C\uC5B4\uC694!\n\n<align=\"right\">\uB3C4\uB85C\uC2DC\uAC00</align>"
  BookCredit: "<size=17><b>2025 by Team Afternoon </b></size>\n<size=15>\n<size=14>All
    paths are clearly described.\nAll characters appear as originally written.\nSome
    paths return to where they began.\nNot all answer are final.\nThe story ends
    as stories usually do.</size>\n\n\n\n\n\n\n<size=17>\uC778\uC1C4: 2025\uB144
    12\uC6D4 16\uC77C \uCD08\uD310 1\uC1C4\n\uBC1C\uD589: 2026\uB144 2\uC6D4 20\uC77C
    \uCD08\uD310 1\uC1C4\n\n\uC5ED\uC790: \uD76C\uC2B9, \uC720\uC9C4, \uC218\uD604,
    \uC9C0\uC740\n\uBC1C\uD589\uCC98: \uC6B0\uC8FC \uC6D0\uC804 \uB3C4\uC11C\uAD00\n\n\uC815\uAC00:
    0\uC6D0"
  TitlePollutionID: 0
  _spreadPollutionIDs: 010000000200000001000000020000000100000002000000
  _bookPages:
  - ChapterTitle: 
    IsChapterStart: 0
    BodyText: 
  - ChapterTitle: "1\uC7A5. \uB3C4\uB85C\uC2DC\uC758 \uD0C8\uCD9C"
    IsChapterStart: 1
    BodyText: "\uCE94\uC790\uC2A4\uC758 \uB05D\uC5C6\uC774 \uD3BC\uCCD0\uC9C4 \uD478\uB978
      \uCD08\uC6D0 \uD55C\uAC00\uC6B4\uB370, \uC791\uC740 \uC9D1 \uD558\uB098\uAC00
      \uC678\uB86D\uAC8C \uC11C \uC788\uC5C8\uC5B4\uC694. \n<color=#81290E>\uADF8
      \uC9D1\uC5D0\uC11C \uB3C4\uB85C\uC2DC\uB294 \uD5E8\uB9AC \uC544\uC800\uC528\uC640
      \uC5E0 \uC544\uC8FC\uBA38\uB2C8\uC640 \uD568\uAED8 \uC0B4\uACE0 \uC788\uC5C8\uC9C0\uC694.
      </color>\n\uB450 \uC0AC\uB78C\uC740 \uB9E1\uAC8C \uB41C \uB3C4\uB85C\uC2DC\uB97C
      \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4\uD558\uC9C0 \uC54A\uC558\uC5B4\uC694. \uB458\uC740
      \uB3C4\uB85C\uC2DC\uB97C \uB9E4\uC77C\uB9E4\uC77C \uAD6C\uBC15\uD558\uAE30\uB9CC
      \uD588\uB2F5\uB2C8\uB2E4. <color=#81290E>\uD558\uC9C0\uB9CC \uADF8\uACF3\uC5D0
      \uB3C4\uB85C\uC2DC\uC758 \uD3B8\uC740 \uC5C6\uC5C8\uC5B4\uC694.</color> \uBC24\uC5D0
      \uB3C4\uB85C\uC2DC\uAC00 \uB2E4\uB77D\uBC29 \uD55C\uCF20\uC5D0 \uBAB8\uC744
      \uC6C5\uD06C\uB9AC\uACE0 \uB204\uC6B0\uBA74, \uBB38 \uD2C8 \uC0AC\uC774\uB85C
      \uC5B4\uB978\uB4E4\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB610\uB837\uD558\uAC8C
      \uB4E4\uB824\uC654\uC5B4\uC694.\n<color=#81290E>\"\uC800 \uC560\uB294 \uC65C
      \uC800\uB807\uAC8C \uBA4D\uCCAD\uD560\uAE4C.\" \"\uB370\uB824\uC628 \uAC8C
      \uC2E4\uC218\uC600\uC5B4.\"\n\uB3C4\uB85C\uC2DC\uB294 \uADC0\uB97C \uB9C9\uC558\uC9C0\uB9CC,
      \uB9D0\uB4E4\uC740 \uC5B8\uC81C\uB098 \uB9C8\uC74C\uC18D\uAE4C\uC9C0 \uB530\uB77C
      \uB4E4\uC5B4\uC654\uC5B4\uC694.</color>"
  - ChapterTitle: "1\uC7A5. \uB3C4\uB85C\uC2DC\uC758 \uD0C8\uCD9C"
    IsChapterStart: 0
    BodyText: "\uC720\uB09C\uD788 \uBC14\uB78C\uC774 \uAC70\uC13C \uBC24, \uB3C4\uB85C\uC2DC\uB294
      \uCC3D\uBB38\uC5D0 \uC774\uB9C8\uB97C \uB300\uACE0 \uC18D\uC0AD\uC600\uC5B4\uC694.\n\u201C\uC81C\uBC1C\u2026
      \uC800\uB97C \uC5EC\uAE30\uC11C \uB370\uB824\uAC00 \uC8FC\uC138\uC694. \uB2E4\uC2DC
      \uB3CC\uC544\uC624\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uC544\uC694.\u201D\n\uADF8\uB9AC\uACE0
      \uB9C8\uCE58 \uADF8 \uB9D0\uC744 \uB4E4\uC5C8\uB2E4\uB294 \uB4EF, \uD558\uB298\uC774
      \uAC08\uB77C\uC9C0\uBA70 \uC6B8\uBD80\uC9D6\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694.
      \n\uC9C0\uBD95\uC774 \uD754\uB4E4\uB9AC\uACE0, \uBC14\uB78C\uC774 \uC9D1\uC744
      \uC6C0\uCF1C\uC950\uC5C8\uC5B4\uC694. \n\uD5E8\uB9AC \uC544\uC800\uC528\uC640
      \uC5E0 \uC544\uC8FC\uBA38\uB2C8\uB294 \uC775\uC219\uD55C \uB4EF \uC9C0\uD558\uC2E4\uB85C
      \uB2EC\uB824\uAC14\uC9C0\uB9CC, \uB204\uAD6C\uB3C4 \uB3C4\uB85C\uC2DC\uB97C
      \uBD80\uB974\uC9C0 \uC54A\uC558\uC5B4\uC694. \n<color=#81290E>\uBC14\uB2E5\uC774
      \uB4E4\uB9AC\uACE0, \uC9D1\uC774 \uD558\uB298\uB85C \uB5A0\uC62C\uB790\uC5B4\uC694.
      </color>\n\uADF8 \uC21C\uAC04, \uB3C4\uB85C\uC2DC\uB294 \uC54C\uC558\uC5B4\uC694.
      \n\uC774 \uBC14\uB78C\uC740 \uC7AC\uC559\uC774 \uC544\uB2C8\uB77C, \uC790\uC2E0\uC5D0\uAC8C
      \uC8FC\uC5B4\uC9C4 \uC720\uC77C\uD55C \uD0C8\uCD9C\uC774\uB77C\uB294 \uAC83\uC744."
  - ChapterTitle: "2\uC7A5. \uBD81\uCABD \uB9C8\uB140\uC758 \uC8FD\uC74C"
    IsChapterStart: 1
    BodyText: "\uC5BC\uB9C8\uB098 \uC2DC\uAC04\uC774 \uD758\uB800\uC744\uAE4C\uC694.\r\n\uCFF5--\r\n<color=#81290E>\uB454\uD0C1\uD55C
      \uC18C\uB9AC\uC640 \uD568\uAED8 \uC9D1\uC774 \uB545\uC5D0 \uB5A8\uC5B4\uC84C\uC5B4\uC694.</color>\r\n\uB3C4\uB85C\uC2DC\uB294
      \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uBB38\uC744 \uC5F4\uACE0 \uBC16\uC73C\uB85C
      \uB098\uC654\uC5B4\uC694.\r\n\uADF8\uACF3\uC740 \uCE94\uC790\uC2A4\uAC00 \uC544\uB2C8\uC5C8\uC5B4\uC694.\n\uC232\uC740
      \uC9C0\uB098\uCE58\uAC8C \uC9D9\uC5C8\uACE0, \uC8FC\uBCC0\uC740 \uACE0\uC694\uD588\uC9C0\uC694.\r\n\uADF8\uB54C,
      \uB0AE\uACE0 \uC270 \uBAA9\uC18C\uB9AC\uB4E4\uC774 \uB4E4\uB824\uC654\uC5B4\uC694.\r\n<color=#81290E>\u201C\uC800
      \uC544\uC774\uC57C. \uBD81\uCABD \uB9C8\uB140\uB2D8\uC744 \uC8FD\uC778 \uAC8C\u2026\u201D\r\n\uC5B4\uB290\uC0C8
      \uC791\uC740 \uB09C\uC7C1\uC774\uB4E4\uC774 \uB3C4\uB85C\uC2DC\uB97C \uB458\uB7EC\uC2F8\uACE0
      \uC788\uC5C8\uC5B4\uC694.</color>\r\n\uADF8\uB4E4\uC758 \uB208\uC5D0\uB294
      \uC2AC\uD514\uC774 \uC544\uB2C8\uB77C \uC99D\uC624\uAC00 \uB9FA\uD600 \uC788\uC5C8\uC9C0\uC694.\r\n\uC54C\uACE0
      \uBCF4\uB2C8, \uB3C4\uB85C\uC2DC\uC758 \uC9D1\uC774 \uD558\uB298\uC5D0\uC11C
      \uB5A8\uC5B4\uC9C0\uBA70 \uC232\uC18D\uC758 \uB9C8\uB140\uB97C \uADF8\uB300\uB85C
      \uB20C\uB7EC\uBC84\uB838\uACE0, \uB9C8\uB140\uB294 \uC9D1 \uC544\uB798\uC5D0\uC11C
      \uD615\uCCB4\uC870\uCC28 \uB0A8\uAE30\uC9C0 \uBABB\uD55C \uCC44 \uC8FD\uC5B4\uBC84\uB9B0
      \uAC83\uC774\uC5C8\uC5B4\uC694."
  - ChapterTitle: "2\uC7A5. \uBD81\uCABD \uB9C8\uB140\uC758 \uC8FD\uC74C"
    IsChapterStart: 0
    BodyText: "<color=#81290E>\u201C\uB108 \uB54C\uBB38\uC774\uC57C. \uB108\uB3C4
      \uB300\uAC00\uB97C \uCE58\uB7EC\uC57C \uD574.\u201D\n\uB3CC\uBA69\uC774\uAC00
      \uB0A0\uC544\uC654\uACE0, \uC190\uB4E4\uC774 \uBED7\uC5B4\uC654\uC5B4\uC694.</color>\n\uB3C4\uB85C\uC2DC\uB294
      \uBE44\uBA85\uC744 \uC0BC\uD0A8 \uCC44 \uC232\uC18D\uC73C\uB85C \uB2EC\uB838\uC5B4\uC694.\n\uB098\uBB47\uAC00\uC9C0\uAC00
      \uD53C\uBD80\uB97C \uAE01\uACE0, \uC228\uC774 \uD131\uAE4C\uC9C0 \uCC28\uC62C\uB790\uC9C0\uB9CC
      \uB4A4\uCAD3\uC544\uC624\uB294 \uBC1C\uC18C\uB9AC\uB294 \uC27D\uAC8C \uBA48\uCD94\uC9C0
      \uC54A\uC558\uC9C0\uC694.\n<color=#81290E>\uD55C\uCC38\uC744 \uB2EC\uB9B0 \uB4A4\uC5D0\uC57C,
      \uB3C4\uB85C\uC2DC\uB294 \uADF8\uB4E4\uC744 \uB530\uB3CC\uB9B4 \uC218 \uC788\uC5C8\uC5B4\uC694.</color>"
  - ChapterTitle: "3\uC7A5. \uBAA8\uB450\uAC00 \uBD80\uC11C\uC9C4 \uAE38"
    IsChapterStart: 1
    BodyText: "\uB3C4\uB85C\uC2DC\uB294 \uC228\uC744 \uACE0\uB974\uBA70 \uAE38\uC744
      \uAC77\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694.\r\n<color=#81290E>\uC774\uC0C1\uD558\uAC8C\uB3C4,
      \uB3C4\uB85C\uC2DC\uB294 \uACF5\uD3EC \uC18D\uC5D0\uC11C\uB3C4 \uB9C8\uC74C
      \uD55C\uCF20\uC774 \uAC00\uBCBC\uC6E0\uC5B4\uC694.\r\n\uC801\uC5B4\uB3C4, \uADF8
      \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00\uC9C0\uB294 \uC54A\uC544\uB3C4 \uB418\uC5C8\uC73C\uB2C8\uAE4C\uC694.</color>\r\n\uADF8\uB54C,
      \uBC2D \uD55C\uAC00\uC6B4\uB370\uC11C \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC654\uC5B4\uC694.\r\n\u201C\uC800\uAE30\uC694\u2026
      \uAC70\uAE30 \uC9C0\uB098\uAC00\uB294 \uBD84\u2026\u201D\r\n\uC9DA\uC73C\uB85C
      \uC5EE\uC778 \uD5C8\uC218\uC544\uBE44\uAC00 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70
      \uC11C \uC788\uC5C8\uC5B4\uC694.\r\n\uB208\uC740 \uB2E8\uCD94\uC600\uC9C0\uB9CC,
      \uBD84\uBA85 \uB3C4\uB85C\uC2DC\uB97C \uC815\uD655\uD788 \uBC14\uB77C\uBCF4\uACE0
      \uC788\uC5C8\uC9C0\uC694.\r\n\u201C\uC0DD\uAC01\uC774 \uB108\uBB34 \uB9CE\uC544\uC694.\u201D\r\n<color=#81290E>\u201C\uBA38\uB9BF\uC18D\uC774
      \uC2DC\uB044\uB7EC\uC6CC\uC11C\u2026 \uCC28\uB77C\uB9AC \uB1CC\uB97C \uAEBC\uB0B4\uBC84\uB9AC\uACE0
      \uC2F6\uC5B4\uC694.\u201D\r\n\uD5C8\uC218\uC544\uBE44\uB294 \uC6C3\uACE0 \uC788\uC5C8\uC9C0\uB9CC,
      \uADF8 \uC6C3\uC74C\uC5D0\uB294 \uAE30\uC068\uC774 \uC5C6\uC5C8\uC5B4\uC694.</color>"
  - ChapterTitle: "3\uC7A5. \uBAA8\uB450\uAC00 \uBD80\uC11C\uC9C4 \uAE38"
    IsChapterStart: 0
    BodyText: "\uC870\uAE08 \uB354 \uAC77\uC790, \uAE08\uC18D\uC774 \uBD80\uB52A\uD788\uB294
      \uC18C\uB9AC\uAC00 \uB4E4\uB824\uC654\uC5B4\uC694.\r\n\uCA0D--\r\n\uCA0D--\r\n<color=#81290E>\u201C\uBA48\uCD9C
      \uC218\uAC00 \uC5C6\uC5B4! \uC81C\uBC1C\u2026 \uB204\uAC00 \uC880 \uBA48\uCDB0\uC918!\u201D\r\n\uC591\uCCA0\uB85C
      \uB9CC\uB4E4\uC5B4\uC9C4 \uB098\uBB34\uAFBC\uC774 \uB3C4\uB07C\uB97C \uD718\uB450\uB974\uACE0
      \uC788\uC5C8\uC5B4\uC694.</color>\r\n\uADF8 \uD314\uC740 \uC9C0\uCE58\uC9C0
      \uC54A\uC558\uACE0, \uADF8 \uC190\uC740 \uB5A8\uB9AC\uC9C0\uB3C4 \uC54A\uC558\uC9C0\uC694.\r\n\uBC14\uB2E5\uC5D0\uB294
      \uADF8\uB97C \uB9D0\uB9AC\uB824 \uD588\uB358 \uD754\uC801\uB4E4\uC774 \uB0A8\uC544
      \uC788\uC5C8\uC5B4\uC694.\r\n\uC0AC\uB78C\uC774\uC5C8\uC744 \uAC83\uC778\uC9C0,
      \uC544\uB2C8\uBA74 \uC774\uBBF8 \uC0AC\uB78C\uC774 \uC544\uB2C8\uAC8C \uB41C
      \uBB34\uC5B8\uAC00\uC600\uC744\uC9C0\uB294 \uB3C4\uB85C\uC2DC\uB294 \uB05D\uB0B4
      \uD655\uC778\uD558\uC9C0 \uC54A\uC558\uC5B4\uC694.\r\n\uAE38\uAC00\uC5D0\uB294
      \uC885\uC774 \uD55C \uC7A5\uC774 \uB5A8\uC5B4\uC838 \uC788\uC5C8\uC5B4\uC694.\r\n\uB3C4\uB85C\uC2DC\uB294
      \uC8FC\uC6CC \uB4E4\uACE0 \uAE00\uC790\uB97C \uC77D\uC5C8\uC9C0\uC694.\r\n<color=#81290E>\uD604\uC0C1\uC218\uBC30:
      \uC0AC\uC790\r\n\uADF8 \uC21C\uAC04, \uB545\uC744 \uC6B8\uB9AC\uB294 \uD3EC\uD6A8\uAC00
      \uB4E4\uB824\uC654\uC5B4\uC694.</color>\r\n\uC0AC\uC790\uC758 \uC6B8\uC74C\uC740
      \uBD84\uB178\uB77C\uAE30\uBCF4\uB2E4\uB294, \uAD76\uC8FC\uB9BC\uACFC \uC9D1\uCC29\uC5D0
      \uAC00\uAE4C\uC6E0\uC5B4\uC694.\r\n\uB3C4\uB85C\uC2DC\uB294 \uB2E4\uC2DC \uB2EC\uB838\uC5B4\uC694.\r\n\uC774\uBC88\uC5D0\uB294
      \uB4A4\uB3CC\uC544\uBCF4\uC9C0\uB3C4 \uC54A\uC558\uC9C0\uC694.\r\n\uC774 \uC138\uACC4\uC5D0\uB294
      \uBA40\uCA61\uD55C \uC874\uC7AC\uAC00 \uD558\uB098\uB3C4 \uC5C6\uB2E4\uB294
      \uAC78 \uC774\uBBF8 \uC54C\uC544\uBC84\uB838\uC73C\uB2C8\uAE4C\uC694."
  - ChapterTitle: "4\uC7A5. \uB3CC\uC544\uAC00\uC57C \uD558\uB294 \uACF3"
    IsChapterStart: 1
    BodyText: "<color=#81290E>\uADF8\uB807\uAC8C \uB3C4\uCC29\uD55C \uACF3\uC5D0\uB294
      \uC5D0\uBA54\uB784\uB4DC \uBE5B\uC758 \uC131\uC774 \uC788\uC5C8\uC5B4\uC694.</color>\r\n\uC5D0\uBA54\uB784\uB4DC
      \uC131\uC758 \uBB38\uC740 \uB3C4\uB85C\uC2DC\uAC00 \uC62C \uAC83\uC744 \uC54C\uACE0
      \uC788\uC5C8\uB2E4\uB294 \uB4EF \uC5F4\uB824 \uC788\uC5C8\uC5B4\uC694.\r\n\uC131
      \uC548\uC740 \uC9C0\uB098\uCE58\uAC8C \uC815\uB3C8\uB418\uC5B4 \uC788\uC5C8\uACE0,
      \uCD08\uB85D\uBE5B\uC740 \uB208\uC744 \uD3B8\uC548\uD558\uAC8C \uB9CC\uB4E4\uC5C8\uC9C0\uB9CC
      \uB9C8\uC74C\uC740 \uADF8\uB807\uC9C0 \uC54A\uC558\uC5B4\uC694.\r\n\uC911\uC559\uC5D0
      \uC549\uC544 \uC788\uB358 \uB0A8\uC790\uAC00 \uB9D0\uD588\uC5B4\uC694.\r\n\u201C\uB108\uB294
      \uB3C4\uB9DD\uCCE4\uAD6C\uB098.\u201D\r\n\uADF8\uAC74 \uC9C8\uBB38\uC774 \uC544\uB2C8\uC5C8\uC5B4\uC694.\r\n\uD655\uC778\uB3C4,
      \uBE44\uB09C\uB3C4 \uC544\uB2C8\uC5C8\uC9C0\uC694.\r\n\uADF8\uC800 \uC0AC\uC2E4\uC744
      \uB9D0\uD558\uB294 \uBAA9\uC18C\uB9AC\uC600\uC5B4\uC694.\r\n\u201C\uC5EC\uAE34
      \uADF8\uB7F0 \uC544\uC774\uB4E4\uC774 \uC624\uB294 \uACF3\uC774 \uC544\uB2C8\uB2E4.\u201D\r\n<color=#81290E>\u201C\uB3C4\uB9DD\uCE5C
      \uC544\uC774\uB294, \uB3C4\uB9DD\uCE5C \uACF3\uC73C\uB85C \uB418\uB3CC\uC544\uAC00\uC57C
      \uD574.\u201D</color>\n\uB3C4\uB85C\uC2DC\uB294 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uC5B4\uC694.\r\n\u201C\uC804\u2026
      \uB3CC\uC544\uAC00\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uC694.\u201D"
  - ChapterTitle: "4\uC7A5. \uB3CC\uC544\uAC00\uC57C \uD558\uB294 \uACF3"
    IsChapterStart: 0
    BodyText: "\uC624\uC988\uB294 \uCC98\uC74C\uC73C\uB85C \uB3C4\uB85C\uC2DC\uB97C
      \uBC14\uB77C\uBD24\uC5B4\uC694.\r\n\uADF8 \uB208\uBE5B\uC5D0\uB294 \uC5F0\uBBFC\uB3C4,
      \uBD84\uB178\uB3C4 \uC5C6\uC5C8\uC5B4\uC694.\r\n\u201C\uC6D0\uD558\uB290\uB0D0\uB294
      \uC911\uC694\uD558\uC9C0 \uC54A\uB2E4.\u201D\r\n\u201C\uC774 \uC138\uACC4\uB294
      \uB3C4\uD53C\uCC98\uAC00 \uC544\uB2C8\uAC70\uB4E0.\u201D\r\n\uBC14\uB2E5\uC5D0
      \uBB38\uC591\uC774 \uBE5B\uB0AC\uACE0, \uCD08\uB85D\uBE5B\uC774 \uB3C4\uB85C\uC2DC\uC758
      \uBC1C\uBAA9\uC744 \uBD99\uC7A1\uC558\uC5B4\uC694.\r\n<color=#81290E>\u201C\uB3C4\uB9DD\uC740
      \uC120\uD0DD\uD560 \uC218 \uC5C6\uB2E4.\u201D\r\n\uBE5B\uC774 \uBC88\uCA4D\uC600\uACE0,
      \uB3C4\uB85C\uC2DC\uB294 \uB2E4\uC2DC \uADF8 \uC9D1 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uC5B4\uC694.</color>\r\n\uCE94\uC790\uC2A4\uC758
      \uBC14\uB78C\uC740 \uC5EC\uC804\uD788 \uAC74\uC870\uD588\uACE0, \uC9D1\uC740
      \uADF8\uB300\uB85C\uC600\uC5B4\uC694.\r\n\uC544\uBB34\uAC83\uB3C4 \uBC14\uB00C\uC9C0
      \uC54A\uC740 \uCC44\uB85C. \uBB38\uC744 \uC5F4\uC790, \uC9D1 \uC548\uC740 \uC774\uC0C1\uD560
      \uC815\uB3C4\uB85C \uC870\uC6A9\uD588\uC5B4\uC694.\r\n\uC5E0 \uC544\uC8FC\uBA38\uB2C8\uC640
      \uD5E8\uB9AC \uC544\uC800\uC528\uB294 \uB3C4\uB85C\uC2DC\uB97C \uD55C \uBC88
      \uD6D1\uC5B4\uBCF4\uB354\uB2C8 \uB9D0\uD588\uC5B4\uC694.\r\n\u201C\uB3C4\uB9DD\uCCE4\uB2E4\uAC00
      \uB3CC\uC544\uC628 \uAC70\uBA74, \uB0B4\uC77C\uC740 \uB354 \uC5F4\uC2EC\uD788
      \uD574\uC57C\uACA0\uC9C0.\u201D\n\uC774 \uC9D1\uC5D0\uC11C\uB294 \uC0AC\uB77C\uC838\uB3C4
      \uC544\uBB34\uB3C4 \uCC3E\uC9C0 \uC54A\uC558\uACE0, \uB3CC\uC544\uC640\uB3C4
      \uC544\uBB34\uB3C4 \uBC18\uAE30\uC9C0 \uC54A\uC558\uC5B4\uC694. \n<color=#81290E>\uADF8\uC81C\uC11C\uC57C
      \uB3C4\uB85C\uC2DC\uB294 \uC54C\uC558\uC5B4\uC694.\n\uC5EC\uAE30\uB294 \uC9D1\uC774
      \uC544\uB2C8\uB77C, \uC790\uC2E0\uC774 \uACC4\uC18D \uC874\uC7AC\uD574\uC57C\uB9CC
      \uD558\uB294 \uAC10\uC625\uC774\uB77C\uB294 \uAC78.</color>\n"
