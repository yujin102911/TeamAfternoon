  _stageNumber: 5
  _stageName: "\uC883\uBC25 \uD29C\uD1A0\uB9AC\uC5BC\uC774\uC138\uC694"
  _limitRound: 6
  _limitEffect: 4
  _mails:
  - subject: "(\uC81C\uBAA9 \uC5C6\uC74C)"
    sender: "\uC6A9\uC0AC <lv01@msn.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uB9C8\uC655\uC774 \uC808 5\uCE35\uC5D0\uC11C \uAE30\uB2E4\uB9B0\uB2E4\uB294
      \uC18C\uC2DD \uB4E4\uC73C\uC168\uC5B4\uC694?\n5\uCE35\uC73C\uB85C \uC62C\uB77C\uAC00\uBA74
      \uC804 100% \uC8FD\uC744 \uAC81\uB2C8\uB2E4;;;\n\uCC28\uB77C\uB9AC \uC81C\uAC00
      \uB9C8\uC655\uACFC \uC2F8\uC6B0\uB2E4 \uCD5C\uD6C4\uB97C \uB9DE\uB294 \uC601\uC0C1\uC744
      \uB9CC\uB4E4\uBA74 \uC5B4\uB5A8\uAE4C\uC694?\n\uBC30\uACBD \uC815\uB3C4\uC57C
      \uD654\uC9C8\uC744 \uB0AE\uCD94\uBA74 \uB2E4\uB4E4 \uC758\uC2EC\uD558\uC9C0
      \uC54A\uC744 \uAC70\uC5D0\uC694/\n\uB0B4\uC77C\uAE4C\uC9C0 \uC798 \uBD80\uD0C0\u3131\u3131\u3131\u3131\u3131\u3131"
    unlockCondition: 0
  - subject: "[\uAE09\uD568] \uC774\uBBF8 \uC791\uC5C5\uD558\uC168\uB098\uC694?"
    sender: "\uC6A9\uC0AC <lv01@msn.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uB9C8\uC655\uC774 \uC624\uB298 \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4.\n\uB9C8\uC655\uC744
      \uC4F0\uB7EC\uB728\uB9AC\uB294 \uC601\uC0C1\uC5D0 \uBA4B\uC9C0\uAC8C \uB098\uC624\uACE0
      \uC2F6\uB2E4\uACE0\uC694.\n\uC774\uB7F0 \uD3B8\uC9D1\uC740 300\uB144 \uC804\uC5D0\uB3C4
      \uBABB \uBD24\uB2E4\uBA74\uC11C \uB4B7\uD1B5\uC218 \uCE58\uB294 \uBE44\uC5F4\uD55C
      \uB9C8\uC655 \uCF58\uC149\uD2B8\uB85C \uBE0C\uB808\uC2A4 \uD45C\uD604 \uC2E0\uACBD\uC368\uC11C
      \uD574\uB2EC\uB77C\uB294\uB370 \uC77C\uB2E8 \uBCF4\uC218\uB294 \uACF5\uC8FC\uB2D8\uC744
      \uAD6C\uD558\uB294 \uAC78\uB85C \uBC1B\uAE30\uB85C \uD588\uC2B5\uB2C8\uB2E4.\n\n\uB9CC\uB098\uC11C
      \uD569\uC744 \uB9DE\uCDB0\uBCF4\uAE34 \uD588\uB294\uB370 \uC911\uAC04\uCBE4
      \uACC4\uB2E8\uC744 \uB6F0\uC5B4 \uC62C\uB77C\uAC00\uC11C \uC2F8\uC6B0\uB294
      \uAC8C \uB354 \uBA4B\uC788\uC744 \uAC83 \uAC19\uB354\uB77C\uACE0\uC694.\n\uB0B4\uC77C
      \uC774 \uC2DC\uAC04\uC5D0 \uB2E4\uC2DC \uBCF4\uC790\uB2C8\uAE4C \uC624\uB298\uCE58
      \uD3B8\uC9D1\uC740 \uADF8 \uC804\uAE4C\uC9C0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4.\n\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    unlockCondition: 0
  _boardEntries:
  - title: " \uB9C8\uC655, \uC6A9\uC0AC\uC5D0\uAC8C \uC74C\uC131 \uD3B8\uC9C0 \uB0A8\uACA8"
    content: "MSN\uC5D0\uC11C \uC6B8\uC74C\uC18C\uB9AC\uB97C \uD574\uC11D\uD55C \uACB0\uACFC
      \u201C\uD604\uC7AC \uC18D\uB3C4\uB77C\uBA74 \uC624\uB298 \uC6A9\uC0AC\uAC00
      \uB9C8\uC655\uC131\uC5D0 \uB3C4\uCC29\uD558\uACA0\uC73C\uB098, \uB9CC\uC804\uC758
      \uC0C1\uD0DC\uB85C \uC2F8\uC6CC\uC8FC\uAE38 \uBC14\uB77C\uAE30 \uB54C\uBB38\uC5D0
      5\uCE35\uC758 \uACC4\uB2E8\uC744 \uBB34\uB108\uB728\uB838\uB2E4. \uC6A9\uC0AC\uB294
      \uD558\uB8E8 \uD734\uC2DD\uD558\uACE0 \uBC14\uB85C \uC62C\uB77C\uC624\uB77C\u201D\uB294
      \uBA54\uC2DC\uC9C0\uB97C \uC6A9\uC0AC\uC5D0\uAC8C \uC804\uD55C \uAC83\uC73C\uB85C
      \uCD94\uC815\uB41C\uB2E4."
    illustration: {fileID: 0}
  - title: " \uB3CC\uBCF4\uB2E4 \uAC15\uD55C \uC758\uC9C0\uC758 \uC6A9\uC0AC! <\uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30> 4\uD654 \uACE8\uB818 \uD3B8 \uACF5\uAC1C"
    content: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uB098\uD758 \uB9CC\uC5D0 \uB358\uC804
      4\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uC774\uBC88\uC5D0 \uC6A9\uC0AC\uAC00
      \uBB3C\uB9AC\uCE5C \uBAAC\uC2A4\uD130 \uACE8\uB818\uC740 \uC774\uC804\uC758
      \uBAAC\uC2A4\uD130\uC640 \uB2EC\uB9AC \u2018\uADF8\uB798\uBE0C\uB3C8 \uC815\uAE00
      \uAC8C\uC784\uB7A9 5\uAE30 \uBAA8\uC9D1\uC911\u2019\uC774\uB77C\uACE0 \uC0C8\uAE34
      \uB3CC\uC5D0 \uD2B9\uC218\uD55C \uB9C8\uBC95\uC744 \uAC78\uC5B4 \uB9CC\uB4DC\uB294
      \uC778\uACF5 \uC0DD\uBA85\uCCB4\uB2E4. \uADF8\uB7EC\uB098 \uC655\uAD6D\uC5D0\uC11C\uB294
      \uC790\uACA9\uC774 \uC788\uB294 \uB9C8\uBC95\uC0AC\uB4E4\uB9CC \uC81C\uC791\uD560
      \uC218 \uC788\uC73C\uBBC0\uB85C \uD568\uBD80\uB85C \uB530\uB77C\uD558\uB294
      \uAC83\uC740 \uAE08\uBB3C."
    illustration: {fileID: 0}
  - title: " \u201C\uC6A9\uC0AC, \uC9C4\uC9DC \uC6A9\uC0AC \uB9DE\uB098\u201D \uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30 \u2018\uD569\uC131\u2019 \uC758\uD639 \uBD88\uAC70\uC838"
    content: "\uD0C8\uC804\uD55C \uB9C8\uC871 A\uC528\uAC00 <\uC6A9\uC0AC, \uC800\uAC70
      \uB2E4 \uCF54\uC2A4\uD504\uB819\uB2C8\uB2E4>\uB77C\uB294 \uC601\uC0C1\uC744
      \uC62C\uB824 \uC5F0\uC77C \uD654\uC81C\uB2E4. A\uC528\uB294 \u201C3\uCE35 \uD6C4\uBC18\uBD80\uBD80\uD130\uB294
      \uC77C\uC9C1\uC120\uC774 \uC544\uB2C8\uB77C \uC6D0\uD615\uC73C\uB85C \uCC0D\uD614\uC5B4\uC57C
      \uB9DE\uB2E4\u201D\uACE0 \uC8FC\uC7A5\uD558\uBA70 \u201C\uCE7C\uC744 \uD718\uB450\uB974\uB294
      \uC7A5\uBA74\uC5D0\uC11C \uBA48\uCDB0\uBCF4\uBA74 \uC190\uAC00\uB77D\uC774
      6\uAC1C\u201D \uB4F1 8\uBD84 \uAC00\uB7C9\uC758 \uCDA9\uACA9\uC801\uC778 \uBD84\uC11D\uC744
      \uACF5\uAC1C\uD588\uB2E4. \u2018\uC6A9\uC0AC\uC758 \uACF5\uC8FC\uB4E4\u2019\uC740
      \uD574\uB2F9 \uC601\uC0C1\uC5D0 \uD5C8\uC704\uC0AC\uC2E4 \uC720\uD3EC \uD610\uC758\uB85C
      \uAC15\uACBD \uB300\uC751\uD560 \uAC83\uC774\uB77C\uACE0 \uBC1D\uD614\uB2E4."
