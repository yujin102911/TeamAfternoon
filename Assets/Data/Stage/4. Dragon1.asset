  _stageName: "\uC883\uBC25 \uD29C\uD1A0\uB9AC\uC5BC\uC774\uC138\uC694"
  _limitRound: 6
  _limitEffect: 4
  _mails:
  - subject: "\uC774\uBBF8 \uC791\uC5C5\uD558\uC168\uB098\uC694?"
    sender: "\uC6A9\uC0AC <lv01@msn.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uC774\uBBF8 \uC791\uC5C5\uD558\uC168\uB098\uC694?\r\n\uB9C8\uC655\uC774
      \uCC3E\uC544\uC654\uC2B5\uB2C8\uB2E4\r\n\uC774\uB7F0 \uD3B8\uC9D1\uC740 300\uB144
      \uC804\uC5D0\uB3C4 \uBABB \uBD24\uB2E4\uBA74\uC11C \uC790\uAE30\uB3C4 \uC601\uC0C1\uC5D0
      \uBA4B\uC788\uAC8C \uB098\uC624\uACE0 \uC2F6\uB2E4\uACE0\r\n\uB4B7\uD1B5\uC218
      \uCE58\uB294 \uBE44\uC5F4\uD55C \uB9C8\uC655 \uCF58\uC149\uD2B8\uC5D0 \uBE0C\uB808\uC2A4
      \uD45C\uD604 \uCD94\uAC00\uD558\uC790\uB294\uB370\r\n\uC77C\uB2E8 100\uB144
      \uB3D9\uC548 \uBD80\uD65C \uC548 \uD558\uB294 \uAC78\uB85C \uD569\uC758\uD558\uACE0
      \uCD2C\uC601 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4\n\r\n\uADF8\uB7F0\uB370 \uC911\uAC04\uC5D4
      \uACC4\uB2E8 \uB6F0\uC5B4 \uC62C\uB77C\uAC00\uC11C \uC2F8\uC6B0\uB294 \uAC8C
      \uB354 \uBA4B\uC788\uC744 \uAC83 \uAC19\uB354\uB77C\uACE0\uC694\r\n\uB0B4\uC77C
      \uC774 \uC2DC\uAC04\uC5D0 \uB2E4\uC2DC \uBCF4\uC790\uB2C8\uAE4C \uC624\uB298\uCE58
      \uD3B8\uC9D1\uC740 \uADF8 \uC804\uAE4C\uC9C0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\n\n\n\uCCA8\uBD80
      \uD30C\uC77C\n[ENTER_LINK]"
    unlockCondition: 0
  - subject: "(\uC81C\uBAA9 \uC5C6\uC74C)"
    sender: "\uC6A9\uC0AC <lv01@msn.com>"
    receiver: "\uC601\uC0C1 \uD3B8\uC9D1\uC0AC <editor@clearrun.fake>"
    body: "\uB9C8\uC655\uC774 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC73C\uBA74 \uC54C\uB824\uC8FC\uC168\uC5B4\uC57C\uC8E0\r\n5\uCE35
      \uCC0D\uC73C\uB824\uB2E4\uAC00 \uACC4\uB2E8 \uBB34\uB108\uC838\uC11C \uAE54\uB9AC\uB294
      \uC904 \uC54C\uC558\uC5B4\uC694\r\n\uACC4\uC18D \uC788\uC73C\uBA74 \uB4E4\uD0AC
      \uAC83 \uAC19\uC740\uB370\r\n\uB9C8\uC655\uC774\uB791 \uC2F8\uC6B0\uB2E4\uAC00
      \uC9C0\uB294 \uAC78\uB85C \uB9C8\uC9C0\uB9C9 \uD3B8\uC9D1 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4\r\n\uD654\uC9C8
      \uB9CE\uC774 \uB0AE\uCDB0 \uC8FC\uC2DC\uACE0\uC694 \uC798 \uBD80\uD0C0\u3131\u3131\u3131\u3131\u3131\u3131\u3131\u3131"
    unlockCondition: 0
  _boardEntries:
  - title: "\uB9C8\uC655, \uC6A9\uC0AC\uC5D0\uAC8C \uC74C\uC131 \uD3B8\uC9C0 \uB0A8\uACA8"
    content: "MSN\uC5D0\uC11C \uC6B8\uC74C\uC18C\uB9AC\uB97C \uD574\uC11D\uD55C \uACB0\uACFC
      \u201C\uD604\uC7AC \uC18D\uB3C4\uB77C\uBA74 \uC624\uB298 \uC6A9\uC0AC\uAC00
      \uB9C8\uC655\uC131\uC5D0 \uB3C4\uCC29\uD558\uACA0\uC73C\uB098, \uB9CC\uC804\uC758
      \uC0C1\uD0DC\uB85C \uC2F8\uC6CC\uC8FC\uAE38 \uBC14\uB77C\uAE30 \uB54C\uBB38\uC5D0
      5\uCE35\uC758 \uACC4\uB2E8\uC744 \uBB34\uB108\uB728\uB838\uB2E4. \uC6A9\uC0AC\uB294
      \uD558\uB8E8 \uD734\uC2DD\uD558\uACE0 \uBC14\uB85C \uC62C\uB77C\uC624\uB77C\u201D\uB294
      \uBA54\uC2DC\uC9C0\uB97C \uC6A9\uC0AC\uC5D0\uAC8C \uC804\uD55C \uAC83\uC73C\uB85C
      \uCD94\uC815\uB41C\uB2E4."
    illustration: {fileID: 0}
  - title: "\uB3CC\uBCF4\uB2E4 \uAC15\uD55C \uC758\uC9C0\uC758 \uC6A9\uC0AC! <\uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30> 4\uD654 \uACE8\uB818 \uD3B8 \uACF5\uAC1C"
    content: "\uC6A9\uC0AC\uAC00 \uC9C4\uC785 \uB098\uD758 \uB9CC\uC5D0 \uB358\uC804
      4\uCE35\uC744 \uC815\uBCF5\uD588\uB2E4. \uC774\uBC88\uC5D0 \uC6A9\uC0AC\uAC00
      \uBB3C\uB9AC\uCE5C \uACE8\uB818\uC740 \uC774\uC804\uC758 \uBAAC\uC2A4\uD130\uC640
      \uB2EC\uB9AC \uB3CC\uC5D0 \uD2B9\uC218\uD55C \uB9C8\uBC95\uC744 \uAC78\uC5B4
      \uB9CC\uB4DC\uB294 \uC778\uACF5 \uC0DD\uBA85\uCCB4\uB2E4. \uC655\uAD6D\uC5D0\uC11C\uB294
      \uC790\uACA9\uC774 \uC788\uB294 \uB9C8\uBC95\uC0AC\uB4E4\uB9CC \uC81C\uC791\uD560
      \uC218 \uC788\uC73C\uBBC0\uB85C \uD568\uBD80\uB85C \uB530\uB77C\uD558\uB294
      \uAC83\uC740 \uAE08\uBB3C."
    illustration: {fileID: 0}
  - title: "\u201C\uC6A9\uC0AC, \uC9C4\uC9DC \uC6A9\uC0AC \uB9DE\uB098\u201D \uB9C8\uC655\uC131
      \uB3C4\uC804\uAE30 \u2018\uD569\uC131\u2019 \uC758\uD639 \uBD88\uAC70\uC838"
    content: "\uD0C8\uC804\uD55C \uB9C8\uC871 A\uC528\uAC00 <\uC6A9\uC0AC, \uC800\uAC70
      \uB2E4 \uCF54\uC2A4\uD504\uB819\uB2C8\uB2E4>\uB77C\uB294 \uC601\uC0C1\uC744
      \uC62C\uB824 \uD654\uC81C\uB2E4. \uC601\uC0C1\uC5D0\uB294 \u201C\uCE7C\uC744
      \uD718\uB450\uB974\uB294 \uC7A5\uBA74\uC5D0\uC11C \uC190\uAC00\uB77D\uC774
      6\uAC1C\u201D \uB4F1\uC758 \uB0B4\uC6A9\uC774 \uB2F4\uACBC\uB2E4. \u2018\uC6A9\uC0AC\uC758
      \uACF5\uC8FC\uB4E4\u2019\uC740 \uD5C8\uC704\uC0AC\uC2E4 \uC720\uD3EC \uD610\uC758\uB85C
      \uAC15\uACBD \uB300\uC751\uD560 \uAC83\uC774\uB77C\uACE0 \uBC1D\uD614\uB2E4."
    illustration: {fileID: 0}
