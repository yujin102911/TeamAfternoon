  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC548\uB155\uD558\uC138\uC694, \uC0AC\uC11C\uB2D8!\n\uC5FC\uCE58\uC5C6\uC9C0\uB9CC
    \uC694\uC998 \uC800\uD76C \uB9C8\uC744\uC758 \uC0C1\uD669\uC774 \uB108\uBB34
    \uC2EC\uAC01\uD574\n\uC774\uB807\uAC8C <b><color=black>\uB3C4\uC6C0\uC744 \uCCAD\uD558\uB294
    \uD3B8\uC9C0</b></color>\uB97C \uBCF4\uB0B4\uAC8C \uB410\uC2B5\uB2C8\uB2E4.\n\n\uBA70\uCE60
    \uC804\uBD80\uD130 \uAC1C\uBBF8\uC640 \uBCA0\uC9F1\uC774\uAC00 \uB9C8\uC744 \uACF3\uACF3\uC744
    \uB3CC\uC544\uB2E4\uB2C8\uBA70\n\uB3C4\uBB34\uC9C0 <b><color=black>\uB9D0\uB9B4
    \uC218 \uC5C6\uB294 \uB09C\uB3D9</b></color>\uC744 \uBD80\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uC800\uD76C\uB3C4
    \uD06C\uAC8C \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\n\uD558\uC9C0\uB9CC
    \uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D \uB0B4\uAE30\uB294 \uC810\uC810 \uACFC\uD574\uC84C\uACE0,\n\uC774\uB97C
    \uB9D0\uB9AC\uB824\uB294 \uACE4\uCDA9\uB4E4\uC5D0\uAC8C <b><color=black>\uD3ED\uB825\uC744
    \uD718\uB450\uB974\uAE30 \uC2DC\uC791</b></color>\uD588\uC2B5\uB2C8\uB2E4.\n\uC9C0\uAE08\uC740
    \uB204\uAD6C\uB3C4 \uC27D\uAC8C \uB2E4\uAC00\uAC00\uC9C0 \uBABB\uD560 \uC815\uB3C4\uC785\uB2C8\uB2E4.\n\uACB0\uAD6D
    \uC774\uC7A5\uB2D8\uAED8\uC11C \uC9C1\uC811 \uB098\uC11C\uC168\uB2E4\uAC00 \uD06C\uAC8C
    \uB2E4\uCE58\uC154 \uBCD1\uC6D0\uC5D0 \uC785\uC6D0\uD558\uC2DC\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uC800\uB97C
    \uD3EC\uD568\uD55C \uB9C8\uC744\uC758 \uACE4\uCDA9\uB4E4\uC740 \uC9C0\uAE08\uB3C4
    \uB450\uB824\uC6C0\uC5D0 \uB5A8\uACE0 \uC788\uC2B5\uB2C8\uB2E4...\n\uC0AC\uC11C\uB2D8\uAED8\uC11C
    \uC9C0\uB2CC <b><color=black>\uD2B9\uBCC4\uD55C \uD798</b></color>\uC73C\uB85C
    \uC774 \uB0B4\uAE30\uB97C \uBA48\uCD94\uACE0\n\uAC1C\uBBF8\uC640 \uBCA0\uC9F1\uC774\uB97C
    \uC6D0\uB798\uC758 \uBAA8\uC2B5\uC73C\uB85C \uB418\uB3CC\uB824 \uC8FC\uC2E4 \uC218
    \uC5C6\uC744\uAE4C\uC694?\n\uC774\uB300\uB85C\uB77C\uBA74 \uB354 \uD070 \uD53C\uD574\uAC00
    \uC0DD\uAE38\uAE4C \uB108\uBB34 \uB450\uB824\uC6CC\uC694.\n\uB367\uBD99\uC5EC
    \uD55C \uAC00\uC9C0 \uC774\uC0C1\uD55C \uC810\uC740\n\uAC1C\uBBF8\uC640 \uBCA0\uC9F1\uC774\uAC00
    \uB09C\uB3D9\uC744 \uBD80\uB9AC\uAE30 \uC9C1\uC804,\n<b><color=black>\uC815\uCCB4\uB97C
    \uC54C \uC218 \uC5C6\uB294 \uD070 \uACB0\uC815</b></color>\uC744 \uC0BC\uCF30\uB2E4\uB294
    \uC18C\uBB38\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\uAC04\uC808\uD55C \uB9C8\uC74C\uC73C\uB85C
    \uB3C4\uC6C0\uC744 \uAD6C\uD569\uB2C8\uB2E4."
  m_isRightToLeft: 0
