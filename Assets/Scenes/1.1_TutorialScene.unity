--- !u!114 &1009927118
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1009927116}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC804\uC18D \uD3B8\uC9D1\uC0AC \uACE0\uC6A9\uACC4\uC57D\uC11C\r\n\uC6A9\uC0AC(\uC774\uD558
    \u201C\uAC11\u201D\uC774\uB77C \uD568)\uC640 \uD3B8\uC9D1\uC0AC(\uC774\uD558
    \u201C\uC744\u201D\uC774\uB77C \uD568)\uB294 \uB2E4\uC74C\uACFC \uAC19\uC774
    \uACC4\uC57D\uC744 \uCCB4\uACB0\uD55C\uB2E4.\n\r\n\uC81C 1\uC870. \uACC4\uC57D\uAE30\uAC04\r\n\uADFC\uB85C\uACC4\uC57D\uAE30\uAC04\uC740
    \uC744\uC774 \uACC4\uC57D\uC11C\uB97C \uD68C\uC2E0\uD55C \uB0A0\uC9DC\uBD80\uD130
    \uB9CC\uB8CC\uC77C\uAE4C\uC9C0\uB85C \uD55C\uB2E4. \uB9CC\uB8CC\uC77C\uC740 \uBA85\uC2DC\uB418\uC9C0
    \uC54A\uC740 \uACBD\uC6B0 \uC790\uB3D9 \uC5F0\uC7A5\uB418\uBA70, \uB9CC\uB8CC\uC77C\uC774
    \uD2B9\uC815 \uB0A0\uC9DC\uB85C \uAC31\uC2E0\uB410\uC744 \uACBD\uC6B0 \uCD5C\uC18C
    \uB9CC\uB8CC\uC758 7\uC77C \uC804 \uC744\uC5D0\uAC8C \uD1B5\uBCF4\uB418\uC5B4\uC57C
    \uD55C\uB2E4.\n\r\n\uC81C 2\uC870. \uADFC\uBB34 \uC7A5\uC18C \uBC0F \uC5C5\uBB34\uB0B4\uC6A9\r\n\uC744\uC740
    \uAC11\uC758 Wtube \uCC44\uB110\uC758 \uD3B8\uC9D1\uC0AC\uB85C\uC11C \uAC11\uC774
    \uC744\uC5D0\uAC8C \uC804\uB2EC\uD558\uB294 \uC601\uC0C1\uC758 \uD3B8\uC9D1 \uC804\uBC18\uC744
    \uC218\uD589\uD55C\uB2E4. \uC744\uC740 \uAC11\uC774 \uD1B5\uC9C0\uD55C \uAE30\uAC04
    \uB0B4\uC5D0 \uC601\uC0C1 \uD30C\uC77C\uC744 \uC804\uC1A1\uD574\uC57C \uD55C\uB2E4.
    \uC744\uC758 \uADFC\uBB34 \uC7A5\uC18C\uB294 \uC790\uD0DD\uC73C\uB85C \uD558\uBA70
    \uAC11\uC5D0\uAC8C \uADFC\uBB34 \uC0AC\uC2E4\uC744 \uC77C\uB9C8\uB2E4 \uBCC4\uB3C4\uB85C
    \uD1B5\uC9C0\uD560 \uD544\uC694\uAC00 \uC5C6\uB2E4. \uB2E8, \uAC11\uC774 \uADFC\uBB34
    \uC0AC\uC2E4\uC744 \uC694\uAD6C\uD560 \uB54C\uC5D0\uB294 Manasoft Worlds Movie
    Weaver\uC758 \uC2E4\uD589 \uAE30\uB85D, \uC0DD\uC131\uD55C \uC601\uC0C1 \uD30C\uC77C\uC758
    \uD3B8\uC9D1 \uB0A0\uC9DC \uB4F1\uC73C\uB85C \uC99D\uBE59 \uAC00\uB2A5\uD574\uC57C
    \uD55C\uB2E4.\n\r\n\uC81C 3\uC870. \uADFC\uB85C\uC2DC\uAC04 \uBC0F \uD734\uAC8C\uC2DC\uAC04\r\n\uADFC\uB85C\uC2DC\uAC04\uC740
    \uD558\uB8E8 \uCD5C\uB300 8\uC2DC\uAC04\uC5D0 \uD734\uC77C\uADFC\uBB34\uB97C
    \uD3EC\uD568\uD55C \uC5F0\uC7A5\uADFC\uB85C\uB97C \uCD1D 12\uC2DC\uAC04\uAE4C\uC9C0
    \uD5C8\uC6A9\uD558\uC5EC \uC8FC 52\uC2DC\uAC04\uC81C\uB97C \uC6D0\uCE59\uC73C\uB85C
    \uD558\uBA70, \uADFC\uBB34\uC2DC\uAC04 \uBC0F \uD734\uAC8C\uC2DC\uAC04\uC740
    \uB2E4\uC74C\uACFC \uAC19\uB2E4. \uADFC\uBB34\uC77C... \uACC4\uC57D\uC11C\uC758
    \uC774\uD558 \uC138\uBD80 \uB0B4\uC6A9\uC744 \uD655\uC778\uD558\uC2DC\uB824\uBA74
    \uC774\uACF3\uC744 \uB20C\uB7EC Manasoft \uACF5\uC2DD \uD648\uD398\uC774\uC9C0\uB85C
    \uC774\uB3D9\uD558\uC2ED\uC2DC\uC624."
