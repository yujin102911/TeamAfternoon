--- !u!114 &621299784
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 621299782}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Manasoft(\uB610\uB294 \uAC70\uC8FC \uC9C0\uC5ED\uC5D0 \uB530\uB77C \uACC4\uC5F4\uC0AC
    \uC911 \uD558\uB098)\uC740 \uADC0\uD558\uC5D0\uAC8C \uBCF8 \uCD94\uAC00 \uAD6C\uC131
    \uC694\uC18C\uC758 \uC0AC\uC6A9\uAD8C\uC744 \uD5C8\uC5EC\uD569\uB2C8\uB2E4.\n\n\uBCF8
    \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB294 \uD574\uB2F9\uB418\uB294 \uC804\uC18D
    \uD3B8\uC9D1\uC0AC \uACE0\uC6A9\uACC4\uC57D\uC11C, \uC804\uC18D \uC545\uB2E8
    \uACE0\uC6A9\uACC4\uC57D\uC11C, \uC804\uC18D \uD574\uC801 \uACE0\uC6A9\uACC4\uC57D\uC11C(\uC774\uD558
    \u201C\uACC4\uC57D\uC11C\u201D)\uC5D0 \uB300\uD55C \uC0AC\uC6A9\uAD8C\uC774 \uC788\uB294
    \uACBD\uC6B0 \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB97C \uC0AC\uC6A9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uACC4\uC57D\uC11C\uC5D0 \uB300\uD55C
    \uC0AC\uC6A9\uAD8C\uC774 \uC5C6\uAC70\uB098 \uB9CC\uB8CC\uB41C \uACBD\uC6B0\uC5D0\uB294
    \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB3C4 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\nManasoft\uB294
    \uACF5\uC2DD \uD648\uD398\uC774\uC9C0\uC5D0 \uBA85\uC2DC\uD55C \uBC14\uC640 \uAC19\uC774
    \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uC5D0 \uB300\uD55C \uC9C0\uC6D0 \uC11C\uBE44\uC2A4\uB97C
    \uC81C\uACF5\uD569\uB2C8\uB2E4. \uBCF8 \uCD94\uAC00 \uAD6C\uC131 \uC694\uC18C\uB294
    \uC0AC\uC6A9\uC790\uAC00 \uBCC4\uB3C4\uB85C \uC124\uCE58 \uBC0F \uB77C\uC774\uC13C\uC2A4\uB97C
    \uD5C8\uC5EC\uBC1B\uC544\uC57C \uD558\uB294 Worlds\uC6A9 Manasoft Worlds Movie
    Weaver \uC751\uC6A9 \uD504\uB85C\uADF8\uB7A8(\uC774\uD558 \u201C\uD504\uB85C\uADF8\uB7A8\u201D)\uC744
    \uD1B5\uD574 \uD5C8\uAC00 \uBC1B\uC740 \uC0AC\uC6A9\uC790\uC758 \uD29C\uD1A0\uB9AC\uC5BC
    \uC9C4\uD589\uC744 \uC9C0\uC6D0\uD569\uB2C8\uB2E4.\n\n\uCD94\uAC00 \uAD6C\uC131
    \uC694\uC18C\uB97C \uC124\uCE58, \uBCF5\uC0AC, \uB2E4\uC6B4\uB85C\uB4DC, \uC561\uC138\uC2A4,
    \uB610\uB294 \uAE30\uD0C0 \uBC29\uC2DD\uC73C\uB85C \uC0AC\uC6A9\uD568\uC73C\uB85C\uC368
    \uADC0\uD558\uB294 \uBCF8 \uACC4\uC57D\uC758 \uC870\uAC74\uC5D0 \uB3D9\uC758\uD569\uB2C8\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4a853867acc19b34d875d02b8423914e, type: 2}
